        painter.text("Vector Font Showcase", Math.Vec2(28.0, 18.0), Canvas.TextStyle(size:30.0, color:ink(), font:font))
        painter.text("3  Scene3D — mesh planaire éclairé + vraie shadow map", Math.Vec2(620.0, 26.0), Canvas.TextStyle(size:16.0, color:cyan(), font:font))
        painter.fill(Canvas.Rect(Math.Vec2(24.0, 92.0), Math.Vec2(390.0, 118.0), 12.0), Canvas.Fill.solid(Color.bytes(18, 24, 38)))
        painter.text("Même GlyphRun", Math.Vec2(48.0, 114.0), Canvas.TextStyle(size:18.0, color:amber(), font:font))
        painter.text("normales physiques · PBR · holes", Math.Vec2(48.0, 154.0), Canvas.TextStyle(size:15.0, color:ink(), font:font))
        painter.text("caster et receiver séparés", Math.Vec2(48.0, 180.0), Canvas.TextStyle(size:15.0, color:muted(), font:font))
        footer(painter, font, "O : repères du plan · Espace : lumière + curseur cyan")
    })
}

func scene_geometry(font:Canvas.Font) Canvas {
    return Canvas()..paint(func(painter:&Canvas.Painter) {
        painter.stroke(Canvas.Rect(Math.Vec2(438.0, 214.0), Math.Vec2(760.0, 300.0)), Canvas.Stroke(cyan(), 2.0))
        painter.stroke(Canvas.Line(Math.Vec2(470.0, 500.0), Math.Vec2(1160.0, 500.0)), Canvas.Stroke(amber(), 2.0))
        painter.fill(Canvas.Circle(Math.Vec2(470.0, 500.0), 6.0), Canvas.Fill.solid(cyan()))
        painter.text("plan du GlyphRun · origine · receiver d'ombre", Math.Vec2(454.0, 226.0), Canvas.TextStyle(size:14.0, color:cyan(), font:font))
    })
}

func cursor_board() Canvas {
    return Canvas()..paint(func(painter:&Canvas.Painter) {
        painter.stroke(Canvas.Line(Math.Vec2(2.0, 10.0), Math.Vec2(34.0, 10.0)), Canvas.Stroke(cyan(), 2.0))
        painter.fill(Canvas.Circle(Math.Vec2(34.0, 10.0), 5.0), Canvas.Fill.solid(cyan()))
    })
}

func capture_board(font:Canvas.Font, terminal_font:Canvas.Font) Canvas {
    var drawing = typography_board(font, terminal_font)
    var overlay_instance = required_instance(Font.Instance.create(font.face(), size:56.0))
    var overlay_run = required_run(overlay_instance.shape("office"))
    let overlay_baseline = 164.0 + Math.ceil(overlay_instance.metrics().ascender) as int as float
    drawing.paint(func(painter:&Canvas.Painter) {
        paint_typography_geometry(painter, font, overlay_run, overlay_baseline)
        painter.fill(Canvas.Rect(Math.Vec2(824.0, 356.0), Math.Vec2(408.0, 242.0), 12.0), Canvas.Fill.solid(Color.bytes(30, 35, 49)))
        painter.text("Scene2D outline", Math.Vec2(848.0, 378.0), Canvas.TextStyle(size:16.0, color:cyan(), font:font))
        painter.text("O  Bé", Math.Vec2(848.0, 420.0), Canvas.TextStyle(size:72.0, color:amber(), font:font))
        painter.text("Scene3D : voir la vue 3 interactive", Math.Vec2(848.0, 520.0), Canvas.TextStyle(size:15.0, color:ink(), font:font))
        painter.text("PNG = Canvas déterministe, pas capture GPU", Math.Vec2(848.0, 552.0), Canvas.TextStyle(size:13.0, color:muted(), font:font))
    })
    return drawing
}

func save_capture(path:str, font:Canvas.Font, terminal_font:Canvas.Font) {
    if path == "" { panic("capture path cannot be empty") }
    var drawing = capture_board(font, terminal_font)
    let image = drawing.rasterize(Layout.width, Layout.height, background())
    assert(image.width() == Layout.width)
    assert(image.height() == Layout.height)
    let pixels = image.pixels()
    var changed = 0
    var index = 0
    while index < pixels.count() {
        if pixels[index] != 12 as uint8 || pixels[index + 1] != 16 as uint8 ||
            pixels[index + 2] != 27 as uint8
        { changed++ }
        index += 4
    }
    assert(changed > 200000)
    let png = PNG.encode(image)
    assert(png.count() > 10000)
    match File.write_all(path, @png[0:png.count()]) {
        failure(error) => { panic(error.detail) }
        success => {}
    }
    print("VECTOR_FONT_SHOWCASE capture=", path, " changed_pixels=", changed, " png_bytes=", png.count())
}

func create_showcase(
    world:&Resources.World,
    meshes:&Resources.Meshes3D,
    state:&ShowcaseState
) {
    var clock = Clock()
    clock.tick()
    var font = Canvas.Font.default()
    var terminal_font = Canvas.Font.monospace()
    var face = font.face()
    state.typography_panel = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(typography_board(font, terminal_font), Layout.width, Layout.height)
            ..space = Scene2D.CanvasSpace.viewport
            ..pivot = Math.Vec2()
            ..layer = 100
            ..text_mode = Scene2D.CanvasTextMode.coverage
            ..coverage_density = 1.0
        )
    )
    state.vector_panel = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(vector_board(font), Layout.width, Layout.height)
            ..space = Scene2D.CanvasSpace.viewport
            ..pivot = Math.Vec2()
            ..layer = 100
            ..color = Color.bytes(255, 255, 255, 0)
            ..text_mode = Scene2D.CanvasTextMode.coverage
        )
    )
    state.vector_sample = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(vector_sample_board(font), Layout.width, Layout.height)
            ..space = Scene2D.CanvasSpace.viewport
            ..pivot = Math.Vec2()
            ..layer = 110
            ..color = Color.bytes(255, 255, 255, 0)
            ..text_mode = Scene2D.CanvasTextMode.vector
        )
    )
    state.scene_panel = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(scene_board(font), Layout.width, Layout.height)
            ..space = Scene2D.CanvasSpace.viewport
            ..pivot = Math.Vec2()
            ..layer = 100
            ..visible = false
            ..text_mode = Scene2D.CanvasTextMode.coverage
        )
    )
    state.typography_overlay = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(typography_geometry(font), Layout.width, Layout.height)
            ..space = Scene2D.CanvasSpace.viewport
            ..pivot = Math.Vec2()
            ..layer = 120
            ..text_mode = Scene2D.CanvasTextMode.coverage
        )
    )
    state.vector_overlay = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(vector_geometry(font), Layout.width, Layout.height)
            ..space = Scene2D.CanvasSpace.viewport
            ..pivot = Math.Vec2()
            ..layer = 120
            ..color = Color.bytes(255, 255, 255, 0)
            ..text_mode = Scene2D.CanvasTextMode.coverage
        )
    )
    state.scene_overlay = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(scene_geometry(font), Layout.width, Layout.height)
            ..space = Scene2D.CanvasSpace.viewport
            ..pivot = Math.Vec2()
            ..layer = 120
            ..visible = false
            ..text_mode = Scene2D.CanvasTextMode.coverage
        )
    )
    state.cursor = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform(position:Math.Vec2(26.0, 646.0)))
        ..with(Scene2D.Canvas(cursor_board(), 40, 20)
            ..space = Scene2D.CanvasSpace.viewport
            ..pivot = Math.Vec2()
            ..layer = 140
            ..text_mode = Scene2D.CanvasTextMode.vector
        )
    )

    var instance = required_instance(Font.Instance.create(face, size:1.0))
    var run = required_run(instance.shape("Vector O Bé"))
    let text_mesh = required_text(meshes.add_text(Scene3D.Text(
        run,
        plane:Scene3D.TextPlane(
            origin:Math.Vec3(-3.4, 0.2, 0.0),
            x_axis:Math.Vec3.right(),
            y_axis:Math.Vec3.up()
        ),
        tolerance:0.003
    )))
    let receiver_mesh = meshes.add(Scene3D.Geometry.Plane.make(Math.Vec2(9.4, 3.4)))
    state.text = world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform())
        ..with(Scene3D.Mesh(text_mesh, casts_shadows:true)..visible = false)
        ..with(Scene3D.Material(albedo:amber(), metallic:0.12, roughness:0.46))
        ..with(Scene3D.MaterialSettings(double_sided:true))
    )
    state.receiver = world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(position:Math.Vec3(0.0, 0.1, -0.7)))
        ..with(Scene3D.Mesh(receiver_mesh, casts_shadows:false)..visible = false)
        ..with(Scene3D.Material(albedo:Color.bytes(42, 49, 65), roughness:0.92))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(position:Math.Vec3(0.0, 1.0, 7.0)))
        ..with(Scene3D.Camera(near_plane:0.05, far_plane:50.0))
    )
    world.spawn(ECS.EntityRecipe()..with(Scene3D.AmbientLight(intensity:0.1)))
    state.light = world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.SunLight(
            direction:Math.Vec3(0.3, -0.35, -1.0).normalized(),
            intensity:4.5
        ))
    )
    print("VECTOR_FONT_SHOWCASE startup_cpu_ms=", clock.tick() * 1000.0)
}

func mesh_visibility(world:&Resources.World, entity:ECS.Entity?, visible:bool) {
    if let value = entity {
        world.update<Scene3D.Mesh>(value, func(mesh:&Scene3D.Mesh) { mesh.visible = visible })
    }
}

func canvas_visibility(world:&Resources.World, entity:ECS.Entity?, visible:bool) {
    if let value = entity {
        world.update<Scene2D.Canvas>(value, func(canvas:&Scene2D.Canvas) { canvas.visible = visible })
    }
}

func canvas_color(world:&Resources.World, entity:ECS.Entity?, color:Color) {
    if let value = entity {
        world.update<Scene2D.Canvas>(value, func(canvas:&Scene2D.Canvas) { canvas.color = color })
    }
}

func apply_view(world:&Resources.World, state:&ShowcaseState, view:int) {
    state.view = view
    canvas_visibility(world, state.typography_panel, view == 1)
    var vector_color = Color.bytes(255, 255, 255, 0)
    if view == 2 { vector_color = Color.white() }
    canvas_color(world, state.vector_panel, vector_color)
    canvas_color(world, state.vector_sample, vector_color)
    canvas_visibility(world, state.scene_panel, view == 3)
    canvas_visibility(world, state.typography_overlay, state.overlays && view == 1)
    var vector_overlay_color = Color.bytes(255, 255, 255, 0)
    if state.overlays && view == 2 { vector_overlay_color = Color.white() }
    canvas_color(world, state.vector_overlay, vector_overlay_color)
    canvas_visibility(world, state.scene_overlay, state.overlays && view == 3)
    mesh_visibility(world, state.text, view == 3)
    mesh_visibility(world, state.receiver, view == 3)
}

func timed_view(world:&Resources.World, state:&ShowcaseState, view:int) {
    if state.view == view { return }
    state.switch_clock.reset()
    state.switch_clock.tick()
    apply_view(world, state, view)
    state.pending_view = view
    print("VECTOR_FONT_SHOWCASE switch=$(view) cpu_ms=", state.switch_clock.get_total_milliseconds())
}

func input_showcase(
    input:@Resources.InputState,
    world:&Resources.World,
    state:&ShowcaseState,
    controller:&Application.Controller
) {
    if input.is_pressed(Input.Key.num1) { timed_view(world, state, 1) }
    if input.is_pressed(Input.Key.num2) { timed_view(world, state, 2) }
    if input.is_pressed(Input.Key.num3) { timed_view(world, state, 3) }
    if input.is_pressed(Input.Key.o) {
        state.overlays = !state.overlays
        apply_view(world, state, state.view)
    }
    if input.is_pressed(Input.Key.space) {
        state.paused = !state.paused
        var cursor_color = Color.white()
        if state.paused { cursor_color = amber() }
        if let cursor_entity = state.cursor {
            world.update<Scene2D.Canvas>(cursor_entity, func(canvas:&Scene2D.Canvas) {
                canvas.color = cursor_color
            })
        }
    }
    if input.is_pressed(Input.Key.escape) { controller.stop() }
}

func animate_showcase(
    time:@Resources.FrameTime,
    world:&Resources.World,
    state:&ShowcaseState
) {
    if state.paused { return }
    state.elapsed += time.delta
    if let cursor_entity = state.cursor {
        let x = 26.0 + (Math.sin(state.elapsed * 1.8) * 0.5 + 0.5) * 1190.0
        world.update<Scene2D.Transform>(cursor_entity, func(transform:&Scene2D.Transform) {
            transform.position = Math.Vec2(x, 646.0)
        })
    }
    if let light_entity = state.light {
        let angle = state.elapsed * 0.35
        world.update<Scene3D.SunLight>(light_entity, func(light:&Scene3D.SunLight) {
            light.direction = Math.Vec3(Math.sin(angle) * 0.35, -0.4, -1.0).normalized()
        })
    }
}

func report_present_latency(state:&ShowcaseState) {
    if !state.first_present_reported {
        print("VECTOR_FONT_SHOWCASE first_present_ms=", state.launch_clock.tick() * 1000.0)
        state.first_present_reported = true
    }
    if state.pending_view > 0 {
        print(
            "VECTOR_FONT_SHOWCASE switch=$(state.pending_view) present_ms=",
            state.switch_clock.tick() * 1000.0
        )
        state.pending_view = 0
    }
}

func finish_verification(
    world:&Resources.World,
    state:&ShowcaseState,
    meshes:@Resources.Meshes3D,
    controller:&Application.Controller
) {
    if !state.verification { return }
    state.frames++
    if state.frames == 1 { timed_view(world, state, 2) }
    if state.frames == 2 { timed_view(world, state, 3) }
    if state.frames == 3 { timed_view(world, state, 1) }
    if state.frames == 4 {
        state.overlays = false
        apply_view(world, state, state.view)
    }
    if state.frames == 5 {
        state.overlays = true
        apply_view(world, state, state.view)
    }
    if state.frames == 6 { timed_view(world, state, 2) }
    if state.frames == 7 { timed_view(world, state, 1) }
    if state.frames < 9 { return }
    let stats = meshes.text_cache_stats()
    assert(stats.tessellations > 0)
    assert(stats.text_builds == 1)
    print(
        "VECTOR_FONT_SHOWCASE verify=ok frames=", state.frames,
        " text_tessellations=", stats.tessellations,
        " text_meshes=", stats.glyph_meshes
    )
    controller.stop()
}

func run_showcase(verification:bool) {
    Application()
        ..add_resource(ShowcaseState(verification))
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Vector Font Showcase — 1/2/3, O, Space, Escape"
            ..width = Layout.width
            ..height = Layout.height
            ..hidden = verification
        ))
        ..add_plugin(Plugins.Input())
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()..clear = background()))
        ..add_plugin(Scene2D.Plugin())
        ..add_plugin(Scene3D.Plugin())
        ..add_plugin(Plugins.Time())
        ..add_system(Application.Schedule.startup, create_showcase)
        ..add_system(Application.Schedule.pre_update, input_showcase)
        ..add_system(Application.Schedule.update, animate_showcase)
        ..add_after_system(Application.Schedule.render, report_present_latency)
        ..add_after_system(Application.Schedule.render, finish_verification)
        ..run()
}

func main() {
    let configured = options()
    if let path = configured.capture {
        var font = Canvas.Font.default()
        var terminal_font = Canvas.Font.monospace()
        save_capture(path, font, terminal_font)
    }
    if configured.capture != null && !configured.verification { return }
    run_showcase(configured.verification)
}
