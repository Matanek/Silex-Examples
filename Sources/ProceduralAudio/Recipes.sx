use GFX.Audio.Synthesis
use GFX.Audio.Processing
use GFX.Audio.MIDI
use Module.Envelope.Gated
use Module.Engine.Engine
use STD.Error
use STD.Error.Kind

public struct Recipe {
    let name:str
    let frames:int
    var source:Synthesis.Generator
}
public func names() str[] { return ["beep","impact","laser","explosion","engine","retro","melody","midi"] }
func format(channels:int = 1) Processing.Format { return Processing.Format(sample_rate:48_000,channels:channels) }
func tone(hz:float32, amplitude:float32, waveform:Synthesis.Waveform = Synthesis.Waveform.sine) Result<Synthesis.Oscillator, Error> {
    return (try Synthesis.Oscillator.create(format(),frequency_hz:hz,amplitude:amplitude,waveform:waveform))
}
func gated(source:Synthesis.Generator, gate:int, attack:int, decay:int, sustain:float32, release:int) Result<Synthesis.Generator, Error> {
    var envelope = try Synthesis.Envelope.create(source.format,attack,decay,sustain,release) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    return Result<Synthesis.Generator, Error>.success(Gated(source,envelope,gate))
}
func impact() Result<Synthesis.Generator, Error> {
    var bass = try tone(65.0,0.25) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var noise = try Synthesis.WhiteNoise.create(format(),seed:42,amplitude:0.15) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var filter = try Processing.LowPass.create(format(),cutoff_hz:1_200.0) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var texture = try Synthesis.Processed.create(noise,[filter]) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var mix = try Synthesis.Mix.create([bass,texture],[1.0 as float32,1.0 as float32]) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    return (try gated(mix,480,48,0,1.0,12_000))
}
func laser() Result<Synthesis.Generator, Error> {
    var pitch = try Synthesis.Curve.create(format(),start:1.0,end:-1.0,duration_frames:24_000) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var source = try Synthesis.FrequencyModulation.create(format(),pitch,frequency_hz:1_500.0,deviation_hz:1_400.0,amplitude:0.15) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    return (try gated(source,24_000,240,8_000,0.4,12_000))
}
func explosion() Result<Synthesis.Generator, Error> {
    var noise = try Synthesis.WhiteNoise.create(format(),seed:1985,amplitude:0.35) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var filter = try Processing.LowPass.create(format(),cutoff_hz:450.0) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var texture = try Synthesis.Processed.create(noise,[filter]) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var bass = try tone(48.0,0.2) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var mix = try Synthesis.Mix.create([texture,bass],[1.0 as float32,1.0 as float32]) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    return (try gated(mix,48_000,48,24_000,0.1,12_000))
}
func retro() Result<Synthesis.Generator, Error> {
    var source = try tone(440.0,0.15,Synthesis.Waveform.square) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var crusher = try Processing.Bitcrusher.create(format(),bits:8,hold_frames:6) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var crushed = try Synthesis.Processed.create(source,[crusher]) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    return (try gated(crushed,19_200,240,1_200,0.4,4_800))
}
func melody() Result<Synthesis.Generator, Error> {
    var voice = try Synthesis.SineInstrument.create(format(),max_voices:8,attack_frames:240,decay_frames:2_400,sustain:0.6,release_frames:4_800) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var events:Synthesis.Event[] = []
    // Four beats at 120 BPM. Chord and lead share one polyphonic instrument.
    let notes:float32[] = [261.6256,329.6276,391.9954,523.2511]
    events.append(Synthesis.Event(frame:0,command:Synthesis.Command.gain_to(0.3,0)))
    events.append(Synthesis.Event(frame:0,command:Synthesis.Command.note_on(100,130.8128,0.3)))
    events.append(Synthesis.Event(frame:0,command:Synthesis.Command.note_on(101,195.9977,0.2)))
    for index, frequency in notes.indexed() {
        events.append(Synthesis.Event(frame:index*24_000,command:Synthesis.Command.note_on(index,frequency,0.6)))
        events.append(Synthesis.Event(frame:index*24_000+16_800,command:Synthesis.Command.note_off(index)))
    }
    events.append(Synthesis.Event(frame:96_000,command:Synthesis.Command.all_notes_off))
    var source = try Synthesis.Sequence.create(voice,events) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    return Result<Synthesis.Generator, Error>.success(source)
}
func midi() Result<Synthesis.Generator, Error> {
    let bytes = embed_bytes("Score.mid")
    var score = try MIDI.Score.parse(@bytes[0:bytes.count()],48_000) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    assert(score.track_count == 2 && score.end_frame == 172_800)
    var bass = try Synthesis.SineInstrument.create(format(2),max_voices:16,attack_frames:240,decay_frames:2_400,sustain:0.65,release_frames:4_800) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var lead = try Synthesis.SineInstrument.create(format(2),max_voices:16,attack_frames:480,decay_frames:4_800,sustain:0.45,release_frames:7_200) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var bright = try Synthesis.SineInstrument.create(format(2),max_voices:16,attack_frames:48,decay_frames:1_200,sustain:0.8,release_frames:9_600) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var synth = try MIDI.Synthesizer.create([
        MIDI.Binding(channel:0,program:0,instrument:bass),
        MIDI.Binding(channel:1,program:1,instrument:lead),
        MIDI.Binding(channel:1,program:2,instrument:bright),
    ],gain:0.35,controller_ramp_frames:240) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var player = try MIDI.Player.create(score,synth) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var echo = try Processing.Delay.create(format(2),delay_frames:7_200,feedback:0.25,wet:0.25) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    var source = try Synthesis.Processed.create(player,[echo]) else error { return Result<Synthesis.Generator,Error>.failure(error) }
    return Result<Synthesis.Generator, Error>.success(source)
}
public func make(index:int) Result<Recipe, Error> {
    match index {
        0 => { var source = try tone(660.0,0.15) else error { return Result<Recipe,Error>.failure(error) }; var result = try gated(source,8_400,240,2_400,0.65,5_760) else error { return Result<Recipe,Error>.failure(error) }; return Result<Recipe, Error>.success(Recipe(name:"beep",frames:14_160,source:result)) }
        1 => { var source = try impact() else error { return Result<Recipe,Error>.failure(error) }; return Result<Recipe, Error>.success(Recipe(name:"impact",frames:12_480,source:source)) }
        2 => { var source = try laser() else error { return Result<Recipe,Error>.failure(error) }; return Result<Recipe, Error>.success(Recipe(name:"laser",frames:36_000,source:source)) }
        3 => { var source = try explosion() else error { return Result<Recipe,Error>.failure(error) }; return Result<Recipe, Error>.success(Recipe(name:"explosion",frames:60_000,source:source)) }
        4 => { var source = try Engine.create() else error { return Result<Recipe,Error>.failure(error) }; return Result<Recipe, Error>.success(Recipe(name:"engine",frames:244_800,source:source)) }
        5 => { var source = try retro() else error { return Result<Recipe,Error>.failure(error) }; return Result<Recipe, Error>.success(Recipe(name:"retro",frames:24_000,source:source)) }
        6 => { var source = try melody() else error { return Result<Recipe,Error>.failure(error) }; return Result<Recipe, Error>.success(Recipe(name:"melody",frames:120_000,source:source)) }
        7 => { var source = try midi() else error { return Result<Recipe,Error>.failure(error) }; return Result<Recipe, Error>.success(Recipe(name:"midi",frames:220_800,source:source)) }
        else => { return Result<Recipe, Error>.failure(Error(kind:Kind.invalid_input(),operation:"demo.audio",subject:null,detail:"choose a recipe from 0 to 7")) }
    }
}
