use STD.Math
use Module.Bank
use Module.Voice

public func check() {
    var bank = Bank(); var voice = Voice(bank)
    var samples:float32[] = []; for _ in 0...512 { samples.append(0.0) }
    // The user-visible failure was missed by the coarse H3 RPM grid.
    voice.set_state(7_980.0, 1.0); voice.set_variation(false); voice.reset()
    var static_peak:float = 0.0
    for _ in 0...400 {
        voice.render(&samples[0:512])
        for value in samples { static_peak = Math.max(static_peak, Math.abs(value)) }
    }
    assert(static_peak <= 0.980001, "7980 RPM full-load blend exceeded certified headroom")
    voice.set_variation(true)
    var peak:float = 0.0; var state = 17; var bad_rpm:float = 0.0; var bad_load:float = 0.0
    for block in 0...6_000 {
        state = (state * 48_271) % 2_147_483_647
        let rpm = 1_800.0 + (state % 8_701) as float
        state = (state * 48_271) % 2_147_483_647
        let load = (state % 1_001) as float / 1_000.0
        // Alternate rapid controls and held states, exercising the settled
        // registered branch as well as transitions out of it.
        if block % 7 == 0 && block % 500 < 250 {
            if block % 2 == 0 { voice.set_state(rpm, load) }
            else { voice.set_drive((state % 1_001) as float / 1_000.0, load) }
        }
        if block % 181 == 0 { voice.set_idle(1_800.0 + (state % 1_701) as float) }
        if block % 223 == 0 { voice.set_inertia(1.0 + (state % 10) as float) }
        voice.render(&samples[0:512])
        for value in samples {
            assert(Math.is_finite(value) && Math.abs(value) <= 0.980001, "interactive control blend left the audio range")
            if Math.abs(value) > peak { peak = Math.abs(value); bad_rpm = voice.current_rpm(); bad_load = voice.current_load() }
        }
    }
    print("H5 headroom: static=", static_peak, " control-stress peak=", peak, " RPM=", bad_rpm, " load=", bad_load)
}
