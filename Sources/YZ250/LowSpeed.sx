use STD.Math
use Module.LowSpeedData

// The nearby YZ250X supplies native-time idle and order-domain overrun.
// This immutable data is shared by voices through Bank; state lives in Texture.
public class LowSpeed {
    let audio_bytes:int
    let idle_frames:int
    private var pcm:float32[] = []
    private var data:LowSpeedData = LowSpeedData()
    init() {
        let bytes = embed_bytes("Assets/LowSpeed.pcm")
        self.audio_bytes = bytes.count(); self.idle_frames = self.data.idle_frames
        assert(bytes.count() == (self.idle_frames * 3 + 16_384) * 4)
        for i in 0...bytes.count() / 2 {
            var word = bytes[i * 2] as int + bytes[i * 2 + 1] as int * 256
            if word >= 32_768 { word -= 65_536 }
            self.pcm.append(word as float32 / 32_768.0)
        }
    }
    private func sample(offset:int, frames:int, position:float64, channel:int) float64 {
        let index = Math.floor(position) as int; let fraction = position - index as float64
        let a = self.pcm[(offset + index) * 2 + channel] as float64
        let b = self.pcm[(offset + (index + 1) % frames) * 2 + channel] as float64
        return a + fraction * (b - a)
    }
    func idle(position:float64, channel:int, rpm:float64) float64 {
        let rate = rpm / 1_800.0
        let medium = Math.clamp((rate - 1.0) * 20.0, 0.0, 1.0)
        let high = Math.clamp((rate - 1.9) * 10.0, 0.0, 1.0)
        var value = self.sample(0, self.idle_frames, position, channel) * (1.0 - medium)
        value += self.sample(self.idle_frames, self.idle_frames, position, channel) * medium
        value = value * (1.0 - high) + self.sample(self.idle_frames * 2, self.idle_frames, position, channel) * high
        return value * Math.min(1.0, 0.98 / self.data.idle_peak)
    }
    func coast(turns:float64, channel:int) float64 {
        return self.sample(self.idle_frames * 3, 16_384, turns * 512.0, channel) * Math.min(1.0, 0.98 / self.data.coast_peak)
    }
    func coast_peak() float64 { return self.data.coast_peak }
}
