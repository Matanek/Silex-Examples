use STD.Math
use Module.BlendEnergy
use Module.PeakBounds
use Module.Registered
use Module.LowSpeed

// Original attacks (768 KiB) and one aligned take G, two bandwidths (128 KiB).
// Both voices share the same continuous crank clock.
public class Bank {
    let minimum_rpm:float = 1_800.0
    let recorded_minimum_rpm:float = 3_660.0
    let maximum_rpm:float = 10_500.0
    let rpms:float64[] = [3_660.0, 4_500.0, 6_000.0, 7_500.0, 9_000.0, 10_500.0]
    let audio_bytes:int
    let idle_frames:int
    private var pcm:float32[] = []
    private var energy:BlendEnergy = BlendEnergy()
    private var bounds:PeakBounds = PeakBounds()
    private var registered:Registered = Registered()
    private var low_speed:LowSpeed = LowSpeed()
    init() {
        let bytes = embed_bytes("Assets/Compact.pcm")
        self.audio_bytes = bytes.count() + self.registered.audio_bytes + self.low_speed.audio_bytes
        self.idle_frames = self.low_speed.idle_frames
        assert(bytes.count() == 12 * 32 * 512 * 4)
        for i in 0...bytes.count() / 2 {
            var word = bytes[i * 2] as int + bytes[i * 2 + 1] as int * 256
            if word >= 32_768 { word -= 65_536 }
            self.pcm.append(word as float32 / 32_768.0)
        }
    }
    // Preserve the expected energy between RPM nodes, while retaining the
    // existing within-node load blend. Covariance is measured offline from
    // the stereo PCM; this never follows the instantaneous audio amplitude.
    func node_power(index:int) float64 { return self.energy.covariance[index * 12 + index] }
    func mix_power(weights:@float64[..]) float64 {
        var measured:float64 = 0.0
        for i in 0...12 {
            if weights[i] < 0.00000001 { continue }
            for j in 0...12 { measured += weights[i] * weights[j] * self.energy.covariance[i * 12 + j] }
        }
        return measured
    }
    func blend_gain(weights:@float64[..]) float64 {
        let measured = self.mix_power(weights); var desired:float64 = 0.0
        // Keep the accepted low/mid attack's internal blend as one group.
        // Only crossings into/between upper nodes receive energy correction.
        for group in 0...4 {
            var begin = 0; var end = 6
            if group > 0 { begin = group * 2 + 4; end = begin + 2 }
            var weight:float64 = 0.0; var power:float64 = 0.0
            for i in begin...end {
                weight += weights[i]
                for j in begin...end { power += weights[i] * weights[j] * self.energy.covariance[i * 12 + j] }
            }
            if weight > 0.00000001 { desired += power / weight }
        }
        if measured <= 0.000000000001 { return 1.0 }
        return Math.sqrt(desired / measured)
    }
    func registered_gain(weights:@float64[..], original_gain:float64) float64 {
        return self.registered.gain(self.mix_power(weights) * original_gain * original_gain)
    }
    func registered_peak() float64 { return self.registered.peak() }
    func registered_sample(turns:float64, channel:int, rpm:float64) float64 { return self.registered.sample(turns, channel, rpm) }
    func registered_residual(turns:float64, channel:int) float64 { return self.registered.residual(turns, channel) }
    func idle_sample(position:float64, channel:int, rpm:float64) float64 { return self.low_speed.idle(position, channel, rpm) }
    func coast_sample(turns:float64, channel:int) float64 { return self.low_speed.coast(turns, channel) }
    func coast_peak() float64 { return self.low_speed.coast_peak() }
    func node_peak(index:int) float64 { return self.bounds.peaks[index] }
    private func bound_at(pair:int, rpm:float64, low:float64, high:float64) float64 {
        let r = Math.clamp(rpm * 16.0, 0.0, 16.0)
        let l = Math.clamp(low * 4.0, 0.0, 4.0); let h = Math.clamp(high * 4.0, 0.0, 4.0)
        var ri = Math.floor(r) as int; if ri == 16 { ri = 15 }
        var li = Math.floor(l) as int; if li == 4 { li = 3 }
        var hi = Math.floor(h) as int; if hi == 4 { hi = 3 }
        let rf = r - ri as float64; let lf = l - li as float64; let hf = h - hi as float64
        var value:float64 = 0.0
        for dr in 0...2 { for dl in 0...2 { for dh in 0...2 {
            var weight = rf; if dr == 0 { weight = 1.0 - rf }
            if dl == 0 { weight *= 1.0 - lf } else { weight *= lf }
            if dh == 0 { weight *= 1.0 - hf } else { weight *= hf }
            let index = ((pair * 17 + ri + dr) * 5 + li + dl) * 5 + hi + dh
            value += weight * self.bounds.values[index]
        } } }
        return value
    }
    // Convex peak envelopes cover every sample, not a set of audition RPMs.
    // Residual weights during fast transitions are included, not discarded.
    func peak_bound(weights:@float64[..]) float64 {
        var total:float64 = 0.0
        for i in 0...12 { total += weights[i] * self.bounds.peaks[i] }
        var result = total
        for pair in 0...5 {
            let i = pair * 2
            let a = weights[i] + weights[i + 1]; let b = weights[i + 2] + weights[i + 3]
            let sum = a + b
            if sum < 0.000001 { continue }
            var low:float64 = 0.0; var high:float64 = 0.0
            if a > 0.0 { low = weights[i + 1] / a }
            if b > 0.0 { high = weights[i + 3] / b }
            var residual = total
            for j in i...i + 4 { residual -= weights[j] * self.bounds.peaks[j] }
            result = Math.min(result, residual + sum * self.bound_at(pair, b / sum, low, high))
        }
        return result
    }
    func sample(node:int, turns:float64, channel:int) float64 {
        let position = turns * 512.0
        let index = Math.floor(position) as int
        let fraction = position - index as float64
        let a = self.pcm[(node * 16_384 + index) * 2 + channel] as float64
        let b = self.pcm[(node * 16_384 + (index + 1) % 16_384) * 2 + channel] as float64
        return a + fraction * (b - a)
    }
}
