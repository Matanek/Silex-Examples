use STD.File
use STD.Math
use STD.Text.UTF8
use Module.Bank
use Module.Voice

func zeros(frames:int) float32[] { var values:float32[] = []; for _ in 0...frames * 2 { values.append(0.0) }
    return values }
func word(bytes:&uint8[], value:int, count:int) {
    var remaining = value
    for _ in 0...count { bytes.append((remaining % 256) as uint8); remaining /= 256 }
}
func wave(path:str, values:@float32[..]) {
    var bytes:uint8[] = [82 as uint8, 73 as uint8, 70 as uint8, 70 as uint8]
    word(bytes, 36 + values.count() * 2, 4)
    for value in [87, 65, 86, 69, 102, 109, 116, 32] { bytes.append(value as uint8) }
    word(bytes, 16, 4); word(bytes, 1, 2); word(bytes, 2, 2); word(bytes, 44_100, 4)
    word(bytes, 176_400, 4); word(bytes, 4, 2); word(bytes, 16, 2)
    for value in [100, 97, 116, 97] { bytes.append(value as uint8) }
    word(bytes, values.count() * 2, 4)
    for value in values {
        assert(Math.is_finite(value) && Math.abs(value) <= 1.0)
        var sample = Math.round(value * 32_767.0) as int
        if sample < 0 { sample += 65_536 }
        word(bytes, sample, 2)
    }
    File.write_all(path, @bytes[0:bytes.count()])
}
public func render(prefix:str) {
    var bank = Bank(); var samples = zeros(256)
    for scenario in 0...6 {
        var voice = Voice(bank); var rpm:float = 4_500.0; var load:float = 0.7
        var suffix = "Fixed-4500"; var seconds = 8
        if scenario == 1 { rpm = 7_000.0; suffix = "Fixed-7000" }
        if scenario == 2 { rpm = 9_500.0; suffix = "Fixed-9500" }
        if scenario == 3 { rpm = 7_000.0; load = 0.0; suffix = "Load-Low" }
        if scenario == 4 { rpm = 7_000.0; load = 1.0; suffix = "Load-High" }
        if scenario == 5 { suffix = "Throttle"; seconds = 12 }
        voice.set_state(rpm, load)
        if scenario == 5 { voice.set_drive(0.0, 0.4) }
        voice.reset()
        var output:float32[] = []; var telemetry = "frame,rpm,turns,load,throttle\n"
        let duration = seconds * 44_100
        var frame = 0
        while frame < duration {
            let time = frame as float / 44_100.0
            if scenario == 5 {
                var throttle:float = 0.0
                if time >= 0.5 && time < 0.7 { throttle = 1.0 }
                if time >= 1.2 && time < 1.5 { throttle = 1.0 }
                if time >= 2.2 && time < 7.0 { throttle = 1.0 }
                if time >= 9.0 && time < 10.5 { throttle = 0.6 }
                voice.set_drive(throttle, 0.4)
            }
            var count = 256; if frame + count > duration { count = duration - frame }
            voice.render(&samples[0:count * 2])
            for i in 0...count * 2 {
                var fade:float32 = 1.0
                if frame + i / 2 > duration - 883 { fade = (duration - 1 - frame - i / 2) as float32 / 882.0 }
                output.append(samples[i] * 0.7 * fade)
            }
            frame += count
            telemetry += "$(frame),$(voice.current_rpm()),$(voice.crank_turns()),$(voice.current_load()),$(voice.current_throttle())\n"
        }
        wave(prefix + "-$(suffix).wav", @output[0:output.count()])
        var encoded = UTF8.bytes(telemetry); File.write_all(prefix + "-$(suffix).csv", @encoded[0:encoded.count()])
        print("YZ250 H1 export: ", prefix, "-", suffix, ".wav")
    }
}
public func check() {
    var bank = Bank(); assert(bank.audio_bytes == 786_432)
    var a = zeros(512); var b = zeros(512); var peak:float = 0.0
    let rpms:float[] = [3_660.0, 4_500.0, 6_000.0, 7_000.0, 7_500.0, 9_000.0, 10_500.0]
    let loads:float[] = [0.0, 0.5, 1.0]
    for rpm in rpms {
        for load in loads {
            var voice = Voice(bank); voice.set_state(rpm, load); voice.reset()
            var energy:float64 = 0.0
            for _ in 0...150 {
                voice.render(&a[0:1_024])
                for value in a {
                    assert(Math.is_finite(value) && Math.abs(value) < 1.0, "non-finite or clipped output")
                    peak = Math.max(peak, Math.abs(value)); energy += value as float64 * value as float64
                }
            }
            let expected = voice.frame() as float64 * rpm as float64 / 2_646_000.0
            assert(Math.abs(voice.crank_turns() - expected) < 0.000001, "fixed firing cadence drifted")
            assert(energy > 0.1, "silent point")
        }
    }
    var whole = Voice(bank); var split = Voice(bank)
    whole.set_drive(1.0, 0.6); split.set_drive(1.0, 0.6); whole.reset(); split.reset()
    for _ in 0...100 {
        whole.render(&a[0:1_024]); split.render(&b[0:128]); split.render(&b[128:690]); split.render(&b[690:1_024])
        for i in 0...1_024 { assert(a[i] == b[i], "block sizes changed audio") }
    }
    var free = Voice(bank); var loaded = Voice(bank)
    free.set_drive(1.0, 0.0); loaded.set_drive(1.0, 1.0); free.reset(); loaded.reset()
    for _ in 0...30 { free.render(&a[0:1_024]); loaded.render(&b[0:1_024]) }
    assert(free.current_rpm() > loaded.current_rpm() + 500.0, "load did not slow acceleration")
    for _ in 0...400 { loaded.render(&b[0:1_024]) }
    assert(loaded.current_rpm() > 10_490.0, "load incorrectly capped full throttle RPM")
    var low = Voice(bank); var high = Voice(bank)
    low.set_state(7_000.0, 0.0); high.set_state(7_000.0, 1.0); low.reset(); high.reset()
    var difference:float64 = 0.0
    for _ in 0...80 {
        low.render(&a[0:1_024]); high.render(&b[0:1_024])
        for i in 0...1_024 { difference += Math.abs(a[i] as float64 - b[i] as float64) }
    }
    assert(difference > 1.0 && low.crank_turns() == high.crank_turns(), "load changed pitch or had no sound effect")
    whole.set_drive(0.0, 0.6)
    for _ in 0...250 { whole.render(&a[0:1_024]) }
    assert(whole.current_rpm() < 3_670.0 && whole.current_throttle() < 0.001, "gas release did not return to floor")
    whole.set_drive(0.0, 0.6, false)
    for _ in 0...50 { whole.render(&a[0:1_024]) }
    for value in a { assert(Math.abs(value) < 0.000001, "stop did not silence") }
    let clock = whole.frame()
    match try whole.set_state(Math.sqrt(-1.0), 0.0) { failure(value) => {}; success => { panic("NaN accepted") } }
    match try whole.set_drive(1.01, 0.0) { failure(value) => {}; success => { panic("invalid gas accepted") } }
    match try whole.render(&a[0:3]) { failure(value) => {}; success => { panic("partial frame accepted") } }
    assert(clock == whole.frame())
    print("YZ250 H1 checks passed: 768 KiB bank, 21 steady points, gas/load/hold/release, phase, split blocks, stop and errors. Peak=", peak)
}
