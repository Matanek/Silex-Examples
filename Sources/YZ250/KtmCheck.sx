use STD.Math
use Module.KtmData
use Module.KtmVoice

func sample(bytes:@uint8[..], index:int) float32 {
    var word = bytes[index * 2] as int + bytes[index * 2 + 1] as int * 256
    if word >= 32_768 { word -= 65_536 }
    return word as float32 / 32_768.0
}

func check_clip(voice:KtmVoice, first:int, end:int) {
    let bytes = embed_bytes("Assets/Ktm.pcm")
    var output:float32[] = []
    for _ in 0...512 { output.append(0.0) }
    var frame = first
    while frame < end {
        var count = 256
        if end - frame < count { count = end - frame }
        voice.render(&output[0:count * 2])
        for index in 0...count * 2 {
            assert(output[index] == sample(@bytes[0:bytes.count()], frame * 2 + index))
        }
        frame += count
    }
}

func advance(voice:KtmVoice, frames:int) {
    var output:float32[] = []
    for _ in 0...512 { output.append(0.0) }
    var remaining = frames
    while remaining > 0 {
        var count = 256
        if remaining < count { count = remaining }
        voice.render(&output[0:count * 2])
        var power:float64 = 0.0
        for i in 0...count * 2 {
            let value = output[i]
            assert(Math.is_finite(value) && Math.abs(value) < 1.0, "KTM render left PCM range")
            power += (value as float64) * (value as float64)
        }
        if count == 256 { assert(power > 0.00001, "KTM ride introduced a silent block") }
        remaining -= count
    }
}

func check_opening(voice:KtmVoice) {
    let bytes = embed_bytes("Assets/Ktm.pcm")
    voice.listen_idle()
    advance(voice, 2_048)
    assert(voice.status() == "Ralenti")
    voice.gas(true)
    advance(voice, KtmData.join_frames)
    assert(voice.status() == "Ouverture des gaz")
    var probe:float32[] = []
    for _ in 0...32 { probe.append(0.0) }
    voice.render(&probe[0:32])
    let first = KtmData.opening_begin + KtmData.join_frames
    for frame in first...first + 1_324 {
        var matches = true
        for i in 0...32 {
            if probe[i] != sample(@bytes[0:bytes.count()], frame * 2 + i) { matches = false; break }
        }
        if matches {
            check_clip(voice, frame + 16, KtmData.opening_join)
            advance(voice, KtmData.join_frames)
            check_clip(voice, KtmData.rise_begin + KtmData.join_frames, KtmData.coast_begin)
            return
        }
    }
    assert(false, "throttle did not use the recorded opening")
}

public func check() {
    var voice = KtmVoice()
    voice.listen_original(); check_clip(voice, KtmData.original_begin, KtmData.idle_begin)
    assert(voice.status() == "À l’arrêt")
    voice.listen_mix(); check_clip(voice, 0, KtmData.mix_frames)
    assert(voice.status() == "À l’arrêt")
    check_opening(voice)
    voice.stop()

    voice.gas(true)
    advance(voice, 6_000)
    assert(voice.status() == "Ouverture des gaz")
    voice.gas(false)
    advance(voice, 1_024)
    assert(voice.status() == "Ralenti", "brief press played the rest of the opening")

    voice.gas(true)
    advance(voice, 92_000)
    assert(voice.status() == "Montée")
    voice.gas(false)
    advance(voice, 1_024)
    assert(voice.status() == "Retombée", "short press kept climbing")
    voice.gas(true)
    advance(voice, 1_024)
    assert(voice.status() == "Montée", "reopening during fall did not accelerate")
    advance(voice, 220_500)
    assert(voice.status() == "Maintien", "held gas did not sustain the plateau")
    voice.gas(false)
    advance(voice, 2_048)
    assert(voice.status() == "Retombée")
    advance(voice, 132_300)
    assert(voice.status() == "Ralenti")

    for block in 0...500 {
        if block % 7 == 0 { voice.gas(block % 3 == 0) }
        advance(voice, 513)
    }
    voice.stop()
    assert(voice.status() == "À l’arrêt")
    print("KTM E/G: source, mix and recorded opening sample-exact outside joins; brief press, release, reopening, hold and idle passed")
}
