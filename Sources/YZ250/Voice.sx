use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.Math
use STD.Error
use STD.Error.Kind
use Module.Bank

// Recorded texture, a shared continuous crank phase and four adjacent loop
// gains. No grain selection, internal pitch sweep or reset at RPM crossings.
public class Voice:Synthesis.Generator {
    let format:Processing.Format = Processing.Format(sample_rate:44_100, channels:2)
    private var bank:Bank
    private var clock:int = 0
    private var turns:float64 = 0.0
    private var total_turns:float64 = 0.0
    private var target_rpm:float64
    private var target_load:float64 = 0.5
    private var rpm:float64
    private var load:float64 = 0.5
    private var running:bool = false
    private var gain:float64 = 0.0
    private var blend_gain:float64 = 1.0
    private var target_blend_gain:float64 = 1.0
    private var driving:bool = false
    private var target_throttle:float64 = 0.0
    private var throttle:float64 = 0.0
    private var weights:float64[] = []
    private var desired_weights:float64[] = []

    init(bank:Bank) {
        self.bank = bank; self.rpm = bank.minimum_rpm as float64; self.target_rpm = self.rpm
        for _ in 0...12 { self.weights.append(0.0); self.desired_weights.append(0.0) }
        self.reset()
    }
    func set_state(rpm:float, load:float, running:bool = true) Result<void,Error> {
        if !Math.is_finite(rpm) || rpm < self.bank.minimum_rpm || rpm > self.bank.maximum_rpm || !Math.is_finite(load) || load < 0.0 || load > 1.0 {
            return Result<void,Error>.failure(Error(kind:Kind.invalid_input(), operation:"yz250.state", detail:"RPM inside recorded estimated range and finite load in 0..1 required"))
        }
        self.driving = false
        self.target_rpm = rpm; self.target_load = load; self.running = running
        return Result<void,Error>.success()
    }
    func set_drive(throttle:float, load:float, running:bool = true) Result<void,Error> {
        if !Math.is_finite(throttle) || throttle < 0.0 || throttle > 1.0 || !Math.is_finite(load) || load < 0.0 || load > 1.0 {
            return Result<void,Error>.failure(Error(kind:Kind.invalid_input(), operation:"yz250.drive", detail:"finite throttle and load in 0..1 required"))
        }
        self.driving = true; self.target_throttle = throttle; self.target_load = load; self.running = running
        return Result<void,Error>.success()
    }
    func current_rpm() float { return round_float<float>(self.rpm) }
    func current_load() float { return round_float<float>(self.load) }
    func current_throttle() float { return round_float<float>(self.throttle) }
    func frame() int { return self.clock }
    func crank_turns() float64 { return self.total_turns }
    func reset() {
        self.clock = 0; self.turns = 0.0; self.total_turns = 0.0; self.gain = 0.0
        self.rpm = self.target_rpm; self.load = self.target_load; self.throttle = 0.0
        if self.driving { self.rpm = self.bank.minimum_rpm as float64; self.load = 0.0 }
        self.mix_weights()
        for i in 0...12 { self.weights[i] = self.desired_weights[i] }
        self.blend_gain = self.bank.blend_gain(@self.weights[0:12]); self.target_blend_gain = self.blend_gain
    }
    private func mix_weights() {
        var node = 0
        while node < 4 && self.rpm > self.bank.rpms[node + 1] { node++ }
        let mix = Math.clamp((self.rpm - self.bank.rpms[node]) / (self.bank.rpms[node + 1] - self.bank.rpms[node]), 0.0, 1.0)
        for i in 0...12 { self.desired_weights[i] = 0.0 }
        self.desired_weights[node * 2] = (1.0 - mix) * (1.0 - self.load)
        self.desired_weights[node * 2 + 1] = (1.0 - mix) * self.load
        self.desired_weights[node * 2 + 2] = mix * (1.0 - self.load)
        self.desired_weights[node * 2 + 3] = mix * self.load
    }
    func render(samples:&float32[..]) Result<void,Error> {
        if samples.count() % 2 != 0 {
            return Result<void,Error>.failure(Error(kind:Kind.invalid_input(), operation:"yz250.render", detail:"complete stereo frames required"))
        }
        if !self.running && self.gain < 0.0000001 {
            self.gain = 0.0
            for i in 0...samples.count() { samples[i] = 0.0 }
            return Result<void,Error>.success()
        }
        for frame in 0...samples.count() / 2 {
            if self.driving {
                // Listening response, without measured torque/inertia. Load
                // slows acceleration; full throttle still reaches full RPM.
                self.throttle += 0.0015 * (self.target_throttle - self.throttle)
                let span = (self.bank.maximum_rpm - self.bank.minimum_rpm) as float64
                let target = self.bank.minimum_rpm as float64 + span * self.throttle
                var seconds:float64 = 0.24
                if target > self.rpm { seconds = 0.18 + 0.35 * self.target_load }
                let acceleration = (target - self.rpm) / seconds
                self.rpm += acceleration / 44_100.0
                let acoustic_load = Math.clamp(self.throttle * (0.85 + 0.15 * self.target_load) + acceleration / 30_000.0, 0.0, 1.0)
                self.load += 0.002 * (acoustic_load - self.load)
            } else {
                self.rpm += Math.clamp(self.target_rpm - self.rpm, -60_000.0 / 44_100.0, 60_000.0 / 44_100.0)
                self.load += 0.002 * (self.target_load - self.load)
            }
            // Weights updated at 689 Hz and slewed per audio frame. Loop
            // positions remain synchronized even while a loop has zero gain.
            if self.clock % 64 == 0 {
                self.mix_weights(); self.target_blend_gain = self.bank.blend_gain(@self.weights[0:12])
            }
            self.blend_gain += 0.008 * (self.target_blend_gain - self.blend_gain)
            for i in 0...12 { self.weights[i] += 0.008 * (self.desired_weights[i] - self.weights[i]) }
            let advance = self.rpm / 2_646_000.0
            self.turns += advance; self.total_turns += advance
            if self.turns >= 32.0 { self.turns -= 32.0 }
            var target:float64 = 0.0; if self.running { target = 1.0 }
            self.gain += 0.003 * (target - self.gain)
            for channel in 0...2 {
                var value:float64 = 0.0
                for i in 0...12 {
                    if self.weights[i] > 0.000001 { value += self.weights[i] * self.bank.sample(i, self.turns, channel) }
                }
                samples[frame * 2 + channel] = round_float<float32>(value * self.gain * self.blend_gain)
            }
            self.clock++
        }
        return Result<void,Error>.success()
    }
}
