use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.Math
use STD.Error
use STD.Error.Kind
use Module.Bank
use Module.Texture
use Module.Pulses

// One continuous firing scheduler with fixed-duration recorded pressure
// packets. The H5 pitched-loop path remains available for live comparison.
public class Voice:Synthesis.Generator {
    let format:Processing.Format = Processing.Format(sample_rate:44_100, channels:2)
    private var bank:Bank
    private var texture:Texture = Texture()
    private var pulses:Pulses = Pulses()
    private var pulse_mode:bool = true
    private var pulse_amount:float64 = 1.0
    private var idle_rpm:float64 = 1_800.0
    private var bound:float64 = 1.0
    private var registered_gain:float64 = 1.0
    private var target_registered_gain:float64 = 1.0
    private var bound_weights:float64[] = []
    private var clock:int = 0
    private var revision:int = 0
    private var inertia:float64 = 1.0
    private var turns:float64 = 0.0
    private var total_turns:float64 = 0.0
    private var target_rpm:float64
    private var target_load:float64 = 0.5
    private var rpm:float64
    private var load:float64 = 0.5
    private var running:bool = false
    private var gain:float64 = 0.0
    private var blend_gain:float64 = 1.0
    private var target_blend_gain:float64 = 1.0
    private var driving:bool = false
    private var target_throttle:float64 = 0.0
    private var throttle:float64 = 0.0
    private var weights:float64[] = []
    private var desired_weights:float64[] = []

    init(bank:Bank, pulses:bool = true) {
        self.bank = bank; self.rpm = bank.minimum_rpm as float64; self.target_rpm = self.rpm
        self.pulse_mode = pulses
        for _ in 0...12 { self.weights.append(0.0); self.desired_weights.append(0.0); self.bound_weights.append(0.0) }
        self.reset()
    }
    // Public state/render calls share Silex's recursive critical section.
    // The audio worker renders bounded 256-frame blocks; UI commands never
    // hold this lock while drawing or waiting for device capacity.
    func generation() int { mutex { return self.revision } }
    func set_variation(enabled:bool) { mutex { self.texture.set_enabled(enabled) } }
    func set_pulses(enabled:bool) { mutex { self.pulse_mode = enabled } }
    func set_idle(rpm:float) Result<void,Error> {
        mutex {
            if !Math.is_finite(rpm) || rpm < 1_800.0 || rpm > 3_500.0 {
                return Result<void,Error>.failure(Error(kind:Kind.invalid_input(), operation:"yz250.idle", detail:"base RPM in 1800..3500 required"))
            }
            self.idle_rpm = rpm as float64; return Result<void,Error>.success()
        }
    }
    func set_inertia(value:float) Result<void,Error> {
        mutex {
            if !Math.is_finite(value) || value < 1.0 || value > 10.0 {
                return Result<void,Error>.failure(Error(kind:Kind.invalid_input(), operation:"yz250.inertia", detail:"inertia in 1..10 required"))
            }
            self.inertia = value as float64; return Result<void,Error>.success()
        }
    }
    func set_state(rpm:float, load:float, running:bool = true) Result<void,Error> {
        mutex {
            if !Math.is_finite(rpm) || rpm < self.bank.minimum_rpm || rpm > self.bank.maximum_rpm || !Math.is_finite(load) || load < 0.0 || load > 1.0 {
                return Result<void,Error>.failure(Error(kind:Kind.invalid_input(), operation:"yz250.state", detail:"RPM in 1800..10500 and finite load in 0..1 required"))
            }
            self.driving = false
            self.target_rpm = rpm; self.target_load = load; self.running = running
            return Result<void,Error>.success()
        }
    }
    func set_drive(throttle:float, load:float, running:bool = true) Result<void,Error> {
        mutex {
            if !Math.is_finite(throttle) || throttle < 0.0 || throttle > 1.0 || !Math.is_finite(load) || load < 0.0 || load > 1.0 {
                return Result<void,Error>.failure(Error(kind:Kind.invalid_input(), operation:"yz250.drive", detail:"finite throttle and load in 0..1 required"))
            }
            self.driving = true; self.target_throttle = throttle; self.target_load = load; self.running = running
            return Result<void,Error>.success()
        }
    }
    func current_rpm() float { mutex { return round_float<float>(self.rpm) } }
    func current_load() float { mutex { return round_float<float>(self.load) } }
    func current_throttle() float { mutex { return round_float<float>(self.throttle) } }
    func current_coast() float { mutex {
        if self.pulse_mode { return self.pulses.coast() }
        return self.texture.coast()
    } }
    func frame() int { mutex { return self.clock } }
    func crank_turns() float64 { mutex { return self.total_turns } }
    func reset() {
        mutex {
            self.texture.reset(); self.revision++; self.clock = 0; self.turns = 0.0; self.total_turns = 0.0; self.gain = 0.0
            self.rpm = self.target_rpm; self.load = self.target_load; self.throttle = 0.0
            if self.driving { self.rpm = self.idle_rpm; self.load = 0.0 }
            self.mix_weights()
            for i in 0...12 { self.weights[i] = self.desired_weights[i] }
            self.bound = self.bank.peak_bound(@self.weights[0:12])
            for i in 0...12 { self.bound_weights[i] = self.weights[i] }
            self.blend_gain = self.bank.blend_gain(@self.weights[0:12]); self.target_blend_gain = self.blend_gain
            self.registered_gain = self.bank.registered_gain(@self.weights[0:12], self.blend_gain)
            self.target_registered_gain = self.registered_gain
            self.pulses.reset(self.rpm, self.idle_rpm, self.registered_gain)
            self.pulse_amount = 0.0; if self.pulse_mode { self.pulse_amount = 1.0 }
        }
    }
    private func mix_weights() {
        var node = 0
        while node < 4 && self.rpm > self.bank.rpms[node + 1] { node++ }
        let mix = Math.clamp((self.rpm - self.bank.rpms[node]) / (self.bank.rpms[node + 1] - self.bank.rpms[node]), 0.0, 1.0)
        for i in 0...12 { self.desired_weights[i] = 0.0 }
        self.desired_weights[node * 2] = (1.0 - mix) * (1.0 - self.load)
        self.desired_weights[node * 2 + 1] = (1.0 - mix) * self.load
        self.desired_weights[node * 2 + 2] = mix * (1.0 - self.load)
        self.desired_weights[node * 2 + 3] = mix * self.load
    }
    func render(samples:&float32[..]) Result<void,Error> {
        mutex {
            if samples.count() % 2 != 0 {
                return Result<void,Error>.failure(Error(kind:Kind.invalid_input(), operation:"yz250.render", detail:"complete stereo frames required"))
            }
            if !self.running && self.gain < 0.0000001 {
                self.gain = 0.0
                for i in 0...samples.count() { samples[i] = 0.0 }
                return Result<void,Error>.success()
            }
            for frame in 0...samples.count() / 2 {
                let previous_rpm = self.rpm
                if self.driving {
                    // Listening response, without measured torque/inertia. Load
                    // slows acceleration; full throttle still reaches full RPM.
                    self.throttle += 0.0015 * (self.target_throttle - self.throttle)
                    let span = self.bank.maximum_rpm as float64 - self.idle_rpm
                    let target = self.idle_rpm + span * self.throttle
                    // Closed gas changes combustion texture immediately, but
                    // does not remove stored rotation or the audible overrun.
                    var seconds:float64 = 0.62
                    if target > self.rpm {
                        seconds = 0.18 + 0.35 * self.target_load
                        seconds *= self.inertia
                    }
                    let acceleration = (target - self.rpm) / seconds
                    self.rpm += acceleration / 44_100.0
                    let acoustic_load = Math.clamp(self.throttle * (0.85 + 0.15 * self.target_load) + acceleration / 30_000.0, 0.0, 1.0)
                    self.load += 0.002 * (acoustic_load - self.load)
                } else {
                    self.rpm += Math.clamp(self.target_rpm - self.rpm, -60_000.0 / 44_100.0, 60_000.0 / 44_100.0)
                    self.load += 0.002 * (self.target_load - self.load)
                }
                // Weights updated at 689 Hz and slewed per audio frame. Loop
                // positions remain synchronized even while a loop has zero gain.
                if self.clock % 64 == 0 {
                    self.mix_weights(); self.target_blend_gain = self.bank.blend_gain(@self.weights[0:12])
                    self.bound = self.bank.peak_bound(@self.weights[0:12])
                    self.target_registered_gain = self.bank.registered_gain(@self.weights[0:12], self.target_blend_gain)
                    for i in 0...12 { self.bound_weights[i] = self.weights[i] }
                }
                self.blend_gain += 0.008 * (self.target_blend_gain - self.blend_gain)
                self.registered_gain += 0.008 * (self.target_registered_gain - self.registered_gain)
                for i in 0...12 { self.weights[i] += 0.008 * (self.desired_weights[i] - self.weights[i]) }
                var peak_bound = self.bound
                for i in 0...12 {
                    peak_bound += Math.abs(self.weights[i] - self.bound_weights[i]) * self.bank.node_peak(i)
                    // Omitting a tiny residual also removes its cancellation.
                    if self.weights[i] <= 0.000001 { peak_bound += self.weights[i] * self.bank.node_peak(i) }
                }
                let safe_gain = Math.min(self.blend_gain, 0.98 / peak_bound)
                let safe_registered_gain = Math.min(self.registered_gain, 0.98 / self.bank.registered_peak())
                let advance = self.rpm / 2_646_000.0
                self.texture.update(self.rpm, (self.rpm - previous_rpm) * 44_100.0, self.idle_rpm, self.driving, self.target_throttle, self.bank.idle_frames)
                let closing = self.driving && self.target_throttle < 0.25 && self.rpm > self.idle_rpm + 100.0 && (self.rpm - previous_rpm) * 44_100.0 < -100.0
                self.pulses.update(self.bank, self.rpm, self.idle_rpm, self.driving, self.target_throttle, closing, safe_registered_gain)
                var pulse_target:float64 = 0.0; if self.pulse_mode { pulse_target = 1.0 }
                self.pulse_amount += 0.002 * (pulse_target - self.pulse_amount)
                self.turns += advance; self.total_turns += advance
                if self.turns >= 32.0 { self.turns -= 32.0 }
                var target:float64 = 0.0; if self.running { target = 1.0 }
                self.gain += 0.003 * (target - self.gain)
                for channel in 0...2 {
                    if self.pulse_amount > 0.999999 {
                        samples[frame * 2 + channel] = round_float<float32>(self.pulses.sample(self.bank, channel) * self.gain)
                        continue
                    }
                    var value:float64 = 0.0
                    for i in 0...12 {
                        if self.weights[i] > 0.000001 { value += self.weights[i] * self.bank.sample(i, self.turns, channel) }
                    }
                    let textured = self.texture.sample(self.bank, self.turns, channel, self.rpm, value * safe_gain, safe_registered_gain)
                    let pulse = self.pulses.sample(self.bank, channel)
                    samples[frame * 2 + channel] = round_float<float32>((textured * (1.0 - self.pulse_amount) + pulse * self.pulse_amount) * self.gain)
                }
                self.clock++
            }
            return Result<void,Error>.success()
        }
    }
}
