use STD.Math
use Module.Bank
use Module.Voice

public func check() {
    var bank = Bank(); var voice = Voice(bank)
    var block:float32[] = []; var split:float32[] = []
    for _ in 0...1_024 { block.append(0.0); split.append(0.0) }
    voice.set_drive(1.0, 0.4); voice.reset()
    for _ in 0...300 { voice.render(&block[0:1_024]) }
    assert(voice.current_rpm() > 10_490.0)
    voice.set_drive(0.0, 0.4)
    for _ in 0...5 { voice.render(&block[0:1_024]) }
    assert(voice.current_throttle() < 0.03, "closing gas did not close the throttle")
    assert(voice.current_rpm() > 9_500.0 && voice.current_rpm() < 10_490.0, "rotation vanished with the throttle")
    assert(voice.current_coast() > 0.95, "closed gas has no distinct overrun texture")
    var minimum:float64 = 1.0
    for i in 0...80 {
        voice.render(&block[0:1_024])
        var power:float64 = 0.0
        for value in block {
            assert(Math.is_finite(value) && Math.abs(value) <= 0.980001)
            power += value as float64 * value as float64
        }
        if i > 10 { minimum = Math.min(minimum, Math.sqrt(power / 1_024.0)) }
    }
    assert(minimum > 0.04, "the engine went quiet before overrun finished")
    assert(voice.current_rpm() > 3_300.0, "RPM fall is still nearly instantaneous")
    for _ in 0...280 { voice.render(&block[0:1_024]) }
    assert(voice.current_rpm() < 1_815.0 && voice.current_coast() < 0.001, "overrun never returned to idle")
    voice.set_drive(1.0, 0.4)
    for _ in 0...15 { voice.render(&block[0:1_024]) }
    assert(voice.current_coast() < 0.001, "old closed-gas pops leaked into reopening")
    var whole = Voice(bank); var divided = Voice(bank)
    whole.set_drive(1.0, 0.4); divided.set_drive(1.0, 0.4); whole.reset(); divided.reset()
    for _ in 0...300 { whole.render(&block[0:1_024]); divided.render(&split[0:1_024]) }
    whole.set_drive(0.0, 0.4); divided.set_drive(0.0, 0.4)
    for _ in 0...350 {
        whole.render(&block[0:1_024])
        divided.render(&split[0:74]); divided.render(&split[74:690]); divided.render(&split[690:1_024])
        for i in 0...1_024 { assert(block[i] == split[i], "idle/overrun depends on buffer splitting") }
    }
    print("H5 overrun passed: gas closes, RPM and recorded clacks persist, reopening, native idle and split blocks. Minimum RMS=", minimum)
}
