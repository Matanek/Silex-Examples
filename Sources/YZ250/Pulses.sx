use STD.Math
use Module.Bank

// Recorded firings keep a fixed time scale (G at 7000); only their scheduling
// follows RPM. At 7000, overlapping Hann windows reconstruct isolated G.
// Eight slots cover the 17 ms packets at every supported RPM. No allocations
// or trigonometry run in update/sample: windows are prepared once per voice.
public class Pulses {
    private var ages:float64[] = []
    private var cycles:int[] = []
    private var coasts:bool[] = []
    private var gains:float64[] = []
    private var weights:float64[] = []
    private var window:float64[] = []
    private var phase:float64 = 0.0
    private var cycle:int = 1
    private var divisor:float64 = 1.0
    private var idle_position:float64 = 0.0
    private var idle_amount:float64 = 0.0
    private var residual_turns:float64 = 0.0
    private var residual_gain:float64 = 0.0
    private var coasting:bool = false
    init() {
        for _ in 0...8 { self.ages.append(-1.0); self.cycles.append(0); self.coasts.append(false); self.gains.append(1.0); self.weights.append(0.0) }
        for i in 0...757 { self.window.append(0.5 - 0.5 * Math.cos(Math.pi<float64>() * i as float64 / 378.0)) }
    }
    func reset(rpm:float64, idle:float64, gain:float64) {
        for i in 0...8 { self.ages[i] = -1.0; self.weights[i] = 0.0 }
        self.ages[0] = 378.0; self.cycles[0] = 31; self.coasts[0] = false; self.gains[0] = gain
        self.ages[1] = 0.0; self.cycles[1] = 0; self.coasts[1] = false; self.gains[1] = gain
        self.phase = 0.0; self.cycle = 1; self.divisor = 1.0
        self.idle_position = 0.0; self.idle_amount = 0.0
        if rpm <= idle + 150.0 { self.idle_amount = 1.0 }
        self.residual_turns = 0.0; self.residual_gain = 0.0
        self.coasting = false
    }
    func coast() float {
        if self.coasting { return 1.0 }
        return 0.0
    }
    func update(bank:Bank, rpm:float64, idle:float64, driving:bool, throttle:float64, coast:bool, gain:float64) {
        self.coasting = coast
        self.idle_position += 1.0
        if self.idle_position >= bank.idle_frames as float64 { self.idle_position -= bank.idle_frames as float64 }
        var idling:float64 = 0.0
        if rpm < idle + 150.0 && (!driving || throttle < 0.02) { idling = 1.0 }
        self.idle_amount += 0.001 * (idling - self.idle_amount)
        self.residual_turns += 1.0 / 378.0
        if self.residual_turns >= 32.0 { self.residual_turns -= 32.0 }
        self.residual_gain = Math.clamp((6_000.0 - rpm) / 4_200.0, 0.0, 1.0) * 0.025 / (2.0 * bank.registered_peak())
        for i in 0...8 {
            if self.ages[i] >= 0.0 {
                self.ages[i] += 1.0
                if self.ages[i] >= 756.0 { self.ages[i] = -1.0 }
            }
        }
        let advance = rpm / 2_646_000.0
        self.phase += advance
        if self.phase >= 1.0 {
            self.phase -= 1.0
            var slot = 0; while slot < 8 && self.ages[slot] >= 0.0 { slot++ }
            assert(slot < 8, "firing packet capacity exceeded")
            self.ages[slot] = self.phase / advance
            self.cycles[slot] = self.cycle; self.cycle = (self.cycle + 1) % 32
            self.coasts[slot] = coast
            self.gains[slot] = gain
            if coast { self.gains[slot] = 1.0 }
        }
        var sum:float64 = 0.0
        for i in 0...8 {
            self.weights[i] = 0.0
            if self.ages[i] >= 0.0 {
                let index = Math.floor(self.ages[i]) as int
                let mix = self.ages[i] - index as float64
                self.weights[i] = self.window[index] * (1.0 - mix) + self.window[index + 1] * mix
                sum += self.weights[i]
            }
        }
        // Never divide a small packet edge by its envelope. Normalization
        // only reduces overlap; pressure packets therefore keep finite peaks.
        self.divisor = Math.max(1.0, sum)
    }
    func sample(bank:Bank, channel:int) float64 {
        var value:float64 = 0.0
        for i in 0...8 {
            if self.weights[i] <= 0.0 { continue }
            var turns = self.cycles[i] as float64 + self.ages[i] / 378.0
            if turns >= 32.0 { turns -= 32.0 }
            var pressure = bank.registered_sample(turns, channel, 7_000.0)
            var gain = Math.min(self.gains[i], 0.94 / bank.registered_peak())
            if self.coasts[i] { pressure = bank.coast_sample(turns, channel); gain = Math.min(1.0, 0.94 / bank.coast_peak()) }
            value += pressure * gain * self.weights[i]
        }
        value /= self.divisor
        value += bank.registered_residual(self.residual_turns, channel) * self.residual_gain
        // Native idle is never swept up/down as a pitched background layer.
        return value * (1.0 - self.idle_amount) + bank.idle_sample(self.idle_position, channel, 1_800.0) * self.idle_amount
    }
}
