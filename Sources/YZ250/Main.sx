use STD.Process
use Module.Offline
use Module.Session
use Module.LiveCheck
use Module.ControlCheck
use Module.CoastCheck
use Module.JoinCheck
use Module.KtmSession
use Module.KtmCheck

func main() {
    let arguments = Process.arguments()
    if arguments.count() > 1 {
        if arguments[1] == "--yz250" { Session.show(); return }
        if arguments[1] == "--ktm-check" { KtmCheck.check(); return }
        if arguments[1] == "--control-check" { ControlCheck.check(); return }
        if arguments[1] == "--coast-check" { CoastCheck.check(); return }
        if arguments[1] == "--join-check" { JoinCheck.check(); return }
        if arguments[1] == "--check" { KtmCheck.check(); Offline.check(); Session.check(); LiveCheck.check(); ControlCheck.check(); CoastCheck.check(); JoinCheck.check(); return }
        if arguments[1] == "--render" && arguments.count() == 3 { Offline.render(arguments[2]); return }
        if arguments[1] == "--live-check" && arguments.count() == 3 { LiveCheck.run(arguments[2]); return }
        if arguments[1] == "--ktm-live-check" && arguments.count() == 3 { LiveCheck.run(arguments[2], ktm:true); return }
        panic("Options: --yz250 | --check | --ktm-check | --control-check | --coast-check | --join-check | --render output-prefix | --live-check output-prefix | --ktm-live-check output-prefix")
    }
    KtmSession.show()
}
