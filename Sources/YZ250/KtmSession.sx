use GFX.Audio
use GFX.Canvas
use GFX.Color
use GFX.Input.Events
use GFX.Input.Keyboard
use GFX.UI
use GFX.Viewer
use GFX.Window
use STD.Threading
use Module.KtmVoice
use Module.Output
use Module.Session.text
use Module.Session.button

public class KtmSession:Canvas.Session {
    private var voice:KtmVoice
    private var ui:UI.Session = UI.Session(UI.Text(""))
    private var output:Output
    private var executor:Threading.Executor
    private var work:Threading.JobHandle<Output>
    private var status:UI.State<str> = UI.State<str>("À l’arrêt")
    private var volume:UI.State<float> = UI.State<float>(0.7)
    private var joined:bool = false

    init(audio:Audio) {
        self.voice = KtmVoice()
        self.output = Output(audio, self.voice, self.voice.generation)
        self.executor = Threading.Executor(worker_count:1)
        self.work = self.executor.submit(self.output)
        self.ui = UI.Session(self.view())
    }
    func shutdown() {
        if self.joined { return }
        self.output.stop(); var finished = self.work.complete(); self.joined = true
    }
    drop { self.shutdown() }

    private func listen_original() { self.voice.listen_original() }
    private func listen_mix() { self.voice.listen_mix() }
    private func listen_idle() { self.voice.listen_idle() }
    private func stop() { self.voice.stop() }
    func gas(held:bool) { self.voice.gas(held) }
    func statistics() Output.Statistics { return self.output.statistics() }
    private func set_volume(value:float) { self.output.set_volume(value) }
    private func status_view(reads:UI.Reads) UI.View { return text(reads.read(self.status)) }
    private func view() UI.View {
        var volume = UI.Slider(self.volume, 0.0, 1.0, self.set_volume)
        volume.style.height = 28.0; volume.style.accent = Color.cyan_400()
        var content = UI.Column([text("KTM 250 SX · mix E/G", 28.0),
            text("Maintenez Espace pour accélérer et tenir le régime. Relâchez pour la retombée."),
            UI.Reactive(self.status_view),
            UI.Row([button("Ralenti", self.listen_idle), button("Prise originale", self.listen_original), button("Mix E/G intégral", self.listen_mix),
                button("Arrêter · M", self.stop)], wrap:true),
            text("Volume"), volume])
        content.style.gap = 14.0; content.style.padding = UI.Insets(22.0)
        content.style.background = Color.bytes(10, 16, 24); content.style.foreground = Color.slate_100()
        return UI.ScrollView(content, smooth_scroll:true)
    }
    func drawing(width:int, height:int) Canvas { return self.ui.drawing(width, height) }
    func update(delta:float) bool {
        let info = self.output.statistics()
        if info.error != "" { panic(info.error) }
        let current = self.voice.status()
        if current != self.status.value() { self.status.set(current) }
        return self.ui.update(delta)
    }
    func handle(event:@Events.Event) bool {
        match event {
            window_focus_lost(value) => { self.gas(false) }
            key_pressed(value) => {
                if !value.modifiers.control && !value.modifiers.alt && !value.modifiers.system {
                    if value.key == Keyboard.Key.space {
                        if !value.repeated { self.gas(true) }
                        return true
                    }
                    let m = value.keycode == 109 as uint32 || value.keycode == 77 as uint32 ||
                        (value.keycode == 0 as uint32 && value.key == Keyboard.Key.m)
                    if m && !value.repeated { self.stop(); return true }
                }
            }
            key_released(value) => { if value.key == Keyboard.Key.space { self.gas(false); return true } }
            else => {}
        }
        return self.ui.handle(event)
    }
    func accepts_text_input() bool { return self.ui.accepts_text_input() }
    func text_input_target() Canvas.TextInputTarget? { return self.ui.text_input_target() }
    func pointer_cursor() Window.Cursor { return self.ui.pointer_cursor() }
}

public func show() {
    var audio = Audio(); var session = KtmSession(audio)
    Viewer.show(session, Viewer.CanvasSettings(width:800, height:400, title:"Silex — KTM 250 SX · mix E/G · Espace = gaz"))
}
