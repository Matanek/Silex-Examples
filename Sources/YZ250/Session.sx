use GFX.Audio
use GFX.Audio.Synthesis
use GFX.Canvas
use GFX.Color
use GFX.UI
use GFX.Viewer
use GFX.Window
use GFX.Input.Events
use GFX.Input.Keyboard
use STD.Error.Kind
use STD.Math
use Module.Bank
use Module.Voice

func text(value:str, size:float = 15.0) UI.Text {
    var result = UI.Text(value); result.style.font_size = size; result.style.foreground = Color.slate_200(); return result
}
func button(label:str, action:func()) UI.Button {
    var result = UI.Button(label, action)
    result.style.height = 40.0; result.style.padding = UI.Insets(horizontal:14.0, vertical:8.0)
    result.style.background = Color.slate_700(); result.style.foreground = Color.slate_100(); result.style.radius = 7.0
    return result
}
class Bench {
    var bank:Bank = Bank()
    var voice:Voice
    var rpm:UI.State<float> = UI.State<float>(7_000.0)
    var throttle:UI.State<float> = UI.State<float>(0.0)
    var driving:UI.State<bool> = UI.State<bool>(true)
    var load:UI.State<float> = UI.State<float>(0.4)
    var volume:UI.State<float> = UI.State<float>(0.7)
    var playing:UI.State<bool> = UI.State<bool>(false)
    var status:UI.State<str> = UI.State<str>("À l’arrêt · maintenez Espace pour démarrer et accélérer")
    var generation:int = 0
    private var elapsed:float = 0.0
    private var space_held:bool = false
    init() { self.voice = Voice(self.bank); self.changed(0.0) }
    func changed(value:float) {
        if self.driving.value() {
            var throttle = self.throttle.value(); if self.space_held { throttle = 1.0 }
            self.voice.set_drive(throttle, self.load.value(), self.playing.value())
        } else { self.voice.set_state(self.rpm.value(), self.load.value(), self.playing.value()) }
    }
    private func start() {
        let was_playing = self.playing.value(); self.playing.set(true); self.changed(0.0)
        if !was_playing { self.voice.reset(); self.generation++ }
        self.update(1.0)
    }
    func drive() { self.driving.set(true); self.start() }
    func manual() { self.driving.set(false); self.space_held = false; self.start() }
    func gas(held:bool) {
        self.space_held = held
        if held { self.driving.set(true); self.start() }
        else { self.changed(0.0); self.update(1.0) }
    }
    func toggle() {
        self.space_held = false
        if !self.playing.value() { self.start() }
        else { self.playing.set(false); self.changed(0.0); self.update(1.0) }
    }
    func handle(event:@Events.Event) bool {
        match event {
            window_focus_lost(value) => { self.gas(false) }
            key_pressed(value) => {
                if value.modifiers.control || value.modifiers.alt || value.modifiers.system { return false }
                if value.key == Keyboard.Key.space {
                    if !value.repeated || self.space_held { self.gas(true) }
                    return true
                }
                let m = value.keycode == 109 as uint32 || value.keycode == 77 as uint32 || (value.keycode == 0 as uint32 && value.key == Keyboard.Key.m)
                if m && !value.repeated { self.toggle(); return true }
            }
            key_released(value) => { if value.key == Keyboard.Key.space { self.gas(false); return true } }
            else => {}
        }
        return false
    }
    func update(delta:float) {
        self.elapsed += delta; if self.elapsed < 0.1 { return }
        self.elapsed = 0.0
        if !self.playing.value() { self.status.set("À l’arrêt · Espace pour démarrer et accélérer"); return }
        var command = "Banc · régime imposé"
        if self.driving.value() {
            command = "Accélérateur · gaz $(Math.round(self.voice.current_throttle() * 100.0) as int) %"
            if self.space_held { command += " · ESPACE maintenu" }
        }
        self.status.set("$(command) · $(Math.round(self.voice.current_rpm()) as int) tr/min estimés")
    }
    func rpm_label(value:float) str { return "$(Math.round(value) as int) tr/min estimés" }
    func percent(value:float) str { return "$(Math.round(value * 100.0) as int) %" }
    func status_view(reads:UI.Reads) UI.View { return text(reads.read(self.status), 20.0) }
    func control_view(reads:UI.Reads) UI.View {
        if reads.read(self.driving) {
            var slider = UI.Slider(self.throttle, 0.0, 1.0, self.changed)
            slider.style.height = 28.0; slider.style.accent = Color.cyan_400()
            return UI.Column([text("Position des gaz au relâchement d’Espace"), UI.Text(self.throttle, format:self.percent), slider])
        }
        var slider = UI.Slider(self.rpm, self.bank.minimum_rpm, self.bank.maximum_rpm, self.changed)
        slider.style.height = 28.0; slider.style.accent = Color.cyan_400()
        return UI.Column([text("Régime imposé · Espace repasse en accélérateur"), UI.Text(self.rpm, format:self.rpm_label), slider])
    }
    func view() UI.View {
        var load = UI.Slider(self.load, 0.0, 1.0, self.changed)
        var volume = UI.Slider(self.volume, 0.0, 1.0, self.changed)
        load.style.height = 28.0; load.style.accent = Color.cyan_400()
        volume.style.height = 28.0; volume.style.accent = Color.cyan_400()
        var content = UI.Column([text("YZ250 · banque compacte · H1", 28.0),
            text("Texture enregistrée réelle · 12 boucles · banque audio 768 Kio"), UI.Reactive(self.status_view),
            text("Maintenez ESPACE : démarrage et pleins gaz. Relâchez : retombée du régime."),
            UI.Row([button("Accélérateur", self.drive), button("Banc à régime fixe", self.manual), button("Lecture / arrêt · M", self.toggle)], wrap:true),
            UI.Reactive(self.control_view),
            text("Charge mécanique · ralentit la montée, sans bloquer le plein régime"), UI.Text(self.load, format:self.percent), load,
            text("Volume"), UI.Text(self.volume, format:self.percent), volume,
            text("Les boucles conservent plusieurs explosions et la matière mécanique du fichier YZ250 / FMF."),
            text("Leur régime interne est stabilisé avant lecture ; les transitions partagent la même cadence."),
            text("Régime estimé sans compte-tours. Réponse aux gaz simplifiée ; pas de ralenti enregistré."),
            text("Écouter des coups de gaz brefs, un maintien des gaz, puis la retombée. 454 / 500 4T inchangés.")])
        content.style.gap = 14.0; content.style.padding = UI.Insets(22.0)
        content.style.background = Color.bytes(10, 16, 24); content.style.foreground = Color.slate_100()
        return UI.ScrollView(content, smooth_scroll:true)
    }
}
class Session:Canvas.Session {
    private var bench:Bench
    private var ui:UI.Session
    private var audio:Audio
    private var producer:Synthesis.StreamProducer
    private var playing:Audio.PlayingSound = Audio.PlayingSound()
    private var generation:int = 0
    private var volume:float = -1.0
    init() {
        self.bench = Bench(); self.ui = UI.Session(self.bench.view()); self.audio = Audio()
        self.producer = Synthesis.StreamProducer.create(self.audio, self.bench.voice, 9_223_372_036_854_775_807,
            block_frames:256, capacity_frames:2_048)
    }
    private func feed() {
        if self.generation != self.bench.generation {
            if self.playing.is_valid() { self.audio.stop(self.playing) }
            self.producer = Synthesis.StreamProducer.create(self.audio, self.bench.voice, 9_223_372_036_854_775_807,
                block_frames:256, capacity_frames:2_048)
            self.playing = Audio.PlayingSound(); self.generation = self.bench.generation
        }
        for _ in 0...10 {
            if self.audio.stream_info(self.producer.stream()).queued_frames >= 2_048 { break }
            match try self.producer.pump() {
                failure(error) => { if error.kind != Kind.would_block() { panic(error.detail) }
                    break }
                success(count) => { if count == 0 { break } }
            }
        }
        if !self.playing.is_valid() && self.audio.stream_info(self.producer.stream()).queued_frames >= 1_024 {
            self.playing = self.audio.play(self.producer.stream(), Audio.Playback(volume:self.bench.volume.value()))
        }
        if self.playing.is_valid() && self.volume != self.bench.volume.value() {
            self.volume = self.bench.volume.value(); self.audio.set_volume(self.playing, self.volume)
        }
    }
    func drawing(width:int, height:int) Canvas { self.feed(); return self.ui.drawing(width, height) }
    func update(delta:float) bool { self.bench.update(delta); self.feed(); return self.ui.update(delta) }
    func handle(event:@Events.Event) bool {
        if self.bench.handle(event) { return true }
        return self.ui.handle(event)
    }
    func accepts_text_input() bool { return self.ui.accepts_text_input() }
    func text_input_target() Canvas.TextInputTarget? { return self.ui.text_input_target() }
    func pointer_cursor() Window.Cursor { return self.ui.pointer_cursor() }
    drop { if self.playing.is_valid() { self.audio.stop(self.playing) } }
}
public func show() {
    var session = Session()
    Viewer.show(session, Viewer.CanvasSettings(width:1_100, height:820, title:"Silex — YZ250 · banque compacte · H1 · ESPACE = gaz"))
}
func key_event(key:Keyboard.Key, repeated:bool = false) Events.KeyEvent {
    return Events.KeyEvent(window:Window.Id(value:0 as uint32), keyboard:Keyboard.KeyboardId(value:0 as uint32),
        key:key, keycode:0 as uint32, raw:0 as uint16, repeated:repeated,
        modifiers:Keyboard.Modifiers(), timestamp:Events.Timestamp(nanoseconds:0 as uint))
}
public func check() {
    var bench = Bench(); var samples:float32[] = []; for _ in 0...1_024 { samples.append(0.0) }
    assert(bench.handle(Events.Event.key_pressed(key_event(Keyboard.Key.space))))
    assert(bench.playing.value() && bench.driving.value())
    let generation = bench.generation
    assert(bench.handle(Events.Event.key_pressed(key_event(Keyboard.Key.space, true))))
    assert(bench.generation == generation, "auto-repeat restarted the voice")
    for _ in 0...80 { bench.voice.render(&samples[0:1_024]) }
    assert(bench.voice.current_rpm() > 8_000.0, "space did not accelerate")
    assert(bench.handle(Events.Event.key_released(key_event(Keyboard.Key.space))))
    for _ in 0...150 { bench.voice.render(&samples[0:1_024]) }
    assert(bench.voice.current_rpm() < 3_700.0, "space release did not close throttle")
    bench.handle(Events.Event.key_pressed(key_event(Keyboard.Key.space)))
    for _ in 0...30 { bench.voice.render(&samples[0:1_024]) }
    bench.handle(Events.Event.window_focus_lost(Events.WindowEvent(window:Window.Id(value:0 as uint32), timestamp:Events.Timestamp(nanoseconds:0 as uint))))
    for _ in 0...80 { bench.voice.render(&samples[0:1_024]) }
    assert(bench.voice.current_throttle() < 0.001, "lost focus left gas held")
    var runtime = UI.Runtime(bench.view()); runtime.drawing(1_100, 820)
    assert(runtime.key_pressed(Keyboard.Key.tab)); assert(runtime.key_pressed(Keyboard.Key.tab)); assert(runtime.key_pressed(Keyboard.Key.enter))
    assert(!bench.driving.value(), "bench button did not switch mode")
    assert(bench.handle(Events.Event.key_pressed(key_event(Keyboard.Key.space))))
    assert(bench.driving.value(), "space from bench did not restore throttle")
    assert(bench.handle(Events.Event.key_pressed(key_event(Keyboard.Key.m))))
    assert(!bench.playing.value())
    assert(bench.handle(Events.Event.key_pressed(key_event(Keyboard.Key.space, true))))
    assert(!bench.playing.value(), "repeat restarted after M stop")
    var ui = UI.Session(bench.view()); for width in [400, 760, 1_100] { ui.drawing(width, 820) }
    print("YZ250 H1 UI passed: space press/repeat/release/focus, auto-start, bench switch, M and layouts")
}
