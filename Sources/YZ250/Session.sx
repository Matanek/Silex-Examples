use GFX.Audio
use GFX.Audio.Synthesis
use GFX.Canvas
use GFX.Color
use GFX.UI
use GFX.Viewer
use GFX.Window
use GFX.Input.Events
use GFX.Input.Keyboard
use STD.Error.Kind
use STD.Math
use Module.Bank
use Module.Voice

func text(value:str, size:float = 15.0) UI.Text {
    var result = UI.Text(value); result.style.font_size = size; result.style.foreground = Color.slate_200(); return result
}
func button(label:str, action:func()) UI.Button {
    var result = UI.Button(label, action)
    result.style.height = 40.0; result.style.padding = UI.Insets(horizontal:14.0, vertical:8.0)
    result.style.background = Color.slate_700(); result.style.foreground = Color.slate_100(); result.style.radius = 7.0
    return result
}
class Bench {
    var bank:Bank
    var voice:Voice
    var rpm:UI.State<float>
    var throttle:UI.State<float> = UI.State<float>(0.0)
    var driving:UI.State<bool> = UI.State<bool>(true)
    var load:UI.State<float> = UI.State<float>(0.5)
    var volume:UI.State<float> = UI.State<float>(0.7)
    var playing:UI.State<bool> = UI.State<bool>(false)
    var mode:UI.State<int> = UI.State<int>(2)
    var status:UI.State<str> = UI.State<str>("À l’arrêt · choisissez une écoute")
    var generation:int = 0
    private var elapsed:float = 0.0
    private var space_held:bool = false

    init() {
        self.bank = Bank(); self.voice = Voice(self.bank)
        self.rpm = UI.State<float>(self.bank.minimum_rpm + (self.bank.maximum_rpm - self.bank.minimum_rpm) * 0.35)
        self.changed(0.0)
    }
    func changed(value:float) {
        if self.driving.value() {
            var throttle = self.throttle.value(); if self.space_held { throttle = 1.0 }
            self.voice.set_drive(throttle, self.load.value(), self.playing.value())
        } else { self.voice.set_state(self.rpm.value(), self.load.value(), self.playing.value()) }
    }
    func drive() { self.driving.set(true); self.changed(0.0); self.update(1.0) }
    func manual() { self.driving.set(false); self.space_held = false; self.changed(0.0); self.update(1.0) }
    func gas(held:bool) { self.space_held = held; self.changed(0.0) }
    func reference() { self.choose(0) }
    func reconstruction() { self.choose(1) }
    func controlled() { self.choose(2) }
    private func choose(value:int) {
        self.space_held = false
        self.mode.set(value); self.playing.set(true); self.changed(0.0)
        var mode = Voice.Mode.reference
        if value == 1 { mode = Voice.Mode.reconstruction }
        if value == 2 { mode = Voice.Mode.engine }
        self.voice.set_mode(mode); self.generation++; self.update(1.0)
    }
    func toggle() {
        self.space_held = false
        self.playing.set(!self.playing.value()); self.changed(0.0)
        if self.playing.value() { self.voice.reset(); self.generation++ }
        self.update(1.0)
    }
    func update(delta:float) {
        self.elapsed += delta
        if self.elapsed < 0.1 { return }
        self.elapsed = 0.0
        if self.mode.value() != 2 && self.voice.frame() >= self.bank.frames + 4_096 {
            self.playing.set(false); self.changed(0.0)
        }
        if !self.playing.value() { self.status.set("À l’arrêt · M pour reprendre"); return }
        if self.mode.value() == 2 {
            var command = "Banc · régime imposé"
            if self.driving.value() { command = "Accélérateur · gaz $(Math.round(self.voice.current_throttle() * 100.0) as int) %" }
            self.status.set("C · $(command) · $(Math.round(self.voice.current_rpm()) as int) tr/min estimés")
        } else {
            var label = "A · Référence originale"; if self.mode.value() == 1 { label = "B · Reconstruction à vitesse d’origine" }
            let seconds = Math.round(Math.min(self.voice.frame() as float / 44_100.0, self.bank.frames as float / 44_100.0) * 10.0) / 10.0
            self.status.set("$(label) · $(seconds) / 13,19 s")
        }
    }
    func rpm_label(value:float) str { return "$(Math.round(value) as int) tr/min estimés" }
    func percent(value:float) str { return "$(Math.round(value * 100.0) as int) %" }
    func status_view(reads:UI.Reads) UI.View { return text(reads.read(self.status), 20.0) }
    func control_view(reads:UI.Reads) UI.View {
        if reads.read(self.driving) {
            var slider = UI.Slider(self.throttle, 0.0, 1.0, self.changed)
            slider.style.height = 28.0; slider.style.accent = Color.cyan_400()
            return UI.Column([text("Accélérateur · Espace maintenu : pleins gaz"), UI.Text(self.throttle, format:self.percent), slider])
        }
        var slider = UI.Slider(self.rpm, self.bank.minimum_rpm, self.bank.maximum_rpm, self.changed)
        slider.style.height = 28.0; slider.style.accent = Color.cyan_400()
        return UI.Column([text("Banc · régime imposé"), UI.Text(self.rpm, format:self.rpm_label), slider])
    }
    func view() UI.View {
        var buttons = UI.Row([button("A · Référence", self.reference), button("B · Reconstruction", self.reconstruction),
            button("C · Moteur piloté", self.controlled), button("Lecture / arrêt · M", self.toggle)], wrap:true)
        buttons.style.gap = 10.0
        var load = UI.Slider(self.load, 0.0, 1.0, self.changed)
        var volume = UI.Slider(self.volume, 0.0, 1.0, self.changed)
        load.style.height = 28.0; load.style.accent = Color.cyan_400()
        volume.style.height = 28.0; volume.style.accent = Color.cyan_400()
        var content = UI.Column([text("YZ250 · prototype d’écoute", 28.0),
            text("2023 YZ250 + FMF Full Exhaust PURE SOUND · 13,19 s stéréo"), buttons, UI.Reactive(self.status_view),
            text("A / B : comparer la matière originale et sa reconstruction."),
            text("C : donner des gaz, relâcher et écouter la montée / descente en régime."),
            UI.Row([button("Accélérateur", self.drive), button("Banc à régime imposé", self.manual)], wrap:true),
            UI.Reactive(self.control_view),
            text("Charge · freine la montée en mode accélérateur"), UI.Text(self.load, format:self.percent), load,
            text("Volume commun A / B / C"), UI.Text(self.volume, format:self.percent), volume,
            text("Régime estimé par analyse sonore, sans compte-tours de référence."),
            text("Charge estimée depuis les montées et descentes en régime, sans mesure de couple."),
            text("Réponse aux gaz simplifiée ; régime plancher limité au bas de l’enregistrement."),
            text("Les bruits et variations du fichier sont conservés ; la fidélité reste à valider à l’écoute.")])
        content.style.gap = 12.0; content.style.padding = UI.Insets(22.0)
        content.style.background = Color.bytes(10, 16, 24); content.style.foreground = Color.slate_100()
        return UI.ScrollView(content, smooth_scroll:true)
    }
}
class Session:Canvas.Session {
    private var bench:Bench
    private var ui:UI.Session
    private var audio:Audio
    private var producer:Synthesis.StreamProducer
    private var playing:Audio.PlayingSound = Audio.PlayingSound()
    private var generation:int = 0
    private var volume:float = -1.0
    init() {
        self.bench = Bench(); self.ui = UI.Session(self.bench.view()); self.audio = Audio()
        self.producer = Synthesis.StreamProducer.create(self.audio, self.bench.voice, 9_223_372_036_854_775_807,
            block_frames:256, capacity_frames:2_048)
    }
    private func feed() {
        if self.generation != self.bench.generation {
            if self.playing.is_valid() { self.audio.stop(self.playing) }
            self.producer = Synthesis.StreamProducer.create(self.audio, self.bench.voice, 9_223_372_036_854_775_807,
                block_frames:256, capacity_frames:2_048)
            self.playing = Audio.PlayingSound(); self.generation = self.bench.generation
        }
        for _ in 0...10 {
            if self.audio.stream_info(self.producer.stream()).queued_frames >= 2_048 { break }
            match try self.producer.pump() {
                failure(error) => { if error.kind != Kind.would_block() { panic(error.detail) }
                    break }
                success(count) => { if count == 0 { break } }
            }
        }
        if !self.playing.is_valid() && self.audio.stream_info(self.producer.stream()).queued_frames >= 1_024 {
            self.playing = self.audio.play(self.producer.stream(), Audio.Playback(volume:self.bench.volume.value()))
        }
        if self.playing.is_valid() && self.volume != self.bench.volume.value() {
            self.volume = self.bench.volume.value(); self.audio.set_volume(self.playing, self.volume)
        }
    }
    func drawing(width:int, height:int) Canvas { self.feed(); return self.ui.drawing(width, height) }
    func update(delta:float) bool { self.bench.update(delta); self.feed(); return self.ui.update(delta) }
    func handle(event:@Events.Event) bool {
        match event {
            window_focus_lost(value) => { self.bench.gas(false) }
            key_pressed(value) => {
                let m = value.keycode == 109 as uint32 || value.keycode == 77 as uint32 || (value.keycode == 0 as uint32 && value.key == Keyboard.Key.m)
                if m && !value.repeated && !value.modifiers.control && !value.modifiers.alt && !value.modifiers.system { self.bench.toggle(); return true }
                if value.key == Keyboard.Key.space && self.bench.mode.value() == 2 && self.bench.driving.value() && !value.modifiers.control && !value.modifiers.alt && !value.modifiers.system {
                    self.bench.gas(true); return true
                }
            }
            key_released(value) => {
                if value.key == Keyboard.Key.space && self.bench.mode.value() == 2 && self.bench.driving.value() { self.bench.gas(false); return true }
            }
            else => {}
        }
        return self.ui.handle(event)
    }
    func accepts_text_input() bool { return self.ui.accepts_text_input() }
    func text_input_target() Canvas.TextInputTarget? { return self.ui.text_input_target() }
    func pointer_cursor() Window.Cursor { return self.ui.pointer_cursor() }
    drop { if self.playing.is_valid() { self.audio.stop(self.playing) } }
}
public func show() {
    var session = Session()
    Viewer.show(session, Viewer.CanvasSettings(width:1_060, height:840, title:"Silex — YZ250 · accélérateur et banc A/B/C"))
}
public func check() {
    var bench = Bench(); var runtime = UI.Runtime(bench.view()); runtime.drawing(1_060, 840)
    assert(runtime.key_pressed(Keyboard.Key.tab)); assert(runtime.key_pressed(Keyboard.Key.tab)); assert(runtime.key_pressed(Keyboard.Key.enter))
    assert(bench.mode.value() == 1 && bench.playing.value())
    var controls = UI.Runtime(bench.view()); controls.drawing(1_060, 840)
    for _ in 0...3 { assert(controls.key_pressed(Keyboard.Key.tab)) }
    assert(controls.key_pressed(Keyboard.Key.enter))
    assert(bench.mode.value() == 2 && bench.driving.value())
    for _ in 0...4 { assert(controls.key_pressed(Keyboard.Key.tab)) }
    assert(controls.key_pressed(Keyboard.Key.end)); assert(bench.throttle.value() == 1.0 as float)
    assert(controls.key_pressed(Keyboard.Key.home)); assert(bench.throttle.value() == 0.0 as float)
    var manual = UI.Runtime(bench.view()); manual.drawing(1_060, 840)
    for _ in 0...6 { assert(manual.key_pressed(Keyboard.Key.tab)) }
    assert(manual.key_pressed(Keyboard.Key.enter)); assert(!bench.driving.value())
    var ui = UI.Session(bench.view()); for width in [400, 760, 1_060] { ui.drawing(width, 840) }
    print("YZ250 UI check passed: reference/reconstruction buttons and three layouts")
}
