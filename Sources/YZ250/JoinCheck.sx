use STD.Math
use Module.Bank
use Module.Voice

// A valid steady loop did not prove the audible end of an acceleration. Check
// the reference shape 46 ms after the rise, before H5's 350 ms voice change.
public func check() {
    var bank = Bank(); var voice = Voice(bank); var legacy = Voice(bank, pulses:false)
    var a:float32[] = []; var b:float32[] = []
    for _ in 0...1_024 { a.append(0.0); b.append(0.0) }
    voice.set_state(1_800.0, 1.0); legacy.set_state(1_800.0, 1.0)
    voice.reset(); legacy.reset()
    voice.set_state(7_000.0, 1.0); legacy.set_state(7_000.0, 1.0)
    while voice.current_rpm() < 6_999.9 { voice.render(&a[0:1_024]); legacy.render(&b[0:1_024]) }
    for _ in 0...4 { voice.render(&a[0:1_024]); legacy.render(&b[0:1_024]) }
    var dot:float64 = 0.0; var actual:float64 = 0.0; var reference:float64 = 0.0
    var old_dot:float64 = 0.0; var old_power:float64 = 0.0
    for _ in 0...8 {
        var turns = voice.crank_turns()
        while turns >= 32.0 { turns -= 32.0 }
        voice.render(&a[0:1_024]); legacy.render(&b[0:1_024])
        for frame in 0...512 {
            turns += 1.0 / 378.0; if turns >= 32.0 { turns -= 32.0 }
            for channel in 0...2 {
                let expected = bank.registered_sample(turns, channel, 7_000.0)
                let value = a[frame * 2 + channel] as float64
                let old = b[frame * 2 + channel] as float64
                assert(Math.is_finite(value) && Math.abs(value) <= 0.980001)
                dot += value * expected; actual += value * value; reference += expected * expected
                old_dot += old * expected; old_power += old * old
            }
        }
    }
    let correlation = dot / Math.sqrt(actual * reference)
    let old_correlation = old_dot / Math.sqrt(old_power * reference)
    assert(correlation > 0.9999, "the end of acceleration does not retain G's timbre")
    print("H6 rise-to-hold waveform correlation: ", correlation, " ; H5 comparison: ", old_correlation)
}
