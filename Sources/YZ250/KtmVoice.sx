use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.Math
use STD.Error
use STD.Error.Kind
use Module.KtmData

enum Playback { ride; original; mix }

public class KtmVoice:Synthesis.Generator {
    let format:Processing.Format = Processing.Format(sample_rate:44_100, channels:2)
    private var pcm:float32[] = []
    private var playback:Playback = Playback.ride
    private var cursor:int = KtmData.idle_begin
    private var incoming:int = -1
    private var overlap:int = 0
    private var attack:int = 0
    private var revision:int = 0
    private var running:bool = false
    private var pressure:float = 0.0
    private var full:bool = false
    private var low:bool = false
    private var coasting:bool = false

    // Corresponding firing cadences on the rising and falling sides of H.
    // Landmarks are approximate; alignment searches nearby for a matching phase.
    private let rise:int[] = [11_907, 13_539, 15_876, 17_816, 22_270, 23_594]
    private let fall:int[] = [95_032, 87_098, 77_000, 69_237, 62_843, KtmData.coast_begin]

    init() {
        let bytes = embed_bytes("Assets/Ktm.pcm")
        assert(bytes.count() == (KtmData.quick_join + KtmData.join_frames) * 4)
        for i in 0...bytes.count() / 2 {
            var word = bytes[i * 2] as int + bytes[i * 2 + 1] as int * 256
            if word >= 32_768 { word -= 65_536 }
            self.pcm.append(word as float32 / 32_768.0)
        }
    }
    func generation() int { mutex { return self.revision } }
    func set_throttle(value:float) {
        mutex {
            self.pressure = 0.0
            if Math.is_finite(value) && value > 0.03 { self.pressure = Math.min(1.0, value) }
            self.full = self.pressure >= 0.90 || (self.full && self.pressure >= 0.84)
            self.low = self.pressure < 0.36 || (self.low && self.pressure < 0.41)
            if self.pressure > 0.0 && (!self.running || self.playback != Playback.ride) { self.start_idle() }
        }
    }
    func listen_idle() { mutex { self.set_throttle(0.0); self.start_idle() } }
    func listen_original() { mutex { self.start(Playback.original, KtmData.original_begin) } }
    func listen_mix() { mutex { self.start(Playback.mix, 0) } }
    func stop() { mutex { self.running = false; self.set_throttle(0.0); self.revision++ } }
    func reset() {
        mutex {
            if self.playback == Playback.mix { self.start(Playback.mix, 0) }
            else if self.playback == Playback.original { self.start(Playback.original, KtmData.original_begin) }
            else if self.running { self.start(Playback.ride, KtmData.idle_begin) }
        }
    }
    func status() str {
        mutex {
            if !self.running { return "À l’arrêt" }
            if self.playback == Playback.original { return "Prise originale · lecture" }
            if self.playback == Playback.mix { return "Mix E/G · lecture" }
            if self.cursor >= KtmData.quick_begin { return "Ouverture franche" }
            if self.cursor >= KtmData.opening_begin {
                if !self.full && self.cursor >= self.partial_begin() {
                    if self.low { return "Gaz partiels · bas" }
                    return "Gaz partiels · intermédiaire"
                }
                return "Ouverture progressive"
            }
            if self.cursor >= KtmData.idle_begin { return "Ralenti" }
            if self.cursor >= KtmData.coast_begin { return "Retombée" }
            if self.cursor >= self.rise[self.rise.count() - 1] { return "Maintien" }
            return "Montée"
        }
    }
    private func start_idle() {
        self.start(Playback.ride, KtmData.idle_begin)
        self.attack = KtmData.join_frames
    }
    private func start(playback:Playback, position:int) {
        self.playback = playback; self.cursor = position
        self.incoming = -1; self.overlap = 0; self.attack = 0
        self.running = true; self.coasting = false; self.revision++
    }
    private func join(position:int) { self.incoming = position; self.overlap = 0 }

    private func aligned(position:int, lower:int, upper:int, radius:int = 180) int {
        var best = position; var best_score:float = -2.0
        var from = position - radius; var last = position + radius
        if from < lower { from = lower }
        if last > upper { last = upper }
        while from <= last {
            var cross:float = 0.0; var aa:float = 0.0; var bb:float = 0.0
            var i = 0
            while i < KtmData.join_frames {
                for channel in 0...2 {
                    let a = self.pcm[(self.cursor + i) * 2 + channel]
                    let b = self.pcm[(from + i) * 2 + channel]
                    cross += a * b; aa += a * a; bb += b * b
                }
                i += 8
            }
            let score = cross / Math.sqrt(aa * bb + 0.00000001)
            if score > best_score { best = from; best_score = score }
            from += 4
        }
        return best
    }
    private func match_fall() int {
        for i in 1...self.rise.count() {
            if self.cursor <= self.rise[i] {
                let progress = self.cursor - self.rise[i - 1]
                let width = self.rise[i] - self.rise[i - 1]
                return self.fall[i - 1] - progress * (self.fall[i - 1] - self.fall[i]) / width
            }
        }
        return KtmData.coast_begin
    }
    private func match_rise() int {
        if self.cursor >= self.fall[0] { return self.rise[0] }
        for i in 1...self.fall.count() {
            if self.cursor >= self.fall[i] {
                let progress = self.cursor - self.fall[i]
                let width = self.fall[i - 1] - self.fall[i]
                return self.rise[i] - progress * (self.rise[i] - self.rise[i - 1]) / width
            }
        }
        return KtmData.hold_begin
    }
    private func partial_begin() int {
        if self.low { return KtmData.low_begin }
        return KtmData.mid_begin
    }
    private func partial_end() int {
        if self.low { return KtmData.low_end }
        return KtmData.mid_end
    }
    private func return_to_idle() {
        self.join(self.aligned(KtmData.idle_begin, KtmData.idle_begin, KtmData.idle_end, radius:1_323))
    }
    private func opening() {
        if self.pressure == 0.0 { self.return_to_idle(); return }
        if self.cursor >= KtmData.quick_begin {
            if !self.full {
                let quick = self.cursor - KtmData.quick_begin
                let length = KtmData.quick_join - KtmData.quick_begin
                let position = KtmData.opening_begin + quick * (KtmData.opening_join - KtmData.opening_begin) / length
                var target = position
                if target > self.partial_end() - KtmData.join_frames { target = self.partial_begin() }
                self.join(self.aligned(target, KtmData.opening_begin, self.partial_end() - KtmData.join_frames))
            } else if self.cursor == KtmData.quick_join { self.join(KtmData.rise_begin) }
        } else if !self.full && self.cursor >= self.partial_end() {
            var begin = self.partial_begin()
            if self.cursor != self.partial_end() {
                begin = self.aligned(begin, begin - 180, begin + 180)
            }
            self.join(begin)
        } else if self.cursor == KtmData.opening_join {
            self.join(KtmData.rise_begin)
        }
    }
    private func drive() {
        if self.cursor >= KtmData.opening_begin {
            self.opening()
        } else if self.cursor >= KtmData.idle_begin {
            self.coasting = false
            if self.pressure > 0.0 {
                var start = KtmData.opening_begin
                if self.full { start = KtmData.quick_begin }
                self.join(self.aligned(start, start, start + 1_323, radius:1_323))
            }
            else if self.cursor == KtmData.idle_end { self.join(KtmData.idle_begin) }
        } else if self.cursor >= KtmData.coast_begin {
            if self.full && !self.coasting {
                self.join(KtmData.hold_begin)
            } else if self.full && self.cursor < KtmData.mix_frames - KtmData.join_frames {
                self.join(self.aligned(self.match_rise(), KtmData.rise_begin, KtmData.coast_begin - KtmData.join_frames))
                self.coasting = false
            } else if self.cursor == KtmData.mix_frames - KtmData.join_frames {
                if self.pressure > 0.0 { self.join(self.partial_begin()) }
                else { self.join(KtmData.idle_begin) }
            } else {
                self.coasting = true
            }
        } else if !self.full && self.cursor < KtmData.coast_begin - KtmData.join_frames {
            if self.cursor < self.rise[0] {
                if self.pressure > 0.0 { self.join(self.partial_begin()) }
                else { self.join(KtmData.idle_begin) }
            }
            else {
                self.join(self.aligned(self.match_fall(), KtmData.coast_begin, KtmData.mix_frames - 2 * KtmData.join_frames))
                self.coasting = true
            }
        }
    }
    func render(output:&float32[..]) Result<void,Error> {
        mutex {
            if output.count() % 2 != 0 {
                return Result<void,Error>.failure(Error(kind:Kind.invalid_input(), operation:"ktm.render", detail:"complete stereo frames required"))
            }
            for frame in 0...output.count() / 2 {
                if !self.running {
                    output[frame * 2] = 0.0; output[frame * 2 + 1] = 0.0
                    continue
                }
                if self.playback == Playback.ride && self.incoming < 0 { self.drive() }
                var mix:float32 = 0.0
                if self.incoming >= 0 {
                    let position = self.overlap as float32 / (KtmData.join_frames - 1) as float32
                    mix = position * position * (3.0 - 2.0 * position)
                }
                let attack = 1.0 - self.attack as float32 / KtmData.join_frames as float32
                for channel in 0...2 {
                    var value = self.pcm[self.cursor * 2 + channel]
                    if self.incoming >= 0 {
                        let next = self.pcm[self.incoming * 2 + channel]
                        value += mix * (next - value)
                    }
                    output[frame * 2 + channel] = value * attack
                }
                if self.attack > 0 { self.attack-- }
                self.cursor++
                if self.incoming >= 0 {
                    self.incoming++; self.overlap++
                    if self.overlap == KtmData.join_frames { self.cursor = self.incoming; self.incoming = -1 }
                }
                if (self.playback == Playback.mix && self.cursor == KtmData.mix_frames) ||
                    (self.playback == Playback.original && self.cursor == KtmData.idle_begin) { self.running = false }
            }
            return Result<void,Error>.success()
        }
    }
}
