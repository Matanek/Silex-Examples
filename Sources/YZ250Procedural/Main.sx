use STD.Process
use Module.Offline
use Module.Session

func main() {
    let arguments = Process.arguments()
    if arguments.count() > 1 {
        if arguments[1] == "--check" { Offline.check(); Session.check(); return }
        if arguments[1] == "--render" && arguments.count() == 3 { Offline.render(arguments[2]); return }
        panic("Options: --check | --render output-prefix")
    }
    Session.show()
}
