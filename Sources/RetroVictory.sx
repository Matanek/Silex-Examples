use GFX.Audio
use GFX.Audio.Music

// Depuis SilexProject : silex run Silex-Examples/Sources/RetroVictory.sx --release
func main() {
    var audio = Audio()
    var melody = try Music.Melody.create([
        Music.Note(key:72, beats:0.5), Music.Note(key:76, beats:0.5),
        Music.Note(key:79, beats:0.5), Music.Note(key:84, beats:1.25),
    ], tempo:187.5) else error { panic(error.detail) }

    var timbre = Music.Timbre.retro()
    // Exemple de personnalisation : timbre.release_seconds = 0.07
    let victory = try melody.prepare(audio, using:timbre) else error { panic(error.detail) }
    let playing = audio.play(victory) // Préparer au chargement, déclencher à la victoire.
    audio.wait(playing)              // Seulement pour cette démo ; ne pas attendre en jeu.
}
