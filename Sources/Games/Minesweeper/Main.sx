use GFX.Application
use GFX.Color
use GFX.Input
use GFX.Plugins
use GFX.Resources
use GFX.Window
use Module.Assets.load_visual_assets
use Module.Presentation.menu_bundle
use Module.Session.GameSession
use STD.Math
use STD.Process

func verification_mode() bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments { if argument == "--verify" { return true } }
        }
    }
    return false
}

package func window_settings(verification:bool) Plugins.Window.Settings {
    return Plugins.Window.Settings()
        ..title = "Minesweeper"
        ..width = 800
        ..height = 800
        ..resizable = verification
        ..fullscreen = false
        ..borderless = false
        ..hidden = verification
}

package func prepare_window(verification:bool, window:&Window) {
    assert(!window.state().visible)
    if verification {
        window.set_minimum_size(Math.Vec2(560.0, 620.0))
        return
    }
    window.set_opacity(0.0)
    window.show()
    window.set_fullscreen(true)
    window.sync()
    assert(window.is_fullscreen())
}

func configure_window(
    session:@GameSession,
    window:&Window,
    device:@Resources.Device,
    surface:@Resources.GPUSurface
) {
    prepare_window(session.verification, window)
    if session.verification { return }
    surface.wait_until_ready()
    var commands = device.commands()
    commands.clear(surface, Color.bytes(7, 12, 24))
    commands.submit()
    window.set_opacity(1.0)
}

func main() {
    let verification = verification_mode()
    var session = GameSession(verification)
    var application = Application()
        ..add_resource(session)
        ..add_plugin(Plugins.Window(window_settings(verification)))
        ..add_plugin(Plugins.FramePacing(60))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.bytes(7, 12, 24)
            ..antialiasing = Plugins.RenderingAntialiasing.none
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.ViewportCamera2D(
            Plugins.ViewportCamera2D.Settings()
                ..position = Math.Vec2(192.0)
                ..min_zoom = 0.25
                ..max_zoom = 2.0
                ..overscroll = Math.Vec2(100.0)
                ..controls = Plugins.ViewportCamera2DControls(
                    pan:Input.MouseButton.middle,
                    scroll:Plugins.ViewportCamera2DScroll.pan
                )
        ))
        ..add_plugin(Plugins.Audio())
        ..add_plugin(Plugins.Time())
        ..add_plugin(Plugins.BundleManager())
        ..add_system(Application.Schedule.startup, configure_window)

    application.prepare()
    {
        var resources = application.resources()
        var images:&Resources.Images = resources.get_mut<Resources.Images>()
        application.add_resource(load_visual_assets(images))
    }
    {
        var resources = application.resources()
        var manager:&Plugins.BundleManager = resources.get_mut<Plugins.BundleManager>()
        manager.add(menu_bundle(manager.create()))
    }

    assert(application.run() == 0)
    if verification {
        assert(session.settings().width == 48)
        assert(session.settings().height == 12)
        assert(session.settings().difficulty == 3)
        assert(session.menu_visits == 2)
        assert(session.menu_finalizations == 2)
        assert(session.game_finalizations == 1)
        print("Minesweeper menu verification passed")
    }
}
