use STD.Algorithms.Random
use STD.Math
use STD.Randomizer

public enum GameState {
    ready
    playing
    won
    lost
}

public enum CellState {
    covered
    revealed
    flagged
}

public struct Coordinate {
    let x:int
    let y:int
}

public struct Cell {
    var mine:bool
    var neighboring_mines:int
    var state:CellState

    init() {
        self.mine = false
        self.neighboring_mines = 0
        self.state = CellState.covered
    }
}

public struct Settings {
    let width:int
    let height:int
    let difficulty:int

    init(width:int, height:int, difficulty:int = 1) {
        validate_dimension("width", width)
        validate_dimension("height", height)
        if difficulty < 1 || difficulty > 6 {
            panic("Minesweeper difficulty must be between 1 and 6")
        }
        self.width = width
        self.height = height
        self.difficulty = difficulty
    }

    func cell_count() int { return self.width * self.height }
    func sector_columns() int { return self.width / 4 }
    func sector_rows() int { return self.height / 4 }
    func sector_count() int { return self.sector_columns() * self.sector_rows() }
    func mine_count() int { return self.sector_count() * self.difficulty }

    static func compact(difficulty:int = 1) Settings {
        return Settings(8, 8, difficulty)
    }

    static func wide(difficulty:int = 1) Settings {
        return Settings(16, 8, difficulty)
    }

    static func large(difficulty:int = 1) Settings {
        return Settings(32, 8, difficulty)
    }

    static func huge(difficulty:int = 1) Settings {
        return Settings(48, 12, difficulty)
    }

    static func fit(
        viewport:Math.Vec2,
        difficulty:int = 1,
        tile_size:float = 48.0,
        reserved:Math.Vec2 = Math.Vec2(300.0)
    ) Settings {
        if tile_size <= 0.0 {
            panic("Minesweeper fit requires a positive tile size")
        }
        let available = Math.Vec2(
            Math.max(0.0, viewport.x - reserved.x),
            Math.max(0.0, viewport.y - reserved.y)
        )
        return Settings(
            fitted_dimension(available.x, tile_size),
            fitted_dimension(available.y, tile_size),
            difficulty
        )
    }
}

public struct ActionResult {
    let changed:Coordinate[]
    let state:GameState
    let generated:bool
    let triggered:Coordinate?

    func changed_anything() bool { return !self.changed.is_empty() }
}

public class Board {
    private let configuration:Settings
    private var cells:Cell[]
    private var current_state:GameState
    private var current_seed:int
    private var generated:bool
    private var revealed_safe_cells:int
    private var flag_count:int
    private var triggered_mine:Coordinate? = null

    init(settings:Settings, seed:int = 1) {
        self.configuration = settings
        self.cells = empty_cells(settings.cell_count())
        self.current_state = GameState.ready
        self.current_seed = seed
        self.generated = false
        self.revealed_safe_cells = 0
        self.flag_count = 0
    }

    func settings() Settings { return self.configuration }
    func state() GameState { return self.current_state }
    func seed() int { return self.current_seed }
    func has_generated_mines() bool { return self.generated }
    func flags() int { return self.flag_count }
    func triggered() Coordinate? { return self.triggered_mine }
    func target_mines() int { return self.configuration.mine_count() }
    func safe_cells_revealed() int { return self.revealed_safe_cells }

    func contains(x:int, y:int) bool {
        return x >= 0 && y >= 0 &&
            x < self.configuration.width && y < self.configuration.height
    }

    func cell(x:int, y:int) Cell {
        self.require_coordinate(x, y)
        return self.cells[self.index(x, y)]
    }

    func actual_mine_count() int {
        var count = 0
        for cell in self.cells { if cell.mine { count++ } }
        return count
    }

    func reveal(x:int, y:int) ActionResult {
        if !self.contains(x, y) ||
            self.current_state == GameState.won ||
            self.current_state == GameState.lost
        { return self.result([], false) }
        let selected = self.index(x, y)
        if self.cells[selected].state != CellState.covered {
            return self.result([], false)
        }
        var just_generated = false
        if self.current_state == GameState.ready {
            self.generate(x, y)
            self.current_state = GameState.playing
            just_generated = true
        }
        var starts:int[] = [selected]
        return self.reveal_from(starts, just_generated)
    }

    func toggle_flag(x:int, y:int) ActionResult {
        if !self.contains(x, y) || self.current_state != GameState.playing {
            return self.result([], false)
        }
        let selected = self.index(x, y)
        if self.cells[selected].state == CellState.revealed {
            return self.result([], false)
        }
        if self.cells[selected].state == CellState.flagged {
            self.cells[selected].state = CellState.covered
            self.flag_count--
        } else {
            self.cells[selected].state = CellState.flagged
            self.flag_count++
        }
        var changed:Coordinate[] = [self.coordinate(selected)]
        return self.result(changed, false)
    }

    func chord(x:int, y:int) ActionResult {
        if !self.contains(x, y) || self.current_state != GameState.playing {
            return self.result([], false)
        }
        let selected = self.index(x, y)
        let center = self.cells[selected]
        if center.state != CellState.revealed || center.neighboring_mines <= 0 {
            return self.result([], false)
        }
        var flagged = 0
        var starts:int[] = []
        for index in self.neighbor_indices(x, y) {
            if self.cells[index].state == CellState.flagged {
                flagged++
            } elif self.cells[index].state == CellState.covered {
                starts.append(index)
            }
        }
        if flagged != center.neighboring_mines {
            return self.result([], false)
        }
        return self.reveal_from(starts, false)
    }

    func is_wrong_flag(x:int, y:int) bool {
        if !self.contains(x, y) { return false }
        let selected = self.cells[self.index(x, y)]
        return selected.state == CellState.flagged && !selected.mine
    }

    func reset(seed:int) {
        self.cells = empty_cells(self.configuration.cell_count())
        self.current_state = GameState.ready
        self.current_seed = seed
        self.generated = false
        self.revealed_safe_cells = 0
        self.flag_count = 0
        self.triggered_mine = null
    }

    func reset() {
        var randomizer = Randomizer()
        self.reset(randomizer.get_int())
    }

    private func generate(safe_x:int, safe_y:int) {
        var randomizer = Randomizer(self.current_seed)
        var sector_y = 0
        while sector_y < self.configuration.sector_rows() {
            var sector_x = 0
            while sector_x < self.configuration.sector_columns() {
                var candidates:int[] = []
                var local_y = 0
                while local_y < 4 {
                    var local_x = 0
                    while local_x < 4 {
                        let x = sector_x * 4 + local_x
                        let y = sector_y * 4 + local_y
                        if Math.abs(x - safe_x) > 1 || Math.abs(y - safe_y) > 1 {
                            candidates.append(self.index(x, y))
                        }
                        local_x++
                    }
                    local_y++
                }
                Random.shuffle<int>(
                    randomizer,
                    &candidates[0:candidates.count()]
                )
                var mine = 0
                while mine < self.configuration.difficulty {
                    self.cells[candidates[mine]].mine = true
                    mine++
                }
                sector_x++
            }
            sector_y++
        }
        self.compute_neighboring_mines()
        self.generated = true
    }

    private func compute_neighboring_mines() {
        var y = 0
        while y < self.configuration.height {
            var x = 0
            while x < self.configuration.width {
                let selected = self.index(x, y)
                if !self.cells[selected].mine {
                    var count = 0
                    for neighbor in self.neighbor_indices(x, y) {
                        if self.cells[neighbor].mine { count++ }
                    }
                    self.cells[selected].neighboring_mines = count
                }
                x++
            }
            y++
        }
    }

    private func reveal_from(starts:int[], just_generated:bool) ActionResult {
        if starts.is_empty() { return self.result([], just_generated) }
        var queued = empty_bools(self.cells.count())
        var queue:int[] = []
        for selected in starts {
            if !queued[selected] {
                queued[selected] = true
                queue.append(selected)
            }
        }
        var changed:Coordinate[] = []
        var cursor = 0
        while cursor < queue.count() && self.current_state == GameState.playing {
            let selected = queue[cursor]
            cursor++
            if self.cells[selected].state != CellState.covered { continue }
            if self.cells[selected].mine {
                self.lose(selected, changed)
                break
            }
            self.cells[selected].state = CellState.revealed
            self.revealed_safe_cells++
            changed.append(self.coordinate(selected))
            if self.cells[selected].neighboring_mines == 0 {
                let point = self.coordinate(selected)
                for neighbor in self.neighbor_indices(point.x, point.y) {
                    if !queued[neighbor] &&
                        self.cells[neighbor].state == CellState.covered &&
                        !self.cells[neighbor].mine
                    {
                        queued[neighbor] = true
                        queue.append(neighbor)
                    }
                }
            }
        }
        if self.current_state == GameState.playing &&
            self.revealed_safe_cells ==
                self.configuration.cell_count() - self.configuration.mine_count()
        {
            self.current_state = GameState.won
        }
        return self.result(changed, just_generated)
    }

    private func lose(selected:int, changed:&Coordinate[]) {
        self.current_state = GameState.lost
        self.triggered_mine = self.coordinate(selected)
        var index = 0
        while index < self.cells.count() {
            if self.cells[index].mine && self.cells[index].state == CellState.covered {
                self.cells[index].state = CellState.revealed
                changed.append(self.coordinate(index))
            }
            index++
        }
    }

    private func neighbor_indices(x:int, y:int) int[] {
        var result:int[] = []
        var offset_y = -1
        while offset_y <= 1 {
            var offset_x = -1
            while offset_x <= 1 {
                let neighbor_x = x + offset_x
                let neighbor_y = y + offset_y
                if (offset_x != 0 || offset_y != 0) &&
                    self.contains(neighbor_x, neighbor_y)
                {
                    result.append(self.index(neighbor_x, neighbor_y))
                }
                offset_x++
            }
            offset_y++
        }
        return result
    }

    private func result(changed:Coordinate[], just_generated:bool) ActionResult {
        return ActionResult(
            changed:changed,
            state:self.current_state,
            generated:just_generated,
            triggered:self.triggered_mine
        )
    }

    private func index(x:int, y:int) int {
        return y * self.configuration.width + x
    }

    private func coordinate(index:int) Coordinate {
        return Coordinate(
            x:index % self.configuration.width,
            y:index / self.configuration.width
        )
    }

    private func require_coordinate(x:int, y:int) {
        if !self.contains(x, y) {
            panic("Minesweeper coordinate is outside the board")
        }
    }
}

func validate_dimension(name:str, value:int) {
    if value < 4 || value > 256 || value % 4 != 0 {
        panic("Minesweeper $(name) must be a multiple of 4 between 4 and 256")
    }
}

func fitted_dimension(available:float, tile_size:float) int {
    var cells = Math.floor(available / tile_size) as int
    cells = cells / 4 * 4
    if cells < 4 { return 4 }
    if cells > 256 { return 256 }
    return cells
}

func empty_cells(count:int) Cell[] {
    var result:Cell[] = []
    while result.count() < count { result.append(Cell()) }
    return result
}

func empty_bools(count:int) bool[] {
    var result:bool[] = []
    while result.count() < count { result.append(false) }
    return result
}
