use GFX.Window
use Package.Games.Minesweeper.Menu.MenuLayout
use Package.Games.Minesweeper.Menu.interact_menu
use Package.Games.Minesweeper.Main.prepare_window
use Package.Games.Minesweeper.Main.window_settings
use Package.Games.Minesweeper.Session.GameSession
use Package.Games.Minesweeper.Session.Request
use STD.Math

test "enter native fullscreen only after the hidden render surface is ready" {
    let normal = window_settings(false)
    assert(!normal.borderless)
    assert(!normal.fullscreen)
    assert(!normal.resizable)
    assert(!normal.hidden)

    let verification = window_settings(true)
    assert(!verification.borderless)
    assert(!verification.fullscreen)
    assert(verification.resizable)
    assert(verification.hidden)

    var window = Window(Window.Settings(
        title:"Minesweeper startup test",
        width:800,
        height:800,
        resizable:false,
        borderless:false,
        hidden:true
    ))
    prepare_window(false, window)
    assert(window.is_fullscreen())
    assert(window.state().fullscreen)
    assert(!window.state().visible)
}

test "round every menu setting into the canonical model" {
    var session = GameSession()
    session.set_width(21.0)
    session.set_height(14.0)
    session.set_difficulty(5.7)
    assert(session.settings().width == 20)
    assert(session.settings().height == 16)
    assert(session.settings().difficulty == 6)
    assert(session.summary() == "120 mines pour 20 × 16 cases")

    session.adjust_width(-20)
    session.adjust_height(100)
    assert(session.settings().width == 4)
    assert(session.settings().height == 256)
}

test "preserve one dimension across the three fit actions" {
    var session = GameSession()
    session.preset(3)
    session.fit_width(Math.Vec2(1_260.0, 876.0))
    assert(session.settings().width == 20)
    assert(session.settings().height == 12)
    session.fit_height(Math.Vec2(1_260.0, 1_068.0))
    assert(session.settings().width == 20)
    assert(session.settings().height == 16)
    session.fit_screen(Math.Vec2(1_260.0, 876.0))
    assert(session.settings().width == 20)
    assert(session.settings().height == 12)
}

test "center the Godot-sized menu card and keep every action inside it" {
    let compact = MenuLayout.calculate(Math.Vec2(600.0, 700.0))
    let wide = MenuLayout.calculate(Math.Vec2(1_280.0, 800.0))
    assert(compact.compact)
    assert(!wide.compact)
    assert(compact.card.x >= 0.0 && compact.card.maximum().x <= 600.0)
    assert(wide.card.w == 416.0 && wide.card.h == 616.0)
    assert(wide.card.center().x == 640.0)
    assert(wide.card.center().y == 400.0)
    assert(compact.hit_test(compact.play.center()) == "play")
    assert(wide.hit_test(wide.quit.center()) == "quit")
    assert(wide.hit_test(Math.Vec2()) == "background")
}

test "drive dimensions, difficulty and play from canvas hit regions" {
    var session = GameSession()
    let viewport = Math.Vec2(1_280.0, 800.0)
    let layout = MenuLayout.calculate(viewport)
    let initial_width = session.settings().width
    assert(interact_menu(session, layout.width_plus.center(), viewport, false))
    assert(session.settings().width == initial_width + 4)
    assert(interact_menu(session, layout.preset_3.center(), viewport, false))
    assert(session.settings().width == 48 && session.settings().height == 12)
    assert(interact_menu(
        session,
        Math.Vec2(layout.difficulty.maximum().x - 1.0, layout.difficulty.center().y),
        viewport,
        true
    ))
    assert(session.settings().difficulty == 6)
    assert(interact_menu(session, layout.play.center(), viewport, false))
    assert(session.request() == Request.play)
}
