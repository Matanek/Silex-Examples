use GFX.UI
use GFX.Canvas
use GFX.Input.Events
use GFX.Input.Pointer
use GFX.Accessibility as AX
use GFX.Scene2D
use STD.Math
use STD.Time
use STD.Process
use Module.InteractionTrace.TraceSession
use Module.Main.Model
use Module.Main.named
use Module.InteractionProfile.observe

// Replay through Canvas.Session and the broad event bridge, in Viewer order.
// No Window, SDL runner or GPU. Complements the direct Runtime profile.
func run(slider:bool, semantics:bool, traced:bool) {
    var model = Model(); model.placed = true
    var runtime:Canvas.Session = UI.Session(UI.Reactive(model.describe))
    if traced { runtime = TraceSession(runtime) }
    var drawing = runtime.drawing(780, 820); var source = runtime.accessibility_source()!
    let id = named(source, source.root()!, "Volume", AX.Role.slider)!
    assert(source.perform(id, AX.Request(AX.Action.focus)))
    drawing = runtime.drawing(780, 820)
    if semantics { observe(source, source.root()!); let initial = source.changes() }
    let bounds = source.read(id)!.bounds
    let x = bounds.x + bounds.width * 0.5; let y = bounds.y + bounds.height * 0.5
    var presented = Scene2D.Canvas(drawing, 780, 820)
    if slider { assert(runtime.handle(Events.Event.mouse_button_pressed(Events.MouseButtonEvent(
        position:Math.Vec2(x, y), button:Pointer.MouseButton.left, down:true,
        timestamp:Events.Timestamp(nanoseconds:0 as uint))))) }
    var input = 0.0; var before = 0.0; var paint = 0.0; var replace = 0.0; var after = 0.0
    var clock = Time.Stopwatch()
    var step = 0
    while step < 90 {
        var amount = step % 30
        if step % 60 >= 30 { amount = 30 - amount }
        clock.restart()
        let updated = runtime.update(1.0 / 60.0)
        if slider {
            runtime.handle(Events.Event.mouse_moved(Events.MouseMotionEvent(
                position:Math.Vec2(bounds.x + 20.0 + amount as float * (bounds.width - 40.0) / 30.0, y),
                delta:Math.Vec2(), timestamp:Events.Timestamp(nanoseconds:0 as uint))))
        } else {
            var delta:float = -4.0
            if step % 60 >= 30 { delta = 4.0 }
            runtime.handle(Events.Event.mouse_wheel(Events.MouseWheelEvent(position:Math.Vec2(30.0, 30.0),
                delta:Math.Vec2(0.0, delta), timestamp:Events.Timestamp(nanoseconds:0 as uint))))
        }
        input += clock.get_elapsed_milliseconds()
        clock.restart()
        if semantics { let root = source.root(); let changes = source.changes() }
        before += clock.get_elapsed_milliseconds()
        clock.restart()
        drawing = runtime.drawing(780, 820)
        paint += clock.get_elapsed_milliseconds()
        clock.restart()
        presented.replace(drawing)
        replace += clock.get_elapsed_milliseconds()
        clock.restart()
        if semantics { let root = source.root(); let changes = source.changes() }
        after += clock.get_elapsed_milliseconds()
        step++
    }
    if slider { runtime.handle(Events.Event.mouse_button_released(Events.MouseButtonEvent(
        position:Math.Vec2(x, y), button:Pointer.MouseButton.left, down:false,
        timestamp:Events.Timestamp(nanoseconds:0 as uint)))) }
    assert(presented.revision() > 1)
    print("presenter slider=$(slider) semantics=$(semantics) traced=$(traced) n=90 input_ms=$(input) before_ms=$(before) paint_ms=$(paint) replace_ms=$(replace) after_ms=$(after)")
}
func main() {
    var traced = false
    for argument in Process.arguments() { if argument == "--trace" { traced = true } }
    run(true, false, traced); run(true, true, traced)
    run(false, false, traced); run(false, true, traced)
}
