use GFX.UI
use GFX.Canvas
use GFX.Accessibility
use GFX.Viewer
use STD.Process
use STD.Math

class Model {
    var name:UI.State<str> = UI.State<str>("Ada")
    var presses:UI.State<int> = UI.State<int>(0)
    var notifications:UI.State<bool> = UI.State<bool>(false)
    var profile:UI.State<str?> = UI.State<str?>("Calme")
    var volume:UI.State<float> = UI.State<float>(12.0)
    var locked:UI.State<bool> = UI.State<bool>(false)
    var details:UI.State<bool> = UI.State<bool>(true)
    var folders:UI.State<str[]> = UI.State<str[]>([])
    var file:UI.State<str?> = UI.State<str?>(null)
    var hidden_focus:UI.State<bool> = UI.State<bool>(false)
    func activate() { self.presses.set(self.presses.value() + 1) }
    func toggle_focus() { self.hidden_focus.set(!self.hidden_focus.value()) }
    func file_key(value:str) str { return value }
    func file_children(value:str) str[] {
        if value == "Documents" { return ["Notes", "Rapport"] }
        return []
    }
    func file_row(value:str) UI.View { return UI.Text(value) }
    func describe(reads:UI.Reads) UI.View {
        var title = UI.Text("Accessibilité — macOS"); title.style.font_size = 28.0
        var slider = UI.Slider(self.volume, minimum:10.0, maximum:20.0)
        slider.style.disabled = reads.read(self.locked)
        var choices = UI.Style()
        var focus_label = "Masquer les contours des cases et radios"
        if reads.read(self.hidden_focus) {
            choices.focus = UI.FocusAppearance.none()
            focus_label = "Afficher les contours des cases et radios"
        }
        let profile = reads.read(self.profile) ?? "aucun"
        var tree = UI.TreeView<str>(["Documents", "Images"], self.file_key, self.file_children, self.file_row,
            selection:self.file, expanded:self.folders, smooth_scroll:true, scroll_chain:false)
        tree.style.height = 180.0
        var root = UI.Column([
            title,
            UI.Text("Essayez les contrôles et l’option de contour. Tab conserve la navigation."),
            UI.Button(focus_label, self.toggle_focus),
            UI.Label("Nom", UI.TextField(self.name)),
            UI.Button("Valider", self.activate),
            UI.Text("Nom courant : $(reads.read(self.name))"),
            UI.Text("Activations : $(reads.read(self.presses))"),
            UI.Checkbox("Notifications", self.notifications, style:choices),
            UI.Accessible(UI.RadioGroup<str>([
                UI.RadioOption<str>("Calme", "Calme"),
                UI.RadioOption<str>("Énergique", "Énergique"),
                UI.RadioOption<str>("Indisponible", "Indisponible", disabled:true)
            ], self.profile, style:choices), "Profil"),
            UI.Label("Volume", slider),
            UI.Checkbox("Verrouiller le volume", self.locked, style:choices),
            UI.Text("Notifications : $(reads.read(self.notifications)) · Profil : $(profile)"),
            UI.Text("Volume : $(reads.read(self.volume)) — plage de 10 à 20"),
            UI.CollapsiblePanel("Fichiers", tree, self.details),
            UI.Text("Fichier sélectionné : $(reads.read(self.file) ?? "aucun")")
        ])
        root.style.padding = UI.Insets(20.0); root.style.gap = 14.0
        root.style.theme = UI.Theme.dark()
        return UI.ScrollView(root, smooth_scroll:true)
    }
}

func named(source:Accessibility.Source, id:str, name:str, role:Accessibility.Role) str? {
    var semantics = source
    if let element = semantics.read(id) {
        if element.name == name && element.role == role { return id }
        var index = 0
        while index < element.child_count {
            if let child = semantics.child(id, index) {
                if let found = named(semantics, child, name, role) { return found }
            }
            index++
        }
    }
    return null
}

func visible_text(commands:Canvas.Command[]) int {
    var count = 0
    for command in commands { match command {
        text(value) => {
            let color = value.style.color
            assert(color.r > 0.5 && color.g > 0.5 && color.b > 0.5 && color.a > 0.0)
            count++
        }
        layer(value) => { count += visible_text(value.commands()) }
        else => {}
    } }
    return count
}

test "the dark accessibility demo paints readable labels instead of dark text on the viewer background" {
    var model = Model()
    var session = UI.Session(UI.Reactive(model.describe))
    var drawing = session.drawing(780, 820)
    assert(visible_text(drawing.commands()) >= 10)
}

func check_cpu() {
    var model = Model()
    var session:Canvas.Session = UI.Session(UI.Reactive(model.describe))
    var drawing = session.drawing(780, 820)
    var source = session.accessibility_source()!
    let root = source.root()!
    let field = named(source, root, "Nom", Accessibility.Role.text_field)!
    let button = named(source, root, "Valider", Accessibility.Role.button)!
    assert(source.read(field)!.role == Accessibility.Role.text_field)
    assert(source.perform(field, Accessibility.Request(Accessibility.Action.focus)))
    assert(source.perform(field, Accessibility.Request(Accessibility.Action.set_value, text:"Été 👋")))
    assert(source.perform(button, Accessibility.Request(Accessibility.Action.activate)))
    drawing = session.drawing(780, 820)
    assert(model.name.value() == "Été 👋" && model.presses.value() == 1)
    assert(source.read(field)!.value == "Été 👋" && source.focused() == field)
    let check = named(source, root, "Notifications", Accessibility.Role.checkbox)!
    let radios = named(source, root, "Profil", Accessibility.Role.radio_group)!
    let calm = named(source, radios, "Calme", Accessibility.Role.radio)!
    let energetic = named(source, radios, "Énergique", Accessibility.Role.radio)!
    let unavailable = named(source, radios, "Indisponible", Accessibility.Role.radio)!
    assert(source.perform(check, Accessibility.Request(Accessibility.Action.activate)))
    assert(model.notifications.value() && source.read(check)!.checked == true)
    assert(source.perform(energetic, Accessibility.Request(Accessibility.Action.activate)))
    assert(model.profile.value() == "Énergique")
    assert(source.read(calm)!.checked == false && source.read(energetic)!.checked == true)
    assert(!source.read(unavailable)!.enabled)
    assert(!source.perform(unavailable, Accessibility.Request(Accessibility.Action.activate)))
    let slider = named(source, root, "Volume", Accessibility.Role.slider)!
    assert(source.read(slider)!.minimum == 10.0 && source.read(slider)!.maximum == 20.0)
    assert(source.perform(slider, Accessibility.Request(Accessibility.Action.increment)))
    assert(Math.abs(model.volume.value() - 12.1) < 0.001)
    assert(source.perform(slider, Accessibility.Request(Accessibility.Action.decrement)))
    assert(Math.abs(model.volume.value() - 12.0) < 0.001)
    assert(source.perform(slider, Accessibility.Request(Accessibility.Action.set_value, number:100.0)))
    assert(model.volume.value() == 20.0)
    let lock = named(source, root, "Verrouiller le volume", Accessibility.Role.checkbox)!
    assert(source.perform(lock, Accessibility.Request(Accessibility.Action.activate)))
    drawing = session.drawing(780, 820)
    assert(!source.read(slider)!.enabled)
    assert(!source.perform(slider, Accessibility.Request(Accessibility.Action.decrement)))
    assert(model.volume.value() == 20.0)
    let toggle = named(source, root, "Masquer les contours des cases et radios", Accessibility.Role.button)!
    assert(source.perform(toggle, Accessibility.Request(Accessibility.Action.activate)))
    drawing = session.drawing(780, 820)
    assert(model.hidden_focus.value() && visible_text(drawing.commands()) >= 10)
    assert(source.perform(toggle, Accessibility.Request(Accessibility.Action.activate)))
    assert(!model.hidden_focus.value())
    let label = source.read(field)!.labelled_by!
    assert(source.read(label)!.labels == field)
    let panel = named(source, root, "Fichiers", Accessibility.Role.button)!
    let folder = named(source, root, "Documents", Accessibility.Role.tree_item)!
    assert(source.read(folder)!.expanded == false)
    assert(source.perform(folder, Accessibility.Request(Accessibility.Action.expand)))
    assert(source.read(folder)!.expanded == true && source.read(folder)!.child_count == 2)
    let note = source.child(folder, 0)!
    assert(source.read(note)!.name == "Notes" && source.read(note)!.parent == folder)
    assert(source.perform(note, Accessibility.Request(Accessibility.Action.select)))
    drawing = session.drawing(780, 820)
    assert(model.file.value() == "Notes" && source.read(note)!.selected == true)
    assert(source.perform(note, Accessibility.Request(Accessibility.Action.deselect)))
    assert(model.file.value() == null)
    assert(source.perform(folder, Accessibility.Request(Accessibility.Action.collapse)))
    assert(source.read(note) == null && source.read(folder)!.expanded == false)
    assert(source.perform(panel, Accessibility.Request(Accessibility.Action.collapse)))
    assert(!model.details.value() && source.read(folder) == null)
    assert(source.perform(panel, Accessibility.Request(Accessibility.Action.expand)))
    assert(model.details.value() && source.read(folder)!.expanded == false)
    print("UIAccessibility CPU : OK")
}

test "the accessibility demo edits and activates the same model through Canvas Session" { check_cpu() }

func main() {
    for argument in Process.arguments() { if argument == "--cpu-check" { check_cpu(); return } }
    var model = Model()
    var session = UI.Session(UI.Reactive(model.describe))
    let code = Viewer.show(session, Viewer.CanvasSettings(width:780, height:820,
        title:"Silex — Accessibilité macOS J5"))
    if code != 0 { panic("Accessibility viewer failed") }
}
