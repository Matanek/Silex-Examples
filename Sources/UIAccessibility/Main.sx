use GFX.UI
use Module.InteractionTrace.TraceSession
use GFX.Canvas
use GFX.Accessibility
use GFX.Viewer
use GFX.Input.Events
use GFX.Input.Keyboard
use GFX.Window
use GFX.Color
use STD.Process
use STD.Math
use STD.Text.UTF8

package class Model {
    var placed:bool = false
    var complete:bool = false
    var tab:UI.State<str?> = UI.State<str?>("navigation")
    var choice:UI.State<str?> = UI.State<str?>("Rapide")
    var dialog:UI.State<bool> = UI.State<bool>(false)
    var name:UI.State<str> = UI.State<str>("Ada")
    var message:UI.State<str> = UI.State<str>("Aé👩‍💻中Z\nDeuxième ligne")
    var presses:UI.State<int> = UI.State<int>(0)
    var notifications:UI.State<bool> = UI.State<bool>(false)
    var profile:UI.State<str?> = UI.State<str?>("Calme")
    var volume:UI.State<float> = UI.State<float>(12.0)
    var locked:UI.State<bool> = UI.State<bool>(false)
    var details:UI.State<bool> = UI.State<bool>(true)
    var folders:UI.State<str[]> = UI.State<str[]>([])
    var file:UI.State<str?> = UI.State<str?>(null)
    var hidden_focus:UI.State<bool> = UI.State<bool>(false)
    var person:UI.State<str?> = UI.State<str?>(null)
    func open_dialog() { self.dialog.set(true) }
    func close_dialog() { self.dialog.set(false) }
    func compare_names(first:str, second:str) int {
        let left = UTF8.scalars(first); let right = UTF8.scalars(second); var index = 0
        while index < left.count() && index < right.count() {
            if left[index] < right[index] { return -1 }
            if left[index] > right[index] { return 1 }
            index++
        }
        return left.count()-right.count()
    }
    func activate() { self.presses.set(self.presses.value() + 1) }
    func toggle_focus() { self.hidden_focus.set(!self.hidden_focus.value()) }
    func file_key(value:str) str { return value }
    func file_children(value:str) str[] {
        if value == "Documents" { return ["Notes", "Rapport"] }
        return []
    }
    func file_row(value:str) UI.View { return UI.Text(value) }
    func team_cell(value:str) UI.View {
        if value == "Linus" { return UI.Text("Systèmes") }
        return UI.Text("Langages")
    }
    func volume_label(value:float) str { return "Volume : $(value) — plage de 10 à 20" }
    func describe(reads:UI.Reads) UI.View {
        var title = UI.Text("Accessibilité — macOS"); title.style.font_size = 28.0
        var slider = UI.Slider(self.volume, minimum:10.0, maximum:20.0)
        slider.style.disabled = reads.read(self.locked)
        var choices = UI.Style()
        var focus_label = "Masquer les contours des cases et radios"
        if reads.read(self.hidden_focus) {
            choices.focus = UI.FocusAppearance.none()
            focus_label = "Afficher les contours des cases et radios"
        }
        let profile = reads.read(self.profile) ?? "aucun"
        var tree = UI.TreeView<str>(["Documents", "Images"], self.file_key, self.file_children, self.file_row,
            selection:self.file, expanded:self.folders, smooth_scroll:true, scroll_chain:false)
        tree.style.height = 180.0
        var message = UI.TextArea(self.message, smooth_scroll:true, scroll_chain:false)
        message.style.height = 110.0
        var table = UI.TableView<str>(["Ada", "Linus", "Grace"], self.file_key, [
            UI.TableColumn<str>("name", "Personne", self.file_row, width:260.0, compare:self.compare_names),
            UI.TableColumn<str>("team", "Domaine", self.team_cell, width:220.0)
        ], selection:self.person, smooth_scroll:true, scroll_chain:false, stretch_last_column:true, full_height_resize:true)
        table.style.height = 190.0
        var nodes:UI.View[] = [
            title,
            UI.Text("Essayez les contrôles et l’option de contour. Tab conserve la navigation."),
            UI.Button(focus_label, self.toggle_focus),
            UI.Label("Nom", UI.TextField(self.name)),
            UI.Label("Message Unicode", message),
            UI.Button("Valider", self.activate),
            UI.Text("Nom courant : $(reads.read(self.name))"),
            UI.Text("Activations : $(reads.read(self.presses))"),
            UI.Checkbox("Notifications", self.notifications, style:choices),
            UI.Accessible(UI.RadioGroup<str>([
                UI.RadioOption<str>("Calme", "Calme"),
                UI.RadioOption<str>("Énergique", "Énergique"),
                UI.RadioOption<str>("Indisponible", "Indisponible", disabled:true)
            ], self.profile, style:choices), "Profil"),
            UI.Label("Volume", slider),
            UI.Checkbox("Verrouiller le volume", self.locked, style:choices),
            UI.Text("Notifications : $(reads.read(self.notifications)) · Profil : $(profile)"),
            UI.Text(self.volume, format:self.volume_label),
            UI.CollapsiblePanel("Fichiers", tree, self.details),
            UI.Text("Fichier sélectionné : $(reads.read(self.file) ?? "aucun")"),
            UI.Text("Équipe — 3 lignes, 2 colonnes"),
            UI.Accessible(table, "Équipe"),
            UI.Text("Personne sélectionnée : $(reads.read(self.person) ?? "aucune")")
        ]
        if self.complete {
            var action = UI.Command("Action de menu",self.activate)
            nodes.append(UI.Text("Complétion macOS — onglets, choix, menu et dialogue"))
            nodes.append(UI.Tabs([
                UI.Tab("navigation","Navigation",UI.Text("Premier panneau")),
                UI.Tab("preferences","Préférences",UI.Text("Second panneau"))
            ],self.tab))
            let options:UI.SelectOption<str>[] = [UI.SelectOption<str>("Rapide","Rapide"),UI.SelectOption<str>("Précis","Précis")]
            nodes.append(UI.Label("Mode de rendu",UI.Select<str>(options,self.choice)))
            nodes.append(UI.Label("Recherche de mode",UI.ComboBox<str>(options,self.choice)))
            nodes.append(UI.Menu("Actions macOS",[UI.MenuItem.command(action)]))
            nodes.append(UI.Toolbar([action]))
            nodes.append(UI.Tooltip(UI.Button("Aide",self.activate),UI.Text("Aide accessible du contrôle")))
            nodes.append(UI.Button("Ouvrir le dialogue",self.open_dialog))
            nodes.append(UI.Text("Choix courant : $(reads.read(self.choice) ?? "aucun")"))
        }
        var root = UI.Column(nodes)
        root.style.padding = UI.Insets(20.0); root.style.gap = 14.0
        root.style.theme = UI.Theme.dark()
        var page = UI.ScrollView(root, smooth_scroll:true)
        if !self.placed {
            if self.complete { return self.with_dialog(page) }
            return page
        }
        // The root receives the viewport. Size its child instead, leaving room
        // for the Viewer's positive position and anchor on both axes.
        page.style.relative_width = 0.9; page.style.relative_height = 0.9
        var frame = UI.Column([page])
        frame.style.padding = UI.Insets(top:0.0, right:48.0, bottom:32.0, left:0.0)
        if self.complete { return self.with_dialog(frame) }
        return frame
    }
    private func with_dialog(base:UI.View) UI.View {
        var content = UI.Column([UI.Text("Dialogue macOS"),UI.Button("Fermer le dialogue",self.close_dialog)])
        content.style.width = 360.0; content.style.padding = UI.Insets(20.0)
        content.style.theme = UI.Theme.dark(); content.style.background = Color.slate_900()
        return UI.Accessible(UI.Dialog(base,content,self.dialog),"Dialogue macOS")
    }
}

func presentation_settings(placed:bool, complete:bool = false) Viewer.CanvasSettings {
    var settings = Viewer.CanvasSettings(width:780, height:820, title:"Silex — Accessibilité macOS J5", show_fps:true)
    if placed {
        settings.position = Math.Vec2(24.0, 16.0); settings.anchor = Math.Vec2(0.05)
        settings.title = "Silex — Accessibilité macOS J5 · Placement ajusté"
    }
    if complete { settings.title = "Silex — Accessibilité macOS · Complétion" }
    return settings
}

package func named(source:Accessibility.Source, id:str, name:str, role:Accessibility.Role) str? {
    var semantics = source
    if let element = semantics.read(id) {
        if element.name == name && element.role == role { return id }
        var index = 0
        while index < element.child_count {
            if let child = semantics.child(id, index) {
                if let found = named(semantics, child, name, role) { return found }
            }
            index++
        }
    }
    return null
}

func visible_text(commands:Canvas.Command[]) int {
    var count = 0
    for command in commands { match command {
        text(value) => {
            let color = value.style.color
            assert(color.r > 0.5 && color.g > 0.5 && color.b > 0.5 && color.a > 0.0)
            count++
        }
        layer(value) => { count += visible_text(value.commands()) }
        else => {}
    } }
    return count
}

test "the dark accessibility demo paints readable labels instead of dark text on the viewer background" {
    var model = Model()
    var session = UI.Session(UI.Reactive(model.describe))
    var drawing = session.drawing(780, 820)
    assert(visible_text(drawing.commands()) >= 10)
}

func check_cpu(placed:bool = false) {
    var model = Model()
    model.placed = placed
    var session:Canvas.Session = UI.Session(UI.Reactive(model.describe))
    var drawing = session.drawing(780, 820)
    var source = session.accessibility_source()!
    let root = source.root()!
    let field = named(source, root, "Nom", Accessibility.Role.text_field)!
    let button = named(source, root, "Valider", Accessibility.Role.button)!
    assert(source.read(field)!.role == Accessibility.Role.text_field)
    assert(source.perform(field, Accessibility.Request(Accessibility.Action.focus)))
    assert(source.perform(field, Accessibility.Request(Accessibility.Action.set_value, text:"Été 👋")))
    assert(source.perform(button, Accessibility.Request(Accessibility.Action.activate)))
    drawing = session.drawing(780, 820)
    assert(model.name.value() == "Été 👋" && model.presses.value() == 1)
    assert(source.read(field)!.value == "Été 👋" && source.focused() == field)
    let check = named(source, root, "Notifications", Accessibility.Role.checkbox)!
    let radios = named(source, root, "Profil", Accessibility.Role.radio_group)!
    let calm = named(source, radios, "Calme", Accessibility.Role.radio)!
    let energetic = named(source, radios, "Énergique", Accessibility.Role.radio)!
    let unavailable = named(source, radios, "Indisponible", Accessibility.Role.radio)!
    assert(source.perform(check, Accessibility.Request(Accessibility.Action.activate)))
    assert(model.notifications.value() && source.read(check)!.checked == true)
    assert(source.perform(energetic, Accessibility.Request(Accessibility.Action.activate)))
    assert(model.profile.value() == "Énergique")
    assert(source.read(calm)!.checked == false && source.read(energetic)!.checked == true)
    assert(!source.read(unavailable)!.enabled)
    assert(!source.perform(unavailable, Accessibility.Request(Accessibility.Action.activate)))
    let slider = named(source, root, "Volume", Accessibility.Role.slider)!
    assert(source.read(slider)!.minimum == 10.0 && source.read(slider)!.maximum == 20.0)
    assert(source.perform(slider, Accessibility.Request(Accessibility.Action.increment)))
    assert(Math.abs(model.volume.value() - 12.1) < 0.001)
    assert(source.perform(slider, Accessibility.Request(Accessibility.Action.decrement)))
    assert(Math.abs(model.volume.value() - 12.0) < 0.001)
    assert(source.perform(slider, Accessibility.Request(Accessibility.Action.set_value, number:100.0)))
    assert(model.volume.value() == 20.0)
    let lock = named(source, root, "Verrouiller le volume", Accessibility.Role.checkbox)!
    assert(source.perform(lock, Accessibility.Request(Accessibility.Action.activate)))
    drawing = session.drawing(780, 820)
    assert(!source.read(slider)!.enabled)
    assert(!source.perform(slider, Accessibility.Request(Accessibility.Action.decrement)))
    assert(model.volume.value() == 20.0)
    let toggle = named(source, root, "Masquer les contours des cases et radios", Accessibility.Role.button)!
    assert(source.perform(toggle, Accessibility.Request(Accessibility.Action.activate)))
    drawing = session.drawing(780, 820)
    assert(model.hidden_focus.value() && visible_text(drawing.commands()) >= 10)
    assert(source.perform(toggle, Accessibility.Request(Accessibility.Action.activate)))
    assert(!model.hidden_focus.value())
    let label = source.read(field)!.labelled_by!
    assert(source.read(label)!.labels == field)
    let panel = named(source, root, "Fichiers", Accessibility.Role.button)!
    let folder = named(source, root, "Documents", Accessibility.Role.tree_item)!
    assert(source.read(folder)!.expanded == false)
    assert(source.perform(folder, Accessibility.Request(Accessibility.Action.expand)))
    assert(source.read(folder)!.expanded == true && source.read(folder)!.child_count == 2)
    let note = source.child(folder, 0)!
    assert(source.read(note)!.name == "Notes" && source.read(note)!.parent == folder)
    assert(source.perform(note, Accessibility.Request(Accessibility.Action.select)))
    drawing = session.drawing(780, 820)
    assert(model.file.value() == "Notes" && source.read(note)!.selected == true)
    assert(source.perform(note, Accessibility.Request(Accessibility.Action.deselect)))
    assert(model.file.value() == null)
    assert(source.perform(folder, Accessibility.Request(Accessibility.Action.collapse)))
    assert(source.read(note) == null && source.read(folder)!.expanded == false)
    assert(source.perform(panel, Accessibility.Request(Accessibility.Action.collapse)))
    assert(!model.details.value() && source.read(folder) == null)
    assert(source.perform(panel, Accessibility.Request(Accessibility.Action.expand)))
    assert(model.details.value() && source.read(folder)!.expanded == false)
    let table = named(source, root, "Équipe", Accessibility.Role.table)!
    assert(source.read(table)!.row_count == 3 && source.read(table)!.column_count == 2)
    var table_rows = source.rows(table)!
    assert(table_rows.count() == 3 && table_rows.row(3) == null)
    let row = table_rows.row(0)!
    assert(row == named(source, table, "", Accessibility.Role.row)!)
    assert(source.read(row)!.row_index == 0 && source.read(row)!.child_count == 2)
    let cell = source.child(row, 1)!
    assert(source.read(cell)!.column_index == 1 && source.read(cell)!.row_index == 0)
    assert(source.read(cell)!.name == "Domaine" && source.read(cell)!.value == "Langages")
    assert(source.perform(row, Accessibility.Request(Accessibility.Action.select)))
    drawing = session.drawing(780, 820)
    assert(model.person.value() == "Ada" && source.read(row)!.selected == true)
    let area = named(source, root, "Message Unicode", Accessibility.Role.text_area)!
    let original = model.message.value()
    assert(source.perform(area, Accessibility.Request(Accessibility.Action.focus)))
    assert(source.perform(area, Accessibility.Request(Accessibility.Action.set_text_selection, anchor:2, cursor:3)))
    assert(source.read(area)!.selection_anchor == 2 && source.read(area)!.selection_cursor == 3)
    let text_event = Events.Event.text_input(Events.TextInputEvent(window:Window.Id(value:1 as uint32),
        text:"🙂", timestamp:Events.Timestamp(nanoseconds:0 as uint)))
    assert(session.handle(text_event))
    assert(model.message.value() == "Aé🙂中Z\nDeuxième ligne")
    let undo = Events.Event.key_pressed(Events.KeyEvent(window:Window.Id(value:1 as uint32),
        keyboard:Keyboard.KeyboardId(value:0 as uint32), key:Keyboard.Key.z, keycode:0 as uint32,
        raw:0 as uint16, repeated:false, modifiers:Keyboard.Modifiers(system:true),
        timestamp:Events.Timestamp(nanoseconds:0 as uint)))
    assert(session.handle(undo) && model.message.value() == original)
    print("UIAccessibility CPU : OK")
}

test "the accessibility demo edits and activates the same model through Canvas Session" { check_cpu() }
test "the placed accessibility demo retains its controls and text editing" { check_cpu(true) }

func check_placed_geometry() {
    var model = Model(); model.placed = true
    var session = UI.Session(UI.Reactive(model.describe))
    var source = session.accessibility_source()!
    let settings = presentation_settings(true)
    let sizes:Math.Vec2[] = [Math.Vec2(780.0, 820.0), Math.Vec2(640.0, 620.0), Math.Vec2(1000.0, 900.0), Math.Vec2(780.0, 820.0)]
    var field_id:str? = null
    for size in sizes {
        var drawing = session.drawing(size.x as int, size.y as int)
        let root = source.root()!
        let page = source.read(named(source, root, "", Accessibility.Role.scroll_view)!)!.bounds
        let origin = Math.Vec2(settings.position.x + size.x * settings.anchor.x, settings.position.y + size.y * settings.anchor.y)
        assert(page.width > 0.0 && page.height > 0.0)
        assert(page.x + origin.x >= 0.0 && page.y + origin.y >= 0.0)
        assert(page.x + page.width + origin.x <= size.x + 0.001)
        assert(page.y + page.height + origin.y <= size.y + 0.001)
        let field = named(source, root, "Nom", Accessibility.Role.text_field)!
        if let previous = field_id { assert(field == previous) }
        field_id = field
        let bounds = source.read(field)!.bounds
        assert(bounds.width > 0.0 && bounds.x >= page.x)
        assert(bounds.x + bounds.width <= page.x + page.width + 0.001)
        let title = source.read(named(source, root, "Accessibilité — macOS", Accessibility.Role.text)!)!
        assert(!title.offscreen && title.bounds.y >= page.y)
    }
}
test "the placed accessibility page and field stay inside the resized window" { check_placed_geometry() }

func check_complete() {
    var model = Model(); model.complete = true
    var session = UI.Session(UI.Reactive(model.describe)); var drawing = session.drawing(780,820)
    var source = session.accessibility()
    let preferences = named(source,source.root()!,"Préférences",Accessibility.Role.tab)!
    assert(source.perform(preferences,Accessibility.Request(Accessibility.Action.activate)))
    assert(model.tab.value() == "preferences")
    let table = named(source,source.root()!,"Équipe",Accessibility.Role.table)!
    var columns = source.columns(table)!
    assert(columns.count() == 2 && source.read(columns.column(0)!)!.header != null)
    let open = named(source,source.root()!,"Ouvrir le dialogue",Accessibility.Role.button)!
    assert(source.perform(open,Accessibility.Request(Accessibility.Action.activate)))
    assert(model.dialog.value())
    assert(source.read(source.root()!)!.role == Accessibility.Role.dialog && source.read(source.root()!)!.name == "Dialogue macOS")
    assert(source.perform(source.root()!,Accessibility.Request(Accessibility.Action.dismiss)))
    assert(!model.dialog.value())
}

func main() {
    var complete = false
    var placed = false
    var trace = false
    var frame_trace = false
    for argument in Process.arguments() {
        if argument == "--cpu-check" { check_cpu(); check_cpu(true); check_placed_geometry(); check_complete(); return }
        if argument == "--placed" { placed = true }
        if argument == "--complete" { complete = true }
        if argument == "--trace-drag" { trace = true }
        if argument == "--trace-frame" { frame_trace = true }
    }
    var model = Model()
    model.placed = placed; model.complete = complete
    var session = UI.Session(UI.Reactive(model.describe))
    if frame_trace {
        var capture = Viewer.FrameTrace()
        var settings = presentation_settings(placed,complete); settings.frame_trace = capture
        let code = Viewer.show(session, settings)
        capture.report()
        if code != 0 { panic("Accessibility viewer failed") }
        return
    }
    if trace {
        var traced = TraceSession(session)
        let code = Viewer.show(traced, presentation_settings(placed,complete))
        traced.report()
        if code != 0 { panic("Accessibility viewer failed") }
        return
    }
    let code = Viewer.show(session, presentation_settings(placed,complete))
    if code != 0 { panic("Accessibility viewer failed") }
}
