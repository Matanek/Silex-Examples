use AI.BehaviourTree
use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Plugins
use GFX.Resources
use STD.Math
use STD.Process

static struct Demo {
    let width:int = 1100
    let height:int = 700
    let hud_width:int = 320
    let verification_frames:int = 540
    let verification_delta:float = 1.0 / 30.0
    let respawn_delay:float = 2.0
    let worker_speed:float = 105.0
    let guard_speed:float = 125.0
    let raider_speed:float = 92.0
    let wounded_health:float = 40.0
    let maximum_health:float = 100.0
    let no_guard_assignment:int = 0
    let tank_assignment:int = 1
    let support_assignment:int = 2
    let mine:Math.Vec2 = Math.Vec2(-350.0, 150.0)
    let storage:Math.Vec2 = Math.Vec2(-310.0, -150.0)
    let raider_camp:Math.Vec2 = Math.Vec2(165.0, 135.0)
}

enum Role {
    worker
    guard
    raider
}

enum Intent {
    idle
    mine
    gather
    haul
    deposit
    patrol
    frontline
    support
    raid
    attack
    retreat
    heal
    defeated
}

class Actor {
    let id:int
    let name:str
    let role:Role
    var position:Math.Vec2
    var health:float
    let maximum_health:float
    let attack_damage:float
    var alive:bool
    var intent:Intent
    var cargo:int
    var action_elapsed:float
    var patrol_target:int
    var guard_assignment:int
    var guard_assignment_changed:bool
    var rendered_health:int
    var rendered_cargo:int
    var rendered_guard_assignment:int
    var entity:ECS.Entity?
    var visual:Canvas

    init(
        id:int,
        name:str,
        role:Role,
        position:Math.Vec2,
        health:float = Demo.maximum_health,
        attack_damage:float = 0.0
    ) {
        self.id = id
        self.name = name
        self.role = role
        self.position = position
        self.health = health
        self.maximum_health = health
        self.attack_damage = attack_damage
        self.alive = true
        self.intent = Intent.idle
        self.cargo = 0
        self.action_elapsed = 0.0
        self.patrol_target = id % 2
        self.guard_assignment = Demo.no_guard_assignment
        self.guard_assignment_changed = false
        self.rendered_health = -1
        self.rendered_cargo = -1
        self.rendered_guard_assignment = -1
        self.entity = null
        self.visual = Canvas()
    }

    func drawing() Canvas { return self.visual }
}

class Battlefield {
    let verification:bool
    var actors:Actor[]
    var current_actor_index:int
    var delta:float
    var elapsed:float
    var hud_elapsed:float
    var villagers:Actor[]
    var workers:Actor[]
    var guards:Actor[]
    var raiders:Actor[]
    var hud:Canvas
    var next_actor_id:int
    var waves_spawned:int
    var respawn_remaining:float
    var definitions_built:int
    var instances_created:int
    var evaluations:int
    var interruptions:int
    var resources_gathered:int
    var resources_stored:int
    var deliveries:int
    var guard_hits:int
    var raider_hits:int
    var raiders_defeated:int
    var heals_completed:int
    var active_tank_id:int
    var tank_switches:int
    var maximum_recovering_guards:int

    init(verification:bool) {
        self.verification = verification
        self.actors = []
        self.current_actor_index = -1
        self.delta = 0.0
        self.elapsed = 0.0
        self.hud_elapsed = 1.0
        self.villagers = []
        self.workers = []
        self.guards = []
        self.raiders = []
        self.hud = Canvas()
        self.next_actor_id = 0
        self.waves_spawned = 0
        self.respawn_remaining = -1.0
        self.definitions_built = 0
        self.instances_created = 0
        self.evaluations = 0
        self.interruptions = 0
        self.resources_gathered = 0
        self.resources_stored = 0
        self.deliveries = 0
        self.guard_hits = 0
        self.raider_hits = 0
        self.raiders_defeated = 0
        self.heals_completed = 0
        self.active_tank_id = -1
        self.tank_switches = 0
        self.maximum_recovering_guards = 0
    }

    func hud_drawing() Canvas { return self.hud }
    func current_actor() Actor { return self.actors[self.current_actor_index] }
    func actor_at(index:int) Actor { return self.actors[index] }
}

struct UnitMind {
    let actor_index:int
}

func verification_mode() bool {
    match (try Process.arguments()) {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments { if argument == "--verify" { return true } }
        }
    }
    return false
}

func is_villager_wounded(mind:@Battlefield) bool {
    return mind.current_actor().role != Role.raider && mind.current_actor().health < Demo.wounded_health
}

func is_worker(mind:@Battlefield) bool { return mind.current_actor().role == Role.worker }
func is_guard(mind:@Battlefield) bool { return mind.current_actor().role == Role.guard }
func is_raider(mind:@Battlefield) bool { return mind.current_actor().role == Role.raider }
func is_active_tank(mind:@Battlefield) bool {
    return mind.current_actor().guard_assignment == Demo.tank_assignment
}
func is_support_guard(mind:@Battlefield) bool {
    return mind.current_actor().guard_assignment == Demo.support_assignment
}
func carries_resources(mind:@Battlefield) bool { return mind.current_actor().cargo > 0 }

func closest_alive(actors:@Actor[], origin:Math.Vec2) Actor? {
    var closest:Actor? = null
    var closest_distance = 1_000_000.0
    for actor in actors {
        if actor.alive {
            let distance = actor.position.distance(origin)
            if distance < closest_distance {
                closest = actor
                closest_distance = distance
            }
        }
    }
    return closest
}

func nearest_raider(mind:@Battlefield) Actor? {
    return closest_alive(mind.raiders, mind.current_actor().position)
}

func has_raider(mind:@Battlefield) bool { return nearest_raider(mind) != null }

func active_tank(mind:@Battlefield) Actor? {
    for guard in mind.guards {
        if guard.alive && guard.id == mind.active_tank_id { return guard }
    }
    return null
}

func raid_target(mind:@Battlefield) Actor? {
    return active_tank(mind)
}

func move_towards(actor:&Actor, target:Math.Vec2, speed:float, delta:float) bool {
    let offset = target.subtract(actor.position)
    let distance = offset.length()
    if distance <= 3.0 {
        actor.position = target
        return true
    }
    let step = speed * delta
    if step >= distance {
        actor.position = target
        return true
    }
    actor.position = actor.position.add(offset.normalized().multiply(step))
    return false
}

func retreat_to_storage(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.retreat
    var offset = Math.Vec2(-42.0, -58.0)
    if actor.role == Role.guard {
        let slot = actor.id % 3
        offset = Math.Vec2(-50.0 + slot as float * 38.0, -68.0)
    } elif actor.id % 2 == 1 {
        offset = Math.Vec2(18.0, -58.0)
    }
    let storage = Demo.storage
    if move_towards(actor, storage.add(offset), Demo.guard_speed, mind.delta) {
        return BehaviourTree.Status.success
    }
    return BehaviourTree.Status.running
}

func heal_at_storage(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.heal
    actor.health = Math.min(
        Demo.maximum_health,
        actor.health + 68.0 * mind.delta
    )
    if actor.health < Demo.maximum_health { return BehaviourTree.Status.running }
    actor.action_elapsed = 0.0
    mind.heals_completed++
    return BehaviourTree.Status.success
}

func walk_to_mine(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.mine
    var offset = Math.Vec2(-22.0, -42.0)
    if actor.id % 2 == 1 { offset = Math.Vec2(26.0, -42.0) }
    let mine = Demo.mine
    if move_towards(actor, mine.add(offset), Demo.worker_speed, mind.delta) {
        return BehaviourTree.Status.success
    }
    return BehaviourTree.Status.running
}

func gather_crystals(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.gather
    actor.action_elapsed += mind.delta
    if actor.action_elapsed < 1.0 { return BehaviourTree.Status.running }
    actor.action_elapsed = 0.0
    actor.cargo = 3
    mind.resources_gathered += 3
    return BehaviourTree.Status.success
}

func haul_to_storage(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.haul
    var offset = Math.Vec2(-35.0, -58.0)
    if actor.id % 2 == 1 { offset = Math.Vec2(10.0, -58.0) }
    let storage = Demo.storage
    if move_towards(actor, storage.add(offset), Demo.worker_speed, mind.delta) {
        return BehaviourTree.Status.success
    }
    return BehaviourTree.Status.running
}

func deposit_resources(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.deposit
    mind.resources_stored += actor.cargo
    actor.cargo = 0
    mind.deliveries++
    return BehaviourTree.Status.success
}

func patrol(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.patrol
    let lane = (actor.id % 3) as float
    var target = Math.Vec2(-185.0 + lane * 48.0, -38.0 + lane * 22.0)
    if actor.patrol_target == 1 {
        target = Math.Vec2(-62.0 + lane * 42.0, 92.0 - lane * 24.0)
    }
    if move_towards(actor, target, Demo.guard_speed * 0.55, mind.delta) {
        actor.patrol_target = 1 - actor.patrol_target
    }
    return BehaviourTree.Status.running
}

func defeat_raider(actor:&Actor, target:&Actor, mind:&Battlefield, damage:float, cooldown:float) bool {
    actor.action_elapsed -= mind.delta
    if actor.action_elapsed > 0.0 { return false }
    target.health -= damage
    actor.action_elapsed = cooldown
    mind.guard_hits++
    if target.health > 0.0 { return false }
    target.health = 0.0
    target.alive = false
    target.intent = Intent.defeated
    mind.raiders_defeated++
    actor.action_elapsed = 0.0
    return true
}

func hold_frontline(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.frontline
    if var target = nearest_raider(mind) {
        let front = target.position.add(Math.Vec2(-34.0, 0.0))
        let can_strike = actor.position.distance(target.position) <= 46.0
        if actor.position.distance(front) > 5.0 {
            move_towards(actor, front, Demo.guard_speed, mind.delta)
            if !can_strike { return BehaviourTree.Status.running }
        }
        if defeat_raider(actor, target, mind, 14.0, 0.55) {
            return BehaviourTree.Status.success
        }
        return BehaviourTree.Status.running
    }
    return BehaviourTree.Status.success
}

func support_frontline(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.support
    if var target = nearest_raider(mind) {
        var offset = Math.Vec2(-48.0, -42.0)
        if actor.id % 3 == 1 { offset = Math.Vec2(-48.0, 42.0) }
        elif actor.id % 3 == 2 { offset = Math.Vec2(-64.0, 0.0) }
        let formation = target.position.add(offset)
        let can_strike = actor.position.distance(target.position) <= 76.0
        if actor.position.distance(formation) > 5.0 {
            move_towards(actor, formation, Demo.guard_speed * 0.92, mind.delta)
            if !can_strike { return BehaviourTree.Status.running }
        }
        if defeat_raider(actor, target, mind, 12.0, 0.70) {
            return BehaviourTree.Status.success
        }
        return BehaviourTree.Status.running
    }
    return BehaviourTree.Status.success
}

func approach_village(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.raid
    if let target = raid_target(mind) {
        if actor.position.distance(target.position) <= 34.0 {
            return BehaviourTree.Status.success
        }
        move_towards(actor, target.position, Demo.raider_speed, mind.delta)
        return BehaviourTree.Status.running
    }
    return BehaviourTree.Status.failure
}

func attack_villager(mind:&Battlefield) BehaviourTree.Status {
    var actor = mind.current_actor()
    actor.intent = Intent.attack
    if let target = raid_target(mind) {
        if actor.position.distance(target.position) > 42.0 {
            return BehaviourTree.Status.failure
        }
        actor.action_elapsed -= mind.delta
        if actor.action_elapsed <= 0.0 {
            target.health -= actor.attack_damage
            if target.health < 10.0 { target.health = 10.0 }
            actor.action_elapsed = 0.65
            mind.raider_hits++
        }
        return BehaviourTree.Status.running
    }
    return BehaviourTree.Status.failure
}

func abandon_action(mind:&Battlefield) {
    var actor = mind.current_actor()
    actor.action_elapsed = 0.0
}

func unit_definition(battlefield:&Battlefield) BehaviourTree.Definition<Battlefield> {
    var builder = BehaviourTree.Builder<Battlefield>()
    builder.begin_selector("unit priorities")

    builder.begin_sequence("recover at storage")
    builder.condition("villager is wounded", is_villager_wounded)
    builder.action("retreat to storage", retreat_to_storage, abandon_action)
    builder.action("heal at storage", heal_at_storage, abandon_action)
    builder.end()

    builder.begin_sequence("worker routine")
    builder.condition("is a worker", is_worker)
    builder.begin_selector("deliver or gather")
    builder.begin_sequence("deliver cargo")
    builder.condition("is carrying crystals", carries_resources)
    builder.action("haul to storage", haul_to_storage, abandon_action)
    builder.action("deposit crystals", deposit_resources)
    builder.end()
    builder.begin_sequence("collect cargo")
    builder.action("walk to crystal mine", walk_to_mine, abandon_action)
    builder.action("gather crystals", gather_crystals, abandon_action)
    builder.end()
    builder.end()
    builder.end()

    builder.begin_sequence("guard routine")
    builder.condition("is a guard", is_guard)
    builder.begin_selector("defend or patrol")
    builder.begin_sequence("hold the frontline")
    builder.condition("raider detected", has_raider)
    builder.condition("is active tank", is_active_tank)
    builder.action("hold and strike", hold_frontline, abandon_action)
    builder.end()
    builder.begin_sequence("support the tank")
    builder.condition("raider detected", has_raider)
    builder.condition("is support guard", is_support_guard)
    builder.action("flank and strike", support_frontline, abandon_action)
    builder.end()
    builder.action("patrol village", patrol, abandon_action)
    builder.end()
    builder.end()

    builder.begin_sequence("raider routine")
    builder.condition("is a raider", is_raider)
    builder.action("approach village", approach_village, abandon_action)
    builder.action("attack villager", attack_villager, abandon_action)
    builder.end()
    builder.end()

    var definition:BehaviourTree.Definition<Battlefield>? = null
    match (try builder.build()) {
        success(value) => { definition = value }
        failure(_) => { panic("the RTS behaviour tree must be valid") }
    }
    battlefield.definitions_built++
    return definition!
}

func intent_label(intent:Intent) str {
    return match intent {
        idle => "choosing a task"
        mine => "walking to the mine"
        gather => "gathering crystals"
        haul => "hauling cargo"
        deposit => "depositing cargo"
        patrol => "patrolling"
        frontline => "tanking on the frontline"
        support => "supporting the tank"
        raid => "raiding the village"
        attack => "attacking a villager"
        retreat => "retreating to storage"
        heal => "healing at storage"
        defeated => "defeated"
    }
}

func role_color(role:Role) Color {
    return match role {
        worker => Color.amber_400()
        guard => Color.sky_400()
        raider => Color.rose_500()
    }
}

func actor_marker(actor:Actor) str {
    return match actor.role {
        worker => "W$(actor.id + 1)"
        guard => "G$(actor.id - 1)"
        raider => "R$(actor.id)"
    }
}

func redraw_actor(actor:Actor) {
    let body = role_color(actor.role)
    let health_ratio = actor.health / actor.maximum_health
    var health_color = Color.emerald_400()
    if health_ratio < 0.6 { health_color = Color.rose_400() }
    var drawing = actor.visual
    drawing.clear()
    drawing.paint(func(painter:&Canvas.Painter) {
        var font = Canvas.Font.default()
        if actor.role == Role.worker {
            painter.fill(Canvas.Circle(Math.Vec2(36.0, 31.0), 14.0), Canvas.Fill.solid(body))
            if actor.cargo > 0 {
                painter.fill(
                    Canvas.Circle(Math.Vec2(54.0, 31.0), 5.0),
                    Canvas.Fill.solid(Color.amber_100())
                )
            }
        } elif actor.role == Role.guard {
            painter.fill(
                Canvas.Rect(Math.Vec2(22.0, 17.0), Math.Vec2(28.0, 28.0)),
                Canvas.Fill.solid(Color.blue_500())
            )
            if actor.guard_assignment == Demo.tank_assignment {
                painter.stroke(
                    Canvas.Rect(Math.Vec2(18.0, 13.0), Math.Vec2(36.0, 36.0)),
                    Canvas.Stroke(Color.cyan_100(), 2.0)
                )
            }
        } else {
            var diamond = Canvas.Path()
                ..move_to(Math.Vec2(36.0, 14.0))
                ..line_to(Math.Vec2(53.0, 31.0))
                ..line_to(Math.Vec2(36.0, 48.0))
                ..line_to(Math.Vec2(19.0, 31.0))
                ..close()
            painter.fill(diamond, Canvas.Fill.solid(body))
        }
        painter.fill(
            Canvas.Rect(Math.Vec2(10.0, 4.0), Math.Vec2(52.0, 4.0), 2.0),
            Canvas.Fill.solid(Color.slate_800())
        )
        painter.fill(
            Canvas.Rect(Math.Vec2(10.0, 4.0), Math.Vec2(52.0 * health_ratio, 4.0), 2.0),
            Canvas.Fill.solid(health_color)
        )
        painter.text(
            actor_marker(actor),
            Math.Vec2(27.0, 53.0),
            Canvas.TextStyle(size:11.0, color:Color.white(), font:font)
        )
    })
    actor.rendered_health = Math.round(actor.health) as int
    actor.rendered_cargo = actor.cargo
    actor.rendered_guard_assignment = actor.guard_assignment
}

func background_drawing() Canvas {
    return Canvas()..paint(func(painter:&Canvas.Painter) {
        var font = Canvas.Font.default()
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(Demo.width as float, Demo.height as float)),
            Canvas.Fill.solid(Color.rgb(0.035, 0.075, 0.07))
        )
        painter.fill(
            Canvas.Rect(Math.Vec2(18.0, 92.0), Math.Vec2(744.0, 588.0), 18.0),
            Canvas.Fill.solid(Color.rgb(0.075, 0.145, 0.105))
        )
        var x = 48.0
        while x < 760.0 {
            painter.stroke(
                Canvas.Line(Math.Vec2(x, 110.0), Math.Vec2(x, 660.0)),
                Canvas.Stroke(Color.white().with_alpha(0.035), 1.0)
            )
            x += 48.0
        }
        var y = 116.0
        while y < 680.0 {
            painter.stroke(
                Canvas.Line(Math.Vec2(28.0, y), Math.Vec2(750.0, y)),
                Canvas.Stroke(Color.white().with_alpha(0.035), 1.0)
            )
            y += 48.0
        }
        painter.text(
            "BEHAVIOUR TREE · RTS VILLAGE",
            Math.Vec2(28.0, 24.0),
            Canvas.TextStyle(size:26.0, color:Color.white(), font:font)
        )
        painter.text(
            "Watch priorities change: work / patrol / raid → retreat → heal",
            Math.Vec2(30.0, 60.0),
            Canvas.TextStyle(size:15.0, color:Color.slate_300(), font:font)
        )
    })
}

func mine_drawing() Canvas {
    return Canvas()..paint(func(painter:&Canvas.Painter) {
        var font = Canvas.Font.default()
        painter.fill(Canvas.Circle(Math.Vec2(70.0, 52.0), 40.0), Canvas.Fill.solid(Color.slate_800()))
        painter.fill(Canvas.Circle(Math.Vec2(52.0, 46.0), 12.0), Canvas.Fill.solid(Color.cyan_300()))
        painter.fill(Canvas.Circle(Math.Vec2(74.0, 35.0), 15.0), Canvas.Fill.solid(Color.sky_400()))
        painter.fill(Canvas.Circle(Math.Vec2(89.0, 57.0), 11.0), Canvas.Fill.solid(Color.cyan_200()))
        painter.text("CRYSTAL MINE", Math.Vec2(18.0, 92.0), Canvas.TextStyle(size:14.0, color:Color.cyan_100(), font:font))
    })
}

func storage_drawing() Canvas {
    return Canvas()..paint(func(painter:&Canvas.Painter) {
        var font = Canvas.Font.default()
        painter.fill(
            Canvas.Rect(Math.Vec2(20.0, 26.0), Math.Vec2(125.0, 70.0), 10.0),
            Canvas.Fill.solid(Color.amber_800())
        )
        var roof = Canvas.Path()
            ..move_to(Math.Vec2(10.0, 34.0))
            ..line_to(Math.Vec2(82.0, 4.0))
            ..line_to(Math.Vec2(154.0, 34.0))
            ..close()
        painter.fill(roof, Canvas.Fill.solid(Color.orange_500()))
        painter.fill(
            Canvas.Rect(Math.Vec2(68.0, 58.0), Math.Vec2(28.0, 38.0), 4.0),
            Canvas.Fill.solid(Color.amber_200())
        )
        painter.fill(Canvas.Circle(Math.Vec2(129.0, 76.0), 13.0), Canvas.Fill.solid(Color.emerald_400()))
        painter.text("STORAGE + HEAL", Math.Vec2(17.0, 105.0), Canvas.TextStyle(size:14.0, color:Color.amber_100(), font:font))
    })
}

func camp_drawing() Canvas {
    return Canvas()..paint(func(painter:&Canvas.Painter) {
        var font = Canvas.Font.default()
        painter.fill(Canvas.Circle(Math.Vec2(66.0, 49.0), 40.0), Canvas.Fill.solid(Color.rose_950()))
        painter.stroke(Canvas.Circle(Math.Vec2(66.0, 49.0), 29.0), Canvas.Stroke(Color.rose_500(), 5.0))
        painter.fill(Canvas.Circle(Math.Vec2(66.0, 49.0), 10.0), Canvas.Fill.solid(Color.rose_400()))
        painter.text("RAIDER CAMP", Math.Vec2(15.0, 94.0), Canvas.TextStyle(size:14.0, color:Color.rose_200(), font:font))
    })
}

func active_raiders(battlefield:@Battlefield) int {
    var count = 0
    for raider in battlefield.raiders { if raider.alive { count++ } }
    return count
}

func paint_hud(battlefield:&Battlefield) {
    var drawing = battlefield.hud
    drawing.clear()
    drawing.paint(func(painter:&Canvas.Painter) {
        var font = Canvas.Font.default()
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(Demo.hud_width as float, Demo.height as float)),
            Canvas.Fill.solid(Color.slate_950().with_alpha(0.97))
        )
        painter.stroke(
            Canvas.Line(Math.Vec2(0.0, 0.0), Math.Vec2(0.0, Demo.height as float)),
            Canvas.Stroke(Color.slate_700(), 2.0)
        )
        painter.text("LIVE DECISIONS", Math.Vec2(24.0, 26.0), Canvas.TextStyle(size:20.0, color:Color.white(), font:font))
        painter.text("One shared tree · one instance per unit", Math.Vec2(24.0, 56.0), Canvas.TextStyle(size:12.0, color:Color.slate_400(), font:font))
        var tank_name = "none"
        if let tank = active_tank(battlefield) { tank_name = tank.name }
        painter.text("Tank: " + tank_name + " · rotations $(battlefield.tank_switches)", Math.Vec2(24.0, 76.0), Canvas.TextStyle(size:11.0, color:Color.cyan_200(), font:font))

        var y = 94.0
        for actor in battlefield.villagers {
            painter.fill(Canvas.Circle(Math.Vec2(29.0, y + 8.0), 6.0), Canvas.Fill.solid(role_color(actor.role)))
            painter.text(actor.name + "  HP $(Math.round(actor.health) as int)", Math.Vec2(44.0, y), Canvas.TextStyle(size:14.0, color:Color.slate_100(), font:font))
            painter.text("→ " + intent_label(actor.intent), Math.Vec2(44.0, y + 22.0), Canvas.TextStyle(size:12.0, color:Color.slate_400(), font:font))
            y += 58.0
        }

        painter.stroke(
            Canvas.Line(Math.Vec2(24.0, 397.0), Math.Vec2(296.0, 397.0)),
            Canvas.Stroke(Color.slate_700(), 1.0)
        )
        painter.text("RAID", Math.Vec2(24.0, 417.0), Canvas.TextStyle(size:14.0, color:Color.rose_300(), font:font))
        painter.text("Wave $(battlefield.waves_spawned) · $(active_raiders(battlefield)) alive", Math.Vec2(24.0, 443.0), Canvas.TextStyle(size:16.0, color:Color.white(), font:font))
        if active_raiders(battlefield) == 0 {
            painter.text("Next wave in $(Math.ceil(battlefield.respawn_remaining) as int) s", Math.Vec2(24.0, 469.0), Canvas.TextStyle(size:12.0, color:Color.slate_400(), font:font))
        } else {
            var raider_y = 469.0
            for raider in battlefield.raiders {
                if raider.alive {
                    painter.text(raider.name + "  HP $(Math.round(raider.health) as int) · " + intent_label(raider.intent), Math.Vec2(24.0, raider_y), Canvas.TextStyle(size:11.0, color:Color.rose_200(), font:font))
                    raider_y += 20.0
                }
            }
        }

        painter.fill(
            Canvas.Rect(Math.Vec2(20.0, 524.0), Math.Vec2(280.0, 145.0), 12.0),
            Canvas.Fill.solid(Color.slate_900())
        )
        painter.text("VILLAGE", Math.Vec2(36.0, 542.0), Canvas.TextStyle(size:13.0, color:Color.emerald_300(), font:font))
        painter.text("Stored crystals   $(battlefield.resources_stored)", Math.Vec2(36.0, 570.0), Canvas.TextStyle(size:15.0, color:Color.white(), font:font))
        painter.text("Deliveries        $(battlefield.deliveries)", Math.Vec2(36.0, 598.0), Canvas.TextStyle(size:14.0, color:Color.slate_300(), font:font))
        painter.text("Raiders defeated  $(battlefield.raiders_defeated)", Math.Vec2(36.0, 624.0), Canvas.TextStyle(size:14.0, color:Color.slate_300(), font:font))
        painter.text("Heals completed   $(battlefield.heals_completed)", Math.Vec2(36.0, 650.0), Canvas.TextStyle(size:14.0, color:Color.slate_300(), font:font))
    })
}

func spawn_actor(
    definition:@Resources.Behaviour<Battlefield>,
    world:&Resources.World,
    battlefield:&Battlefield,
    actor:Actor
) {
    redraw_actor(actor)
    let actor_index = battlefield.actors.count()
    battlefield.actors.append(actor)
    let entity = world.spawn(ECS.EntityRecipe()
        ..with(UnitMind(actor_index:actor_index))
        ..with(definition.instantiate())
        ..with(Components.BehaviourReady())
        ..with(Components.Transform2D(position:actor.position))
        ..with(Components.Canvas(actor.drawing(), 72, 68)..layer = 8)
    )
    actor.entity = entity
    battlefield.instances_created++
}

func spawn_villager(
    definition:@Resources.Behaviour<Battlefield>,
    world:&Resources.World,
    battlefield:&Battlefield,
    name:str,
    role:Role,
    position:Math.Vec2
) {
    var actor = Actor(battlefield.next_actor_id, name, role, position)
    battlefield.next_actor_id++
    battlefield.villagers.append(actor)
    if role == Role.worker { battlefield.workers.append(actor) }
    else { battlefield.guards.append(actor) }
    spawn_actor(definition, world, battlefield, actor)
}

func spawn_wave(
    definition:@Resources.Behaviour<Battlefield>,
    world:&Resources.World,
    battlefield:&Battlefield
) {
    battlefield.waves_spawned++
    battlefield.respawn_remaining = -1.0
    var count = 1
    if battlefield.waves_spawned % 2 == 0 { count = 2 }
    var health = 160.0
    var attack_damage = 14.0
    if count > 1 {
        health = 110.0
        attack_damage = 8.0
    }
    for index in 0...count {
        let position = Math.Vec2(165.0, 101.0 + index as float * 68.0)
        var actor = Actor(
            battlefield.next_actor_id,
            "RAIDER $(battlefield.next_actor_id)",
            Role.raider,
            position,
            health,
            attack_damage
        )
        battlefield.next_actor_id++
        battlefield.raiders.append(actor)
        spawn_actor(definition, world, battlefield, actor)
    }
}

func setup_scene(
    definition:@Resources.Behaviour<Battlefield>,
    world:&Resources.World,
    battlefield:&Battlefield
) {
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Camera2D())
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Canvas(background_drawing(), Demo.width, Demo.height)
            ..layer = -20
        )
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Demo.mine))
        ..with(Components.Canvas(mine_drawing(), 140, 112)..layer = 1)
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Demo.storage))
        ..with(Components.Canvas(storage_drawing(), 164, 124)..layer = 1)
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Demo.raider_camp))
        ..with(Components.Canvas(camp_drawing(), 132, 108)..layer = 1)
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Canvas(battlefield.hud_drawing(), Demo.hud_width, Demo.height)
            ..space = Components.CanvasSpace.viewport
            ..anchor = Math.Vec2(1.0, 0.0)
            ..pivot = Math.Vec2(1.0, 0.0)
            ..layer = 20
        )
    )

    spawn_villager(definition, world, battlefield, "WORKER 1", Role.worker, Math.Vec2(-355.0, -115.0))
    spawn_villager(definition, world, battlefield, "WORKER 2", Role.worker, Math.Vec2(-262.0, -130.0))
    spawn_villager(definition, world, battlefield, "GUARD 1", Role.guard, Math.Vec2(-155.0, -55.0))
    spawn_villager(definition, world, battlefield, "GUARD 2", Role.guard, Math.Vec2(-105.0, 5.0))
    spawn_villager(definition, world, battlefield, "GUARD 3", Role.guard, Math.Vec2(-55.0, 65.0))
    spawn_wave(definition, world, battlefield)
    paint_hud(battlefield)
}

func advance_game(time:@Resources.FrameTime, battlefield:&Battlefield) {
    if battlefield.verification { battlefield.delta = Demo.verification_delta }
    else { battlefield.delta = time.delta }
    battlefield.elapsed += battlefield.delta
    battlefield.hud_elapsed += battlefield.delta
}

func update_waves(
    definition:@Resources.Behaviour<Battlefield>,
    world:&Resources.World,
    battlefield:&Battlefield
) {
    if active_raiders(battlefield) > 0 { return }
    if battlefield.respawn_remaining < 0.0 {
        battlefield.respawn_remaining = Demo.respawn_delay
        return
    }
    battlefield.respawn_remaining -= battlefield.delta
    if battlefield.respawn_remaining <= 0.0 {
        spawn_wave(definition, world, battlefield)
    }
}

func coordinate_guards(battlefield:&Battlefield) {
    let raiders_are_active = active_raiders(battlefield) > 0
    var recovering_guards = 0
    for guard in battlefield.guards {
        if guard.intent == Intent.retreat || guard.intent == Intent.heal {
            recovering_guards++
        }
    }
    if raiders_are_active && recovering_guards > battlefield.maximum_recovering_guards {
        battlefield.maximum_recovering_guards = recovering_guards
    }
    let previous_tank_id = battlefield.active_tank_id + 0
    var next_tank_id = previous_tank_id + 0
    var current_is_ready = false
    if raiders_are_active {
        for guard in battlefield.guards {
            if guard.alive && guard.id == next_tank_id &&
                guard.health >= Demo.wounded_health &&
                guard.intent != Intent.retreat && guard.intent != Intent.heal
            {
                current_is_ready = true
            }
        }
        if !current_is_ready {
            next_tank_id = -1
            var best_health = Demo.wounded_health - 1.0
            for guard in battlefield.guards {
                if guard.alive && guard.health >= Demo.wounded_health &&
                    guard.intent != Intent.retreat && guard.intent != Intent.heal &&
                    guard.health > best_health
                {
                    next_tank_id = guard.id
                    best_health = guard.health
                }
            }
        }
    } else {
        next_tank_id = -1
    }

    if previous_tank_id >= 0 && next_tank_id >= 0 &&
        previous_tank_id != next_tank_id
    {
        battlefield.tank_switches++
    }
    battlefield.active_tank_id = next_tank_id

    for guard in battlefield.guards {
        var assignment = Demo.no_guard_assignment
        if raiders_are_active {
            assignment = Demo.support_assignment
            if guard.id == next_tank_id { assignment = Demo.tank_assignment }
        }
        if guard.guard_assignment != assignment {
            guard.guard_assignment = assignment
            guard.guard_assignment_changed = true
        }
    }
}

func replan_priorities(
    battlefield:&Battlefield,
    query:ECS.Query<(&Components.Behaviour<Battlefield>, &UnitMind)>
) {
    for (behaviour, mind) in query {
        battlefield.current_actor_index = mind.actor_index
        var interrupt = false
        if is_villager_wounded(battlefield) &&
            battlefield.current_actor().intent != Intent.retreat &&
            battlefield.current_actor().intent != Intent.heal
        {
            interrupt = true
        }
        if battlefield.current_actor().role == Role.guard && has_raider(battlefield) &&
            battlefield.current_actor().intent == Intent.patrol
        {
            interrupt = true
        }
        if battlefield.current_actor().role == Role.guard &&
            battlefield.current_actor().guard_assignment_changed
        {
            var guard = battlefield.current_actor()
            guard.guard_assignment_changed = false
            interrupt = true
        }
        if interrupt {
            behaviour.interrupt(battlefield)
            battlefield.interruptions++
        }
    }
}

func run_behaviours(
    battlefield:&Battlefield,
    query:ECS.Query<(
        &Components.Behaviour<Battlefield>,
        &UnitMind,
        @Components.BehaviourReady
    )>
) {
    for (behaviour, mind, ready) in query {
        battlefield.current_actor_index = mind.actor_index
        if !battlefield.current_actor().alive { continue }
        battlefield.evaluations++
        let status = behaviour.evaluate(battlefield)
        if status != BehaviourTree.Status.running { behaviour.reset() }
    }
}

func cleanup_defeated(world:&Resources.World, battlefield:&Battlefield) {
    for raider in battlefield.raiders {
        if !raider.alive {
            if let entity = raider.entity {
                if world.is_alive(entity) { world.destroy(entity) }
                raider.entity = null
            }
        }
    }
}

func present_units(
    battlefield:&Battlefield,
    query:ECS.Query<(@UnitMind, &Components.Transform2D)>
) {
    for (mind, transform) in query {
        var actor = battlefield.actor_at(mind.actor_index)
        transform.position = actor.position
        if actor.rendered_health != Math.round(actor.health) as int ||
            actor.rendered_cargo != actor.cargo ||
            actor.rendered_guard_assignment != actor.guard_assignment
        {
            redraw_actor(actor)
        }
    }
    if battlefield.hud_elapsed >= 0.1 {
        battlefield.hud_elapsed = 0.0
        paint_hud(battlefield)
    }
}

func run_verification(application:Application) int {
    application.run_schedule(Application.Schedule.initialize)
    application.run_schedule(Application.Schedule.startup)
    for frame in 0...Demo.verification_frames {
        application.run_schedule(Application.Schedule.pre_update)
        application.run_schedule(Application.Schedule.update)
        application.run_schedule(Application.Schedule.post_update)
        if frame % 30 == 0 { application.run_schedule(Application.Schedule.render) }
    }
    application.run_schedule(Application.Schedule.shutdown)
    application.run_schedule(Application.Schedule.finalize)
    return 0
}

func verify(battlefield:@Battlefield) {
    assert(battlefield.definitions_built == 1)
    assert(battlefield.villagers.count() == 5)
    assert(battlefield.workers.count() == 2)
    assert(battlefield.guards.count() == 3)
    assert(battlefield.instances_created > 5)
    assert(battlefield.waves_spawned >= 2)
    assert(battlefield.resources_gathered > 0)
    assert(battlefield.resources_stored > 0)
    assert(battlefield.deliveries > 0)
    assert(battlefield.guard_hits > 0)
    assert(battlefield.raider_hits > 0)
    assert(battlefield.raiders_defeated > 0)
    assert(battlefield.heals_completed > 0)
    assert(battlefield.tank_switches > 0)
    assert(battlefield.maximum_recovering_guards < battlefield.guards.count())
    assert(battlefield.interruptions > 0)
    assert(battlefield.evaluations > Demo.verification_frames)
}

func main() {
    let verification = verification_mode()
    var battlefield = Battlefield(verification)
    var definition = unit_definition(battlefield)
    var application = Application()
        ..add_resource(definition)
        ..add_resource(battlefield)
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Behaviour Tree RTS Village"
            ..width = Demo.width
            ..height = Demo.height
            ..hidden = verification
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.ECS())
        ..add_plugin(Plugins.Time())
        ..add_plugin(Plugins.FramePacing(60))
        ..add_system(Application.Schedule.startup, setup_scene)
        ..add_system(Application.Schedule.update, advance_game)
        ..add_system(Application.Schedule.update, update_waves)
        ..add_system(Application.Schedule.update, coordinate_guards)
        ..add_system(Application.Schedule.update, replan_priorities)
        ..add_system(Application.Schedule.update, run_behaviours)
        ..add_system(Application.Schedule.update, cleanup_defeated)
        ..add_system(Application.Schedule.update, present_units)

    if verification { application.with_runner(run_verification) }

    assert(application.run() == 0)
    if verification { verify(battlefield) }
}
