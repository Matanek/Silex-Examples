use Package.Platformer2D.Player
use Package.Platformer2D.Level
use GFX.Application
use GFX.Assets.Image
use GFX.ECS
use GFX.Nodes
use GFX.Physics
use GFX.Plugins
use STD.Math

func step(app:Application) {
    var resources = app.resources()
    var time = resources.get_mut<Application.FrameTime>()
    time.delta = 1.0 / 120.0
    app.run_schedule(Application.Schedule.update)
    app.run_schedule(Application.Schedule.post_update)
}

func verify_course() {
    var images = Image.Store()
    let image = images.add(Image())
    var level = Level(image)
    var player = Player(image)
    var root = Nodes.Node()
    root.add_child(level)
    root.add_child(player)
    var app = Application()
        ..add_plugin(Plugins.Physics2D(Plugins.Physics2D.Settings()
            ..scene_units_per_meter = 18.0..fixed_delta = 1.0 / 120.0
            ..world = (Physics.World2DSettings()..gravity = Math.Vec2())))
        ..add_plugin(Plugins.Nodes(root))
    app.run_schedule(Application.Schedule.startup)
    for _ in 0...90 { step(app) }
    assert(player.is_grounded())
    assert(player.position.y > 63.0 && player.position.y < 65.0)
    assert(app.resources().get<Physics.World2D>().body_count() == 2)
    let thresholds = [222.0, 615.0, 756.0]
    var next_jump = 0
    var maximum_height = 0.0
    for _ in 0...1200 {
        var jump = false
        if next_jump < thresholds.count() && player.position.x >= thresholds[next_jump] && player.is_grounded() {
            jump = true
            next_jump++
        }
        player.control(1.0, true, jump)
        step(app)
        maximum_height = Math.max(maximum_height, player.position.y)
        level.update(player.position, 1.0 / 120.0)
        assert(player.position.y > 0.0)
        if level.won() { break }
    }
    assert(next_jump == 3)
    assert(maximum_height > 130.0)
    assert(level.won())
    assert(level.score() > 0 && level.score() <= level.coin_count())
    level.reset()
    player.reset()
    step(app)
    assert(!level.won() && level.score() == 0)
    assert(player.position.x < 60.0)
    app.run_schedule(Application.Schedule.shutdown)
    assert(app.resources().get<Physics.World2D>().body_count() == 0)
}


test "land, jump both gaps, climb terrain, collect coins and reach the flag" { verify_course() }
func main() { verify_course(); print("Platformer2D course passed") }
