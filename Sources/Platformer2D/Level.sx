use Module.Art
use GFX.Assets.Image
use GFX.Nodes
use GFX.Scene2D
use STD.Math

public class Level:Nodes.Node2D {
    private var coins:Nodes.Sprite2D[] = []
    private var flag:Nodes.Sprite2D
    private var elapsed:float = 0.0
    private var collected:int = 0
    private var completed:bool = false

    init(image:Image.Handle):super("Level") {
        let atlas = Scene2D.TileAtlas(image, 18, 18)
        var ground = Nodes.TileMap2D(atlas, 72, 14, "Solid terrain", layer:-10)
        ground.collision_enabled = true
        // Kenney grass corners/edge, dirt sides/center, and lower border.
        let grass = Scene2D.TilePatch(21, 22, 23, 121, 122, 123, 141, 142, 143)
        ground.fill(0, 0, 16, 3, grass)
        ground.fill(19, 0, 17, 3, grass)
        ground.fill(39, 0, 33, 3, grass)
        // The green panel really is a contiguous 3 x 3 block in the atlas.
        let green = Scene2D.TilePatch.atlas(17, 20)
        ground.fill(7, 5, 5, 2, green)
        ground.fill(24, 5, 5, 2, green)
        ground.fill(44, 3, 5, 2, green)
        ground.fill(51, 5, 5, 2, green)
        self.add_child(ground)
        var scenery = Nodes.TileMap2D(atlas, 72, 14, "Scenery", layer:-20)
        for column in [2, 5, 13, 20, 32, 40, 59, 64, 69] { scenery.set(column, 3, 124) }
        self.add_child(scenery)
        let positions:Math.Vec2[] = [Math.Vec2(117.0, 72.0), Math.Vec2(171.0, 144.0),
            Math.Vec2(252.0, 72.0), Math.Vec2(378.0, 72.0), Math.Vec2(477.0, 144.0),
            Math.Vec2(603.0, 72.0), Math.Vec2(747.0, 72.0), Math.Vec2(837.0, 108.0),
            Math.Vec2(963.0, 144.0), Math.Vec2(1089.0, 72.0)]
        for position in positions {
            var coin = Art.sprite(image, 151, position)
            self.coins.append(coin)
            self.add_child(coin)
        }
        self.flag = Art.sprite(image, 111, Math.Vec2(1224.0, 81.0))
        self.add_child(self.flag)
        self.add_child(Art.sprite(image, 109, Math.Vec2(1224.0, 63.0)))
    }

    func score() int { return self.collected }
    func coin_count() int { return self.coins.count() }
    func won() bool { return self.completed }

    func reset() {
        self.collected = 0
        self.completed = false
        var index = 0
        while index < self.coins.count() {
            var coin = self.coins[index]
            coin.visible = true
            index++
        }
    }

    func update(player_position:Math.Vec2, delta:float) {
        self.elapsed += delta
        var index = 0
        let frame = Math.floor(self.elapsed * 5.0) as int % 2
        while index < self.coins.count() {
            var coin = self.coins[index]
            if coin.visible {
                coin.region(Art.tile_region(151 + frame))
                if coin.position.subtract(player_position).length_squared() < 17.0 * 17.0 {
                    coin.visible = false
                    self.collected++
                }
            }
            index++
        }
        self.flag.region(Art.tile_region(111 + frame))
        if Math.abs(player_position.x - 1224.0) < 16.0 && player_position.y < 105.0 {
            self.completed = true
        }
    }
}
