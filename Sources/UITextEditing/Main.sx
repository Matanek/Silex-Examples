use GFX.UI
use GFX.Canvas
use GFX.Canvas.Command.Text as CanvasText
use GFX.Input.Events
use GFX.Input.Keyboard
use GFX.Input.Pointer
use STD.Math
use GFX.UI.Input as UIInput
use GFX.Viewer
use GFX.Window
use GFX.Window.Cursor
use STD.Process

func long_line() str {
    var value = ""
    for index in 0...8 { value += "Été été · 世界 · 👩‍💻 · mots séparés\u{a0}par un espace Unicode. " }
    return value
}
func paragraphs() str {
    var value = "Première ligne : éditez, sélectionnez puis annulez."
    for index in 0...14 { value += "\nLigne $(index + 2) : café été 👩‍💻 — le caret reste visible." }
    return value
}
class EditingForm {
    var short:UI.State<str> = UI.State<str>("Silex — été 👩‍💻")
    var long:UI.State<str> = UI.State<str>(long_line())
    var area:UI.State<str> = UI.State<str>(paragraphs())
    var bright:UI.State<bool> = UI.State<bool>(false)
    var touch_mode:UI.State<bool> = UI.State<bool>(false)
    var smooth:UI.State<bool> = UI.State<bool>(true)
    var scroll_chain:UI.State<bool> = UI.State<bool>(false)
    var page_scroll:UI.ScrollState = UI.ScrollState(0.0)
    var changes:UI.State<int> = UI.State<int>(0)
    var short_focus:UI.Focus = UI.Focus()
    var long_focus:UI.Focus = UI.Focus()
    var area_focus:UI.Focus = UI.Focus()
    func edited(value:str) { self.changes.set(self.changes.value() + 1) }
    func toggle_theme() { self.bright.set(!self.bright.value()) }
    func reset() {
        self.short.set("Silex — été 👩‍💻"); self.long.set(long_line()); self.area.set(paragraphs())
    }
    func focus_short() { self.short_focus.request() }
    func focus_long() { self.long_focus.request() }
    func focus_area() { self.area_focus.request() }
    func describe(reads:UI.Reads) UI.View {
        var theme = UI.Theme.dark(); if reads.read(self.bright) { theme = UI.Theme.light() }
        var style = UI.Style(); style.height = 44.0; style.padding = UI.Insets(10.0)
        let smooth = reads.read(self.smooth); let chain = reads.read(self.scroll_chain)
        var short = UI.TextField(self.short, on_change:self.edited, style:style,smooth_scroll:smooth,scroll_chain:chain)
        var long = UI.TextField(self.long, on_change:self.edited, style:style,smooth_scroll:smooth,scroll_chain:chain)
        var area = UI.TextArea(self.area, on_change:self.edited, style:style,smooth_scroll:smooth,scroll_chain:chain); area.style.height = 200.0
        var touch_hint = "F4 : simulation tactile à la souris. Tap : caret ; maintien : mot ; poignées : sélection."
        if reads.read(self.touch_mode) { touch_hint = "SIMULATION TACTILE — souris = doigt ; glissez le texte pour défiler, Échap annule le geste." }
        var root = UI.Column([
            UI.Text("Édition de texte — historique, IME et tactile"),
            UI.Text(touch_hint),
            UI.Text("Cmd/Ctrl+Z : annuler · Maj+Cmd/Ctrl+Z ou Ctrl+Y : rétablir."),
            UI.Text("Option/Ctrl+flèches : mots · ajouter Maj pour sélectionner."),
            UI.Text("Glissez hors du champ et maintenez sans bouger ; relâchez pour arrêter."),
            UI.Text("Option/Ctrl+retour arrière : effacer un mot · F2 : thème · F3 : réinitialiser."),
            UI.Row([UI.Button("Clair / sombre",self.toggle_theme,style:style),
                UI.Button("Valeurs initiales",self.reset,style:style)],wrap:true),
            UI.Row([UI.Button("Champ court",self.focus_short,style:style),
                UI.Button("Ligne longue",self.focus_long,style:style),
                UI.Button("Texte multiligne",self.focus_area,style:style)],wrap:true),
            UI.Text("IME : activez une saisie japonaise ou chinoise, composez puis validez ou annulez."),
            UI.Text("Le texte provisoire est souligné ; les notifications attendent sa validation."),
            UI.Row([UI.Checkbox("Défilement lissé",self.smooth),
                UI.Checkbox("Transférer le scroll à la page",self.scroll_chain)],wrap:true),
            UI.Text("Champ court : accents combinés et emoji"),
            UI.Keyed("short",UI.FocusTarget(self.short_focus,short)),
            UI.Text("Ligne longue : sélectionnez et vérifiez le défilement"),
            UI.Keyed("long",UI.FocusTarget(self.long_focus,long)),
            UI.Text("Texte multiligne : modifiez plusieurs lignes puis annulez"),
            UI.Keyed("area",UI.FocusTarget(self.area_focus,area)),
            UI.Text("Notifications d’édition, undo et redo : $(reads.read(self.changes))"),
            UI.Text("Changer de thème conserve l’historique. Une valeur externe différente le réinitialise.")
        ])
        root.style.padding = UI.Insets(20.0); root.style.gap = 10.0
        var viewport = UI.ScrollView(root,state:self.page_scroll,smooth_scroll:smooth); viewport.style.theme = theme
        return viewport
    }
}
class EditingSession:Canvas.Session {
    var form:EditingForm = EditingForm()
    private var runtime:UI.Runtime?
    private var width:int = 0
    private var height:int = 0
    private var last_touch:Math.Vec2 = Math.Vec2()
    init(simulated:bool = false) {
        self.form.touch_mode.set(simulated)
        self.runtime = UI.Runtime(UI.Reactive(self.form.describe))
    }
    func ui() UI.Runtime { return self.runtime! }
    func drawing(width:int,height:int) Canvas {
        self.width = width; self.height = height
        return self.ui().drawing(width,height)
    }
    func update(delta:float) bool { return self.ui().update(delta) }
    func accepts_text_input() bool { return self.ui().accepts_text_input() }
    func text_input_target() Canvas.TextInputTarget? { return self.ui().text_input_target() }
    func pointer_cursor() Cursor { return self.ui().pointer_cursor() }
    func handle(event:@Events.Event) bool {
        match event { key_pressed(value) => {
            if !value.repeated && value.key == Keyboard.Key.f4 {
                var runtime = self.ui()
                let canceled = UIInput.handle(runtime,Events.Event.finger_canceled(self.simulated_contact(self.last_touch)))
                self.form.touch_mode.set(!self.form.touch_mode.value()); return true
            }
            if !value.repeated && value.key == Keyboard.Key.escape && self.form.touch_mode.value() {
                var runtime = self.ui()
                if UIInput.handle(runtime,Events.Event.finger_canceled(self.simulated_contact(self.last_touch))) { return true }
            }
            if !value.repeated && value.key == Keyboard.Key.f2 { self.form.toggle_theme(); return true }
            if !value.repeated && value.key == Keyboard.Key.f3 { self.form.reset(); return true }
        }; else => {} }
        var runtime = self.ui()
        if self.form.touch_mode.value() && self.width > 0 && self.height > 0 {
            match event {
                mouse_moved(value) => {
                    if value.mouse.is_touch() { return false }
                    self.last_touch = value.position
                    return UIInput.handle(runtime,Events.Event.finger_moved(self.simulated_contact(value.position)))
                }
                mouse_button_pressed(value) => {
                    if value.mouse.is_touch() { return false }
                    if value.button == Pointer.MouseButton.left {
                        self.last_touch = value.position
                        return UIInput.handle(runtime,Events.Event.finger_pressed(self.simulated_contact(value.position)))
                    }
                }
                mouse_button_released(value) => {
                    if value.mouse.is_touch() { return false }
                    if value.button == Pointer.MouseButton.left {
                        self.last_touch = value.position
                        return UIInput.handle(runtime,Events.Event.finger_released(self.simulated_contact(value.position)))
                    }
                }
                else => {}
            }
        }
        return UIInput.handle(runtime,event)
    }
    private func simulated_contact(point:Math.Vec2) Events.TouchEvent {
        let width = Math.max(1.0,self.width as float); let height = Math.max(1.0,self.height as float)
        return Events.TouchEvent(touch:Events.TouchId(value:42 as uint),finger:Events.FingerId(value:1 as uint),
            window:Window.Id(value:1 as uint32),position:Math.Vec2(point.x / width,point.y / height),
            delta:Math.Vec2(),pressure:1.0,timestamp:Events.Timestamp(nanoseconds:1 as uint))
    }
    func check_wheel() {
        self.form.area_focus.request()
        let focused = self.update(0.0)
        var drawing = self.drawing(900,760)
        let line = "Ligne 15 : café été 👩‍💻 — le caret reste visible."
        let command = find_text_command(drawing.commands(),line)!
        let point = Math.Vec2(command.position.x + 2.0,command.position.y + 3.0)
        let notifications = self.form.changes.value(); let original = self.form.area.value()
        var runtime = self.ui()
        assert(runtime.pointer_scrolled(point,Math.Vec2(0.0,0.1)))
        drawing = self.drawing(900,760)
        assert(find_text_command(drawing.commands(),line)!.position == command.position)
        let advanced = self.update(1.0 / 120.0); drawing = self.drawing(900,760)
        let moved = find_text_command(drawing.commands(),line)!.position
        assert(moved.y > command.position.y && moved.y < command.position.y + 4.8)
        let settled = self.update(1.0); drawing = self.drawing(900,760)
        assert(runtime.pointer_scrolled(point,Math.Vec2(0.0,-1000.0)))
        let at_end = self.update(1.0); drawing = self.drawing(900,760)
        let page = self.form.page_scroll.offset()
        assert(!runtime.pointer_scrolled(point,Math.Vec2(0.0,-1.0)))
        assert(self.form.page_scroll.offset() == page)
        assert(runtime.pointer_scrolled(Math.Vec2(4.0,4.0),Math.Vec2(0.0,0.25)))
        assert(self.form.page_scroll.offset() == page)
        let page_frame = self.update(1.0 / 120.0)
        assert(self.form.page_scroll.offset() < page)
        let page_settled = self.update(1.0); drawing = self.drawing(900,760)
        let current = find_text_command(drawing.commands(),line)!
        self.form.scroll_chain.set(true); let enabled = self.update(0.0)
        drawing = self.drawing(900,760)
        let before = self.form.page_scroll.offset()
        assert(runtime.pointer_scrolled(Math.Vec2(current.position.x + 2.0,current.position.y + 3.0),Math.Vec2(0.0,-0.25)))
        let transferred = self.update(1.0)
        assert(self.form.page_scroll.offset() > before)
        assert(self.form.area.value() == original && self.form.changes.value() == notifications)
    }
    func check_touch() {
        self.form.touch_mode.set(true)
        var drawing = self.drawing(900,760)
        let original = self.form.short.value()
        let command = find_text_command(drawing.commands(),original)!
        let point = Math.Vec2(command.position.x + 2.0,command.position.y + 8.0)
        let notifications = self.form.changes.value()
        assert(self.handle(mouse_button_event(point,true)))
        let held = self.update(0.5); drawing = self.drawing(900,760)
        let bubbles = touch_handle_count(drawing.commands())
        assert(bubbles == 2 && self.form.short.value() == original && self.form.changes.value() == notifications)
        assert(self.handle(mouse_button_event(point,false)))
        var runtime = self.ui()
        assert(runtime.key_pressed(Keyboard.Key.f1))
        drawing = self.drawing(900,760); assert(touch_handle_count(drawing.commands()) == 0)
        assert(!runtime.key_pressed(Keyboard.Key.f1))
        assert(runtime.insert_text("X"))
        assert(self.form.short.value() == "X — été 👩‍💻" && self.form.changes.value() == notifications + 1)
        assert(runtime.key_pressed(Keyboard.Key.z,Keyboard.Modifiers(system:true)))
        assert(self.form.short.value() == original)
    }
    func check_selection() {
        var drawing = self.drawing(900,760)
        let original = self.form.long.value()
        let bounds = long_text_bounds(drawing,original)
        let inside = Math.Vec2(bounds.position.x + 2.0,bounds.position.y + 12.0)
        let outside = Math.Vec2(bounds.position.x + bounds.size.x + 18.0,inside.y)
        let pressed = self.handle(mouse_button_event(inside,true))
        let moved = self.handle(mouse_move_event(outside))
        drawing = self.drawing(900,760)
        let before = long_text_origin(drawing,original)
        let notifications = self.form.changes.value()
        for index in 0...10 { let changed = self.update(0.1); drawing = self.drawing(900,760) }
        assert(long_text_origin(drawing,original).x < before.x)
        assert(self.form.long.value() == original && self.form.changes.value() == notifications)
        let released = self.handle(mouse_button_event(outside,false))
        drawing = self.drawing(900,760); let stopped = long_text_origin(drawing,original)
        for index in 0...10 { let changed = self.update(0.1); drawing = self.drawing(900,760) }
        assert(long_text_origin(drawing,original) == stopped)
        var runtime = self.ui(); assert(runtime.insert_text("!"))
        assert(self.form.long.value() != original)
        assert(self.handle(letter_event(Keyboard.Key.w,122 as uint32)))
        assert(self.form.long.value() == original)
    }
    func check_ime() {
        var runtime = self.ui(); var drawing = self.drawing(900,760)
        self.form.short_focus.request(); let focused = self.update(0.0)
        let original = self.form.short.value(); let notifications = self.form.changes.value()
        let id = self.text_input_target()!.id
        assert(self.handle(Events.Event.text_editing(Events.TextEditingEvent(
            window:Window.Id(value:1 as uint32),text:"日本",start:2,length:0,
            timestamp:Events.Timestamp(nanoseconds:1 as uint)))))
        drawing = self.drawing(900,760)
        assert(self.form.short.value() == original && self.form.changes.value() == notifications)
        self.form.toggle_theme(); let themed = self.update(0.0); drawing = self.drawing(900,760)
        assert(self.text_input_target()!.id == id)
        assert(runtime.key_pressed(Keyboard.Key.escape)); drawing = self.drawing(900,760)
        assert(self.accepts_text_input() && self.form.short.value() == original)
        assert(self.text_input_target()!.id != id)
        assert(runtime.compose_text("仮",1,0)); assert(runtime.insert_text("日本"))
        assert(self.form.short.value() == original + "日本" && self.form.changes.value() == notifications + 1)
        assert(runtime.key_pressed(Keyboard.Key.z,Keyboard.Modifiers(system:true)))
        assert(self.form.short.value() == original)
    }
    func check_cpu() {
        var drawing = self.drawing(900,760)
        for layer in drawing.prepared(900,760).text_layers() {
            for run in layer.glyph_runs() { assert(run.missing_glyph_count() == 0) }
        }
        var runtime = self.ui(); self.form.short_focus.request(); assert(self.update(0.0))
        let original = self.form.short.value()
        assert(runtime.insert_text(" a")); assert(runtime.insert_text("b"))
        assert(self.form.short.value() == original + " ab")
        assert(runtime.key_pressed(Keyboard.Key.z,Keyboard.Modifiers(system:true)))
        assert(self.form.short.value() == original)
        assert(runtime.key_pressed(Keyboard.Key.z,Keyboard.Modifiers(system:true,shift:true)))
        assert(self.form.short.value() == original + " ab" && self.form.changes.value() == 4)
        self.form.toggle_theme(); assert(self.update(0.0)); drawing = self.drawing(900,760)
        assert(runtime.key_pressed(Keyboard.Key.z,Keyboard.Modifiers(system:true)))
        assert(self.form.short.value() == original)
        self.form.long_focus.request(); assert(self.update(0.0)); drawing = self.drawing(900,760)
        let ended_long = runtime.key_pressed(Keyboard.Key.end); assert(runtime.insert_text("suffix"))
        assert(runtime.key_pressed(Keyboard.Key.left,Keyboard.Modifiers(alt:true,shift:true)))
        assert(runtime.insert_text("replacement")); assert(runtime.key_pressed(Keyboard.Key.z,Keyboard.Modifiers(system:true)))
        assert(self.form.long.value() == long_line() + "suffix")
        self.form.area_focus.request(); assert(self.update(0.0)); drawing = self.drawing(900,760)
        let ended_area = runtime.key_pressed(Keyboard.Key.end); assert(runtime.key_pressed(Keyboard.Key.enter))
        assert(runtime.insert_text("new line")); assert(runtime.key_pressed(Keyboard.Key.z,Keyboard.Modifiers(system:true)))
        assert(self.form.area.value() == paragraphs() + "\n")
        assert(runtime.key_pressed(Keyboard.Key.z,Keyboard.Modifiers(system:true)))
        assert(self.form.area.value() == paragraphs())
        for width in [900,480,200,1] {
            drawing = self.drawing(width,760); self.form.toggle_theme(); let changed = self.update(0.0)
            drawing = self.drawing(width,760); assert(self.accepts_text_input())
        }
        self.form.short_focus.request(); let focused = self.update(0.0)
        assert(runtime.insert_text("external reset")); self.form.reset(); let reset = self.update(0.0)
        let ignored = runtime.key_pressed(Keyboard.Key.z,Keyboard.Modifiers(system:true))
        assert(self.form.short.value() == original)
        var selection = EditingSession(); selection.check_selection()
        var ime = EditingSession(); ime.check_ime()
        var touch = EditingSession(simulated:true); touch.check_touch()
        var wheel = EditingSession(); wheel.check_wheel()
        print("UITextEditing CPU : OK")
    }
}
func main() {
    var cpu = false; var simulated = false
    for argument in Process.arguments() {
        if argument == "--cpu-check" { cpu = true }
        if argument == "--touch-simulation" { simulated = true }
    }
    var session = EditingSession(simulated:simulated)
    if cpu { session.check_cpu(); return }
    let code = Viewer.show(session,Viewer.CanvasSettings(width:900,height:760,title:"Silex — Édition de texte J4"))
    if code != 0 { panic("text editing viewer failed") }
}
test "actual gallery keeps undo word selection and multiline history through theme changes and resize" {
    var session = EditingSession(); session.check_cpu()
}

func letter_event(key:Keyboard.Key, code:uint32, shift:bool = false) Events.Event {
    return Events.Event.key_pressed(Events.KeyEvent(window:Window.Id(value:1 as uint32),
        keyboard:Keyboard.KeyboardId(value:1 as uint32),key:key,keycode:code,raw:0 as uint16,
        repeated:false,modifiers:Keyboard.Modifiers(system:true,shift:shift),
        timestamp:Events.Timestamp(nanoseconds:1 as uint)))
}
test "actual gallery undo and redo follow logical AZERTY events" {
    var session = EditingSession(); var drawing = session.drawing(900,760)
    session.form.short_focus.request(); let focused = session.update(0.0)
    let original = session.form.short.value()
    assert(session.handle(Events.Event.text_input(Events.TextInputEvent(
        window:Window.Id(value:1 as uint32),text:"abc",timestamp:Events.Timestamp(nanoseconds:1 as uint)))))
    assert(session.form.short.value() == original + "abc")
    assert(session.handle(letter_event(Keyboard.Key.w,122 as uint32)))
    assert(session.form.short.value() == original)
    assert(session.handle(letter_event(Keyboard.Key.w,122 as uint32,shift:true)))
    assert(session.form.short.value() == original + "abc")
}

func long_text_origin(drawing:@Canvas, text:str) Math.Vec2 {
    if let value = find_text_command(drawing.commands(),text) { return value.position }
    panic("long field text was not drawn")
}
func long_text_bounds(drawing:@Canvas, text:str) Canvas.Rect {
    if let value = find_text_command(drawing.commands(),text) {
        if let clip = value.clip { return clip }
    }
    panic("long field has no text clip")
}
func find_text_command(commands:@Canvas.Command[], text:str) CanvasText? {
    for command in commands {
        match command {
            text(value) => { if value.value == text { return value } }
            layer(value) => {
                if let found = find_text_command(value.commands(),text) { return found }
            }
            else => {}
        }
    }
    return null
}
func mouse_button_event(position:Math.Vec2, down:bool) Events.Event {
    let value = Events.MouseButtonEvent(window:Window.Id(value:1 as uint32),
        mouse:Pointer.MouseId(value:1 as uint32),button:Pointer.MouseButton.left,
        down:down,clicks:1 as uint8,position:position,
        timestamp:Events.Timestamp(nanoseconds:1 as uint))
    if down { return Events.Event.mouse_button_pressed(value) }
    return Events.Event.mouse_button_released(value)
}
func mouse_move_event(position:Math.Vec2) Events.Event {
    return Events.Event.mouse_moved(Events.MouseMotionEvent(window:Window.Id(value:1 as uint32),
        mouse:Pointer.MouseId(value:1 as uint32),buttons:1 as uint32,
        position:position,delta:Math.Vec2(),relative:false,
        timestamp:Events.Timestamp(nanoseconds:1 as uint)))
}
test "actual gallery keeps scrolling held selection through mouse events and stops on release" {
    var session = EditingSession(); session.check_selection()
}

test "actual gallery composition keeps bindings and notifications committed" {
    var session = EditingSession(); session.check_ime()
}

test "actual gallery simulation delivers a held finger selection through mouse events" {
    var session = EditingSession(simulated:true); session.check_touch()
}

func touch_handle_count(commands:@Canvas.Command[]) int {
    var count = 0
    for command in commands { match command {
        fill_circle(value) => { if value.shape.radius == 6.0 { count++ } }
        layer(value) => { count += touch_handle_count(value.commands()) }
        else => {}
    } }
    return count
}

test "actual gallery smooths editor and page wheels and makes transfer optional" {
    var session = EditingSession(); session.check_wheel()
}
