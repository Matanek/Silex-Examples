use GFX.Color
use GFX.Input
use GFX.Input.Events
use GFX.UI

package class RagdollFallControls {
    var releases:int=0
    var pushes:int=0
    var resets:int=0
    var pauses:int=0
    var automatic:bool=false
    var pause_text:UI.State<str> = UI.State<str>("Reprendre (Espace)")
    var feedback:UI.State<str> = UI.State<str>("En pause — libérez les mannequins ou poussez le torse or.")
    var measure:UI.State<str> = UI.State<str>("")
    func release() { self.releases++ }
    func push() { self.pushes++ }
    func reset() { self.resets++ }
    func pause() { self.pauses++ }
    func button(text:str,action:func()) UI.Button {
        var button=UI.Button(text,action)
        button.style.width=180.0;button.style.height=38.0
        button.style.background=Color.slate_700();button.style.radius=5.0
        return button
    }
    func pause_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.pause_text),self.pause) }
    func status(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.feedback)) }
    func metrics(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.measure)) }
    func describe() UI.View {
        var title=UI.Text("Mannequins en chute — impulsion et contact au sol");title.style.height=34.0
        var help=UI.Text("Or : bras levés et torse à pousser · Bleu : chute de référence · Points blancs : articulations");help.style.height=24.0
        var actions=UI.Row([self.button("Libérer / rejouer",self.release),self.button("Pousser le torse (P)",self.push),self.button("Remettre à zéro (R)",self.reset)])
        actions.style.gap=10.0
        var rows:UI.View[]=[title,help,actions,UI.Reactive(self.pause_button),UI.Reactive(self.status),UI.Reactive(self.metrics),
            UI.Text("P reprend la simulation et pousse l’or. Espace : pause · R : reset · Échap : quitter. Pause automatique après 4 s.")]
        if self.automatic { rows=[UI.Text("TEST AUTOMATIQUE — fermeture à la fin"),UI.Reactive(self.metrics)] }
        var root=UI.Column(rows)
        root.style.padding=UI.Insets(16.0);root.style.gap=8.0
        root.style.background=Color.slate_900().with_alpha(0.94);root.style.foreground=Color.slate_100();root.style.radius=8.0
        return root
    }
    func handle(event:@Events.Event) bool {
        if self.automatic { return false }
        match event {
            key_pressed(key) => {
                let reset=key.keycode==114 as uint32 || key.keycode==82 as uint32 || (key.keycode==0 as uint32 && key.key==Input.Key.r)
                let push=key.keycode==112 as uint32 || key.keycode==80 as uint32 || (key.keycode==0 as uint32 && key.key==Input.Key.p)
                if key.key==Input.Key.space || reset || push {
                    if !key.repeated { if reset { self.reset() } else if push { self.push() } else { self.pause() } }
                    return true
                }
            }
            else => {}
        }
        return false
    }
}
