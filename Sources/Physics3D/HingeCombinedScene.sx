use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use GFX.Scene3D
use STD.Math
use STD.Process
use STD.Time.Clock

class HingeCombinedSceneState {
    var bodies:Physics.RigidBody3D[] = []
    var pivots:Physics.RigidBody3D[] = []
    var joints:Physics.HingeConstraint3D[] = []
    var visuals:ECS.Entity[] = []
    var previous:Physics.Transform3D[] = []
    var initial:Physics.Transform3D[] = []
    var elapsed:float = 0.0
    var accumulator:float = 0.0
    var target:float = 1.0
    var phase:float = 0.0
    var markers:ECS.Entity[] = []
    var gold_error:float = 0.0
    var blue_error:float = 0.0
    var samples:int = 0
    var smoke:bool = false
    var switched:bool = false
    var cycles:int = 0
    var pause_frames:int = 0
    var pause_elapsed:float = 0.0
    var pause_poses:Physics.Transform3D[] = []
    var frame_clock:Clock = Clock()
    var frames:int = 0
    var report_time:float = 0.0
}
func combined_visual(world:&Resources.World, meshes:&Resources.Meshes3D, size:Math.Vec3,
    position:Math.Vec3, color:Color) ECS.Entity
{
    let mesh = meshes.add(Scene3D.Geometry.Cube.make(size))
    return world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(position:position))
        ..with(Components.Mesh3D(mesh)) ..with(Components.Material3D(albedo:color,roughness:0.5)))
}
func set_combined_target(state:&HingeCombinedSceneState) {
    let angle = 0.75*Math.sin(state.phase)
    let speed = 0.6*state.target*Math.cos(state.phase)
    state.joints[0].set_motor(Physics.HingeMotor3D.position_and_velocity(angle,speed,10.0,8.0,4.0))
    state.joints[1].set_motor(Physics.HingeMotor3D.position(angle,10.0,8.0,4.0))
}
func reset_combined(world:&Resources.World, state:&HingeCombinedSceneState) {
    var index = 0
    while index < state.bodies.count() {
        state.bodies[index].set_transform(state.initial[index])
        state.bodies[index].set_linear_velocity(Math.Vec3()); state.bodies[index].set_angular_velocity(Math.Vec3())
        state.previous[index] = state.initial[index]; index++
    }
    state.elapsed = 0.0; state.accumulator = 0.0;state.phase = 0.0
    state.gold_error = 0.0;state.blue_error = 0.0;state.samples = 0
    state.switched = false
    set_combined_target(state)
}
func create_combined(world:&Resources.World, meshes:&Resources.Meshes3D,
    physics:&Physics.World3D, state:&HingeCombinedSceneState)
{
    physics.set_gravity(Math.Vec3())
    var index = 0
    while index < 2 {
        let x = -2.5+5.0*index as float
        let pivot_pose = Physics.Transform3D(Math.Vec3(x,3.0,0.0))
        state.pivots.append(physics.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
            ..transform = pivot_pose ..collision_filter = Physics.CollisionFilter3D(mask_bits:0)))
        let pose = pivot_pose
        state.bodies.append(physics.create_rigid_body(Physics.RigidBody3DSettings() ..transform = pose
            ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.25,2.0,0.4)))
            ..mass_properties = Physics.MassProperties3D(3.0,Math.Vec3(1.0))
            ..collision_filter = Physics.CollisionFilter3D(mask_bits:0) ..allow_sleep = false))
        state.joints.append(physics.create_hinge_constraint(state.pivots[index],state.bodies[index],
            Physics.HingeConstraint3DSettings()))

        state.initial.append(pose); state.previous.append(pose)
        var color = Color.bytes(245,186,82); if index == 1 { color = Color.bytes(89,184,237) }
        state.visuals.append(combined_visual(world,meshes,Math.Vec3(0.25,2.0,0.4),pose.position,color))
        state.markers.append(combined_visual(world,meshes,Math.Vec3(0.08,2.8,0.08),pose.position.add(Math.Vec3(0.0,0.0,-0.3)),Color.bytes(205,214,220)))
        combined_visual(world,meshes,Math.Vec3(0.45),pivot_pose.position,Color.bytes(120,138,156))
        index++
    }
    combined_visual(world,meshes,Math.Vec3(14.0,0.2,10.0),Math.Vec3(0.0,-0.1,0.0),Color.bytes(52,70,87))
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.45)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4,-1.0,-0.3).normalized(),intensity:2.5) ..shadow_distance = 40.0))
    match (try Process.arguments()) {
        success(arguments) => { for argument in arguments { if argument == "--smoke" { state.smoke = true } } }
        failure(error) => { panic(error.detail) }
    }
    reset_combined(world,state); state.frame_clock.tick()
    print("Gold: angle and velocity. Blue: angle alone. Thin gray arms: moving targets. Same k=8, c=4, torque +/-10 N m. T: reverse trajectory. R: restart. Space: pause. Escape: quit.")
}
func toggle_combined_pause(simulation:&Application.Simulation) {
    if simulation.is_paused() { simulation.resume() } else { simulation.pause() }
}
func update_combined(world:&Resources.World, input:@Resources.InputState, simulation:&Application.Simulation,
    physics:&Physics.World3D, state:&HingeCombinedSceneState, controller:&Application.Controller)
{
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if input.is_pressed(Input.Key.space) { toggle_combined_pause(simulation) }
    if !state.smoke {
        if input.is_pressed(Input.Key.r) { reset_combined(world,state) }
        if input.is_pressed(Input.Key.t) { state.target = -state.target; set_combined_target(state) }
    }
    if state.smoke && state.cycles == 0 {
        if state.pause_frames == 0 && state.elapsed >= 0.5 {
            toggle_combined_pause(simulation); assert(simulation.is_paused())
            state.pause_elapsed = state.elapsed
            for body in state.bodies { state.pause_poses.append(body.transform()) }
            state.pause_frames = 1
        } else if state.pause_frames > 0 && state.pause_frames <= 12 {
            assert(simulation.is_paused() && simulation.delta() == 0.0)
            assert(state.elapsed == state.pause_elapsed)
            var index = 0
            while index < state.bodies.count() {
                let pose = state.bodies[index].transform(); let frozen = state.pause_poses[index]
                assert(pose.position == frozen.position && pose.rotation == frozen.rotation)
                index++
            }
            state.pause_frames++
            if state.pause_frames == 13 {
                toggle_combined_pause(simulation); assert(!simulation.is_paused())
                print("Combined pause: poses and simulation time frozen for 12 frames; resumed")
            }
        }
    }
    state.accumulator += simulation.delta()
    let delta = 1.0/120.0
    while state.accumulator >= delta {
        var index = 0
        while index < state.bodies.count() { state.previous[index] = state.bodies[index].transform(); index++ }
        set_combined_target(state)
        physics.step(delta);state.phase += 0.8*state.target*delta;state.elapsed += delta;state.accumulator -= delta
        if state.smoke {
            index = 0
            while index < 2 {
                let joint = state.joints[index]
                assert(joint.anchor_error().length()<0.003 && joint.axis_error()<0.002 && joint.friction_torque()==0.0)
                assert(Math.abs(joint.motor_torque())<=10.00001 && Math.abs(joint.angle())<1.5)
                index++
            }
            if (state.elapsed>=2.0 && state.elapsed<4.0) || state.elapsed>=6.0 {
                let requested = 0.75*Math.sin(state.phase)
                state.gold_error += Math.abs(state.joints[0].angle()-requested)
                state.blue_error += Math.abs(state.joints[1].angle()-requested)
                state.samples++
            }
            if !state.switched && state.elapsed>=4.0 {
                state.target = -state.target;set_combined_target(state);state.switched = true
            }
            if state.elapsed>=8.0 {
                assert(state.samples>400)
                let gold = state.gold_error/state.samples as float
                let blue = state.blue_error/state.samples as float
                assert(gold<0.08 && blue>0.1 && gold<blue*0.6)
                if state.cycles==0 { assert(state.pause_frames==13 && state.elapsed>state.pause_elapsed) }
                state.cycles++
                print("Combined smoke cycle=$(state.cycles): average gold error=$(gold), blue error=$(blue); reversal, reset, pause/resume and rendered poses verified")
                if state.cycles==2 { controller.stop() }
                reset_combined(world,state)
            }
        }
    }

    state.frames++; state.report_time += state.frame_clock.tick()
    if state.report_time >= 1.0 { print("Combined scene FPS=$(state.frames as float/state.report_time)"); state.frames = 0; state.report_time = 0.0 }
}
func render_combined(world:&Resources.World, state:&HingeCombinedSceneState) {
    let alpha = Math.clamp(state.accumulator*120.0,0.0,1.0)
    let target_phase = state.phase-0.8*state.target*(1.0-alpha)/120.0
    let target_rotation = Math.Quat.angle_axis(0.75*Math.sin(target_phase),Math.Vec3(0.0,0.0,1.0))
    var index = 0
    while index < state.bodies.count() {
        let position = state.previous[index].position.lerp(state.bodies[index].position(),alpha)
        let first = state.previous[index].rotation; var second = state.bodies[index].rotation()
        if first.dot(second) < 0.0 { second = second.multiply(-1.0) }
        let rotation = first.multiply(1.0-alpha).add(second.multiply(alpha)).normalized()
        world.update<Components.Transform3D>(state.visuals[index],func(transform:&Components.Transform3D) { transform.position = position; transform.rotation = rotation })
        world.update<Components.Transform3D>(state.markers[index],func(transform:&Components.Transform3D) { transform.rotation = target_rotation })
        if state.smoke {
            let marker = world.get<Components.Transform3D>(state.markers[index])
            assert(Math.abs(marker.rotation.dot(target_rotation))>0.99999)
            let pose = world.get<Components.Transform3D>(state.visuals[index])
            assert(pose.position.nearly_equal(position,0.0001) && Math.abs(pose.rotation.dot(rotation)) > 0.99999)
        }
        index++
    }
}
func main() {
    Application() ..add_resource(HingeCombinedSceneState()) ..add_resource(Physics.World3D())
        ..add_plugin(Plugins.Window(Plugins.Window.Settings() ..title = "Silex combined hinge targets | Gold angle+velocity, Blue angle | T reverse, R restart, Space pause" ..width = 1200 ..height = 720))
        ..add_plugin(Plugins.Time()) ..add_plugin(Plugins.Scene3D())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings() ..target = Math.Vec3(0.0,3.0,0.0)
            ..distance = 14.0 ..yaw = Math.radians(-8.0) ..pitch = Math.radians(-20.0)))
        ..add_system(Application.Schedule.startup,create_combined)
        ..add_system(Application.Schedule.update,update_combined,process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.render,render_combined) ..run()
}
