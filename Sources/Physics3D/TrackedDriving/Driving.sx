use GFX.Physics
use Physics3D.TrackedDriving.Model
use STD.Math

package func step(model:&Model.TrackedModel,gas:float,turn:float,braking:bool) {
    let automatic=copy model.automatic
    var throttle=0.0;var brake=0.0;var left=1.0;var right=1.0
    {
        var vehicle=model.vehicle;var body=vehicle.chassis()
        let forward=body.rotation().rotate(Math.Vec3(0.0,0.0,1.0))
        let speed=body.linear_velocity().dot(forward)
        var gear=1;if gas<0.0 { gear= -1 }
        throttle=gas*0.8*Math.clamp((9.0-Math.abs(speed))/2.0,0.0,1.0)
        let difference=Math.min(0.5,3.6/Math.max(1.0,speed*speed))*Math.abs(turn)
        if turn<0.0 { left-=difference } else if turn>0.0 { right-=difference }
        if gas==0.0 && turn!=0.0 && Math.abs(speed)<0.5 {
            throttle=0.4*Math.clamp((1.2-Math.abs(body.angular_velocity().y))/0.4,0.0,1.0)
            if turn<0.0 { left= -1.0;right=1.0 } else { left=1.0;right= -1.0 }
        }
        if braking || (gas==0.0 && turn==0.0 && Math.abs(speed)<0.15) || gas*speed< -0.5 {
            throttle=0.0;brake=0.04
        } else if !automatic { vehicle.set_transmission(gear) }
    }
    model.drive(throttle,left,right,brake)
}
