use GFX.Physics
use Physics3D.TrackedDriving.Model
use STD.Math

func command(model:&Model.TrackedModel,direction:int) {
    var throttle=0.0;var brake=0.04
    if model.steps>=2*model.rate && model.steps<6*model.rate { throttle=0.8*direction as float;brake=0.0 }
    model.drive(throttle,brake:brake)
}
package func witness() {
    var scenario=0
    for direction in [1,-1] {
        for rate in [60,120] {
            var model=Model.TrackedModel(recipe:6,rate:rate,automatic:true)
            while true {
                print(model.observation("tracked-auto",scenario))
                if model.steps==16*rate { break }
                command(model,direction)
            }
        }
        scenario++
    }
}
package func verify() {
    for direction in [1,-1] { for rate in [60,120] {
        var model=Model.TrackedModel(recipe:6,rate:rate,automatic:true)
        let sequence:int[]=[direction,2*direction,3*direction,2*direction,direction,0]
        var previous=0;var event=0;var open_steps=0
        while model.steps<16*rate {
            command(model,direction);model.verify()
            let power=model.vehicle.powertrain()
            if power.gear!=previous { assert(event<sequence.count() && power.gear==sequence[event]);previous=power.gear;event++ }
            if model.steps>=2*rate && power.clutch==0.0 { open_steps++ }
        }
        assert(event==6 && open_steps>rate && model.supports()==6)
        assert(model.vehicle.chassis().linear_velocity().length()<0.05 && model.vehicle.powertrain().gear==0)
        var old=model.vehicle;model.reset(6);assert(!old.is_valid() && model.automatic && model.steps==0 && model.vehicle.powertrain().gear==0)
    } }
    print("Tracked automatic: forward/reverse1/2/3/2/1/neutral, clutch interruptions, rest and profile retained by R at60/120Hz")
}
test "tracked scene uses automatic shifts under ground loads" { verify() }

package func ramp_witness() {
    for recipe in [6,7] { for rate in [60,120] {
        var model=Model.TrackedModel(recipe:recipe,rate:rate,automatic:true)
        while true {
            print(model.observation("tracked-auto-ramp",recipe-6))
            if model.steps==16*rate { break }
            command(model,1)
        }
    } }
}
package func verify_finished(model:@Model.TrackedModel) {
    assert(model.automatic && model.steps==16*model.rate && model.supports()==6)
    var body=model.vehicle.chassis()
    assert(body.linear_velocity().length()<0.05 && body.angular_velocity().length()<0.05)
    assert(model.normal_samples>0 && Math.abs(model.normal_sum/model.normal_samples as float-981.0)<2.0)
    assert(Math.abs(body.position().y-0.88365)<0.003 && body.position().z>20.0)
    assert(model.vehicle.powertrain().gear==0)
    var expected=2;if model.recipe==7 { expected=3 }
    assert(model.world.body_count()==expected)
    if model.recipe==6 { assert(model.air_steps==0 && model.ramp_samples==0 && !model.landed) }
    else { assert(model.recipe==7 && model.air_steps>model.rate/20 && model.ramp_samples>model.rate && model.landed && model.peak_height>1.1) }
    print("Tracked automatic terrain $(model.recipe) at $(model.rate) Hz: air=$(model.air_steps), ramp=$(model.ramp_samples), peak=$(model.peak_height), landed=$(model.landed), neutral and six supports at rest")
}
package func verify_ramp() {
    for recipe in [6,7] { for rate in [60,120] {
        var model=Model.TrackedModel(recipe:recipe,rate:rate,automatic:true)
        while model.steps<16*rate { command(model,1);model.verify() }
        verify_finished(model)
        var old=model.vehicle;model.reset(6)
        assert(!old.is_valid() && model.automatic && model.steps==0 && model.world.body_count()==2)
        assert(model.air_steps==0 && !model.landed && model.ramp_samples==0)
    } }
}
test "tracked automatic ramp crosses, flies, lands and stops against a flat control" { verify_ramp() }
