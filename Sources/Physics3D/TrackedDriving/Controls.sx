use GFX.Color
use GFX.Input
use GFX.Input.Events
use GFX.UI

func letter(key:@Events.KeyEvent,lower:uint32,upper:uint32,physical:Input.Key) bool {
    return key.keycode==lower || key.keycode==upper || (key.keycode==0 as uint32 && key.key==physical)
}
package class TrackedControls {
    var throttle:bool=false
    var reverse:bool=false
    var left:bool=false
    var right:bool=false
    var braking:bool=false
    var terrain:bool?=null
    var resets:int=0
    var pauses:int=0
    var modes:int=0
    var automatic:bool=false
    var live_check:bool=false
    var ramp_check:bool=false
    var pause_text:UI.State<str> =UI.State<str>("Pause (P)")
    var mode_text:UI.State<str> =UI.State<str>("Pilote OFF (M)")
    var phase:UI.State<str> =UI.State<str>("")
    var measure:UI.State<str> =UI.State<str>("")
    var tracks:UI.State<str> =UI.State<str>("")
    func flat() { self.terrain=false }
    func ramp() { self.terrain=true }
    func reset() { self.resets++ }
    func pause() { self.pauses++ }
    func mode() { self.modes++ }
    func release() { self.throttle=false;self.reverse=false;self.left=false;self.right=false;self.braking=false }
    func held(key:@Events.KeyEvent,down:bool) bool {
        if key.key==Input.Key.space { self.braking=down;return true }
        if letter(key,122 as uint32,90 as uint32,Input.Key.z) { self.throttle=down;return true }
        if letter(key,115 as uint32,83 as uint32,Input.Key.s) { self.reverse=down;return true }
        if letter(key,113 as uint32,81 as uint32,Input.Key.q) || key.key==Input.Key.left { self.left=down;return true }
        if letter(key,100 as uint32,68 as uint32,Input.Key.d) || key.key==Input.Key.right { self.right=down;return true }
        return false
    }
    func button(text:str,action:func()) UI.Button {
        var button=UI.Button(text,action);button.style.width=180.0;button.style.height=38.0
        button.style.radius=5.0;button.style.background=Color.slate_700();return button
    }
    func pause_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.pause_text),self.pause) }
    func mode_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.mode_text),self.mode) }
    func phase_label(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.phase)) }
    func metrics(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.measure)) }
    func track_metrics(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.tracks)) }
    func describe() UI.View {
        var actions=UI.Row([self.button("Rampe (B)",self.ramp),self.button("Plat (F)",self.flat),UI.Reactive(self.mode_button),UI.Reactive(self.pause_button),self.button("Départ (R)",self.reset)])
        actions.style.gap=10.0
        var title=UI.Text("Chenilles — boîte automatique et conduite libre");title.style.height=28.0
        var help=UI.Text("Maintenir Z/S : avant/arrière · Q/D ou flèches : tourner/pivoter · Espace : frein · Échap : quitter");help.style.height=24.0
        var hint=UI.Text("Seul R remet au départ. B/F : terrain sur place. M puis R : cycle de franchissement ; ZQSD reprend la main.");hint.style.height=24.0
        var rows:UI.View[]=[title,help,actions,hint,UI.Reactive(self.phase_label),UI.Reactive(self.metrics),UI.Reactive(self.track_metrics)]
        if self.automatic { rows=[UI.Text("TEST AUTOMATIQUE — huit manœuvres et commandes continues — fermeture à la fin"),UI.Reactive(self.phase_label),UI.Reactive(self.metrics),UI.Reactive(self.track_metrics)] }
        if self.automatic && self.live_check { rows=[UI.Text("TEST AUTOMATIQUE — commandes continues — fermeture à la fin"),UI.Reactive(self.phase_label),UI.Reactive(self.metrics),UI.Reactive(self.track_metrics)] }
        if self.automatic && self.ramp_check { rows=[UI.Text("TEST AUTOMATIQUE — plat et rampe en boîte automatique — fermeture à la fin"),UI.Reactive(self.phase_label),UI.Reactive(self.metrics),UI.Reactive(self.track_metrics)] }
        var root=UI.Column(rows);root.style.padding=UI.Insets(16.0);root.style.gap=8.0
        root.style.background=Color.slate_900().with_alpha(0.94);root.style.foreground=Color.slate_100();root.style.radius=8.0;return root
    }
    func handle(event:@Events.Event) bool {
        if self.automatic { return false }
        match event {
            key_pressed(key)=> {
                if self.held(key,true) { return true }
                let flat=letter(key,102 as uint32,70 as uint32,Input.Key.f)
                let ramp=letter(key,98 as uint32,66 as uint32,Input.Key.b)
                let reset=letter(key,114 as uint32,82 as uint32,Input.Key.r)
                let pause=letter(key,112 as uint32,80 as uint32,Input.Key.p)
                let mode=letter(key,109 as uint32,77 as uint32,Input.Key.m)
                if flat || ramp || reset || pause || mode {
                    if !key.repeated {
                        if flat { self.flat() } else if ramp { self.ramp() }
                        else if reset { self.reset() } else if pause { self.pause() } else { self.mode() }
                    }
                    return true
                }
            }
            key_released(key)=> { return self.held(key,false) }
            window_focus_lost(focus)=> { self.release() }
            else=>{}
        }
        return false
    }
}
