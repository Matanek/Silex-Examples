use GFX.Color
use GFX.Input
use GFX.Input.Events
use GFX.UI

package class SuspensionControls {
    var throttles:float[]=[]
    var power_measure:UI.State<str> =UI.State<str>("")
    var directions:float[]=[]
    var brakes:int=0
    var handbrakes:int=0
    var brake_text:UI.State<str> =UI.State<str>("Frein libre (F)")
    var handbrake_text:UI.State<str> =UI.State<str>("Frein main libre (H)")
    var forwards:int=0
    var sideways:int=0
    var grips:int=0
    var grip_text:UI.State<str> =UI.State<str>("Adhérence active (G)")
    var jumps:int=0
    var loads:int=0
    var resets:int=0
    var pauses:int=0
    var automatic:bool=false
    var pause_text:UI.State<str> =UI.State<str>("Pause (Espace)")
    var feedback:UI.State<str> =UI.State<str>("Après réception : Z accélère, S recule, X relâche. Gaz et braquage restent choisis. F/H freinent ; G compare sans adhérence.")
    var measure:UI.State<str> =UI.State<str>("")
    func forward_drive() { self.throttles.append(0.6) }
    func coast() { self.throttles.append(0.0) }
    func reverse_drive() { self.throttles.append(-0.5) }
    func power_metrics(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.power_measure)) }
    func left() { self.directions.append(-0.6) }
    func center() { self.directions.append(0.0) }
    func right() { self.directions.append(0.6) }
    func brake() { self.brakes++ }
    func handbrake() { self.handbrakes++ }
    func brake_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.brake_text),self.brake) }
    func handbrake_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.handbrake_text),self.handbrake) }
    func push_forward() { self.forwards++ }
    func push_sideways() { self.sideways++ }
    func toggle_grip() { self.grips++ }
    func grip_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.grip_text),self.toggle_grip) }
    func jump() { self.jumps++ }
    func load() { self.loads++ }
    func reset() { self.resets++ }
    func pause() { self.pauses++ }
    func button(text:str,action:func()) UI.Button {
        var result=UI.Button(text,action)
        result.style.width=220.0;result.style.height=38.0;result.style.background=Color.slate_700();result.style.radius=5.0
        return result
    }
    func pause_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.pause_text),self.pause) }
    func status(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.feedback)) }
    func metrics(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.measure)) }
    func describe() UI.View {
        var actions=UI.Row([self.button("Bondir (B)",self.jump),self.button("Surcharger 2 s (C)",self.load),self.button("Recréer (R)",self.reset),UI.Reactive(self.pause_button)])
        actions.style.gap=12.0
        var rolling=UI.Row([self.button("Pousser devant (P)",self.push_forward),self.button("Pousser de côté (V)",self.push_sideways),UI.Reactive(self.grip_button)]);rolling.style.gap=12.0
        var driving=UI.Row([self.button("Gauche (←)",self.left),self.button("Centrer (↑)",self.center),self.button("Droite (→)",self.right),UI.Reactive(self.brake_button),UI.Reactive(self.handbrake_button)]);driving.style.gap=12.0
        var power=UI.Row([self.button("Accélérer (Z)",self.forward_drive),self.button("Relâcher (X)",self.coast),self.button("Reculer (S)",self.reverse_drive)]);power.style.gap=12.0
        var title=UI.Text("Conduite motorisée — contacts physiques");title.style.height=28.0
        var help=UI.Text("Z/S : avancer/reculer · X : relâcher · ←/→ : braquer, ↑ : centrer · F/H : freins · G : adhérence · Échap : quitter");help.style.height=24.0
        var rows:UI.View[]=[title,help,
            actions,rolling,driving,power,UI.Reactive(self.status),UI.Reactive(self.metrics),UI.Reactive(self.power_metrics)]
        if self.automatic { rows=[UI.Text("TEST AUTOMATIQUE — conduite motorisée — fermeture à la fin"),UI.Reactive(self.metrics),UI.Reactive(self.power_metrics)] }
        var root=UI.Column(rows);root.style.padding=UI.Insets(16.0);root.style.gap=8.0
        root.style.background=Color.slate_900().with_alpha(0.94);root.style.foreground=Color.slate_100();root.style.radius=8.0
        return root
    }
    func handle(event:@Events.Event) bool {
        if self.automatic { return false }
        match event {
            key_pressed(key) => {
                let code=key.keycode
                let jump=code==98 as uint32 || code==66 as uint32 || (code==0 as uint32 && key.key==Input.Key.b)
                let load=code==99 as uint32 || code==67 as uint32 || (code==0 as uint32 && key.key==Input.Key.c)
                let reset=code==114 as uint32 || code==82 as uint32 || (code==0 as uint32 && key.key==Input.Key.r)
                let forward=code==112 as uint32 || code==80 as uint32 || (code==0 as uint32 && key.key==Input.Key.p)
                let sideways=code==118 as uint32 || code==86 as uint32 || (code==0 as uint32 && key.key==Input.Key.v)
                let grip=code==103 as uint32 || code==71 as uint32 || (code==0 as uint32 && key.key==Input.Key.g)
                let forward_drive=code==122 as uint32 || code==90 as uint32 || (code==0 as uint32 && key.key==Input.Key.z)
                let reverse_drive=code==115 as uint32 || code==83 as uint32 || (code==0 as uint32 && key.key==Input.Key.s)
                let coast=code==120 as uint32 || code==88 as uint32 || (code==0 as uint32 && key.key==Input.Key.x)
                let left=key.key==Input.Key.left
                let right=key.key==Input.Key.right
                let center=key.key==Input.Key.up
                let brake=code==102 as uint32 || code==70 as uint32 || (code==0 as uint32 && key.key==Input.Key.f)
                let handbrake=code==104 as uint32 || code==72 as uint32 || (code==0 as uint32 && key.key==Input.Key.h)
                if forward_drive || reverse_drive || coast || left || right || center || brake || handbrake || jump || load || reset || forward || sideways || grip || key.key==Input.Key.space {
                    if !key.repeated {
                        if forward_drive { self.forward_drive() } else if reverse_drive { self.reverse_drive() } else if coast { self.coast() } else if left { self.left() } else if right { self.right() } else if center { self.center() } else if brake { self.brake() } else if handbrake { self.handbrake() } else if forward { self.push_forward() } else if sideways { self.push_sideways() } else if grip { self.toggle_grip() } else if jump { self.jump() } else if load { self.load() } else if reset { self.reset() } else { self.pause() }
                    }
                    return true
                }
            }
            else => {}
        }
        return false
    }
}
