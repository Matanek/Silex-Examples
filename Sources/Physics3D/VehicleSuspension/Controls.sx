use GFX.Color
use GFX.Input
use GFX.Input.Events
use GFX.UI

package static struct Hud { let width:int=280;let height:int=360 }
func letter(key:@Events.KeyEvent,lower:uint32,upper:uint32,physical:Input.Key) bool {
    return key.keycode==lower || key.keycode==upper || (key.keycode==0 as uint32 && key.key==physical)
}
package class SuspensionControls {
    var forward_held:bool=false
    var reverse_held:bool=false
    var left_held:bool=false
    var right_held:bool=false
    var rear_held:bool=false
    var models:int=0
    var monster_text:UI.State<str> =UI.State<str>("N : Monster")
    func release() { self.forward_held=false;self.reverse_held=false;self.left_held=false;self.right_held=false;self.rear_held=false }
    func monster() { self.models++;self.release() }
    func monster_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.monster_text),self.monster) }
    func text(value:str,height:float) UI.Text { var text=UI.Text(value);text.style.height=height;text.style.font_size=13.0;return text }

    var tilt_changes:int=0
    var tilt_text:UI.State<str> =UI.State<str>("Limite inactive (L)")
    var topples:int=0
    func toggle_tilt_limit() { self.tilt_changes++ }
    func tilt_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.tilt_text),self.toggle_tilt_limit) }
    func topple() { self.topples++ }
    var anti_roll_changes:int=0
    var anti_roll_text:UI.State<str> =UI.State<str>("Anti-roulis inactif (A)")
    var suspension_changes:int=0
    var suspension_text:UI.State<str> =UI.State<str>("Souple (M)")
    var contact_changes:int=0
    var contact_text:UI.State<str> =UI.State<str>("Contacts : rayon (T)")
    var throttles:float[]=[]
    var power_measure:UI.State<str> =UI.State<str>("")
    var directions:float[]=[]
    var brakes:int=0
    var handbrakes:int=0
    var brake_text:UI.State<str> =UI.State<str>("Frein libre (F)")
    var handbrake_text:UI.State<str> =UI.State<str>("Frein main libre (H)")
    var forwards:int=0
    var sideways:int=0
    var grips:int=0
    var grip_text:UI.State<str> =UI.State<str>("Adhérence active (G)")
    var jumps:int=0
    var loads:int=0
    var resets:int=0
    var pauses:int=0
    var automatic:bool=false
    var pause_text:UI.State<str> =UI.State<str>("Pause (Espace)")
    var feedback:UI.State<str> =UI.State<str>("Attendre la réception puis O pour basculer. L recrée avec une limite à 45° ; refaire O pour comparer. Z accélère, M compare les suspensions, A l’anti-roulis.")
    var measure:UI.State<str> =UI.State<str>("")
    func toggle_anti_roll() { self.anti_roll_changes++ }
    func anti_roll_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.anti_roll_text),self.toggle_anti_roll) }
    func toggle_suspension() { self.suspension_changes++ }
    func suspension_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.suspension_text),self.toggle_suspension) }
    func toggle_contact() { self.contact_changes++ }
    func contact_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.contact_text),self.toggle_contact) }
    func forward_drive() { self.throttles.append(0.6) }
    func coast() { self.throttles.append(0.0) }
    func reverse_drive() { self.throttles.append(-0.5) }
    func power_metrics(reads:UI.Reads) UI.View { return self.text(reads.read(self.power_measure),36.0) }
    func left() { self.directions.append(-0.6) }
    func center() { self.directions.append(0.0) }
    func right() { self.directions.append(0.6) }
    func brake() { self.brakes++ }
    func handbrake() { self.handbrakes++ }
    func brake_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.brake_text),self.brake) }
    func handbrake_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.handbrake_text),self.handbrake) }
    func push_forward() { self.forwards++ }
    func push_sideways() { self.sideways++ }
    func toggle_grip() { self.grips++ }
    func grip_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.grip_text),self.toggle_grip) }
    func jump() { self.jumps++ }
    func load() { self.loads++ }
    func reset() { self.resets++;self.release() }
    func pause() { self.pauses++ }
    func button(text:str,action:func()) UI.Button {
        var result=UI.Button(text,action)
        result.style.width=124.0;result.style.height=30.0;result.style.font_size=13.0;result.style.background=Color.slate_700();result.style.radius=5.0
        return result
    }
    func pause_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.pause_text),self.pause) }
    func status(reads:UI.Reads) UI.View { return self.text(reads.read(self.feedback),36.0) }
    func metrics(reads:UI.Reads) UI.View { return self.text(reads.read(self.measure),36.0) }
    func describe() UI.View {
        var first=UI.Row([self.button("R : repartir",self.reset),UI.Reactive(self.monster_button)]);first.style.gap=8.0
        var second=UI.Row([UI.Reactive(self.contact_button),UI.Reactive(self.suspension_button)]);second.style.gap=8.0
        var third=UI.Row([UI.Reactive(self.anti_roll_button),UI.Reactive(self.tilt_button)]);third.style.gap=8.0
        var title=self.text("Voiture RC / Monster",24.0);title.style.font_size=18.0
        var help=self.text("Z / S : gaz, frein puis recul\nQ / D : direction\nEspace maintenu : frein AR\nO : basculer · B : bond · C : charge",66.0)
        var rows:UI.View[]=[title,UI.Reactive(self.metrics),UI.Reactive(self.power_metrics),UI.Reactive(self.status),first,second,third,help]
        if self.automatic { rows=[self.text("TEST AUTOMATIQUE",24.0),UI.Reactive(self.metrics),UI.Reactive(self.power_metrics)] }
        var root=UI.Column(rows);root.style.padding=UI.Insets(12.0);root.style.gap=6.0
        root.style.background=Color.slate_900().with_alpha(0.88);root.style.foreground=Color.slate_100();root.style.radius=8.0
        return root
    }
    func held(key:@Events.KeyEvent,down:bool) bool {
        if key.key==Input.Key.space { self.rear_held=down;return true }
        if letter(key,122 as uint32,90 as uint32,Input.Key.z) { self.forward_held=down;return true }
        if letter(key,115 as uint32,83 as uint32,Input.Key.s) { self.reverse_held=down;return true }
        if letter(key,113 as uint32,81 as uint32,Input.Key.q) { self.left_held=down;return true }
        if letter(key,100 as uint32,68 as uint32,Input.Key.d) { self.right_held=down;return true }
        return false
    }
    func handle(event:@Events.Event) bool {
        if self.automatic { return false }
        match event {
            key_pressed(key)=>{
                if self.held(key,true) { return true }
                let reset=letter(key,114 as uint32,82 as uint32,Input.Key.r)
                let profile=letter(key,110 as uint32,78 as uint32,Input.Key.n)
                let contact=letter(key,116 as uint32,84 as uint32,Input.Key.t)
                let spring=letter(key,109 as uint32,77 as uint32,Input.Key.m)
                let bars=letter(key,97 as uint32,65 as uint32,Input.Key.a)
                let limit=letter(key,108 as uint32,76 as uint32,Input.Key.l)
                let topple=letter(key,111 as uint32,79 as uint32,Input.Key.o)
                let jump=letter(key,98 as uint32,66 as uint32,Input.Key.b)
                let load=letter(key,99 as uint32,67 as uint32,Input.Key.c)
                let grip=letter(key,103 as uint32,71 as uint32,Input.Key.g)
                if reset || profile || contact || spring || bars || limit || topple || jump || load || grip {
                    if !key.repeated {
                        if reset { self.reset() }
                        else if profile { self.monster() }
                        else if contact { self.toggle_contact() }
                        else if spring { self.toggle_suspension() }
                        else if bars { self.toggle_anti_roll() }
                        else if limit { self.toggle_tilt_limit() }
                        else if topple { self.topple() }
                        else if jump { self.jump() }
                        else if load { self.load() }
                        else if grip { self.toggle_grip() }
                    }
                    return true
                }
            }
            key_released(key)=>{ return self.held(key,false) }
            window_focus_lost(_)=>{ self.release() }
            else=>{}
        }
        return false
    }
}
