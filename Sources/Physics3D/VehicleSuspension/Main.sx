use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Plugins
use GFX.Resources
use GFX.Scene2D
use GFX.Scene3D
use GFX.UI
use GFX.Physics
use Physics3D.VehicleSuspension.Model
use Physics3D.VehicleSuspension.Controls
use Physics3D.ArticulatedPose.Controls as InputCheck
use STD.Math
use STD.Process

class SuspensionScene {
    var model:Model.SuspensionModel
    var controls:Controls.SuspensionControls=Controls.SuspensionControls()
    var ui:UI.Session
    var panel:ECS.Entity=ECS.Entity()
    var chassis:ECS.Entity=ECS.Entity()
    var nose:ECS.Entity=ECS.Entity()
    var axles:ECS.Entity[]=[]
    var tires:ECS.Entity[]=[]
    var hubs:ECS.Entity[]=[]
    var spokes:ECS.Entity[]=[]
    var barrier:ECS.Entity=ECS.Entity()
    var barrier_visible:bool=false
    var obstacle_frames:int=0
    var ray_peak:float=0.0
    var sphere_peak:float=0.0
    var obstacle_hits:int=0
    var floor:ECS.Entity=ECS.Entity()
    var grid:ECS.Entity[]=[]
    var grid_x:float=10000.0
    var grid_z:float=10000.0
    var steering_angles:float[]=[0.0,0.0,0.0,0.0]
    var angles:float[]=[0.0,0.0,0.0,0.0]
    var held_angles:float[]=[]
    var springs:ECS.Entity[]=[]
    var markers:ECS.Entity[]=[]
    var previous:Physics.Transform3D=Physics.Transform3D()
    var lengths:float[]=[0.6,0.6,0.6,0.6]
    let wheel_orientation:Math.Quat=Math.Quat.angle_axis(Math.half_pi(),Math.Vec3.back())
    var accumulator:float=0.0
    var telemetry:float=0.0
    var smoke:bool=false
    var phase:int=0
    var phase_start:int=0
    var pause_frames:int=0
    var held:Physics.Transform3D=Physics.Transform3D()
    var held_rpm:float=0.0
    var held_load:float=0.0
    var lost:bool=false
    var returned:bool=false
    var peak:float=0.0
    var loaded_min:float=10.0
    var loaded_force:float=0.0
    init(obstacle:bool=false,sphere_contact:bool=false) {
        self.model=Model.SuspensionModel(obstacle:obstacle,sphere_contact:sphere_contact)
        self.ui=UI.Session(self.controls.describe())
    }
}
func visual(world:&Resources.World,mesh:Scene3D.MeshHandle,size:Math.Vec3,color:Color) ECS.Entity {
    return world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(scale:size))
        ..with(Components.Mesh3D(mesh)) ..with(Components.Material3D(albedo:color,roughness:0.7)))
}
func remember(state:&SuspensionScene) {
    state.previous=copy state.model.vehicle.chassis().transform()
    for i in [0,1,2,3] { state.lengths[i]=state.model.vehicle.wheel(i).length;state.angles[i]=state.model.vehicle.wheel(i).rotation_angle;state.steering_angles[i]=state.model.vehicle.wheel(i).steering_angle }
}
func labels(state:&SuspensionScene,simulation:@Application.Simulation) {
    var pause="Pause (Espace)";if simulation.is_paused() { pause="Reprendre (Espace)" }
    if state.controls.pause_text.value()!=pause { state.controls.pause_text.set(pause) }
    var contact_name="rayon";if state.model.sphere_contact { contact_name="sphère" }
    let contact="Contacts : $(contact_name) (T)"
    if state.controls.contact_text.value()!=contact { state.controls.contact_text.set(contact) }
    var brake="Frein libre (F)";if state.model.braking { brake="Frein actif (F)" }
    var hand="Frein main libre (H)";if state.model.handbraking { hand="Frein main actif (H)" }
    if state.controls.brake_text.value()!=brake { state.controls.brake_text.set(brake) }
    if state.controls.handbrake_text.value()!=hand { state.controls.handbrake_text.set(hand) }
    let power=state.model.vehicle.powertrain()
    let rpm=Math.round(power.engine_rpm) as int;let clutch=Math.round(power.clutch*100.0) as int;let throttle=Math.round(state.model.throttle*100.0) as int
    var shift="";if power.switching_gear { shift=" · changement en cours" }
    let power_text="Moteur $(rpm) RPM · rapport $(power.gear) · embrayage $(clutch)% · accélérateur $(throttle)%$(shift) · contacts $(contact_name) · gaz persistants"
    if state.controls.power_measure.value()!=power_text { state.controls.power_measure.set(power_text) }
    let turn=Math.round(Math.degrees(state.model.vehicle.wheel(1).steering_angle)) as int
    let height=Math.round(state.model.vehicle.chassis().position().y*100.0) as int
    let force=Math.round(state.model.force()) as int
    var load="Poids seul";if state.model.load_remaining>0.0 { load="Surcharge active" }
    var grip="Adhérence active (G)";if !state.model.grip { grip="Sans adhérence (G)" }
    if state.controls.grip_text.value()!=grip { state.controls.grip_text.set(grip) }
    let speed=Math.round(state.model.vehicle.chassis().linear_velocity().length()*100.0) as int
    let text="$(grip) · $(speed) cm/s · braquage $(turn)° · $(load) · hauteur $(height) cm · appuis $(state.model.supports())/4 · effort $(force) N · bonds $(state.model.jumps)"
    if state.controls.measure.value()!=text { state.controls.measure.set(text) }
}
func perform(state:&SuspensionScene,simulation:&Application.Simulation) {
    var changed=false
    while state.controls.contact_changes>0 {
        state.controls.contact_changes--;state.model.toggle_contact();remember(state);state.accumulator=0.0;simulation.resume();changed=true
        state.controls.feedback.set("Contact changé et véhicule recréé — Z traverse la même bande. Le rayon passe à côté ; la sphère atteint les arêtes.")
    }
    while state.controls.grips>0 {
        state.controls.grips--;state.model.toggle_grip();remember(state);state.accumulator=0.0;simulation.resume();changed=true
        state.controls.feedback.set("Comparaison changée — véhicule recréé. P pousse devant ; V pousse de côté. Les repères du sol indiquent le déplacement.")
    }
    if state.controls.throttles.count()>0 {
        for throttle in state.controls.throttles { state.model.accelerate(throttle) }
        state.controls.throttles=[];simulation.resume();changed=true
        state.controls.feedback.set("Accélérateur choisi — Z avance, S recule, X relâche. La boîte choisit ses rapports ; les pneus transmettent le couple.")
    }
    if state.controls.directions.count()>0 {
        for direction in state.controls.directions { state.model.steer(direction) }
        state.controls.directions=[];simulation.resume();changed=true
        state.controls.feedback.set("Braquage maintenu — ←/→ choisissent le côté du véhicule ; ↑ recentre. P donne la vitesse nécessaire pour tourner.")
    }
    while state.controls.brakes>0 {
        state.controls.brakes--;state.model.toggle_brake();simulation.resume();changed=true
        state.controls.feedback.set("Frein changé — F active ou libère les quatre freins. Le contact des pneus arrête le véhicule.")
    }
    while state.controls.handbrakes>0 {
        state.controls.handbrakes--;state.model.toggle_handbrake();simulation.resume();changed=true
        state.controls.feedback.set("Frein à main changé — H agit seulement sur les roues arrière. Un nouvel appui le libère.")
    }
    while state.controls.forwards>0 {
        state.controls.forwards--;state.model.push_forward();simulation.resume();changed=true
        state.controls.feedback.set("Poussée vers l’avant — avec adhérence, le contact entraîne les jantes blanches. P reste une impulsion distincte du moteur.")
    }
    while state.controls.sideways>0 {
        state.controls.sideways--;state.model.push_sideways();simulation.resume();changed=true
        state.controls.feedback.set("Poussée latérale — les pneus résistent à la dérive ; sans adhérence, le véhicule glisse.")
    }
    while state.controls.jumps>0 {
        state.controls.jumps--;state.model.jump();simulation.resume();changed=true
        state.controls.feedback.set("Bond reconnu — le châssis emporte ses roues, perd ses appuis puis retombe sur ses ressorts.")
    }
    while state.controls.loads>0 {
        state.controls.loads--;state.model.load();simulation.resume();changed=true
        state.controls.feedback.set("Surcharge reconnue — les suspensions se compriment pendant 2 s, puis se détendent sous le poids seul.")
    }
    while state.controls.resets>0 {
        state.controls.resets--;state.model.reset();remember(state);state.accumulator=0.0;simulation.resume();changed=true
        state.controls.feedback.set("Véhicule recréé — chute libre, réception et retour à l’équilibre.")
    }
    while state.controls.pauses>0 {
        state.controls.pauses--;changed=true
        if simulation.is_paused() { simulation.resume();state.controls.feedback.set("Simulation reprise.") }
        else { simulation.pause();state.controls.feedback.set("Simulation en pause — châssis, roues et durée de surcharge figés.") }
    }
    if changed { labels(state,simulation) }
}
func startup(world:&Resources.World,meshes:&Resources.Meshes3D,state:&SuspensionScene,simulation:&Application.Simulation) {
    let cube=meshes.add(Scene3D.Geometry.Cube.make())
    let wheel=meshes.add(Scene3D.Geometry.Cylinder.make(0.3,0.2))
    state.chassis=visual(world,cube,Math.Vec3(1.4,0.4,2.4),Color.bytes(238,157,52))
    state.nose=visual(world,cube,Math.Vec3(1.2,0.1,0.03),Color.bytes(250,230,85))
    for i in [0,1,2,3] {
        state.tires.append(visual(world,wheel,Math.Vec3(1.0),Color.bytes(30,36,44)))
        state.hubs.append(visual(world,wheel,Math.Vec3(0.55,1.04,0.55),Color.bytes(110,200,220)))
        state.spokes.append(visual(world,cube,Math.Vec3(0.22,0.44,0.045),Color.bytes(245,245,250)))
        state.springs.append(visual(world,cube,Math.Vec3(0.045,0.6,0.045),Color.bytes(240,240,245)))
        state.markers.append(visual(world,cube,Math.Vec3(0.35,0.025,0.3),Color.bytes(60,230,125)))
    }
    for i in [0,1] { state.axles.append(visual(world,cube,Math.Vec3(1.85,0.06,0.06),Color.bytes(210,215,225))) }
    state.barrier=visual(world,cube,Model.obstacle_size(),Color.bytes(156,96,205))
    let barrier_pose=Model.obstacle_transform()
    world.update<Components.Transform3D>(state.barrier,func(t:&Components.Transform3D) { t.position=barrier_pose.position;t.rotation=barrier_pose.rotation })
    state.barrier_visible=state.model.obstacle
    world.update<Components.Mesh3D>(state.barrier,func(m:&Components.Mesh3D) { m.visible=state.barrier_visible })
    state.floor=visual(world,cube,Math.Vec3(100.0,0.2,100.0),Color.bytes(65,82,101))
    var line=0
    while line<62 {
        var size=Math.Vec3(30.0,0.006,0.015);if line>=31 { size=Math.Vec3(0.015,0.006,30.0) }
        state.grid.append(visual(world,cube,size,Color.bytes(100,118,137)));line++
    }
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.55)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4,-1.0,-0.3).normalized(),intensity:2.5)))
    simulation.resume();remember(state);labels(state,simulation)
    state.panel=world.spawn(ECS.EntityRecipe() ..with(Scene2D.Transform(position:Math.Vec2()))
        ..with(Scene2D.Canvas(state.ui.drawing(1180,368),1180,368) ..anchor=Math.Vec2() ..pivot=Math.Vec2()
            ..space=Scene2D.CanvasSpace.viewport ..layer=100))
}
func camera_settings() Plugins.ViewportCamera3D.Settings {
    return Plugins.ViewportCamera3D.Settings() ..target=Math.Vec3(0.0,2.85,0.0)
        ..vertical_fov=0.9 ..distance=9.0 ..yaw=Math.radians(-25.0) ..pitch=Math.radians(-20.0)
        ..zoom_speed=0.0 ..scroll_zoom_speed=0.0 ..orbit_sensitivity=0.0 ..pan_sensitivity=0.0
}
func verify_framing(world:@Resources.World,state:@SuspensionScene,view:Scene3D.Transform) {
    var camera=Scene3D.Camera(vertical_fov:camera_settings().vertical_fov)
    let body=world.get<Components.Transform3D>(state.chassis)
    let pose=Physics.Transform3D(body.position,body.rotation)
    let sides:int[]=[-1,1]
    for x in sides { for y in sides { for z in sides {
        let point=camera.project(pose.point(Math.Vec3(1.02*x as float,0.2*y as float,1.3*z as float)),view,Math.Vec2(1280.0,800.0))!
        assert(point.x>20.0 && point.x<1260.0 && point.y>378.0 && point.y<780.0)
    } } }
    for i in [0,1,2,3] {
        let tire=world.get<Components.Transform3D>(state.tires[i])
        for x in sides { for y in sides { for z in sides {
            let corner=tire.position.add(tire.rotation.rotate(Math.Vec3(0.3*x as float,0.1*y as float,0.3*z as float)))
            let point=camera.project(corner,view,Math.Vec2(1280.0,800.0))!
            assert(point.x>20.0 && point.x<1260.0 && point.y>378.0 && point.y<780.0)
        } } }
    }
    if state.model.obstacle {
        let actual=world.get<Components.Transform3D>(state.barrier)
        let physical=state.model.barrier!.transform()
        assert(actual.position==physical.position && actual.rotation==physical.rotation && actual.scale==Model.obstacle_size())
        for i in [0,1,2,3] {
            let wheel=state.model.vehicle.wheel(i)
            if let support=wheel.support() {
                if support.same_body(state.model.barrier!) {
                    let point=camera.project(wheel.contact_point,view,Math.Vec2(1280.0,800.0))!
                    assert(point.x>20.0 && point.x<1260.0 && point.y>378.0 && point.y<780.0)
                }
            }
        }
    }
}
func smoke_commands(state:&SuspensionScene,simulation:&Application.Simulation,controller:&Application.Controller) {
    if state.phase==0 && state.model.steps>=240 {
        state.model.verify_rest();state.controls.jump();perform(state,simulation);state.phase=1
    } else if state.phase==1 && state.model.steps>=720 {
        assert(state.lost && state.returned && state.peak>2.0);state.model.verify_rest()
        state.controls.load();perform(state,simulation);state.phase=2
    } else if state.phase==2 && state.model.steps>=1080 {
        assert(state.loaded_min<0.53 && state.loaded_force>15000.0 && state.model.load_remaining==0.0)
        state.controls.load();perform(state,simulation);state.controls.pause();perform(state,simulation)
        state.held=copy state.model.vehicle.chassis().transform();state.held_load=state.model.load_remaining;state.held_angles=[]
        for i in [0,1,2,3] { state.held_angles.append(state.model.vehicle.wheel(i).rotation_angle) }
        state.phase=3
    } else if state.phase==3 {
        assert(simulation.is_paused() && simulation.delta()==0.0)
        assert(state.model.vehicle.chassis().transform()==state.held && state.model.load_remaining==state.held_load)
        for i in [0,1,2,3] { assert(state.model.vehicle.wheel(i).rotation_angle==state.held_angles[i]) }
        state.pause_frames++
        if state.pause_frames==8 { state.controls.reset();perform(state,simulation);state.phase=4 }
    } else if state.phase==4 && state.model.steps>=240 {
        state.model.verify_rest()
        state.controls.push_forward();perform(state,simulation);state.phase_start=state.model.steps;state.phase=5
    } else if state.phase==5 && state.model.steps-state.phase_start>=240 {
        assert(state.model.vehicle.chassis().position().z>1.5 && state.model.vehicle.wheel(0).angular_velocity>3.0)
        state.controls.pause();perform(state,simulation);state.pause_frames=0;state.held=copy state.model.vehicle.chassis().transform();state.held_angles=[]
        for i in [0,1,2,3] { state.held_angles.append(state.model.vehicle.wheel(i).rotation_angle) }
        state.phase=12
    } else if state.phase==12 {
        assert(simulation.is_paused() && state.model.vehicle.chassis().transform()==state.held)
        for i in [0,1,2,3] { assert(state.model.vehicle.wheel(i).rotation_angle==state.held_angles[i]) }
        state.pause_frames++
        if state.pause_frames==8 { state.controls.toggle_grip();perform(state,simulation);state.phase=6 }
    } else if state.phase==6 && state.model.steps>=240 {
        state.controls.push_forward();perform(state,simulation);state.phase_start=state.model.steps;state.phase=7
    } else if state.phase==7 && state.model.steps-state.phase_start>=240 {
        assert(Math.abs(state.model.vehicle.chassis().position().z-2.0*(state.model.steps-state.phase_start) as float/120.0)<0.01 && state.model.vehicle.wheel(0).rotation_angle==0.0)
        state.controls.toggle_grip();perform(state,simulation);state.phase=8
    } else if state.phase==8 && state.model.steps>=240 {
        state.controls.push_sideways();perform(state,simulation);state.phase_start=state.model.steps;state.phase=9
    } else if state.phase==9 && state.model.steps-state.phase_start>=240 {
        assert(Math.abs(state.model.vehicle.chassis().linear_velocity().x)<0.02 && Math.abs(state.model.vehicle.chassis().position().x)<0.6)
        state.controls.toggle_grip();perform(state,simulation);state.phase=10
    } else if state.phase==10 && state.model.steps>=240 {
        state.controls.push_sideways();perform(state,simulation);state.phase_start=state.model.steps;state.phase=11
    } else if state.phase==11 && state.model.steps-state.phase_start>=240 {
        assert(Math.abs(state.model.vehicle.chassis().position().x-2.0*(state.model.steps-state.phase_start) as float/120.0)<0.01)
        state.controls.toggle_grip();perform(state,simulation);state.phase=13
    } else if state.phase==13 && state.model.steps>=240 {
        state.controls.push_forward();state.controls.right();perform(state,simulation);state.phase_start=state.model.steps;state.phase=14
    } else if state.phase==14 && state.model.steps-state.phase_start>=240 {
        assert(state.model.vehicle.chassis().position().x< -0.2)
        state.controls.center();state.controls.brake();perform(state,simulation);state.phase_start=state.model.steps;state.phase=15
    } else if state.phase==15 && state.model.steps-state.phase_start>=240 {
        assert(state.model.vehicle.chassis().linear_velocity().length()<0.02)
        state.controls.reset();perform(state,simulation);state.phase=16
    } else if state.phase==16 && state.model.steps>=240 {
        state.controls.push_forward();perform(state,simulation);state.phase_start=state.model.steps;state.phase=17
    } else if state.phase==17 && state.model.steps-state.phase_start>=120 {
        state.controls.handbrake();perform(state,simulation);state.phase_start=state.model.steps;state.phase=18
    } else if state.phase==18 && state.model.steps-state.phase_start>=360 {
        assert(state.model.vehicle.chassis().linear_velocity().length()<0.02)
        for i in [1,3] { assert(state.model.vehicle.wheel(i).brake_torque==0.0) }
        state.controls.reset();perform(state,simulation);state.phase=19
    } else if state.phase==19 && state.model.steps>=240 {
        state.controls.forward_drive();perform(state,simulation);state.phase_start=state.model.steps;state.phase=20
    } else if state.phase==20 && state.model.steps-state.phase_start>=360 {
        assert(state.model.vehicle.chassis().position().z>1.0 && state.model.vehicle.powertrain().gear>0)
        state.controls.coast();state.controls.brake();perform(state,simulation);state.phase_start=state.model.steps;state.phase=21
    } else if state.phase==21 && state.model.steps-state.phase_start>=360 {
        assert(state.model.vehicle.chassis().linear_velocity().length()<0.03)
        state.controls.reset();perform(state,simulation);state.phase=22
    } else if state.phase==22 && state.model.steps>=240 {
        state.controls.reverse_drive();perform(state,simulation);state.phase_start=state.model.steps;state.phase=23
    } else if state.phase==23 && state.model.steps-state.phase_start>=360 {
        assert(state.model.vehicle.chassis().position().z< -1.0 && state.model.vehicle.powertrain().gear<0)
        state.controls.coast();state.controls.brake();perform(state,simulation);state.phase_start=state.model.steps;state.phase=24
    } else if state.phase==24 && state.model.steps-state.phase_start>=360 {
        assert(state.model.vehicle.chassis().linear_velocity().length()<0.03)
        state.controls.toggle_grip();perform(state,simulation);state.phase=25
    } else if state.phase==25 && state.model.steps>=240 {
        state.controls.forward_drive();perform(state,simulation);state.phase_start=state.model.steps;state.phase=26
    } else if state.phase==26 && state.model.steps-state.phase_start>=240 {
        assert(Math.abs(state.model.vehicle.chassis().position().z)<0.01 && state.model.vehicle.wheel(0).angular_velocity>1.0)
        state.controls.pause();perform(state,simulation);state.held_rpm=state.model.vehicle.powertrain().engine_rpm
        state.held=copy state.model.vehicle.chassis().transform();state.pause_frames=0;state.held_angles=[]
        for i in [0,1,2,3] { state.held_angles.append(state.model.vehicle.wheel(i).rotation_angle) }
        state.phase=27
    } else if state.phase==27 {
        assert(simulation.is_paused() && state.model.vehicle.powertrain().engine_rpm==state.held_rpm && state.model.vehicle.chassis().transform()==state.held)
        for i in [0,1,2,3] { assert(state.model.vehicle.wheel(i).rotation_angle==state.held_angles[i]) }
        state.pause_frames++
        if state.pause_frames==8 {
            state.model=Model.SuspensionModel(obstacle:true)
            remember(state);state.accumulator=0.0;simulation.resume();state.phase=28
        }
    } else if state.phase==28 && state.model.steps>=240 {
        state.controls.forward_drive();perform(state,simulation);state.phase_start=state.model.steps;state.obstacle_hits=0;state.phase=29
    } else if state.phase==29 && state.model.steps-state.phase_start>=720 {
        assert(state.obstacle_hits==0 && state.ray_peak>0.85 && state.ray_peak<0.9)
        state.controls.toggle_contact();perform(state,simulation);state.obstacle_hits=0;state.phase=30
    } else if state.phase==30 && state.model.steps>=240 {
        state.controls.forward_drive();perform(state,simulation);state.phase_start=state.model.steps;state.phase=31
    } else if state.phase==31 && state.model.steps-state.phase_start>=720 {
        assert(state.obstacle_hits>0 && state.sphere_peak>state.ray_peak+0.08 && state.model.sphere_contact)
        state.controls.pause();perform(state,simulation);state.held=copy state.model.vehicle.chassis().transform()
        state.held_rpm=state.model.vehicle.powertrain().engine_rpm;state.pause_frames=0;state.phase=32
    } else if state.phase==32 {
        assert(simulation.is_paused() && state.model.vehicle.chassis().transform()==state.held && state.model.vehicle.powertrain().engine_rpm==state.held_rpm)
        state.pause_frames++
        if state.pause_frames==8 {
            assert(state.obstacle_frames>0)
            print("Wheel obstacle smoke: ray misses, sphere supports and lifts chassis, contact mode, powered driving, pause and rendered obstacle/camera/wheel transforms verified")
            controller.stop()
        }
    }
}
func update(world:&Resources.World,input:@Resources.InputState,state:&SuspensionScene,simulation:&Application.Simulation,controller:&Application.Controller) {
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if state.smoke { smoke_commands(state,simulation,controller) }
    else {
        for event in input.events() { if !state.controls.handle(event) { let handled=state.ui.handle(event) } }
        perform(state,simulation)
    }
    state.accumulator+=simulation.delta()
    while state.accumulator>=1.0/120.0 && !simulation.is_paused() {
        remember(state);let loaded=state.model.load_remaining>0.0
        state.model.step(1.0/120.0);state.accumulator-=1.0/120.0
        if state.smoke {
            state.model.verify()
            if state.phase==1 {
                if state.model.supports()==0 { state.lost=true }
                if state.lost && state.model.supports()==4 { state.returned=true }
                state.peak=Math.max(state.peak,state.model.vehicle.chassis().position().y)
            }
            if state.phase==29 || state.phase==31 {
                let position=state.model.vehicle.chassis().position()
                if position.z>2.0 && position.z<8.0 {
                    if state.phase==29 { state.ray_peak=Math.max(state.ray_peak,position.y) }
                    else { state.sphere_peak=Math.max(state.sphere_peak,position.y) }
                }
                for i in [0,1,2,3] {
                    if let support=state.model.vehicle.wheel(i).support() { if support.same_body(state.model.barrier!) { state.obstacle_hits++ } }
                }
            }
            if state.phase==2 && loaded {
                state.loaded_min=Math.min(state.loaded_min,state.model.vehicle.chassis().position().y)
                state.loaded_force=Math.max(state.loaded_force,state.model.force())
            }
        }
    }
    state.telemetry+=simulation.delta()
    if state.telemetry>=0.1 { state.telemetry=0.0;labels(state,simulation) }
    if state.ui.update(0.0) {
        world.update<Scene2D.Canvas>(state.panel,func(canvas:&Scene2D.Canvas) { canvas.replace(state.ui.drawing(1180,368)) })
    }
}
func wheel_angle(previous:float,current:float,alpha:float) float {
    var change=Math.remainder(current-previous,Math.two_pi())
    if change>Math.pi() { change-=Math.two_pi() } else if change< -Math.pi() { change+=Math.two_pi() }
    return previous+change*alpha
}
func render(world:&Resources.World,state:&SuspensionScene,camera:&Resources.ViewportCamera3D) {
    let current=state.model.vehicle.chassis().transform();let alpha=Math.clamp(state.accumulator*120.0,0.0,1.0)
    var rotation=current.rotation;if state.previous.rotation.dot(rotation)<0.0 { rotation=rotation.multiply(-1.0) }
    let pose=Physics.Transform3D(state.previous.position.lerp(current.position,alpha),state.previous.rotation.multiply(1.0-alpha).add(rotation.multiply(alpha)).normalized())
    world.update<Components.Transform3D>(state.chassis,func(t:&Components.Transform3D) { t.position=pose.position;t.rotation=pose.rotation })
    world.update<Components.Transform3D>(state.nose,func(t:&Components.Transform3D) { t.position=pose.point(Math.Vec3(0.0,0.0,1.21));t.rotation=pose.rotation })
    for i in [0,1] {
        world.update<Components.Transform3D>(state.axles[i],func(t:&Components.Transform3D) {
            t.position=pose.point(Math.Vec3(0.0,0.0,2.0*i as float-1.0));t.rotation=pose.rotation
        })
    }
    for i in [0,1,2,3] {
        let settings=state.model.vehicle.wheel_settings(i);var wheel=state.model.vehicle.wheel(i)
        let turn=state.steering_angles[i]+(wheel.steering_angle-state.steering_angles[i])*alpha
        let steering=Math.Quat.angle_axis(turn,settings.steering_axis)
        let spin=pose.rotation.multiply(steering).multiply(Math.Quat.angle_axis(wheel_angle(state.angles[i],wheel.rotation_angle,alpha),Math.Vec3.right()))
        let tire_rotation=spin.multiply(state.wheel_orientation)
        let length=state.lengths[i]+(wheel.length-state.lengths[i])*alpha
        let center=pose.point(settings.position.add(settings.direction.multiply(length)))
        world.update<Components.Transform3D>(state.tires[i],func(t:&Components.Transform3D) { t.position=center;t.rotation=tire_rotation })
        world.update<Components.Transform3D>(state.hubs[i],func(t:&Components.Transform3D) { t.position=center;t.rotation=tire_rotation })
        world.update<Components.Transform3D>(state.spokes[i],func(t:&Components.Transform3D) { t.position=center;t.rotation=spin })
        world.update<Components.Transform3D>(state.springs[i],func(t:&Components.Transform3D) {
            t.position=pose.point(settings.position.add(settings.direction.multiply(length*0.5)));t.rotation=pose.rotation;t.scale=Math.Vec3(0.045,Math.max(0.001,length),0.045)
        })
        let visible=wheel.support()!=null
        if world.get<Components.Mesh3D>(state.markers[i]).visible!=visible {
            world.update<Components.Mesh3D>(state.markers[i],func(m:&Components.Mesh3D) { m.visible=visible })
        }
        if visible { world.update<Components.Transform3D>(state.markers[i],func(t:&Components.Transform3D) { t.position=wheel.contact_point.add(Math.Vec3(0.0,0.015,0.0)) }) }
        if state.smoke {
            assert(world.get<Components.Transform3D>(state.tires[i]).position.nearly_equal(center,0.00001))
            assert(world.get<Components.Transform3D>(state.tires[i]).rotation==tire_rotation)
            assert(world.get<Components.Transform3D>(state.spokes[i]).position.nearly_equal(center,0.00001))
            assert(world.get<Components.Transform3D>(state.spokes[i]).rotation==spin)
            assert(world.get<Components.Mesh3D>(state.markers[i]).visible==visible)
        }
    }
    if state.barrier_visible!=state.model.obstacle {
        state.barrier_visible=state.model.obstacle
        world.update<Components.Mesh3D>(state.barrier,func(m:&Components.Mesh3D) { m.visible=state.barrier_visible })
    }
    camera.set_target(Math.Vec3(pose.position.x,2.85,pose.position.z))
    let view=camera.transform()
    if world.is_alive(camera.entity()) {
        world.update<Components.Transform3D>(camera.entity(),func(t:&Components.Transform3D) { t.position=view.position;t.rotation=view.rotation })
    }
    let grid_x=Math.floor(pose.position.x/5.0+0.5)*5.0;let grid_z=Math.floor(pose.position.z/5.0+0.5)*5.0
    if grid_x!=state.grid_x || grid_z!=state.grid_z {
        state.grid_x=grid_x;state.grid_z=grid_z
        world.update<Components.Transform3D>(state.floor,func(t:&Components.Transform3D) { t.position=Math.Vec3(grid_x,-0.1,grid_z) })
        var i=0
        for line in state.grid {
            var position=Math.Vec3(grid_x,0.004,grid_z+(i-15) as float)
            if i>=31 { position=Math.Vec3(grid_x+(i-46) as float,0.004,grid_z) }
            world.update<Components.Transform3D>(line,func(t:&Components.Transform3D) { t.position=position });i++
        }
    }
    if state.smoke {
        assert(world.get<Components.Transform3D>(state.chassis).position.nearly_equal(pose.position,0.00001))
        assert(world.is_alive(camera.entity()))
        let actual=world.get<Components.Transform3D>(camera.entity())
        assert(actual.position.nearly_equal(view.position,0.00001) && actual.rotation==view.rotation)
        verify_framing(world,state,Scene3D.Transform(actual.position,actual.rotation))
        if state.model.obstacle { state.obstacle_frames++ }
    }
}
func verify_controls() {
    var world=Resources.World();var meshes=Resources.Meshes3D();var state=SuspensionScene();var simulation=Application.Simulation()
    var camera=Resources.ViewportCamera3D(camera_settings())
    startup(world,meshes,state,simulation);render(world,state,camera);verify_framing(world,state,camera.transform())
    assert(state.controls.handle(InputCheck.key_event(Input.Key.space,32 as uint32)));perform(state,simulation);assert(simulation.is_paused())
    assert(state.controls.handle(InputCheck.key_event(Input.Key.space,32 as uint32,true)));perform(state,simulation);assert(simulation.is_paused())
    assert(state.controls.handle(InputCheck.key_event(Input.Key.x,98 as uint32)));perform(state,simulation)
    assert(!simulation.is_paused() && state.model.jumps==1 && state.model.vehicle.chassis().linear_velocity().y==5.0)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.b,66 as uint32,true)));perform(state,simulation);assert(state.model.jumps==1)
    simulation.pause();assert(state.controls.handle(InputCheck.key_event(Input.Key.c,0 as uint32)));perform(state,simulation)
    assert(!simulation.is_paused() && state.model.load_remaining==2.0)
    state.controls.pause();perform(state,simulation);let held=copy state.model.vehicle.chassis().transform();let remaining=state.model.load_remaining
    render(world,state,camera);assert(state.model.vehicle.chassis().transform()==held && state.model.load_remaining==remaining)
    var old=state.model.vehicle
    assert(state.controls.handle(InputCheck.key_event(Input.Key.r,82 as uint32)));perform(state,simulation)
    assert(!old.is_valid() && !simulation.is_paused() && state.model.steps==0)
    InputCheck.click(state.ui,100.0,103.0);perform(state,simulation);assert(state.model.jumps==1)
    InputCheck.click(state.ui,330.0,103.0);perform(state,simulation);assert(state.model.loads==1)
    InputCheck.click(state.ui,800.0,103.0);perform(state,simulation);assert(simulation.is_paused())
    old=state.model.vehicle;InputCheck.click(state.ui,560.0,103.0);perform(state,simulation);assert(!old.is_valid() && !simulation.is_paused())
    assert(state.controls.handle(InputCheck.key_event(Input.Key.b,0 as uint32)));perform(state,simulation);assert(state.model.jumps==1)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.c,67 as uint32)));perform(state,simulation);assert(state.model.loads==1)
    remember(state);render(world,state,camera)
    assert(world.get<Components.Transform3D>(state.chassis).position==state.model.vehicle.chassis().position())
    simulation.pause();assert(state.controls.handle(InputCheck.key_event(Input.Key.x,112 as uint32)));perform(state,simulation)
    assert(!simulation.is_paused() && state.model.pushes==1)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.p,80 as uint32,true)));perform(state,simulation);assert(state.model.pushes==1)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.v,0 as uint32)));perform(state,simulation);assert(state.model.pushes==2)
    old=state.model.vehicle;assert(state.controls.handle(InputCheck.key_event(Input.Key.g,71 as uint32)));perform(state,simulation)
    assert(!old.is_valid() && !state.model.grip && state.model.pushes==0)
    InputCheck.click(state.ui,100.0,149.0);perform(state,simulation);assert(state.model.pushes==1)
    InputCheck.click(state.ui,330.0,149.0);perform(state,simulation);assert(state.model.pushes==2)
    old=state.model.vehicle;InputCheck.click(state.ui,560.0,149.0);perform(state,simulation)
    assert(!old.is_valid() && state.model.grip && state.model.pushes==0)
    assert(Math.abs(wheel_angle(6.2,0.1,0.5)-(6.2+(Math.two_pi()+0.1-6.2)*0.5))<0.00001)
    var step=0;while step<240 { remember(state);state.model.step(1.0/120.0);step++ }
    state.model.push_forward();step=0;while step<240 { remember(state);state.model.step(1.0/120.0);step++ }
    render(world,state,camera);verify_framing(world,state,camera.transform())
    assert(world.get<Components.Transform3D>(state.spokes[0]).rotation!=Math.Quat())
    simulation.pause();assert(state.controls.handle(InputCheck.key_event(Input.Key.right,0 as uint32)));perform(state,simulation)
    assert(!simulation.is_paused() && state.model.steering==0.6)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.left,0 as uint32,true)));perform(state,simulation);assert(state.model.steering==0.6)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.up,0 as uint32)));perform(state,simulation);assert(state.model.steering==0.0)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.x,102 as uint32)));perform(state,simulation);assert(state.model.braking)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.f,70 as uint32,true)));perform(state,simulation);assert(state.model.braking)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.h,0 as uint32)));perform(state,simulation);assert(state.model.handbraking)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.h,72 as uint32)));perform(state,simulation);assert(!state.model.handbraking)
    InputCheck.click(state.ui,100.0,195.0);perform(state,simulation);assert(state.model.steering== -0.6)
    InputCheck.click(state.ui,330.0,195.0);perform(state,simulation);assert(state.model.steering==0.0)
    InputCheck.click(state.ui,560.0,195.0);perform(state,simulation);assert(state.model.steering==0.6)
    InputCheck.click(state.ui,800.0,195.0);perform(state,simulation);assert(!state.model.braking)
    InputCheck.click(state.ui,1050.0,195.0);perform(state,simulation);assert(state.model.handbraking)
    state.controls.reset();perform(state,simulation);assert(!state.model.braking && !state.model.handbraking && state.model.steering==0.0)
    simulation.pause();assert(state.controls.handle(InputCheck.key_event(Input.Key.z,122 as uint32)));perform(state,simulation)
    assert(!simulation.is_paused() && state.model.throttle==0.6)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.z,90 as uint32,true)));perform(state,simulation);assert(state.model.throttle==0.6)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.x,88 as uint32)));perform(state,simulation);assert(state.model.throttle==0.0)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.s,0 as uint32)));perform(state,simulation);assert(state.model.throttle== -0.5)
    InputCheck.click(state.ui,100.0,241.0);perform(state,simulation);assert(state.model.throttle==0.6)
    InputCheck.click(state.ui,330.0,241.0);perform(state,simulation);assert(state.model.throttle==0.0)
    InputCheck.click(state.ui,560.0,241.0);perform(state,simulation);assert(state.model.throttle== -0.5)
    state.controls.reset();perform(state,simulation);assert(state.model.throttle==0.0 && state.model.vehicle.powertrain().gear==0)
    old=state.model.vehicle;simulation.pause()
    assert(state.controls.handle(InputCheck.key_event(Input.Key.t,116 as uint32)));perform(state,simulation)
    assert(!old.is_valid() && state.model.sphere_contact && !simulation.is_paused() && state.model.throttle==0.0)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.t,84 as uint32,true)));perform(state,simulation);assert(state.model.sphere_contact)
    assert(state.controls.handle(InputCheck.key_event(Input.Key.t,0 as uint32)));perform(state,simulation);assert(!state.model.sphere_contact)
    InputCheck.click(state.ui,800.0,241.0);perform(state,simulation);assert(state.model.sphere_contact)
    state.controls.reset();perform(state,simulation);assert(state.model.sphere_contact)
    state.controls.automatic=true;assert(!state.controls.handle(InputCheck.key_event(Input.Key.b,98 as uint32)))
    print("Suspension controls: logical keys, physical fallback, uppercase, repetition, buttons, pause and recreation verified")
}
test "vehicle controls reach actions through keys and buttons while preserving pause" { verify_controls() }
func main() {
    var smoke=false
    for argument in Process.arguments() {
        if argument=="--physics-check" { Model.verify_physics();Model.verify_rolling();Model.verify_driving();Model.verify_powered();Model.verify_obstacle();return }
        if argument=="--controls-check" { verify_controls();return }
        if argument=="--smoke" { smoke=true }
    }
    var state=SuspensionScene(obstacle:!smoke,sphere_contact:!smoke)
    if smoke { state.smoke=true;state.controls.automatic=true;state.ui=UI.Session(state.controls.describe()) }
    var title="Rayon ou sphère — franchir une arête"
    if state.smoke { title="TEST AUTOMATIQUE — obstacle et contacts — fermeture à la fin" }
    Application() ..add_resource(state)
        ..add_plugin(Plugins.Window(Plugins.Window.Settings() ..title=title ..width=1280 ..height=800))
        ..add_plugin(Plugins.Time()) ..add_plugin(Plugins.Scene3D()) ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.ViewportCamera3D(camera_settings()))
        ..add_system(Application.Schedule.startup,startup)
        ..add_system(Application.Schedule.update,update,process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.render,render,process_mode:Application.ProcessMode.always) ..run()
}
