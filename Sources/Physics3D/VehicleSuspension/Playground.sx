use GFX.Physics
use STD.Math

package func radius(monster:bool) float { if monster { return 0.65 }return 0.32 }
package func chassis_size(monster:bool) Math.Vec3 { if monster { return Math.Vec3(1.6,0.5,2.8) }return Math.Vec3(1.4,0.4,2.4) }
package func create_vehicle(world:Physics.World3D,contact:Physics.WheelContact3D,monster:bool,soft:bool,anti_roll:bool,limited:bool,grip:bool) Physics.WheeledVehicle3D {
    var coefficient=2.25;if !grip { coefficient=0.0 }
    let curve=Physics.TireFrictionCurve3D([Math.Vec2(0.0,coefficient)])
    var inertia=1.0;if monster { inertia=4.0 }
    let tire=Physics.Tire3DSettings(inertia:inertia,angular_damping:0.15,longitudinal_friction:curve,lateral_friction:curve,combined_friction:true)
    var length=0.65;var track=0.9;var station=1.0;if monster { length=0.85;track=1.15;station=1.4 }
    var stiffness=2200.0;var damping=350.0;if !soft { stiffness=6500.0;damping=850.0 }
    let sides:float[]=[-1.0,1.0];var wheels:Physics.Wheel3DSettings[]=[]
    for x in sides { for z in sides {
        var steering=0.0;var handbrake=4000.0;if z>0.0 { steering=0.6;handbrake=0.0 }
        wheels.append(Physics.Wheel3DSettings(Math.Vec3(track*x,0.0,station*z),radius:radius(monster),maximum_length:length,
            stiffness:stiffness,damping:damping,tire:tire,contact:contact,maximum_steering_angle:steering,
            maximum_brake_torque:2200.0,maximum_handbrake_torque:handbrake))
    } }
    var bars:Physics.VehicleAntiRollBar3DSettings[]=[]
    if anti_roll { bars=[Physics.VehicleAntiRollBar3DSettings(0,2,stiffness:1200.0),Physics.VehicleAntiRollBar3DSettings(1,3,stiffness:1200.0)] }
    var center=Math.Vec3(0.0,-0.25,0.0);if monster { center=Math.Vec3(0.0,-0.55,0.0) }
    var limit=Math.pi();if limited { limit=Math.pi()/3.0 }
    return world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(
        Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(chassis_size(monster)))
            ..transform=Physics.Transform3D(Math.Vec3(0.0,length+radius(monster)+0.35,0.0)) ..allow_sleep=false
            ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(120.0,170.0,120.0),center)
            ..linear_damping=0.03 ..angular_damping=0.15 ..continuous_collision=true,
        wheels,engine:Physics.VehicleEngine3DSettings(maximum_torque:180.0,angular_damping:0.4),
        transmission:Physics.VehicleTransmission3DSettings(gear_ratios:[2.4,1.5,1.0],reverse_gear_ratios:[-2.4],switch_time:0.08,clutch_release_time:0.08,switch_latency:0.15),
        differentials:[Physics.VehicleDifferential3DSettings(0,2,ratio:3.5,engine_torque_ratio:0.5),
            Physics.VehicleDifferential3DSettings(1,3,ratio:3.5,engine_torque_ratio:0.5)],anti_roll_bars:bars,maximum_tilt_angle:limit))
}
