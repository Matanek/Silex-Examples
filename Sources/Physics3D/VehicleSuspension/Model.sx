use GFX.Physics
use STD.Math
func create_vehicle(world:Physics.World3D, grip:bool) Physics.WheeledVehicle3D {
    var wheels:Physics.Wheel3DSettings[]=[]
    var tire=Physics.Tire3DSettings()
    if !grip {
        let none=Physics.TireFrictionCurve3D([Math.Vec2(0.0,0.0)])
        tire=Physics.Tire3DSettings(longitudinal_friction:none,lateral_friction:none)
    }
    let sides:int[]=[-1,1]
    for x in sides { for z in sides {
        var turn=0.0;var hand=20.0
        if z>0 { turn=Math.radians(30.0);hand=0.0 }
        wheels.append(Physics.Wheel3DSettings(Math.Vec3(0.9*x as float,0.0,z as float),tire:tire,
            maximum_steering_angle:turn,maximum_handbrake_torque:hand))
    } }
    return world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(
        Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.4,0.4,2.4)))
            ..transform=Physics.Transform3D(Math.Vec3(0.0,1.4,0.0)) ..allow_sleep=false
            ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
            ..linear_damping=0.0 ..angular_damping=0.0,wheels,
        engine:Physics.VehicleEngine3DSettings(maximum_torque:30.0),
        differentials:[Physics.VehicleDifferential3DSettings(0,2)]))
}

package class SuspensionModel {
    var world:Physics.World3D=Physics.World3D()
    var vehicle:Physics.WheeledVehicle3D
    var grip:bool=true
    var pushes:int=0
    var throttle:float=0.0
    var steering:float=0.0
    var braking:bool=false
    var handbraking:bool=false
    var load_remaining:float=0.0
    var steps:int=0
    var jumps:int=0
    var loads:int=0
    init() {
        self.world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
            ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..friction=1.0)
        self.vehicle=create_vehicle(self.world,self.grip)
    }
    func reset() {
        self.world.destroy_wheeled_vehicle(self.vehicle);self.vehicle=create_vehicle(self.world,self.grip)
        self.load_remaining=0.0;self.steps=0;self.jumps=0;self.loads=0;self.pushes=0;self.steering=0.0;self.throttle=0.0;self.braking=false;self.handbraking=false
    }
    func apply_controls() {
        var brake=0.0;var hand=0.0;if self.braking { brake=1.0 }
        if self.handbraking { hand=1.0 }
        self.vehicle.set_controls(steering:self.steering,brake:brake,handbrake:hand,throttle:self.throttle)
    }
    func accelerate(value:float) { self.throttle=value;self.apply_controls() }
    func steer(value:float) { self.steering=value;self.apply_controls() }
    func toggle_brake() { self.braking=!self.braking;self.apply_controls() }
    func toggle_handbrake() { self.handbraking=!self.handbraking;self.apply_controls() }
    func toggle_grip() { self.grip=!self.grip;self.reset() }
    func push_forward() { self.vehicle.chassis().apply_impulse(self.vehicle.chassis().transform().vector(Math.Vec3(0.0,0.0,200.0)));self.pushes++ }
    func push_sideways() { self.vehicle.chassis().apply_impulse(self.vehicle.chassis().transform().vector(Math.Vec3(200.0,0.0,0.0)));self.pushes++ }
    func jump() { self.vehicle.chassis().apply_impulse(Math.Vec3(0.0,500.0,0.0));self.jumps++ }
    func load() { self.load_remaining=2.0;self.loads++ }
    func step(delta:float) {
        if self.load_remaining>0.0 {
            self.vehicle.chassis().apply_force(Math.Vec3(0.0,-20000.0,0.0))
            self.load_remaining=Math.max(0.0,self.load_remaining-delta)
        }
        self.world.step(delta);self.steps++
    }
    func supports() int {
        var count=0;for i in [0,1,2,3] { if self.vehicle.wheel(i).support()!=null { count++ } }
        return count
    }
    func force() float {
        var total=0.0;for i in [0,1,2,3] { total+=self.vehicle.wheel(i).normal_force }
        return total
    }
    func verify() {
        var body=self.vehicle.chassis()
        assert(self.world.body_count()==2 && self.vehicle.wheel_count()==4)
        assert(body.position().y>0.47 && Math.abs(body.position().y)<10.0 && body.linear_velocity().length()<15.0)
        for i in [0,1,2,3] {
            var wheel=self.vehicle.wheel(i)
            assert(wheel.length>=0.0 && wheel.length<=0.60001 && wheel.normal_force>=0.0 && wheel.normal_force<100000.0)
        }
    }
    func verify_rest() {
        assert(self.supports()==4 && Math.abs(self.vehicle.chassis().position().y-0.875475)<0.003)
        assert(Math.abs(self.force()-981.0)<2.0)
    }
}
package func verify_physics() {
    for rate in [60,120] {
        var model=SuspensionModel();var i=0
        while i<rate*2 { model.step(1.0/rate as float);model.verify();i++ }
        model.verify_rest()
        model.jump();var lost=false;var returned=false;var peak=0.0;i=0
        while i<rate*4 {
            model.step(1.0/rate as float);model.verify();peak=Math.max(peak,model.vehicle.chassis().position().y)
            if model.supports()==0 { lost=true }
            if lost && model.supports()==4 { returned=true }
            i++
        }
        assert(lost && returned && peak>2.0);model.verify_rest()
        model.load();var lowest=10.0;var largest_force=0.0;i=0
        while i<rate*3 {
            model.step(1.0/rate as float);model.verify()
            lowest=Math.min(lowest,model.vehicle.chassis().position().y);largest_force=Math.max(largest_force,model.force());i++
        }
        assert(lowest<0.53 && largest_force>15000.0 && model.load_remaining==0.0)
        i=0;while i<rate*2 { model.step(1.0/rate as float);i++ }
        model.verify_rest()
        var old=model.vehicle;model.reset();assert(!old.is_valid() && model.steps==0 && model.jumps==0 && model.loads==0)
    }
    print("Suspension physics: rest, jump, lost/regained support, loaded stop, recovery and recreation verified at 60/120 Hz")
}
test "visible vehicle uses physical suspensions under weight impulse and temporary overload" { verify_physics() }

package func verify_rolling() {
    for rate in [60,120] { for grip in [false,true] { for sideways in [false,true] {
        var model=SuspensionModel();if !grip { model.toggle_grip() }
        var step=0;while step<rate*2 { model.step(1.0/rate as float);step++ }
        model.verify_rest()
        if sideways { model.push_sideways() } else { model.push_forward() }
        step=0;while step<rate*2 { model.step(1.0/rate as float);model.verify();step++ }
        var body=model.vehicle.chassis()
        if !grip {
            var distance=body.position().z;if sideways { distance=body.position().x }
            assert(Math.abs(distance-4.0)<0.01 && model.vehicle.wheel(0).rotation_angle==0.0)
        } else if sideways {
            assert(Math.abs(body.linear_velocity().x)<0.02 && Math.abs(body.position().x)<0.6)
        } else {
            assert(body.position().z>1.5 && body.position().z<3.5 && model.vehicle.wheel(0).angular_velocity>3.0)
        }
        assert(model.pushes==1)
        var old=model.vehicle;model.toggle_grip();assert(!old.is_valid() && model.grip!=grip && model.steps==0)
    } } }
    print("Passive rolling scene: longitudinal spin, lateral grip, slippery comparison and recreation verified at 60/120 Hz")
}
test "visible tires spin from contact and distinguish rolling from lateral sliding" { verify_rolling() }

package func settle(model:SuspensionModel,rate:int,seconds:int) {
    var step=0;while step<rate*seconds { model.step(1.0/rate as float);model.verify();step++ }
}
package func verify_driving() {
    let signs:float[]=[-1.0,1.0]
    for rate in [60,120] {
        for sign in signs {
            var model=SuspensionModel();settle(model,rate,2);model.push_forward();settle(model,rate,1)
            model.steer(sign*0.6);settle(model,rate,2)
            assert(sign*model.vehicle.chassis().position().x< -0.2)
            assert(Math.abs(model.vehicle.wheel(1).steering_angle+sign*Math.radians(18.0))<0.00001)
            assert(model.vehicle.wheel(0).steering_angle==0.0)
            model.steer(0.0);model.toggle_brake();settle(model,rate,3)
            assert(model.vehicle.chassis().linear_velocity().length()<0.02)
            model.reset();assert(model.steering==0.0 && !model.braking && !model.handbraking)
        }
        var hand=SuspensionModel();settle(hand,rate,2);hand.push_forward();settle(hand,rate,1)
        hand.toggle_handbrake();settle(hand,rate,3);assert(hand.vehicle.chassis().linear_velocity().length()<0.02)
        for i in [1,3] { assert(hand.vehicle.wheel(i).brake_torque==0.0) }
        hand.toggle_handbrake();hand.push_forward();settle(hand,rate,1);assert(hand.vehicle.chassis().linear_velocity().length()>0.5)
        var slide=SuspensionModel();slide.toggle_grip();settle(slide,rate,2);slide.push_forward();settle(slide,rate,1)
        slide.steer(0.6);slide.toggle_brake();slide.toggle_handbrake();settle(slide,rate,2)
        assert(Math.abs(slide.vehicle.chassis().position().x)<0.01 && Math.abs(slide.vehicle.chassis().linear_velocity().z-2.0)<0.01)
        assert(Math.abs(slide.vehicle.wheel(1).steering_angle+Math.radians(18.0))<0.00001)
    }
    print("Vehicle driving scene: mirrored turns, service stop, rear handbrake, release, reset and no-grip comparison verified at 60/120 Hz")
}
test "vehicle steering and brakes act through real tire contact" { verify_driving() }

package func verify_powered() {
    for rate in [60,120] {
        var drive=SuspensionModel();settle(drive,rate,2);drive.accelerate(0.6);settle(drive,rate,3)
        assert(drive.vehicle.chassis().position().z>1.0 && drive.vehicle.chassis().linear_velocity().z>0.5)
        assert(drive.vehicle.powertrain().gear>0 && drive.vehicle.powertrain().engine_rpm>=1000.0)
        drive.accelerate(0.0);drive.toggle_brake();settle(drive,rate,3)
        assert(drive.vehicle.chassis().linear_velocity().length()<0.03)
        var reverse=SuspensionModel();settle(reverse,rate,2);reverse.accelerate(-0.5);settle(reverse,rate,3)
        assert(reverse.vehicle.chassis().position().z< -1.0 && reverse.vehicle.powertrain().gear<0)
        reverse.accelerate(0.0);reverse.toggle_brake();settle(reverse,rate,3)
        assert(reverse.vehicle.chassis().linear_velocity().length()<0.03)
        var turn=SuspensionModel();settle(turn,rate,2);turn.steer(0.4);turn.accelerate(0.6);settle(turn,rate,3)
        assert(turn.vehicle.chassis().position().x< -0.2)
        var slide=SuspensionModel();slide.toggle_grip();settle(slide,rate,2);slide.accelerate(0.6);settle(slide,rate,2)
        assert(Math.abs(slide.vehicle.chassis().position().z)<0.01 && slide.vehicle.wheel(0).angular_velocity>1.0)
        slide.accelerate(0.0);slide.toggle_brake();settle(slide,rate,2)
        assert(Math.abs(slide.vehicle.chassis().position().z)<0.01)
        slide.reset();assert(slide.throttle==0.0 && slide.vehicle.powertrain().gear==0)
    }
    print("Powered driving scene: engine acceleration, reverse, braking, powered turn, no-grip wheel spin and reset verified at 60/120 Hz")
}
test "visible powered vehicle accelerates and reverses only through tire contact" { verify_powered() }
