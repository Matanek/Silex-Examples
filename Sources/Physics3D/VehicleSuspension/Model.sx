use GFX.Physics
use STD.Math
package enum ContactMode { ray; sphere; wide; narrow }
package func contact_name(mode:ContactMode) str {
    match mode {
        ray => { return "rayon" }
        sphere => { return "sphère" }
        wide => { return "cylindre 40 cm" }
        narrow => { return "cylindre 8 cm" }
    }
}
package func wheel_width(mode:ContactMode) float {
    match mode {
        wide => { return 0.4 }
        narrow => { return 0.08 }
        else => { return 0.2 }
    }
}
package func obstacle_size() Math.Vec3 { return Math.Vec3(1.68,0.18,4.0) }
package func obstacle_transform() Physics.Transform3D { return Physics.Transform3D(Math.Vec3(0.0,0.09,5.0)) }
package func maximum_length(soft:bool) float {
    // Même hauteur sous 100 kg : compenser la compression statique du ressort.
    if soft { return 0.6+245.25/1200.0-245.25/10000.0 }
    return 0.6
}
package func pitch(pose:Physics.Transform3D) float {
    return Math.asin(Math.clamp(pose.vector(Math.Vec3(0.0,0.0,1.0)).y,-1.0,1.0))
}
package func roll(pose:Physics.Transform3D) float {
    return Math.atan2(pose.vector(Math.Vec3.right()).y,pose.vector(Math.Vec3.up()).y)
}
func create_vehicle(world:Physics.World3D, grip:bool, contacts:ContactMode, soft:bool) Physics.WheeledVehicle3D {
    var wheels:Physics.Wheel3DSettings[]=[]
    var tire=Physics.Tire3DSettings()
    if !grip {
        let none=Physics.TireFrictionCurve3D([Math.Vec2(0.0,0.0)])
        tire=Physics.Tire3DSettings(longitudinal_friction:none,lateral_friction:none)
    }
    var contact=Physics.WheelContact3D.ray
    match contacts {
        sphere => { contact=Physics.WheelContact3D.sphere(0.12) }
        wide => { contact=Physics.WheelContact3D.cylinder(wheel_width(contacts)) }
        narrow => { contact=Physics.WheelContact3D.cylinder(wheel_width(contacts)) }
        else => {}
    }
    var stiffness=10000.0;var damping=1000.0
    if soft { stiffness=1200.0;damping=160.0 }
    let length=maximum_length(soft)
    let sides:int[]=[-1,1]
    for x in sides { for z in sides {
        var turn=0.0;var hand=20.0
        if z>0 { turn=Math.radians(30.0);hand=0.0 }
        wheels.append(Physics.Wheel3DSettings(Math.Vec3(0.9*x as float,0.0,z as float),tire:tire,
            maximum_steering_angle:turn,maximum_handbrake_torque:hand,contact:contact,
            stiffness:stiffness,damping:damping,maximum_length:length))
    } }
    return world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(
        Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.4,0.4,2.4)))
            ..transform=Physics.Transform3D(Math.Vec3(0.0,1.4,0.0)) ..allow_sleep=false
            ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
            ..linear_damping=0.0 ..angular_damping=0.0,wheels,
        engine:Physics.VehicleEngine3DSettings(maximum_torque:30.0),
        differentials:[Physics.VehicleDifferential3DSettings(0,2)]))
}

package class SuspensionModel {
    var world:Physics.World3D=Physics.World3D()
    var vehicle:Physics.WheeledVehicle3D
    var obstacle:bool=false
    var barrier:Physics.RigidBody3D?=null
    var contacts:ContactMode=ContactMode.ray
    var soft:bool=false
    var grip:bool=true
    var pushes:int=0
    var throttle:float=0.0
    var steering:float=0.0
    var braking:bool=false
    var handbraking:bool=false
    var load_remaining:float=0.0
    var steps:int=0
    var jumps:int=0
    var loads:int=0
    init(obstacle:bool=false,contacts:ContactMode=ContactMode.ray,soft:bool=false) {
        self.obstacle=obstacle;self.contacts=contacts;self.soft=soft
        self.world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
            ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..friction=1.0)
        if obstacle {
            self.barrier=self.world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
                ..shape=Physics.Shape3D.box(Physics.Box3D(obstacle_size())) ..transform=obstacle_transform() ..friction=1.0)
        }
        self.vehicle=create_vehicle(self.world,self.grip,self.contacts,self.soft)
    }
    func reset() {
        self.world.destroy_wheeled_vehicle(self.vehicle);self.vehicle=create_vehicle(self.world,self.grip,self.contacts,self.soft)
        self.load_remaining=0.0;self.steps=0;self.jumps=0;self.loads=0;self.pushes=0;self.steering=0.0;self.throttle=0.0;self.braking=false;self.handbraking=false
    }
    func apply_controls() {
        var brake=0.0;var hand=0.0;if self.braking { brake=1.0 }
        if self.handbraking { hand=1.0 }
        self.vehicle.set_controls(steering:self.steering,brake:brake,handbrake:hand,throttle:self.throttle)
    }
    func accelerate(value:float) { self.throttle=value;self.apply_controls() }
    func steer(value:float) { self.steering=value;self.apply_controls() }
    func toggle_brake() { self.braking=!self.braking;self.apply_controls() }
    func toggle_handbrake() { self.handbraking=!self.handbraking;self.apply_controls() }
    func toggle_contact() {
        match self.contacts {
            ray => { self.contacts=ContactMode.sphere }
            sphere => { self.contacts=ContactMode.wide }
            wide => { self.contacts=ContactMode.narrow }
            narrow => { self.contacts=ContactMode.ray }
        }
        self.reset()
    }
    func toggle_suspension() { self.soft=!self.soft;self.reset() }
    func toggle_grip() { self.grip=!self.grip;self.reset() }
    func push_forward() { self.vehicle.chassis().apply_impulse(self.vehicle.chassis().transform().vector(Math.Vec3(0.0,0.0,200.0)));self.pushes++ }
    func push_sideways() { self.vehicle.chassis().apply_impulse(self.vehicle.chassis().transform().vector(Math.Vec3(200.0,0.0,0.0)));self.pushes++ }
    func jump() { self.vehicle.chassis().apply_impulse(Math.Vec3(0.0,500.0,0.0));self.jumps++ }
    func load() { self.load_remaining=2.0;self.loads++ }
    func step(delta:float) {
        if self.load_remaining>0.0 {
            self.vehicle.chassis().apply_force(Math.Vec3(0.0,-20000.0,0.0))
            self.load_remaining=Math.max(0.0,self.load_remaining-delta)
        }
        self.world.step(delta);self.steps++
    }
    func supports() int {
        var count=0;for i in [0,1,2,3] { if self.vehicle.wheel(i).support()!=null { count++ } }
        return count
    }
    func force() float {
        var total=0.0;for i in [0,1,2,3] { total+=self.vehicle.wheel(i).normal_force }
        return total
    }
    func verify() {
        var body=self.vehicle.chassis()
        var bodies=2;if self.obstacle { bodies=3 }
        assert(self.world.body_count()==bodies && self.vehicle.wheel_count()==4)
        assert(body.position().y>0.47 && Math.abs(body.position().y)<10.0 && body.linear_velocity().length()<15.0)
        let maximum=maximum_length(self.soft)+0.00001
        for i in [0,1,2,3] {
            var wheel=self.vehicle.wheel(i)
            assert(wheel.length>=0.0 && wheel.length<=maximum && wheel.normal_force>=0.0 && wheel.normal_force<100000.0)
        }
    }
    func verify_rest() {
        assert(self.supports()==4 && Math.abs(self.vehicle.chassis().position().y-0.875475)<0.003)
        assert(Math.abs(self.force()-981.0)<2.0)
    }
}
package func verify_physics() {
    for rate in [60,120] {
        var model=SuspensionModel();var i=0
        while i<rate*2 { model.step(1.0/rate as float);model.verify();i++ }
        model.verify_rest()
        model.jump();var lost=false;var returned=false;var peak=0.0;i=0
        while i<rate*4 {
            model.step(1.0/rate as float);model.verify();peak=Math.max(peak,model.vehicle.chassis().position().y)
            if model.supports()==0 { lost=true }
            if lost && model.supports()==4 { returned=true }
            i++
        }
        assert(lost && returned && peak>2.0);model.verify_rest()
        model.load();var lowest=10.0;var largest_force=0.0;i=0
        while i<rate*3 {
            model.step(1.0/rate as float);model.verify()
            lowest=Math.min(lowest,model.vehicle.chassis().position().y);largest_force=Math.max(largest_force,model.force());i++
        }
        assert(lowest<0.53 && largest_force>15000.0 && model.load_remaining==0.0)
        i=0;while i<rate*2 { model.step(1.0/rate as float);i++ }
        model.verify_rest()
        var old=model.vehicle;model.reset();assert(!old.is_valid() && model.steps==0 && model.jumps==0 && model.loads==0)
    }
    print("Suspension physics: rest, jump, lost/regained support, loaded stop, recovery and recreation verified at 60/120 Hz")
}
test "visible vehicle uses physical suspensions under weight impulse and temporary overload" { verify_physics() }

package func verify_rolling() {
    for rate in [60,120] { for grip in [false,true] { for sideways in [false,true] {
        var model=SuspensionModel();if !grip { model.toggle_grip() }
        var step=0;while step<rate*2 { model.step(1.0/rate as float);step++ }
        model.verify_rest()
        if sideways { model.push_sideways() } else { model.push_forward() }
        step=0;while step<rate*2 { model.step(1.0/rate as float);model.verify();step++ }
        var body=model.vehicle.chassis()
        if !grip {
            var distance=body.position().z;if sideways { distance=body.position().x }
            assert(Math.abs(distance-4.0)<0.01 && model.vehicle.wheel(0).rotation_angle==0.0)
        } else if sideways {
            assert(Math.abs(body.linear_velocity().x)<0.02 && Math.abs(body.position().x)<0.6)
        } else {
            assert(body.position().z>1.5 && body.position().z<3.5 && model.vehicle.wheel(0).angular_velocity>3.0)
        }
        assert(model.pushes==1)
        var old=model.vehicle;model.toggle_grip();assert(!old.is_valid() && model.grip!=grip && model.steps==0)
    } } }
    print("Passive rolling scene: longitudinal spin, lateral grip, slippery comparison and recreation verified at 60/120 Hz")
}
test "visible tires spin from contact and distinguish rolling from lateral sliding" { verify_rolling() }

package func settle(model:SuspensionModel,rate:int,seconds:int) {
    var step=0;while step<rate*seconds { model.step(1.0/rate as float);model.verify();step++ }
}
package func verify_driving() {
    let signs:float[]=[-1.0,1.0]
    for rate in [60,120] {
        for sign in signs {
            var model=SuspensionModel();settle(model,rate,2);model.push_forward();settle(model,rate,1)
            model.steer(sign*0.6);settle(model,rate,2)
            assert(sign*model.vehicle.chassis().position().x< -0.2)
            assert(Math.abs(model.vehicle.wheel(1).steering_angle+sign*Math.radians(18.0))<0.00001)
            assert(model.vehicle.wheel(0).steering_angle==0.0)
            model.steer(0.0);model.toggle_brake();settle(model,rate,3)
            assert(model.vehicle.chassis().linear_velocity().length()<0.02)
            model.reset();assert(model.steering==0.0 && !model.braking && !model.handbraking)
        }
        var hand=SuspensionModel();settle(hand,rate,2);hand.push_forward();settle(hand,rate,1)
        hand.toggle_handbrake();settle(hand,rate,3);assert(hand.vehicle.chassis().linear_velocity().length()<0.02)
        for i in [1,3] { assert(hand.vehicle.wheel(i).brake_torque==0.0) }
        hand.toggle_handbrake();hand.push_forward();settle(hand,rate,1);assert(hand.vehicle.chassis().linear_velocity().length()>0.5)
        var slide=SuspensionModel();slide.toggle_grip();settle(slide,rate,2);slide.push_forward();settle(slide,rate,1)
        slide.steer(0.6);slide.toggle_brake();slide.toggle_handbrake();settle(slide,rate,2)
        assert(Math.abs(slide.vehicle.chassis().position().x)<0.01 && Math.abs(slide.vehicle.chassis().linear_velocity().z-2.0)<0.01)
        assert(Math.abs(slide.vehicle.wheel(1).steering_angle+Math.radians(18.0))<0.00001)
    }
    print("Vehicle driving scene: mirrored turns, service stop, rear handbrake, release, reset and no-grip comparison verified at 60/120 Hz")
}
test "vehicle steering and brakes act through real tire contact" { verify_driving() }

package func verify_powered() {
    for rate in [60,120] {
        var drive=SuspensionModel();settle(drive,rate,2);drive.accelerate(0.6);settle(drive,rate,3)
        assert(drive.vehicle.chassis().position().z>1.0 && drive.vehicle.chassis().linear_velocity().z>0.5)
        assert(drive.vehicle.powertrain().gear>0 && drive.vehicle.powertrain().engine_rpm>=1000.0)
        drive.accelerate(0.0);drive.toggle_brake();settle(drive,rate,3)
        assert(drive.vehicle.chassis().linear_velocity().length()<0.03)
        var reverse=SuspensionModel();settle(reverse,rate,2);reverse.accelerate(-0.5);settle(reverse,rate,3)
        assert(reverse.vehicle.chassis().position().z< -1.0 && reverse.vehicle.powertrain().gear<0)
        reverse.accelerate(0.0);reverse.toggle_brake();settle(reverse,rate,3)
        assert(reverse.vehicle.chassis().linear_velocity().length()<0.03)
        var turn=SuspensionModel();settle(turn,rate,2);turn.steer(0.4);turn.accelerate(0.6);settle(turn,rate,3)
        assert(turn.vehicle.chassis().position().x< -0.2)
        var slide=SuspensionModel();slide.toggle_grip();settle(slide,rate,2);slide.accelerate(0.6);settle(slide,rate,2)
        assert(Math.abs(slide.vehicle.chassis().position().z)<0.01 && slide.vehicle.wheel(0).angular_velocity>1.0)
        slide.accelerate(0.0);slide.toggle_brake();settle(slide,rate,2)
        assert(Math.abs(slide.vehicle.chassis().position().z)<0.01)
        slide.reset();assert(slide.throttle==0.0 && slide.vehicle.powertrain().gear==0)
    }
    print("Powered driving scene: engine acceleration, reverse, braking, powered turn, no-grip wheel spin and reset verified at 60/120 Hz")
}
test "visible powered vehicle accelerates and reverses only through tire contact" { verify_powered() }

package func verify_obstacle() {
    for rate in [60,120] {
        var ray=SuspensionModel(obstacle:true)
        var sphere=SuspensionModel(obstacle:true,contacts:ContactMode.sphere)
        settle(ray,rate,2);settle(sphere,rate,2)
        ray.accelerate(0.6);sphere.accelerate(0.6)
        var ray_peak=0.0;var sphere_peak=0.0;var ray_hits=0;var sphere_hits=0;var step=0
        while step<rate*6 {
            ray.step(1.0/rate as float);sphere.step(1.0/rate as float);ray.verify();sphere.verify()
            let rp=ray.vehicle.chassis().position();let sp=sphere.vehicle.chassis().position()
            if rp.z>2.0 && rp.z<8.0 { ray_peak=Math.max(ray_peak,rp.y) }
            if sp.z>2.0 && sp.z<8.0 { sphere_peak=Math.max(sphere_peak,sp.y) }
            for i in [0,1,2,3] {
                if let support=ray.vehicle.wheel(i).support() { if support.same_body(ray.barrier!) { ray_hits++ } }
                if let support=sphere.vehicle.wheel(i).support() { if support.same_body(sphere.barrier!) { sphere_hits++ } }
            }
            step++
        }
        print("Obstacle $(rate) Hz: ray peak=$(ray_peak), sphere peak=$(sphere_peak), ray contacts=$(ray_hits), sphere contacts=$(sphere_hits)")
        assert(ray_hits==0 && sphere_hits>0 && sphere_peak>ray_peak+0.08)
        var old=sphere.vehicle;var barrier=sphere.barrier!;sphere.toggle_contact()
        assert(!old.is_valid() && sphere.contacts==ContactMode.wide && sphere.barrier!.same_body(barrier) && sphere.throttle==0.0 && sphere.steps==0)
    }
    print("Wheel obstacle scene: same raised band, ray misses, sphere supports and lifts chassis, mode recreation verified at 60/120 Hz")
}
test "spherical wheel contacts raise the driven chassis on an edge missed by central rays" { verify_obstacle() }


package func verify_width() {
    for rate in [60,120] {
        var wide=SuspensionModel(obstacle:true,contacts:ContactMode.wide)
        var narrow=SuspensionModel(obstacle:true,contacts:ContactMode.narrow)
        settle(wide,rate,2);settle(narrow,rate,2)
        wide.accelerate(0.6);narrow.accelerate(0.6)
        var wide_peak=0.0;var narrow_peak=0.0;var wide_hits=0;var narrow_hits=0;var step=0
        while step<rate*6 {
            wide.step(1.0/rate as float);narrow.step(1.0/rate as float);wide.verify();narrow.verify()
            let wp=wide.vehicle.chassis().position();let np=narrow.vehicle.chassis().position()
            if wp.z>2.0 && wp.z<8.0 { wide_peak=Math.max(wide_peak,wp.y) }
            if np.z>2.0 && np.z<8.0 { narrow_peak=Math.max(narrow_peak,np.y) }
            for i in [0,1,2,3] {
                if let support=wide.vehicle.wheel(i).support() { if support.same_body(wide.barrier!) { wide_hits++ } }
                if let support=narrow.vehicle.wheel(i).support() { if support.same_body(narrow.barrier!) { narrow_hits++ } }
            }
            step++
        }
        print("Width $(rate) Hz: wide peak=$(wide_peak), narrow peak=$(narrow_peak), wide contacts=$(wide_hits), narrow contacts=$(narrow_hits)")
        assert(wide_hits>0 && narrow_hits==0 && wide_peak>narrow_peak+0.08)
        var old=wide.vehicle;var band=wide.barrier!;wide.toggle_contact()
        assert(!old.is_valid() && wide.contacts==ContactMode.narrow && wide.barrier!.same_body(band) && wide.throttle==0.0)
        wide.toggle_contact();assert(wide.contacts==ContactMode.ray)
        wide.toggle_contact();assert(wide.contacts==ContactMode.sphere)
        wide.toggle_contact();assert(wide.contacts==ContactMode.wide)
        wide.reset();wide.toggle_grip();assert(wide.contacts==ContactMode.wide)
    }
    print("Wheel width scene: same obstacle and engine, wide cylinder supports and lifts chassis, narrow cylinder misses, recreation verified at 60/120 Hz")
}
test "cylindrical tire width changes real support and chassis lift on the same obstacle" { verify_width() }


package func verify_body_motion() {
    let directions:float[]=[-1.0,0.0,1.0]
    let modes:ContactMode[]=[ContactMode.ray,ContactMode.wide]
    for rate in [60,120] { for mode in modes { for direction in directions {
        var firm=SuspensionModel(contacts:mode)
        var soft=SuspensionModel(contacts:mode,soft:true)
        settle(firm,rate,3);settle(soft,rate,3);firm.verify_rest();soft.verify_rest()
        assert(Math.abs(firm.vehicle.chassis().position().y-soft.vehicle.chassis().position().y)<0.002)
        firm.steer(direction*0.6);soft.steer(direction*0.6);firm.accelerate(0.6);soft.accelerate(0.6)
        var fp=0.0;var sp=0.0;var fr=0.0;var sr=0.0;var travel=0.0;var lateral=0.0;var step=0
        while step<rate*3 {
            firm.step(1.0/rate as float);soft.step(1.0/rate as float);firm.verify();soft.verify()
            fp=Math.max(fp,pitch(firm.vehicle.chassis().transform()));sp=Math.max(sp,pitch(soft.vehicle.chassis().transform()))
            fr=Math.max(fr,Math.abs(roll(firm.vehicle.chassis().transform())))
            let r=roll(soft.vehicle.chassis().transform());if Math.abs(r)>Math.abs(sr) { sr=r }
            travel=Math.max(travel,(soft.vehicle.wheel(1).length+soft.vehicle.wheel(3).length-soft.vehicle.wheel(0).length-soft.vehicle.wheel(2).length)*0.5)
            lateral=Math.max(lateral,Math.abs((soft.vehicle.wheel(2).length+soft.vehicle.wheel(3).length-soft.vehicle.wheel(0).length-soft.vehicle.wheel(1).length)*0.5))
            step++
        }
        print("Motion peaks $(rate) Hz $(contact_name(mode)) turn=$(direction): pitch=$(Math.degrees(sp)), roll=$(Math.degrees(sr)), travel=$(travel)/$(lateral)")
        assert(sp>0.06 && sp>fp*3.0 && travel>0.1)
        if direction!=0.0 { assert(direction*sr< -0.02 && Math.abs(sr)>fr*3.0 && lateral>0.04) }
        else { assert(Math.abs(sr)<0.001) }
        firm.accelerate(0.0);soft.accelerate(0.0);firm.steer(0.0);soft.steer(0.0);firm.toggle_brake();soft.toggle_brake()
        var fd=0.0;var sd=0.0;var rest_force=0.0;var rest_samples=0;step=0
        while step<rate*5 {
            firm.step(1.0/rate as float);soft.step(1.0/rate as float);firm.verify();soft.verify()
            fd=Math.min(fd,pitch(firm.vehicle.chassis().transform()));sd=Math.min(sd,pitch(soft.vehicle.chassis().transform()))
            if step>=rate*4 {
                var body=soft.vehicle.chassis();let pose=body.transform()
                assert(soft.supports()==4 && Math.abs(body.position().y-0.875475)<0.003)
                assert(Math.abs(pitch(pose))<0.003 && Math.abs(roll(pose))<0.003 && body.linear_velocity().length()<0.03)
                rest_force+=soft.force();rest_samples++
            }
            step++
        }
        assert(sd< -0.08 && sd<fd*3.0)
        assert(Math.abs(pitch(soft.vehicle.chassis().transform()))<0.003 && Math.abs(roll(soft.vehicle.chassis().transform()))<0.003)
        assert(rest_samples==rate && Math.abs(rest_force/rest_samples as float-981.0)<2.0)
        print("Body motion $(rate) Hz $(contact_name(mode)) turn=$(direction): pitch firm=$(Math.degrees(fp)) soft=$(Math.degrees(sp)), dive firm=$(Math.degrees(fd)) soft=$(Math.degrees(sd)), roll firm=$(Math.degrees(fr)) soft=$(Math.degrees(sr)), travel=$(travel)/$(lateral)")
        var old=soft.vehicle;soft.toggle_suspension();assert(!old.is_valid() && !soft.soft && soft.contacts==mode && soft.throttle==0.0 && !soft.braking)
        soft.toggle_suspension();soft.reset();soft.toggle_grip();assert(soft.soft)
    } } }
    var slide=SuspensionModel(contacts:ContactMode.wide,soft:true);slide.toggle_grip();settle(slide,120,3)
    slide.steer(0.6);slide.accelerate(0.6);settle(slide,120,3)
    assert(Math.abs(pitch(slide.vehicle.chassis().transform()))<0.001 && Math.abs(roll(slide.vehicle.chassis().transform()))<0.001)
    assert(slide.vehicle.chassis().linear_velocity().length()<0.01 && slide.vehicle.wheel(0).angular_velocity>1.0)
    print("Body motion: spring/damper comparison, physical pitch/dive, mirrored roll, wheel travel, equal ride height, settled recovery and no-grip absence verified at 60/120 Hz")
}
test "soft suspensions pitch and roll under real tire forces and recover without animated angles" { verify_body_motion() }
