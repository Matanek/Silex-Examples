use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Plugins
use GFX.Resources
use GFX.Scene2D
use GFX.Scene3D
use GFX.UI
use GFX.Physics
use Physics3D.RagdollPose.Model
use Physics3D.RagdollPose.Controls
use Physics3D.ArticulatedPose.Controls as InputCheck
use STD.Math
use STD.Process

class RagdollPoseScene {
    var model:Model.RagdollPoseModel = Model.RagdollPoseModel()
    var controls:Controls.RagdollPoseControls = Controls.RagdollPoseControls()
    var ui:UI.Session
    var panel:ECS.Entity = ECS.Entity()
    var bodies:ECS.Entity[] = []
    var markers:ECS.Entity[] = []
    var previous:Physics.Transform3D[] = []
    var current:Physics.Transform3D[] = []
    var accumulator:float = 0.0
    var telemetry:float = 0.0
    var smoke:bool = false
    var smoke_phase:int = 0
    var pause_frames:int = 0
    var held_pose:Physics.Transform3D[] = []
    init() { self.ui = UI.Session(self.controls.describe()) }
}
func visual(world:&Resources.World,mesh:Scene3D.MeshHandle,size:Math.Vec3,color:Color) ECS.Entity {
    return world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(scale:size))
        ..with(Components.Mesh3D(mesh)) ..with(Components.Material3D(albedo:color,roughness:0.5)))
}
func sync_previous(state:&RagdollPoseScene) { state.model.write_pose(state.previous);state.accumulator = 0.0 }
func update_labels(state:&RagdollPoseScene,simulation:@Application.Simulation) {
    var label = "Pause (Espace)";if simulation.is_paused() { label = "Reprendre (Espace)" }
    state.controls.pause_text.set(label);state.controls.measure.set(state.model.measurement())
}
func perform(state:&RagdollPoseScene,simulation:&Application.Simulation) {
    while state.controls.resets > 0 {
        state.controls.resets--;state.model.reset();sync_previous(state);simulation.pause()
        state.controls.feedback.set("Assemblages recréés — pose détendue, en pause.")
    }
    if state.controls.has_pose {
        state.controls.has_pose = false;state.model.set_pose(state.controls.variant);sync_previous(state);simulation.pause()
        state.controls.feedback.set("Pose imposée au mannequin or ; le bleu conserve sa pose de référence.")
    }
    while state.controls.releases > 0 {
        state.controls.releases--;state.model.restore_pose();sync_previous(state);simulation.resume()
        state.controls.feedback.set("Chute libre — pause automatique après 600 ms de simulation.")
    }
    while state.controls.pauses > 0 {
        state.controls.pauses--
        if simulation.is_paused() {
            if state.model.finished() { state.model.restore_pose();sync_previous(state) }
            simulation.resume();state.controls.feedback.set("Simulation reprise — Espace pour mettre en pause.")
        } else { simulation.pause();state.controls.feedback.set("En pause — les deux poses restent figées.") }
    }
    update_labels(state,simulation)
}
func startup(world:&Resources.World,meshes:&Resources.Meshes3D,state:&RagdollPoseScene,simulation:&Application.Simulation) {
    let cube = meshes.add(Scene3D.Geometry.Cube.make())
    for instance in [0,1] {
        var color = Color.bytes(238,177,75);if instance == 1 { color = Color.bytes(75,165,225) }
        for size in state.model.sizes {
            state.bodies.append(visual(world,cube,size,color))
            state.markers.append(visual(world,cube,Math.Vec3(0.08),Color.bytes(245,245,245)))
        }
    }
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.55)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4,-1.0,-0.3).normalized(),intensity:2.5)))
    simulation.pause();sync_previous(state);update_labels(state,simulation)
    state.panel = world.spawn(ECS.EntityRecipe() ..with(Scene2D.Transform(position:Math.Vec2()))
        ..with(Scene2D.Canvas(state.ui.drawing(1180,285),1180,285) ..anchor=Math.Vec2() ..pivot=Math.Vec2()
            ..space=Scene2D.CanvasSpace.viewport ..layer=100))
}
func update(world:&Resources.World,input:@Resources.InputState,state:&RagdollPoseScene,simulation:&Application.Simulation,controller:&Application.Controller) {
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if !state.smoke {
        for event in input.events() { if !state.controls.handle(event) { let handled = state.ui.handle(event) } }
        perform(state,simulation)
    } else {
        if state.smoke_phase == 0 { state.controls.folded();state.controls.release();perform(state,simulation);state.smoke_phase = 1 }
        if state.smoke_phase == 1 && state.model.elapsed() >= 0.2 {
            state.controls.pause();perform(state,simulation);state.model.write_pose(state.held_pose);state.smoke_phase = 2
        } else if state.smoke_phase == 2 {
            assert(simulation.is_paused() && simulation.delta() == 0.0)
            state.model.write_pose(state.current)
            assert(state.current.count() == state.held_pose.count())
            var i = 0;while i < state.current.count() { assert(state.current[i] == state.held_pose[i]);i++ }
            state.pause_frames++
            if state.pause_frames == 8 { state.controls.pause();perform(state,simulation);state.smoke_phase = 3 }
        } else if state.smoke_phase == 3 && state.model.finished() {
            state.model.verify();state.controls.reset();state.controls.release();perform(state,simulation);state.smoke_phase = 4
        } else if state.smoke_phase == 4 && state.model.finished() {
            state.model.verify();print("Ragdoll pose smoke: independent hierarchies, poses, free fall, pause, reset and rendered transforms verified");controller.stop()
        }
    }
    state.accumulator += simulation.delta()
    let delta = 1.0 / 120.0
    while state.accumulator >= delta && !simulation.is_paused() {
        state.model.write_pose(state.previous);state.model.step(delta);state.accumulator -= delta
        if state.smoke { state.model.verify() }
        if state.model.finished() {
            simulation.pause();sync_previous(state)
            state.controls.feedback.set("Chute terminée — pose figée. Libérer / rejouer recommence la chute.")
            update_labels(state,simulation)
        }
    }
    state.telemetry += simulation.delta()
    if state.telemetry >= 0.1 { state.telemetry = 0.0;update_labels(state,simulation) }
    if state.ui.update(0.0) { world.update<Scene2D.Canvas>(state.panel,func(canvas:&Scene2D.Canvas) { canvas.replace(state.ui.drawing(1180,285)) }) }
}
func blended(first:Physics.Transform3D,second:Physics.Transform3D,alpha:float) Physics.Transform3D {
    var rotation = second.rotation;if first.rotation.dot(rotation) < 0.0 { rotation = rotation.multiply(-1.0) }
    return Physics.Transform3D(first.position.lerp(second.position,alpha),first.rotation.multiply(1.0-alpha).add(rotation.multiply(alpha)).normalized())
}
func render(world:&Resources.World,state:&RagdollPoseScene) {
    state.model.write_pose(state.current)
    let alpha = Math.clamp(state.accumulator * 120.0,0.0,1.0)
    var i = 0
    while i < 20 {
        let pose = blended(state.previous[i],state.current[i],alpha)
        let position = pose.point(state.model.offsets[i % 10])
        world.update<Components.Transform3D>(state.bodies[i],func(t:&Components.Transform3D) { t.position=position;t.rotation=pose.rotation })
        world.update<Components.Transform3D>(state.markers[i],func(t:&Components.Transform3D) { t.position=pose.position;t.rotation=pose.rotation })
        if state.smoke {
            assert(world.get<Components.Transform3D>(state.bodies[i]).position.nearly_equal(position,0.00001))
            assert(world.get<Components.Transform3D>(state.markers[i]).position.nearly_equal(pose.position,0.00001))
            assert(world.get<Components.Transform3D>(state.bodies[i]).rotation == pose.rotation)
        }
        i++
    }
}
func verify_interactions() {
    var world = Resources.World();var meshes = Resources.Meshes3D();var state = RagdollPoseScene();var simulation = Application.Simulation()
    startup(world,meshes,state,simulation);state.model.verify();assert(simulation.is_paused())
    state.model.write_pose(state.held_pose)
    InputCheck.click(state.ui,290.0,109.0);perform(state,simulation);assert(simulation.is_paused() && state.model.variant == 1)
    state.model.verify();state.model.write_pose(state.current)
    assert(Math.abs(state.current[2].rotation.dot(state.held_pose[2].rotation)) < 0.9)
    var i = 10;while i < 20 { assert(state.current[i] == state.held_pose[i]);i++ }
    render(world,state)
    assert(Math.abs(Math.abs(world.get<Components.Transform3D>(state.bodies[2]).rotation.dot(state.current[2].rotation)) - 1.0) < 0.00001)
    InputCheck.click(state.ui,480.0,109.0);perform(state,simulation);assert(!simulation.is_paused())
    for rate in [60,120] {
        state.model.restore_pose()
        var step = 0;while step < rate * 3 / 5 { state.model.step(1.0 / rate as float);state.model.verify();step++ }
        assert(state.model.finished());sync_previous(state);render(world,state)
        assert(world.get<Components.Transform3D>(state.bodies[0]).position.nearly_equal(state.model.instances[0].body(0).position(),0.00001))
    }
    assert(state.controls.handle(InputCheck.key_event(Input.Key.space,32 as uint32)));perform(state,simulation);assert(simulation.is_paused())
    assert(state.controls.handle(InputCheck.key_event(Input.Key.space,32 as uint32,true)));perform(state,simulation);assert(simulation.is_paused())
    var old = state.model.instances[0]
    assert(state.controls.handle(InputCheck.key_event(Input.Key.p,114 as uint32)));perform(state,simulation)
    assert(simulation.is_paused() && !old.is_valid() && state.model.variant == 0 && state.model.steps == 0)
    state.model.verify();render(world,state)
    let changed = state.ui.update(0.0);var drawing = state.ui.drawing(1180,285)
    InputCheck.click(state.ui,290.0,155.0);perform(state,simulation);assert(!simulation.is_paused())
    InputCheck.click(state.ui,290.0,155.0);perform(state,simulation);assert(simulation.is_paused())
    InputCheck.click(state.ui,100.0,109.0);perform(state,simulation);assert(state.model.variant == 0 && simulation.is_paused())
}
test "ragdoll pose controls preserve branches, independent poses, analytical fall, pause, reset and rendered transforms" { verify_interactions() }
func main() {
    var state = RagdollPoseScene()
    var arguments = Process.arguments()
    for argument in arguments {
        if argument == "--controls-check" { verify_interactions();print("Ragdoll pose: hierarchies, independent poses, analytical fall, controls and rendered transforms verified");return }
        if argument == "--smoke" { state.smoke=true;state.controls.automatic=true;state.ui=UI.Session(state.controls.describe()) }
    }
    var title = "Mannequins articulés — poses indépendantes et chute libre"
    if state.smoke { title = "TEST AUTOMATIQUE — poses ragdoll — fermeture à la fin" }
    Application() ..add_resource(state)
        ..add_plugin(Plugins.Window(Plugins.Window.Settings() ..title=title ..width=1280 ..height=800))
        ..add_plugin(Plugins.Time()) ..add_plugin(Plugins.Scene3D()) ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings() ..target=Math.Vec3(0.0,3.8,0.0)
            ..vertical_fov=0.9 ..distance=8.5 ..yaw=Math.radians(-10.0) ..pitch=Math.radians(-12.0)
            ..zoom_speed=0.0 ..scroll_zoom_speed=0.0 ..orbit_sensitivity=0.0 ..pan_sensitivity=0.0))
        ..add_system(Application.Schedule.startup,startup)
        ..add_system(Application.Schedule.update,update,process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.render,render,process_mode:Application.ProcessMode.always) ..run()
}
