use GFX.Color
use GFX.Input
use GFX.Input.Events
use GFX.UI

package class RagdollDriveControls {
    var poses:int[]=[]
    var toggles:int=0
    var pushes:int=0
    var resets:int=0
    var pauses:int=0
    var automatic:bool=false
    var pause_text:UI.State<str> = UI.State<str>("Pause (Espace)")
    var feedback:UI.State<str> = UI.State<str>("Choisissez une pose : l’or rejoint sa cible avec des efforts physiques.")
    var measure:UI.State<str> = UI.State<str>("")
    func pose_one() { self.poses.append(1) }
    func pose_two() { self.poses.append(2) }
    func neutral() { self.poses.append(0) }
    func toggle() { self.toggles++ }
    func push() { self.pushes++ }
    func reset() { self.resets++ }
    func pause() { self.pauses++ }
    func button(text:str,action:func()) UI.Button {
        var button=UI.Button(text,action)
        button.style.width=180.0;button.style.height=38.0
        button.style.background=Color.slate_700();button.style.radius=5.0
        return button
    }
    func pause_button(reads:UI.Reads) UI.View { return self.button(reads.read(self.pause_text),self.pause) }
    func status(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.feedback)) }
    func metrics(reads:UI.Reads) UI.View { return UI.Text(reads.read(self.measure)) }
    func describe() UI.View {
        var title=UI.Text("Mannequins — suivre une pose, résister, relâcher");title.style.height=34.0
        var help=UI.Text("Torses suspendus · Or : cible à choisir · Bleu : neutre · Limites anatomiques et collisions internes actives");help.style.height=24.0
        var targets=UI.Row([self.button("Pose ouverte (1)",self.pose_one),self.button("Pose repliée (2)",self.pose_two),self.button("Neutre (0)",self.neutral),self.button("Moteurs / libres (M)",self.toggle)])
        targets.style.gap=10.0
        var actions=UI.Row([self.button("Pousser le bras (P)",self.push),self.button("Recréer (R)",self.reset),UI.Reactive(self.pause_button)])
        actions.style.gap=10.0
        var rows:UI.View[]=[title,help,targets,actions,UI.Reactive(self.status),UI.Reactive(self.metrics),UI.Text("M relâche les membres or ; M à nouveau rejoint la cible. Échap : quitter. La simulation continue sans pause automatique.")]
        if self.automatic { rows=[UI.Text("TEST AUTOMATIQUE — commande de pose — fermeture à la fin"),UI.Reactive(self.metrics)] }
        var root=UI.Column(rows)
        root.style.padding=UI.Insets(16.0);root.style.gap=8.0
        root.style.background=Color.slate_900().with_alpha(0.94);root.style.foreground=Color.slate_100();root.style.radius=8.0
        return root
    }
    func handle(event:@Events.Event) bool {
        if self.automatic { return false }
        match event {
            key_pressed(key) => {
                let code=key.keycode
                let reset=code==114 as uint32 || code==82 as uint32 || (code==0 as uint32 && key.key==Input.Key.r)
                let push=code==112 as uint32 || code==80 as uint32 || (code==0 as uint32 && key.key==Input.Key.p)
                let motor=code==109 as uint32 || code==77 as uint32 || (code==0 as uint32 && key.key==Input.Key.m)
                let one=code==49 as uint32 || (code==0 as uint32 && key.key==Input.Key.num1);let two=code==50 as uint32 || (code==0 as uint32 && key.key==Input.Key.num2);let zero=code==48 as uint32 || (code==0 as uint32 && key.key==Input.Key.num0)
                if key.key==Input.Key.space || reset || push || motor || one || two || zero {
                    if !key.repeated {
                        if reset { self.reset() } else if push { self.push() } else if motor { self.toggle() }
                        else if one { self.pose_one() } else if two { self.pose_two() } else if zero { self.neutral() } else { self.pause() }
                    }
                    return true
                }
            }
            else => {}
        }
        return false
    }
}
