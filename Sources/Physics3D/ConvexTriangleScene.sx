use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use GFX.Scene3D
use STD.Math
use STD.Process

class ConvexTriangleState {
    var bodies:Physics.RigidBody3D[] = []
    var visuals:ECS.Entity[] = []
    var previous:Physics.Transform3D[] = []
    var hulls:Physics.ConvexHull3D[] = []
    var touched:bool[] = [false, false, false]
    var rendered:bool[] = [false, false, false]
    var smoke:bool = false
    var elapsed:float = 0.0
    var accumulator:float = 0.0
    var cycles:int = 0
    var steps:int = 0
    var rotated:bool = false
    var emerged:bool = false
}
func start_position(index:int) Math.Vec3 {
    if index == 0 { return Math.Vec3(-4.0, 3.8, -0.3) }
    if index == 1 { return Math.Vec3(0.0, 2.0, -0.3) }
    return Math.Vec3(4.0, 0.2, -0.3)
}
func hull_mesh(hull:Physics.ConvexHull3D) Scene3D.Geometry.Mesh {
    var vertices:Scene3D.Geometry.Vertex[] = []
    var indices:uint32[] = []
    var index = 0
    while index < hull.triangle_count() {
        let triangle = hull.triangle(index)
        let normal = triangle.normal()
        let first = vertices.count() as uint32
        vertices.append(Scene3D.Geometry.Vertex(position:triangle.first, normal:normal))
        vertices.append(Scene3D.Geometry.Vertex(position:triangle.second, normal:normal))
        vertices.append(Scene3D.Geometry.Vertex(position:triangle.third, normal:normal))
        indices.append(first); indices.append(first + 1); indices.append(first + 2)
        index++
    }
    return Scene3D.Geometry.Mesh(vertices, indices)
}
func box_hull(size:Math.Vec3, offset:Math.Vec3 = Math.Vec3()) Physics.ConvexHull3D {
    var points:Math.Vec3[] = []
    var x = -1
    while x <= 1 {
        var y = -1
        while y <= 1 {
            var z = -1
            while z <= 1 {
                points.append(Math.Vec3(size.x * (x as float), size.y * (y as float), size.z * (z as float)).multiply(0.5).add(offset))
                z += 2
            }
            y += 2
        }
        x += 2
    }
    return Physics.ConvexHull3D(points)
}
func dynamic_hull(index:int) Physics.ConvexHull3D {
    if index == 0 {
        return Physics.ConvexHull3D([Math.Vec3(-0.6, -0.4, -0.6), Math.Vec3(0.8, -0.4, -0.6),
            Math.Vec3(-0.6, 1.0, -0.6), Math.Vec3(-0.6, -0.4, 0.8)])
    }
    if index == 1 { return box_hull(Math.Vec3(0.7), Math.Vec3(0.0, 2.0, 0.0)) }
    return box_hull(Math.Vec3(0.6))
}
func reset(state:&ConvexTriangleState) {
    var index = 0
    while index < state.bodies.count() {
        let pose = Physics.Transform3D(position:start_position(index))
        state.bodies[index].set_transform(pose)
        state.bodies[index].set_linear_velocity(Math.Vec3())
        state.bodies[index].set_angular_velocity(Math.Vec3())
        if index == 0 { state.bodies[index].set_angular_velocity(Math.Vec3(1.1, 0.4, 0.7)) }
        if index == 2 { state.bodies[index].set_linear_velocity(Math.Vec3(0.0, 7.0, 0.0)) }
        state.previous[index] = pose; index++
    }
    state.elapsed = 0.0; state.accumulator = 0.0
    state.touched = [false, false, false]; state.rendered = [false, false, false]
    state.rotated = false; state.emerged = false
}
func triangle_mesh(triangle:Physics.Triangle3D) Scene3D.Geometry.Mesh {
    let normal = triangle.normal()
    return Scene3D.Geometry.Mesh([
        Scene3D.Geometry.Vertex(position:triangle.first, normal:normal),
        Scene3D.Geometry.Vertex(position:triangle.second, normal:normal),
        Scene3D.Geometry.Vertex(position:triangle.third, normal:normal)], [0 as uint32, 1 as uint32, 2 as uint32])
}
func create_scene(world:&Resources.World, meshes:&Resources.Meshes3D, physics:&Physics.World3D, state:&ConvexTriangleState) {
    var index = 0
    while index < 3 {
        let position = Math.Vec3(-4.0 + index as float * 4.0, 1.4, 0.0)
        let triangle = Physics.Triangle3D(Math.Vec3(-1.9, 0.0, -2.0), Math.Vec3(0.0, 0.0, 3.0), Math.Vec3(1.9, 0.0, -2.0))
        physics.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
            ..shape = Physics.Shape3D.triangle(triangle) ..transform = Physics.Transform3D(position:position) ..friction = 0.6)
        world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(position:position))
            ..with(Components.Mesh3D(meshes.add(triangle_mesh(triangle))))
            ..with(Components.Material3D(albedo:Color.bytes(77, 104, 124), roughness:0.9)))
        var hull = dynamic_hull(index)
        var tint = Color.bytes(247, 192, 95)
        if index == 1 { tint = Color.bytes(118, 191, 219) }
        if index == 2 { tint = Color.bytes(217, 127, 103) }
        var body = physics.create_rigid_body(Physics.RigidBody3DSettings() ..shape = Physics.Shape3D.convex(hull)
            ..transform = Physics.Transform3D(position:start_position(index)) ..friction = 0.6 ..restitution = 0.1
            ..angular_damping = 0.15 ..allow_sleep = false ..continuous_collision = true)
        state.hulls.append(hull); state.bodies.append(body); state.previous.append(body.transform())
        state.visuals.append(world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(position:body.position()))
            ..with(Components.Mesh3D(meshes.add(hull_mesh(hull))))
            ..with(Components.Material3D(albedo:tint, roughness:0.45))))
        index++
    }
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.4)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4, -1.0, -0.3).normalized(), intensity:3.0) ..shadow_distance = 40.0))
    match (try Process.arguments()) {
        success(arguments) => { for argument in arguments { if argument == "--smoke" { state.smoke = true } } }
        failure(error) => { panic(error.detail) }
    }
    reset(state)
    print("Three fixed triangles: a rotating tetrahedron lands on the left, a cube with a shifted local origin lands in the middle, and a cube crosses the back face on the right then lands on its front.")
    print("Automatic restart every 4 seconds. Space: pause. R: restart. Escape: quit.")
}
func observe(state:&ConvexTriangleState, physics:@Physics.World3D) {
    var contacts:Physics.Contact3D[] = []; physics.write_contacts(contacts)
    var index = 0
    while index < 3 {
        var touched = false; var rotated = false; var emerged = false
        {
            let body = state.bodies[index]
            for contact in contacts {
                if (contact.first_body().same_body(body) || contact.second_body().same_body(body)) && contact.normal_impulse() > 0.0 { touched = true }
            }
            rotated = index == 0 && Math.abs(body.rotation().w) < 0.95
            emerged = index == 2 && body.position().y > 1.9
            if index < 2 || state.emerged || emerged {
                let hull = state.hulls[index]; var face = 0
                while face < hull.triangle_count() {
                    let triangle = hull.triangle(face)
                    assert(body.transform().point(triangle.first).y > 1.34)
                    assert(body.transform().point(triangle.second).y > 1.34)
                    assert(body.transform().point(triangle.third).y > 1.34)
                    face++
                }
            }
            assert(body.position().y > -1.0 && body.position().y < 4.2)
        }
        if touched { state.touched[index] = true }
        if rotated { state.rotated = true }
        if emerged { state.emerged = true }
        index++
    }
}
func control(input:@Resources.InputState, simulation:&Application.Simulation, physics:&Physics.World3D,
    state:&ConvexTriangleState, controller:&Application.Controller) {
    if !state.smoke {
        if input.is_pressed(Input.Key.escape) { controller.stop() }
        if input.is_pressed(Input.Key.space) { if simulation.is_paused() { simulation.resume() } else { simulation.pause() } }
        if input.is_pressed(Input.Key.r) { reset(state) }
    }
    state.accumulator += simulation.delta()
    let delta = 1.0 / 120.0
    while state.accumulator >= delta {
        var index = 0
        while index < state.bodies.count() { state.previous[index] = state.bodies[index].transform(); index++ }
        physics.step(delta); state.elapsed += delta; state.accumulator -= delta; state.steps++
        if state.smoke { observe(state, physics) }
        if state.elapsed >= 4.0 {
            state.cycles++
            if state.smoke {
                assert(state.touched[0] && state.touched[1] && state.touched[2] && state.rotated && state.emerged)
                assert(state.rendered[0] && state.rendered[1] && state.rendered[2])
                print("Convex triangle smoke cycle=$(state.cycles) steps=$(state.steps): supports, rotation, shifted hull, back crossing and rendered poses verified")
                if state.cycles == 2 { controller.stop() }
            }
            reset(state)
        }
    }
}
func sync_bodies(world:&Resources.World, state:&ConvexTriangleState) {
    var index = 0
    while index < state.bodies.count() {
        let alpha = Math.clamp(state.accumulator * 120.0, 0.0, 1.0)
        let position = state.previous[index].position.lerp(state.bodies[index].position(), alpha)
        let first = state.previous[index].rotation
        var second = state.bodies[index].rotation()
        if first.dot(second) < 0.0 { second = second.multiply(-1.0) }
        let rotation = first.multiply(1.0 - alpha).add(second.multiply(alpha)).normalized()
        world.update<Components.Transform3D>(state.visuals[index], func(transform:&Components.Transform3D) {
            transform.position = position; transform.rotation = rotation
        })
        if state.smoke {
            let rendered = world.get<Components.Transform3D>(state.visuals[index])
            assert(rendered.position.nearly_equal(position, 0.0001) && Math.abs(rendered.rotation.dot(rotation)) > 0.99999)
            if Math.abs(rendered.position.y - start_position(index).y) > 0.2 { state.rendered[index] = true }
        }
        index++
    }
}
func main() {
    Application() ..add_resource(ConvexTriangleState()) ..add_resource(Physics.World3D())
        ..add_plugin(Plugins.Window(Plugins.Window.Settings() ..title = "Silex convexes on triangles | Space: pause, R: restart" ..width = 1200 ..height = 720))
        ..add_plugin(Plugins.Time()) ..add_plugin(Plugins.Scene3D())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings() ..target = Math.Vec3(0.0, 1.8, 0.0)
            ..distance = 15.0 ..yaw = Math.radians(-15.0) ..pitch = Math.radians(-20.0)))
        ..add_system(Application.Schedule.startup, create_scene)
        ..add_system(Application.Schedule.update, control, process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.render, sync_bodies) ..run()
}
