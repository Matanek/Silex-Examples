use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Input.Events
use GFX.Window
use GFX.Plugins
use GFX.Resources
use GFX.Scene2D
use GFX.Scene3D
use GFX.UI
use GFX.Physics
use Physics3D.MotorcycleDriving.Model
use Physics3D.MotorcycleDriving.Controls
use Physics3D.MotorcycleDriving.ChaseCamera
use Physics3D.MotorcycleDriving.Ground
use Physics3D.ArticulatedPose.Controls as InputCheck
use STD.Math
use STD.Process

class MotorcycleScene {
    var model:Model.MotorcycleModel=Model.MotorcycleModel()
    var controls:Controls.MotorcycleControls=Controls.MotorcycleControls()
    var ui:UI.Session
    var panel:ECS.Entity=ECS.Entity()
    var chassis:ECS.Entity=ECS.Entity()
    var nose:ECS.Entity=ECS.Entity()
    var floor:ECS.Entity=ECS.Entity()
    var ramp:ECS.Entity=ECS.Entity()
    var ramp_frames:int=0
    var rendered_cross:bool=false
    var origin:ECS.Entity=ECS.Entity()
    var tires:ECS.Entity[]=[]
    var spokes:ECS.Entity[]=[]
    var springs:ECS.Entity[]=[]
    var markers:ECS.Entity[]=[]
    var floor_center:Math.Vec3=Math.Vec3()
    var camera:ECS.Entity=ECS.Entity()
    var follow:ChaseCamera=ChaseCamera()
    var previous:Physics.Transform3D=Physics.Transform3D()
    var lengths:float[]=[0.6,0.6]
    var angles:float[]=[0.0,0.0]
    var steering:float[]=[0.0,0.0]
    let wheel_orientation:Math.Quat=Math.Quat.angle_axis(Math.half_pi(),Math.Vec3.back())
    var accumulator:float=0.0
    var telemetry:float=0.0
    var smoke:bool=false
    var frames:int[]=[0,0,0,0,0,0,0,0]
    var pause_frames:int=0
    var held:Physics.Transform3D=Physics.Transform3D()
    var held_angles:float[]=[]
    var held_steps:int=0
    init(cross:bool=false) {
        if cross { self.model.reset(ramp:true,cross:true) }
        self.ui=UI.Session(self.controls.describe())
    }
}
func visual(world:&Resources.World,mesh:Scene3D.MeshHandle,size:Math.Vec3,color:Color) ECS.Entity {
    return world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(scale:size))
        ..with(Components.Mesh3D(mesh)) ..with(Components.Material3D(albedo:color,roughness:0.7)))
}
func remember(state:&MotorcycleScene) {
    state.previous=copy state.model.vehicle.chassis().transform()
    for i in [0,1] { state.lengths[i]=state.model.vehicle.wheel(i).length;state.angles[i]=state.model.vehicle.wheel(i).rotation_angle;state.steering[i]=state.model.vehicle.wheel(i).steering_angle }
}
func labels(state:&MotorcycleScene,simulation:@Application.Simulation) {
    var pause="Espace : pause";if simulation.is_paused() { pause="Espace : reprise" }
    if state.controls.pause_text.value()!=pause { state.controls.pause_text.set(pause) }
    var assist="A : pilote auto";if !state.model.assistance { assist="A : sans pilote" }
    if state.model.crashed() { assist="A : auto au R";if !state.model.assistance { assist="A : passif au R" } }
    if state.controls.assist_text.value()!=assist { state.controls.assist_text.set(assist) }
    var limit="L : limite ON";if !state.model.vehicle.steering_limit_enabled() { limit="L : limite OFF" }
    if state.controls.limit_text.value()!=limit { state.controls.limit_text.set(limit) }
    var terrain="B : plat";if state.model.ramp_enabled { terrain="B : tremplin" }
    if state.controls.terrain_text.value()!=terrain { state.controls.terrain_text.set(terrain) }
    var phase="Conduite libre"
    if state.model.ramp_enabled && state.model.vehicle.chassis().position().z<12.0 {
        phase="Rampe devant\nZ tout droit · B : comparer au plat"
    }
    if state.model.supports()==0 && state.model.steps>30 { phase="En vol — aucun appui" }
    else if state.model.landed && state.model.supports()==2 { phase="Réception · S : frein · R : départ" }
    if state.model.vehicle.wheel(0).support()==null && state.model.vehicle.wheel(1).support()!=null { phase="Roue arrière · gaz régulés" }
    if state.model.crashed() { phase="Chute · gaz et pilote coupés\nR pour repartir" }
    if state.smoke { phase="Recette $(state.model.recipe+1)/8" }
    if state.controls.phase.value()!=phase { state.controls.phase.set(phase) }
    var body=state.model.vehicle.chassis();let speed=Math.round(body.linear_velocity().length()*36.0)/10.0
    let lean=Math.round(Math.degrees(state.model.tilt())) as int
    let front=Math.round((state.model.vehicle.wheel_settings(0).maximum_length-state.model.vehicle.wheel(0).length)*100.0) as int
    let rear=Math.round((state.model.vehicle.wheel_settings(1).maximum_length-state.model.vehicle.wheel(1).length)*100.0) as int
    let gas=Math.round(state.model.applied_throttle()*100.0) as int
    let text="$(speed) km/h · inclinaison $(lean)°\nCompression AV $(front) / AR $(rear) cm\nAppuis $(state.model.supports())/2 · gaz $(gas) %"
    if state.controls.measure.value()!=text { state.controls.measure.set(text) }
}
func recreate(state:&MotorcycleScene,simulation:&Application.Simulation,recipe:int,keep_assistance:bool=false,ramp:bool?=null) {
    state.model.reset(recipe,keep_assistance:keep_assistance,ramp:ramp);state.follow.reset(state.model.vehicle.chassis().transform());remember(state);state.accumulator=0.0;state.pause_frames=0
    state.controls.release();state.controls.pushes=0;simulation.resume();labels(state,simulation)
}
func perform(state:&MotorcycleScene,simulation:&Application.Simulation) {
    var changed=false
    while state.controls.terrains>0 {
        state.controls.terrains--;recreate(state,simulation,0,keep_assistance:true,ramp:!state.model.ramp_enabled);changed=true
    }
    while state.controls.assists>0 {
        state.controls.assists--;state.model.set_assistance(!state.model.assistance);changed=true
    }
    while state.controls.limits>0 {
        state.controls.limits--;state.model.vehicle.set_steering_limit_enabled(!state.model.vehicle.steering_limit_enabled());changed=true
    }
    while state.controls.resets>0 { state.controls.resets--;recreate(state,simulation,0,keep_assistance:true);changed=true }
    while state.controls.pauses>0 {
        state.controls.pauses--;changed=true;state.controls.release()
        if simulation.is_paused() { simulation.resume() }
        else { simulation.pause();remember(state);state.accumulator=0.0 }
    }
    while state.controls.pushes>0 && !simulation.is_paused() { state.controls.pushes--;state.model.push();changed=true }
    if changed { labels(state,simulation) }
}
func startup(world:&Resources.World,meshes:&Resources.Meshes3D,images:&Resources.Images,state:&MotorcycleScene,simulation:&Application.Simulation) {
    let cube=meshes.add(Scene3D.Geometry.Cube.make())
    let wheel=meshes.add(Scene3D.Geometry.Cylinder.make(0.3,0.18))
    state.chassis=visual(world,cube,Math.Vec3(0.4,0.5,1.6),Color.bytes(222,177,71))
    state.nose=visual(world,cube,Math.Vec3(0.36,0.1,0.03),Color.bytes(250,245,180))
    state.floor=Ground.create(world,meshes,images)
    state.follow.reset(state.model.vehicle.chassis().transform())
    let view=state.follow.transform()
    state.camera=world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(position:view.position,rotation:view.rotation)) ..with(Scene3D.Camera(vertical_fov:0.9,far_plane:400.0)))
    state.ramp=visual(world,cube,Model.ramp_size(state.model.cross),Color.bytes(235,135,65))
    state.rendered_cross=state.model.cross
    let ramp_pose=Model.ramp_pose(state.model.cross)
    world.update<Components.Transform3D>(state.ramp,func(t:&Components.Transform3D) { t.position=ramp_pose.position;t.rotation=ramp_pose.rotation })
    world.update<Components.Mesh3D>(state.ramp,func(m:&Components.Mesh3D) { m.visible=state.model.ramp_enabled })
    state.origin=visual(world,cube,Math.Vec3(0.12,1.6,0.12),Color.bytes(245,245,250))
    for i in [0,1] {
        var color=Color.bytes(90,210,240);if i==1 { color=Color.bytes(250,130,65) }
        state.tires.append(visual(world,wheel,Math.Vec3(1.0),Color.bytes(30,36,44)))
        state.spokes.append(visual(world,cube,Math.Vec3(0.045,0.45,0.06),color))
        state.springs.append(visual(world,cube,Math.Vec3(0.045,0.6,0.045),Color.bytes(240,240,245)))
        state.markers.append(visual(world,cube,Math.Vec3(0.35,0.025,0.3),Color.bytes(60,230,125)))
    }
    world.update<Components.Transform3D>(state.origin,func(t:&Components.Transform3D) { t.position=Math.Vec3(3.0,0.8,0.0) })
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.55)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4,-1.0,-0.3).normalized(),intensity:2.5)))
    simulation.resume();remember(state);labels(state,simulation)
    state.panel=world.spawn(ECS.EntityRecipe() ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(state.ui.drawing(Controls.Hud.width,Controls.Hud.height),Controls.Hud.width,Controls.Hud.height) ..anchor=Math.Vec2() ..pivot=Math.Vec2()
            ..space=Scene2D.CanvasSpace.viewport ..layer=100))
}
func verify_framing(world:@Resources.World,state:@MotorcycleScene,view:Scene3D.Transform) {
    var camera=Scene3D.Camera(vertical_fov:0.9);let sides:int[]=[-1,1]
    let body=world.get<Components.Transform3D>(state.chassis)
    for x in sides { for y in sides { for z in sides {
        let corner=body.position.add(body.rotation.rotate(Math.Vec3(0.2*x as float,0.25*y as float,0.8*z as float)))
        let point=camera.project(corner,view,Math.Vec2(1280.0,800.0))!
        assert(point.x>20.0 && point.x<1260.0 && point.y>20.0 && point.y<780.0 && (point.x>Controls.Hud.width as float+12.0 || point.y>Controls.Hud.height as float+12.0))
    } } }
    for i in [0,1] {
        let tire=world.get<Components.Transform3D>(state.tires[i])
        for x in sides { for y in sides { for z in sides {
            let corner=tire.position.add(tire.rotation.rotate(Math.Vec3(0.3*x as float,0.09*y as float,0.3*z as float)))
            let point=camera.project(corner,view,Math.Vec2(1280.0,800.0))!
            if !(point.x>20.0 && point.x<1260.0 && point.y>20.0 && point.y<780.0 && (point.x>Controls.Hud.width as float+12.0 || point.y>Controls.Hud.height as float+12.0)) {
                print("Camera corner recipe=$(state.model.recipe) step=$(state.model.steps) wheel=$(i) screen=$(point.to_str()) eye=$(view.position.to_str()) body=$(state.model.vehicle.chassis().position().to_str())")
            }
            assert(point.x>20.0 && point.x<1260.0 && point.y>20.0 && point.y<780.0 && (point.x>Controls.Hud.width as float+12.0 || point.y>Controls.Hud.height as float+12.0))
        } } }
    }
}
func wheel_angle(previous:float,current:float,alpha:float) float {
    var change=Math.remainder(current-previous,Math.two_pi())
    if change>Math.pi() { change-=Math.two_pi() } else if change< -Math.pi() { change+=Math.two_pi() }
    return previous+alpha*change
}
func render(world:&Resources.World,state:&MotorcycleScene,simulation:@Application.Simulation) {
    render_frame(world,state,simulation.delta())
}
func render_frame(world:&Resources.World,state:&MotorcycleScene,delta:float) {
    let current=state.model.vehicle.chassis().transform();let alpha=Math.clamp(state.accumulator*120.0,0.0,1.0)
    var rotation=current.rotation;if state.previous.rotation.dot(rotation)<0.0 { rotation=rotation.multiply(-1.0) }
    let pose=Physics.Transform3D(state.previous.position.lerp(current.position,alpha),state.previous.rotation.multiply(1.0-alpha).add(rotation.multiply(alpha)).normalized())
    world.update<Components.Transform3D>(state.chassis,func(t:&Components.Transform3D) { t.position=pose.position;t.rotation=pose.rotation })
    world.update<Components.Transform3D>(state.nose,func(t:&Components.Transform3D) { t.position=pose.point(Math.Vec3(0.0,0.0,0.81));t.rotation=pose.rotation })
    for i in [0,1] {
        let settings=state.model.vehicle.wheel_settings(i);var wheel=state.model.vehicle.wheel(i)
        let length=state.lengths[i]+(wheel.length-state.lengths[i])*alpha
        let center=pose.point(settings.position.add(settings.direction.multiply(length)))
        let steer=state.steering[i]+(wheel.steering_angle-state.steering[i])*alpha
        let steered=pose.rotation.multiply(Math.Quat.angle_axis(steer,settings.steering_axis))
        let spin=steered.multiply(Math.Quat.angle_axis(wheel_angle(state.angles[i],wheel.rotation_angle,alpha),Math.Vec3.right()))
        let tire_rotation=spin.multiply(state.wheel_orientation)
        world.update<Components.Transform3D>(state.tires[i],func(t:&Components.Transform3D) { t.position=center;t.rotation=tire_rotation })
        world.update<Components.Transform3D>(state.spokes[i],func(t:&Components.Transform3D) { let side=0.105
            t.position=center.add(steered.rotate(Math.Vec3(side,0.0,0.0)));t.rotation=spin })
        world.update<Components.Transform3D>(state.springs[i],func(t:&Components.Transform3D) {
            t.position=pose.point(settings.position.add(settings.direction.multiply(length*0.5)));t.rotation=pose.rotation;t.scale=Math.Vec3(0.045,Math.max(0.001,length),0.045)
        })
        let visible=wheel.support()!=null
        if world.get<Components.Mesh3D>(state.markers[i]).visible!=visible { world.update<Components.Mesh3D>(state.markers[i],func(m:&Components.Mesh3D) { m.visible=visible }) }
        if visible { world.update<Components.Transform3D>(state.markers[i],func(t:&Components.Transform3D) { t.position=wheel.contact_point.add(Math.Vec3(0.0,0.015,0.0));t.rotation=Math.Quat() }) }
        if state.smoke {
            assert(world.get<Components.Transform3D>(state.tires[i]).position.nearly_equal(center,0.00001))
            assert(world.get<Components.Transform3D>(state.tires[i]).rotation==tire_rotation)
            assert(world.get<Components.Transform3D>(state.spokes[i]).rotation==spin)
            let spring=world.get<Components.Transform3D>(state.springs[i])
            assert(spring.position.nearly_equal(pose.point(settings.position.add(settings.direction.multiply(length*0.5))),0.00001))
            assert(spring.rotation==pose.rotation && Math.abs(spring.scale.y-Math.max(0.001,length))<0.00001)
            assert(world.get<Components.Mesh3D>(state.markers[i]).visible==visible)
        }
    }
    if state.rendered_cross!=state.model.cross {
        state.rendered_cross=state.model.cross;let ramp_pose=Model.ramp_pose(state.model.cross)
        world.update<Components.Transform3D>(state.ramp,func(t:&Components.Transform3D) { t.position=ramp_pose.position;t.rotation=ramp_pose.rotation;t.scale=Model.ramp_size(state.model.cross) })
    }
    if world.get<Components.Mesh3D>(state.ramp).visible!=state.model.ramp_enabled {
        world.update<Components.Mesh3D>(state.ramp,func(m:&Components.Mesh3D) { m.visible=state.model.ramp_enabled })
    }
    let center=Ground.center(pose.position)
    if center!=state.floor_center {
        state.floor_center=center
        world.update<Components.Transform3D>(state.floor,func(t:&Components.Transform3D) { t.position=center })
    }
    state.follow.advance(pose,delta,!state.model.crashed());let view=state.follow.transform()
    world.update<Components.Transform3D>(state.camera,func(t:&Components.Transform3D) { t.position=view.position;t.rotation=view.rotation })
    if state.smoke {
        assert(world.get<Components.Mesh3D>(state.ramp).visible==state.model.ramp_enabled)
        if state.model.ramp_enabled {
            let ramp_transform=world.get<Components.Transform3D>(state.ramp);let physical=state.model.ramp!.transform()
            assert(ramp_transform.position==physical.position && ramp_transform.rotation==physical.rotation && ramp_transform.scale==Model.ramp_size(state.model.cross))
            let projected=Scene3D.Camera(vertical_fov:0.9).project(ramp_transform.position,view,Math.Vec2(1280.0,800.0))
            if projected!=null { let point=projected;if point.x>0.0 && point.x<1280.0 && point.y>0.0 && point.y<800.0 && (point.x>Controls.Hud.width as float || point.y>Controls.Hud.height as float) { state.ramp_frames++ } }
        }
        assert(world.is_alive(state.camera))
        let actual=world.get<Components.Transform3D>(state.camera)
        assert(actual.position.nearly_equal(view.position,0.00001) && actual.rotation==view.rotation)
        assert(world.get<Components.Transform3D>(state.chassis).position.nearly_equal(pose.position,0.00001))
        assert(world.get<Components.Transform3D>(state.chassis).rotation==pose.rotation)
        assert(world.get<Components.Transform3D>(state.floor).position==Ground.center(pose.position))
        let ground_up=world.get<Components.Transform3D>(state.floor).rotation.rotate(Math.Vec3.back())
        assert(ground_up.nearly_equal(Math.Vec3.up(),0.00001))
        assert(Math.abs(actual.rotation.rotate(Math.Vec3.right()).y)<0.00001 && actual.position.y>=3.0)
        verify_framing(world,state,Scene3D.Transform(actual.position,actual.rotation));state.frames[state.model.recipe]++
    }
}
func finish_recipe(state:&MotorcycleScene,simulation:&Application.Simulation) {
    state.model.verify_finished();remember(state);state.accumulator=0.0;labels(state,simulation)
    if state.smoke {
        assert(state.frames[state.model.recipe]>0)
        simulation.pause();state.held=copy state.model.vehicle.chassis().transform();state.held_steps=state.model.steps
        state.held_angles.clear();for i in [0,1] { state.held_angles.append(state.model.vehicle.wheel(i).rotation_angle) }
        state.pause_frames=0
    }
}
func next_smoke(state:&MotorcycleScene,simulation:&Application.Simulation,controller:&Application.Controller) {
    assert(simulation.is_paused() && state.model.steps==state.held_steps && state.model.vehicle.chassis().transform()==state.held)
    for i in [0,1] { assert(state.model.vehicle.wheel(i).rotation_angle==state.held_angles[i]) }
    state.pause_frames++
    if state.pause_frames<8 { return }
    if state.model.recipe==7 {
        assert(state.ramp_frames>0 && state.model.landed && state.model.flight_steps>120 && state.model.peak_height>3.0)
        print("Motorcycle smoke: eight real recipes, road and cross ramps, unsupported flight/landing, rendered chassis/steered wheels, camera, support markers, pause and recreation verified")
        controller.stop();return
    }
    let next_recipe=state.model.recipe+1;var old_body=state.model.vehicle.chassis()
    recreate(state,simulation,next_recipe)
    var expected=2;if state.model.ramp_enabled { expected=3 }
    assert(!old_body.is_valid() && state.model.world.body_count()==expected && state.model.steps==0 && !simulation.is_paused())
}
func step_free(state:&MotorcycleScene) {
    var throttle=0.0;var brake=0.0;var steering=0.0
    if state.controls.throttle && !state.controls.braking { throttle=0.4 }
    if state.controls.boost && !state.controls.braking { throttle=1.0 }
    if state.controls.braking { brake=0.35 }
    if state.controls.left { steering-=0.35 } if state.controls.right { steering+=0.35 }
    state.model.drive(throttle,steering,brake)
}
func update(world:&Resources.World,input:@Resources.InputState,state:&MotorcycleScene,simulation:&Application.Simulation,controller:&Application.Controller) {
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if state.smoke {
        if simulation.is_paused() { next_smoke(state,simulation,controller) }
    } else {
        for event in input.events() { if !state.controls.handle(event) { let handled=state.ui.handle(event) } }
        perform(state,simulation)
    }
    state.accumulator+=simulation.delta()
    while state.accumulator>=1.0/120.0 && !simulation.is_paused() {
        remember(state)
        if state.smoke {
            state.model.scripted_step();state.model.verify()
        } else { step_free(state) }
        state.accumulator-=1.0/120.0
        if state.smoke && state.model.steps==1920 { finish_recipe(state,simulation);break }
    }
    state.telemetry+=simulation.delta()
    if state.telemetry>=0.1 { state.telemetry=0.0;labels(state,simulation) }
    if state.ui.update(0.0) { world.update<Scene2D.Canvas>(state.panel,func(canvas:&Scene2D.Canvas) { canvas.replace(state.ui.drawing(Controls.Hud.width,Controls.Hud.height)) }) }
}
func press(state:&MotorcycleScene,simulation:&Application.Simulation,key:Input.Key,code:uint32,repeated:bool=false) {
    assert(state.controls.handle(InputCheck.key_event(key,code,repeated)));perform(state,simulation)
}
func release(state:&MotorcycleScene,key:Input.Key,code:uint32=0 as uint32) {
    match InputCheck.key_event(key,code) {
        key_pressed(value)=>{ assert(state.controls.handle(Events.Event.key_released(value))) }
        else=>{ assert(false) }
    }
}
func verify_controls() {
    var world=Resources.World();var meshes=Resources.Meshes3D();var images=Resources.Images();var state=MotorcycleScene();var simulation=Application.Simulation()
    startup(world,meshes,images,state,simulation)
    state.follow.reset(state.model.vehicle.chassis().transform());remember(state);render(world,state,simulation);verify_framing(world,state,state.follow.transform())
    press(state,simulation,Input.Key.x,98 as uint32);assert(state.model.ramp_enabled && state.model.world.body_count()==3)
    var first_ramp=state.model.ramp!
    press(state,simulation,Input.Key.b,66 as uint32,true);assert(state.model.ramp_enabled && first_ramp.is_valid())
    press(state,simulation,Input.Key.b,66 as uint32);assert(!state.model.ramp_enabled && !first_ramp.is_valid())
    press(state,simulation,Input.Key.b,0 as uint32);assert(state.model.ramp_enabled)
    press(state,simulation,Input.Key.b,0 as uint32);assert(!state.model.ramp_enabled)
    press(state,simulation,Input.Key.x,122 as uint32);assert(state.controls.throttle)
    release(state,Input.Key.x,122 as uint32);assert(!state.controls.throttle)
    press(state,simulation,Input.Key.z,90 as uint32);assert(state.controls.throttle)
    release(state,Input.Key.z,90 as uint32)
    press(state,simulation,Input.Key.z,0 as uint32);release(state,Input.Key.z)
    press(state,simulation,Input.Key.s,115 as uint32);assert(state.controls.braking);release(state,Input.Key.s,115 as uint32)
    press(state,simulation,Input.Key.s,83 as uint32);release(state,Input.Key.s,83 as uint32)
    press(state,simulation,Input.Key.left,0 as uint32);assert(state.controls.left);release(state,Input.Key.left)
    press(state,simulation,Input.Key.right,0 as uint32);assert(state.controls.right);release(state,Input.Key.right)
    press(state,simulation,Input.Key.a,97 as uint32);assert(!state.model.vehicle.balance_enabled())
    press(state,simulation,Input.Key.a,65 as uint32,true);assert(!state.model.vehicle.balance_enabled())
    press(state,simulation,Input.Key.a,65 as uint32);assert(state.model.vehicle.balance_enabled())
    press(state,simulation,Input.Key.a,0 as uint32);assert(!state.model.vehicle.balance_enabled())
    press(state,simulation,Input.Key.l,108 as uint32);assert(!state.model.vehicle.steering_limit_enabled())
    press(state,simulation,Input.Key.l,76 as uint32);assert(state.model.vehicle.steering_limit_enabled())
    press(state,simulation,Input.Key.l,0 as uint32);assert(!state.model.vehicle.steering_limit_enabled())
    var old=state.model.vehicle
    press(state,simulation,Input.Key.r,114 as uint32);assert(!old.is_valid() && !state.model.vehicle.balance_enabled() && !state.model.vehicle.steering_limit_enabled())
    let before=state.model.vehicle.chassis().angular_velocity()
    press(state,simulation,Input.Key.p,112 as uint32)
    assert(state.model.vehicle.chassis().angular_velocity().nearly_equal(before.add(Math.Vec3(0.0,0.0,1.5)),0.00001))
    press(state,simulation,Input.Key.space,32 as uint32);assert(simulation.is_paused())
    press(state,simulation,Input.Key.space,32 as uint32,true);assert(simulation.is_paused())
    let held=state.model.vehicle.chassis().angular_velocity()
    press(state,simulation,Input.Key.p,80 as uint32);assert(state.controls.pushes==1 && state.model.vehicle.chassis().angular_velocity()==held)
    press(state,simulation,Input.Key.space,32 as uint32);assert(!simulation.is_paused() && state.controls.pushes==0)
    assert(state.model.vehicle.chassis().angular_velocity().nearly_equal(held.add(Math.Vec3(0.0,0.0,1.5)),0.00001))
    press(state,simulation,Input.Key.z,122 as uint32);press(state,simulation,Input.Key.w,119 as uint32)
    let focus=Events.WindowEvent(window:Window.Id(value:0 as uint32),timestamp:Input.Timestamp(nanoseconds:0 as uint))
    let handled=state.controls.handle(Events.Event.window_focus_lost(focus));assert(!state.controls.throttle && !state.controls.boost && !state.controls.braking && !state.controls.left && !state.controls.right)
    InputCheck.click(state.ui,74.0,187.0);perform(state,simulation);assert(state.model.vehicle.balance_enabled())
    InputCheck.click(state.ui,206.0,187.0);perform(state,simulation);assert(state.model.vehicle.steering_limit_enabled())
    old=state.model.vehicle;InputCheck.click(state.ui,206.0,225.0);perform(state,simulation);assert(!old.is_valid())
    let old_velocity=state.model.vehicle.chassis().angular_velocity()
    InputCheck.click(state.ui,74.0,263.0);perform(state,simulation)
    assert(state.model.vehicle.chassis().angular_velocity().nearly_equal(old_velocity.add(Math.Vec3(0.0,0.0,1.5)),0.00001))
    InputCheck.click(state.ui,206.0,263.0);perform(state,simulation);assert(simulation.is_paused())
    InputCheck.click(state.ui,206.0,263.0);perform(state,simulation);assert(!simulation.is_paused())
    simulation.pause();let previous_assist=state.model.assistance;let previous_limit=state.model.vehicle.steering_limit_enabled()
    InputCheck.click(state.ui,74.0,225.0);perform(state,simulation)
    assert(state.model.ramp_enabled && !simulation.is_paused() && state.model.assistance==previous_assist && state.model.vehicle.steering_limit_enabled()==previous_limit)
    var retained_ramp=state.model.ramp!;old=state.model.vehicle
    state.controls.reset();perform(state,simulation)
    assert(!old.is_valid() && retained_ramp.is_valid() && state.model.ramp_enabled)
    InputCheck.click(state.ui,74.0,225.0);perform(state,simulation);assert(!state.model.ramp_enabled && !retained_ramp.is_valid())
    state.follow.reset(state.model.vehicle.chassis().transform());remember(state);render(world,state,simulation);assert(!world.get<Components.Mesh3D>(state.ramp).visible)
    state.controls.reset();perform(state,simulation)
    var steps=0;while steps<240 { step_free(state);steps++ }
    press(state,simulation,Input.Key.z,122 as uint32);press(state,simulation,Input.Key.left,0 as uint32)
    steps=0;while steps<240 { step_free(state);steps++ }
    assert(state.model.vehicle.chassis().position().z>4.0 && state.model.vehicle.chassis().position().x>2.0)
    assert(state.model.vehicle.wheel(0).steering_angle>0.02 && state.model.vehicle.powertrain().clutch==1.0)
    release(state,Input.Key.z,122 as uint32);release(state,Input.Key.left)
    press(state,simulation,Input.Key.s,115 as uint32);steps=0;while steps<480 { step_free(state);steps++ }
    assert(state.model.vehicle.chassis().linear_velocity().length()<0.03 && state.model.vehicle.powertrain().clutch==0.0)
    release(state,Input.Key.s,115 as uint32)
    state.controls.reset();perform(state,simulation);steps=0;while steps<240 { step_free(state);steps++ }
    press(state,simulation,Input.Key.z,122 as uint32);press(state,simulation,Input.Key.right,0 as uint32)
    steps=0;while steps<240 { step_free(state);steps++ }
    assert(state.model.vehicle.chassis().position().z>4.0 && state.model.vehicle.chassis().position().x< -2.0)
    assert(state.model.vehicle.wheel(0).steering_angle< -0.02)
    release(state,Input.Key.z,122 as uint32);release(state,Input.Key.right)
    let before_turn_push=state.model.vehicle.chassis().angular_velocity()
    let roll_axis=state.model.vehicle.chassis().rotation().rotate(Math.Vec3(0.0,0.0,1.5))
    state.controls.push();perform(state,simulation)
    assert(state.model.vehicle.chassis().angular_velocity().nearly_equal(before_turn_push.add(roll_axis),0.00001))
    state.follow.reset(state.model.vehicle.chassis().transform());remember(state);render(world,state,simulation)
    assert(world.get<Components.Transform3D>(state.chassis).position==state.model.vehicle.chassis().position())
    state.controls.reset();perform(state,simulation);steps=0;while steps<240 { step_free(state);steps++ }
    press(state,simulation,Input.Key.w,119 as uint32);assert(state.controls.boost)
    steps=0;while steps<360 { step_free(state);steps++ }
    assert(state.model.front_air_steps>12 && !state.model.crashed())
    release(state,Input.Key.w,119 as uint32);assert(!state.controls.boost)
    press(state,simulation,Input.Key.w,87 as uint32);release(state,Input.Key.w,87 as uint32)
    press(state,simulation,Input.Key.w,0 as uint32);release(state,Input.Key.w)
    press(state,simulation,Input.Key.b,98 as uint32);assert(state.model.ramp_enabled && state.model.assistance)
    steps=0;while steps<240 { step_free(state);steps++ }
    press(state,simulation,Input.Key.z,122 as uint32)
    while state.model.vehicle.chassis().position().z<35.0 && state.model.steps<960 {
        step_free(state);assert(!state.model.crashed())
        if state.model.supports()==0 {
            labels(state,simulation);assert(state.controls.phase.value()=="En vol — aucun appui")
        }
    }
    assert(state.model.flight_steps>40 && state.model.landed && state.model.ramp_contacts>60 && state.model.supports()==2)
    labels(state,simulation);assert(state.controls.phase.value()=="Réception · S : frein · R : départ")
    release(state,Input.Key.z,122 as uint32);state.follow.reset(state.model.vehicle.chassis().transform());remember(state);render(world,state,simulation)
    assert(world.get<Components.Mesh3D>(state.ramp).visible)
    state.controls.automatic=true;assert(!state.controls.handle(InputCheck.key_event(Input.Key.z,122 as uint32)))
    assert(!state.controls.handle(InputCheck.key_event(Input.Key.b,98 as uint32)))
    verify_cross_controls()
    print("Motorcycle controls: logical/uppercase/physical keys, releases, focus, repetition, six buttons, terrain toggle and retained reset, actual impulse, pause and recreation verified")
}
test "motorcycle controls affect the real vehicle" { verify_controls() }
func main() {
    var smoke=false
    for argument in Process.arguments() {
        if argument=="--physics-check" { Model.verify_physics();Model.verify_ramp();Model.verify_cross();return }
        if argument=="--cross-check" { Model.cross_witness();return }
        if argument=="--ramp-check" { Model.ramp_witness();return }
        if argument=="--oracle-check" { Model.witness();return }
        if argument=="--view-check" { verify_view();return }
        if argument=="--controls-check" { verify_controls();return }
        if argument=="--smoke" { smoke=true }
    }
    var state=MotorcycleScene(cross:!smoke);var title="Moto cross — caméra arrière et sol texturé"
    if smoke { state.smoke=true;state.controls.automatic=true;state.ui=UI.Session(state.controls.describe());title="TEST AUTOMATIQUE — moto — fermeture à la fin" }
    Application() ..add_resource(state)
        ..add_plugin(Plugins.Window(Plugins.Window.Settings() ..title=title ..width=1280 ..height=800))
        ..add_plugin(Plugins.Time()) ..add_plugin(Plugins.Scene3D()) ..add_plugin(Plugins.Scene2D())
        ..add_system(Application.Schedule.startup,startup)
        ..add_system(Application.Schedule.update,update,process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.render,render,process_mode:Application.ProcessMode.always) ..run()
}


func verify_cross_controls() {
    var world=Resources.World();var meshes=Resources.Meshes3D();var images=Resources.Images();var state=MotorcycleScene(cross:true);var simulation=Application.Simulation()
    startup(world,meshes,images,state,simulation)
    assert(state.model.cross && state.model.ramp_enabled)
    var step=0;while step<240 { step_free(state);step++ }
    press(state,simulation,Input.Key.z,122 as uint32)
    while state.model.vehicle.chassis().position().z<45.0 && state.model.steps<1200 { step_free(state);assert(!state.model.crashed()) }
    assert(state.model.peak_height>3.0 && state.model.flight_steps>120 && state.model.landed && state.model.supports()==2)
    release(state,Input.Key.z,122 as uint32);state.follow.reset(state.model.vehicle.chassis().transform());remember(state);render(world,state,simulation)
    assert(world.get<Components.Transform3D>(state.ramp).scale==Model.ramp_size(true))
    press(state,simulation,Input.Key.r,114 as uint32);assert(state.model.cross && state.model.ramp_enabled)
    press(state,simulation,Input.Key.b,98 as uint32);assert(state.model.cross && !state.model.ramp_enabled)
    step=0;while step<240 { step_free(state);step++ }
    press(state,simulation,Input.Key.z,122 as uint32)
    var lifted=0;var compressed=0
    step=0;while step<360 {
        step_free(state);assert(!state.model.crashed())
        if state.model.vehicle.wheel(0).support()==null && state.model.vehicle.wheel(1).support()!=null { lifted++ }
        if 0.9-state.model.vehicle.wheel(1).length>0.35 { compressed++ }
        step++
    }
    assert(lifted>240 && compressed>120)
    release(state,Input.Key.z,122 as uint32);press(state,simulation,Input.Key.s,115 as uint32)
    step=0;while step<720 { step_free(state);step++ }
    assert(!state.model.crashed() && state.model.supports()==2 && state.model.vehicle.chassis().linear_velocity().length()<0.05)
    release(state,Input.Key.s,115 as uint32)
    print("Cross controls: default120Nm preset,Z-held wheelie/rear compression/braking,jump/landing,real ramp transform and R/B profile retention verified")
}

func verify_view() {
    var world=Resources.World();var meshes=Resources.Meshes3D();var images=Resources.Images()
    var state=MotorcycleScene();var simulation=Application.Simulation()
    startup(world,meshes,images,state,simulation);state.smoke=true
    for recipe in [0,1,2,3,4,5,6,7] {
        recreate(state,simulation,recipe)
        while state.model.steps<1920 {
            state.model.scripted_step();state.model.scripted_step();remember(state)
            render_frame(world,state,1.0/60.0)
        }
        assert(state.frames[recipe]>900)
    }
    let held=state.follow.transform();simulation.pause();render_frame(world,state,0.0)
    assert(state.follow.transform()==held)
    recreate(state,simulation,0,keep_assistance:true)
    assert(state.follow.transform().position.subtract(state.model.vehicle.chassis().position()).length()<9.0)
    print("Motorcycle view: textured ground, stable world UV phase, smooth rear camera, framing through eight real recipes, level horizon, pause and reset verified")
}
test "motorcycle rear camera frames turning falling and airborne vehicles" { verify_view() }
