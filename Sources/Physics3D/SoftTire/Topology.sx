use GFX.Physics
use STD.Math

package static struct Profile {
    let segments:int=24
    let slices:int=8
    let major_radius:float=0.9
    let section_radius:float=0.3
    let half_width:float=0.3
}

func vertex(ring:int, slice:int) int {
    return ((ring+Profile.segments)%Profile.segments)*Profile.slices+
        (slice+Profile.slices)%Profile.slices
}

package func make_tire() Physics.SoftBody3DDefinition {
    var positions:Math.Vec3[]=[];var faces:int[]=[]
    var masses:float[]=[];var edges:Physics.SoftEdge3D[]=[];var bends:Physics.SoftBend3D[]=[]
    var ring=0
    while ring<Profile.segments {
        let angle=2.0*Math.pi()*(ring as float)/(Profile.segments as float)
        var slice=0
        while slice<Profile.slices {
            let cross_angle=2.0*Math.pi()*(slice as float)/(Profile.slices as float)
            let radius=Profile.major_radius+Profile.section_radius*Math.cos(cross_angle)
            positions.append(Math.Vec3(Profile.half_width*Math.sin(cross_angle),radius*Math.cos(angle),radius*Math.sin(angle)))
            masses.append(20.0)
            let a=vertex(ring,slice);let b=vertex(ring+1,slice)
            let c=vertex(ring,slice+1);let d=vertex(ring+1,slice+1)
            faces.append(a);faces.append(b);faces.append(c)
            faces.append(b);faces.append(d);faces.append(c)
            edges.append(Physics.SoftEdge3D(a,b,0.00002));edges.append(Physics.SoftEdge3D(a,c,0.00002))
            edges.append(Physics.SoftEdge3D(a,d,0.00004));edges.append(Physics.SoftEdge3D(b,c,0.00004))
            bends.append(Physics.SoftBend3D(b,c,a,d,0.005))
            slice++
        }
        ring++
    }
    return Physics.SoftBody3DDefinition(positions,faces,masses,edges,bends)
}
