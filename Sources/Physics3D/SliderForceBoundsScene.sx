use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use GFX.Scene3D
use STD.Math
use STD.Process
use STD.Time.Clock

class SliderForceBoundsSceneState {
    var bodies:Physics.RigidBody3D[] = []
    var joints:Physics.SliderConstraint3D[] = []
    var visuals:ECS.Entity[] = []
    var previous:Physics.Transform3D[] = []
    var target:float = 0.6
    var elapsed:float = 0.0
    var accumulator:float = 0.0
    var smoke:bool = false
    var reversed:bool = false
    var difference_seen:bool = false
    var expected_speed:float[] = [0.0,0.0]
    var expected_position:float[] = [0.0,0.0]
    var cycles:int = 0
    var pause_frames:int = 0
    var pause_elapsed:float = 0.0
    var pause_pose:Physics.Transform3D = Physics.Transform3D()
    var frame_clock:Clock = Clock()
    var frames:int = 0
    var report_time:float = 0.0
}
func force_bounds_visual(world:&Resources.World, meshes:&Resources.Meshes3D,
    size:Math.Vec3, position:Math.Vec3, color:Color) ECS.Entity
{
    let mesh = meshes.add(Scene3D.Geometry.Cube.make(size))
    return world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(position:position))
        ..with(Components.Mesh3D(mesh)) ..with(Components.Material3D(albedo:color,roughness:0.5)))
}
func apply_slider_force_bounds(world:&Resources.World, state:&SliderForceBoundsSceneState) {
    var i = 0
    while i < 2 {
        var minimum = -0.5
        if i == 1 { minimum = -2.0 }
        state.joints[i].set_motor(Physics.SliderMotor3D(state.target,minimum,2.0))
        i++
    }
    print("Target=$(state.target) m/s. Gold: [-0.5, 2] N. Blue: [-2, 2] N.")
}
func reset_slider_force_bounds(world:&Resources.World, state:&SliderForceBoundsSceneState) {
    var i = 0
    while i < 2 {
        let pose = Physics.Transform3D(Math.Vec3(0.0,3.0,(i as float-0.5)*2.0))
        state.bodies[i].set_transform(pose)
        state.bodies[i].set_linear_velocity(Math.Vec3());state.bodies[i].set_angular_velocity(Math.Vec3())
        state.previous[i] = pose;state.expected_speed[i] = 0.0;state.expected_position[i] = 0.0
        i++
    }
    state.target = 0.6;state.elapsed = 0.0;state.accumulator = 0.0
    state.reversed = false;state.difference_seen = false
    apply_slider_force_bounds(world,state)
}
func create_slider_force_bounds(world:&Resources.World, meshes:&Resources.Meshes3D,
    physics:&Physics.World3D, state:&SliderForceBoundsSceneState)
{
    var i = 0
    while i < 2 {
        let position = Math.Vec3(0.0,3.0,(i as float-0.5)*2.0)
        let pose = Physics.Transform3D(position)
        var rail = physics.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
            ..transform = pose ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
        var body = physics.create_rigid_body(Physics.RigidBody3DSettings() ..transform = pose
            ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.65,0.65,0.65)))
            ..mass_properties = Physics.MassProperties3D(2.0,Math.Vec3(0.2))
            ..collision_filter = Physics.CollisionFilter3D(mask_bits:0) ..allow_sleep = false)
        state.joints.append(physics.create_slider_constraint(rail,body,
            Physics.SliderConstraint3DSettings() ..minimum_position = -2.5 ..maximum_position = 2.5))
        state.bodies.append(body);state.previous.append(pose)
        var color = Color.bytes(245,186,82)
        if i == 1 { color = Color.bytes(75,163,245) }
        state.visuals.append(force_bounds_visual(world,meshes,Math.Vec3(0.65),position,color))
        force_bounds_visual(world,meshes,Math.Vec3(6.6,0.13,0.45),position.add(Math.Vec3(0.0,-0.4,0.0)),Color.bytes(110,125,145))
        let ends:float[] = [-3.0,3.0]
        for end in ends { force_bounds_visual(world,meshes,Math.Vec3(0.2,0.8,0.9),position.add(Math.Vec3(end,0.0,0.0)),Color.bytes(205,105,90)) }
        i++
    }
    force_bounds_visual(world,meshes,Math.Vec3(14.0,0.2,10.0),Math.Vec3(0.0,-0.1,0.0),Color.bytes(52,70,87))
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.45)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4,-1.0,-0.3).normalized(),intensity:2.5) ..shadow_distance = 40.0))
    match (try Process.arguments()) {
        success(arguments) => { for argument in arguments { if argument == "--smoke" { state.smoke = true } } }
        failure(error) => { panic(error.detail) }
    }
    reset_slider_force_bounds(world,state);state.frame_clock.tick()
    print("Gold reverses slowly with weak negative force; blue reverses faster with symmetric force. T: reverse target speed. R: restart. Space: pause/resume. Escape: quit.")
}
func toggle_slider_force_bounds_pause(simulation:&Application.Simulation) {
    if simulation.is_paused() { simulation.resume() } else { simulation.pause() }
}
func update_slider_force_bounds(world:&Resources.World, input:@Resources.InputState, simulation:&Application.Simulation,
    physics:&Physics.World3D, state:&SliderForceBoundsSceneState, controller:&Application.Controller)
{
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if input.is_pressed(Input.Key.space) { toggle_slider_force_bounds_pause(simulation) }
    if !state.smoke {
        if input.is_pressed(Input.Key.r) { reset_slider_force_bounds(world,state) }
        if input.is_pressed(Input.Key.t) { state.target = -state.target;apply_slider_force_bounds(world,state) }
    }
    if state.smoke && state.cycles==0 {
        if state.pause_frames==0 && state.elapsed>=0.5 {
            toggle_slider_force_bounds_pause(simulation);assert(simulation.is_paused())
            state.pause_elapsed = state.elapsed;state.pause_pose = state.bodies[0].transform();state.pause_frames = 1
        } else if state.pause_frames>0 && state.pause_frames<=12 {
            assert(simulation.is_paused() && simulation.delta()==0.0 && state.elapsed==state.pause_elapsed)
            assert(state.bodies[0].transform()==state.pause_pose)
            state.pause_frames++
            if state.pause_frames==13 { toggle_slider_force_bounds_pause(simulation);assert(!simulation.is_paused()) }
        }
    }
    state.accumulator += simulation.delta()
    let delta = 1.0/120.0
    while state.accumulator>=delta {
        var i = 0
        while i<2 { state.previous[i] = state.bodies[i].transform();i++ }
        if state.smoke {
            i = 0
            while i<2 {
                var minimum = -0.5;if i==1 { minimum = -2.0 }
                let force = Math.clamp(2.0*(state.target-state.expected_speed[i])/delta,minimum,2.0)
                state.expected_speed[i] += force*delta/2.0
                state.expected_position[i] += state.expected_speed[i]*delta
                i++
            }
        }
        physics.step(delta);state.elapsed += delta;state.accumulator -= delta
        if state.smoke {
            i = 0
            while i<2 {
                assert(state.joints[i].anchor_error().length()<0.001 && state.joints[i].angular_error().length()<0.001)
                var minimum = -0.5;if i==1 { minimum = -2.0 }
                assert(state.joints[i].motor_force()>=minimum-0.001 && state.joints[i].motor_force()<=2.001)
                assert(Math.abs(state.joints[i].position()-state.expected_position[i])<0.0001)
                assert(Math.abs(state.joints[i].speed()-state.expected_speed[i])<0.0001)
                assert(state.joints[i].friction_force()==0.0 && Math.abs(state.joints[i].position())<2.5)
                i++
            }
            if state.elapsed>2.7 && state.elapsed<4.1 {
                assert(state.joints[0].speed()>0.0 && state.joints[1].speed()<0.0)
                state.difference_seen = true
            }
            if !state.reversed && state.elapsed>=2.0 {
                state.target = -0.6;apply_slider_force_bounds(world,state);state.reversed = true
            }
            if state.elapsed>=8.0 {
                assert(state.reversed && state.difference_seen && state.joints[0].position()>0.2 && state.joints[1].position()< -1.8)
                if state.cycles==0 { assert(state.pause_frames==13) }
                state.cycles++
                print("Slider force bounds smoke cycle=$(state.cycles): signed budgets, independent trajectories, asymmetric reversal, alignment, reset, pause/resume and rendered poses verified")
                if state.cycles==2 { controller.stop() }
                reset_slider_force_bounds(world,state)
            }
        }
    }
    state.frames++;state.report_time += state.frame_clock.tick()
    if state.report_time>=1.0 { print("Slider force bounds FPS=$(state.frames as float/state.report_time)");state.frames = 0;state.report_time = 0.0 }
}
func render_slider_force_bounds(world:&Resources.World, state:&SliderForceBoundsSceneState) {
    let alpha = Math.clamp(state.accumulator*120.0,0.0,1.0)
    var i = 0
    while i<2 {
        let position = state.previous[i].position.lerp(state.bodies[i].position(),alpha)
        let first = state.previous[i].rotation;var second = state.bodies[i].rotation()
        if first.dot(second)<0.0 { second = second.multiply(-1.0) }
        let rotation = first.multiply(1.0-alpha).add(second.multiply(alpha)).normalized()
        world.update<Components.Transform3D>(state.visuals[i],func(transform:&Components.Transform3D) { transform.position = position;transform.rotation = rotation })
        if state.smoke {
            let pose = world.get<Components.Transform3D>(state.visuals[i])
            assert(pose.position.nearly_equal(position,0.0001) && Math.abs(pose.rotation.dot(rotation))>0.99999)
        }
        i++
    }
}
func main() {
    Application() ..add_resource(SliderForceBoundsSceneState()) ..add_resource(Physics.World3D())
        ..add_plugin(Plugins.Window(Plugins.Window.Settings() ..title = "Silex slider forces | Gold asymmetric, blue symmetric | T reverse, R restart, Space pause" ..width = 1200 ..height = 720))
        ..add_plugin(Plugins.Time()) ..add_plugin(Plugins.Scene3D())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings() ..target = Math.Vec3(0.0,3.0,0.0)
            ..distance = 12.0 ..yaw = Math.radians(-8.0) ..pitch = Math.radians(-20.0)))
        ..add_system(Application.Schedule.startup,create_slider_force_bounds)
        ..add_system(Application.Schedule.update,update_slider_force_bounds,process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.render,render_slider_force_bounds) ..run()
}
