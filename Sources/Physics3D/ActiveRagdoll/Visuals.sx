use Physics3D.ActiveRagdoll.Anatomy
use Physics3D.ActiveRagdoll.Geometry
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Resources
use GFX.Scene3D
use GFX.Physics
use STD.Math

package struct Piece {
    let entity:ECS.Entity
    let part:int
    let offset:Physics.Transform3D
    init(entity:ECS.Entity,part:int,offset:Physics.Transform3D=Physics.Transform3D()) {
        self.entity=entity;self.part=part;self.offset=offset
    }
}
package func entity(world:&Resources.World,mesh:Scene3D.MeshHandle,size:Math.Vec3,color:Color) ECS.Entity {
    return world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(scale:size))
        ..with(Components.Mesh3D(mesh)) ..with(Components.Material3D(albedo:color,roughness:0.65)))
}
// The abdomen has three visible shells on the existing pelvis/trunk bodies.
// Those seams describe the reference silhouette; they are not extra spine joints.
package func create(world:&Resources.World,meshes:&Resources.Meshes3D,pieces:&Piece[]) {
    let cube=meshes.add(Scene3D.Geometry.Cube.make())
    let sphere=meshes.add(Geometry.rounded(0.0))
    let capsule=meshes.add(Geometry.rounded(1.0))
    let limb=meshes.add(Geometry.rounded(3.0))
    let head=meshes.add(Geometry.rounded(0.6))
    let neck=meshes.add(Scene3D.Geometry.Cylinder.make())
    let blue=Color.bytes(66,88,153)
    let across=Math.Quat.angle_axis(Math.half_pi(),Math.Vec3.back())
    pieces.append(Piece(entity(world,capsule,Math.Vec3(0.20,0.225,0.25),blue),0,
        Physics.Transform3D(Math.Vec3(0.0,-0.03,0.0),across)))
    pieces.append(Piece(entity(world,capsule,Math.Vec3(0.115,0.18,0.24),blue),0,
        Physics.Transform3D(Math.Vec3(0.0,0.095,0.0),across)))
    pieces.append(Piece(entity(world,capsule,Math.Vec3(0.115,0.195,0.25),blue),1,
        Physics.Transform3D(Math.Vec3(0.0,-0.12,0.0),across)))
    pieces.append(Piece(entity(world,capsule,Math.Vec3(0.16,0.215,0.27),blue),1,
        Physics.Transform3D(Math.Vec3(0.0,0.015,0.0),across)))
    pieces.append(Piece(entity(world,capsule,Math.Vec3(0.19,0.265,0.28),blue),1,
        Physics.Transform3D(Math.Vec3(0.0,0.18,0.0),across)))
    pieces.append(Piece(entity(world,neck,Math.Vec3(0.11,0.075,0.11),blue),1,
        Physics.Transform3D(Math.Vec3(0.0,0.305,0.0))))
    pieces.append(Piece(entity(world,head,Math.Vec3(0.27,0.20,0.24),blue),2))
    let sides:int[]=[-1,1]
    for side in sides {
        pieces.append(Piece(entity(world,sphere,Math.Vec3(0.037),blue),2,
            Physics.Transform3D(Math.Vec3(side as float*0.055,0.015,0.125))))
    }
    for upper in [3,5] {
        pieces.append(Piece(entity(world,limb,Math.Vec3(0.17,0.075,0.18),blue),upper))
        pieces.append(Piece(entity(world,sphere,Math.Vec3(0.20),blue),upper,
            Physics.Transform3D(Math.Vec3(0.0,0.15,0.0))))
        pieces.append(Piece(entity(world,sphere,Math.Vec3(0.12),blue),upper,
            Physics.Transform3D(Math.Vec3(0.0,-0.15,0.0))))
        let forearm=upper+1
        pieces.append(Piece(entity(world,limb,Math.Vec3(0.12,0.0625,0.14),blue),forearm,
            Physics.Transform3D(Math.Vec3(0.0,0.08,0.0))))
        pieces.append(Piece(entity(world,cube,Math.Vec3(0.09,0.16,0.05),blue),forearm,
            Physics.Transform3D(Math.Vec3(0.0,-0.125,0.0))))
    }
    for thigh in [7,10] {
        pieces.append(Piece(entity(world,limb,Math.Vec3(0.22,0.105,0.21),blue),thigh))
        pieces.append(Piece(entity(world,sphere,Math.Vec3(0.14),blue),thigh,
            Physics.Transform3D(Math.Vec3(0.0,-0.21,0.0))))
        let shin=thigh+1
        pieces.append(Piece(entity(world,limb,Math.Vec3(0.18,0.105,0.18),blue),shin))
        pieces.append(Piece(entity(world,cube,Anatomy.size(thigh+2),blue),thigh+2))
    }
}
package func apply(world:&Resources.World,pieces:@Piece[],poses:@Physics.Transform3D[]) {
    for piece in pieces {
        let body=poses[piece.part]
        let pose=Physics.Transform3D(body.point(piece.offset.position),body.rotation.multiply(piece.offset.rotation))
        world.update<Components.Transform3D>(piece.entity,func(t:&Components.Transform3D) { t.position=pose.position;t.rotation=pose.rotation })
    }
}
