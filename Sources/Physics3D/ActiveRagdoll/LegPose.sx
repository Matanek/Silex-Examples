use STD.Math

package struct Pose {
    let hip:Math.Quat
    let knee:Math.Quat
    let ankle:Math.Quat
    init(hip:Math.Quat,knee:Math.Quat,ankle:Math.Quat) {
        self.hip=hip;self.knee=knee;self.ankle=ankle
    }
}

// Two equal 42 cm segments. Targets are projected onto their reachable shell.
// This only computes joint targets; it does not place any physical body.
package func solve(pelvis_position:Math.Vec3,pelvis_rotation:Math.Quat,hip_anchor:Math.Vec3,foot_position:Math.Vec3,heading:float) Pose {
    let foot_rotation=Math.Quat.angle_axis(heading,Math.Vec3.up())
    let hip_world=pelvis_position.add(pelvis_rotation.rotate(hip_anchor))
    let ankle_world=foot_position.subtract(foot_rotation.rotate(Math.Vec3(0.0,-0.04,0.09)))
    var relative=pelvis_rotation.conjugated().rotate(ankle_world.subtract(hip_world))
    let length=relative.length()
    if length>0.83 { relative=relative.multiply(0.83/length) }
    if length<0.00001 { relative=Math.Vec3(0.0,-0.40,0.0) }
    else if length<0.40 { relative=relative.multiply(0.40/length) }
    let abduction=Math.Quat.angle_axis(Math.atan2(relative.x,-relative.y),Math.Vec3.back())
    let sagittal=abduction.conjugated().rotate(relative)
    let knee=2.0*Math.acos(Math.clamp(relative.length()/0.84,0.0,1.0))
    let flexion=Math.atan2(-sagittal.z,-sagittal.y)-knee*0.5
    let hip=abduction.multiply(Math.Quat.angle_axis(flexion,Math.Vec3.right()))
    let knee_rotation=Math.Quat.angle_axis(knee,Math.Vec3.right())
    let parent=pelvis_rotation.multiply(hip).multiply(knee_rotation)
    return Pose(hip,knee_rotation,parent.conjugated().multiply(foot_rotation))
}

test "two-link targets reproduce foot positions and orientations in rotated frames" {
    let lateral:float[]=[-0.24,-0.12,0.0,0.12,0.24]
    let vertical:float[]=[-0.72,-0.60,-0.48]
    let longitudinal:float[]=[-0.40,-0.20,0.0,0.20,0.40]
    let turns:float[]=[-2.4,0.0,1.7]
    var count=0;var maximum=0.0
    for heading in turns {
        let rotation=Math.Quat.angle_axis(heading,Math.Vec3.up()).multiply(Math.Quat.angle_axis(0.1,Math.Vec3.right()))
        let pelvis=Math.Vec3(2.0,1.2,-3.0);let anchor=Math.Vec3(-0.16,-0.11,0.0)
        let foot_rotation=Math.Quat.angle_axis(heading,Math.Vec3.up())
        for x in lateral { for y in vertical { for z in longitudinal {
            let relative=Math.Vec3(x,y,z)
            if relative.length()<0.83 {
                let ankle=pelvis.add(rotation.rotate(anchor.add(relative)))
                let foot=ankle.add(foot_rotation.rotate(Math.Vec3(0.0,-0.04,0.09)))
                let pose=solve(pelvis,rotation,anchor,foot,heading)
                let rotations:Math.Quat[]=[pose.hip,pose.knee,pose.ankle]
                for q in rotations { assert(Math.abs(q.length_squared()-1.0)<0.00001) }
                let upper=rotation.multiply(pose.hip)
                let lower=upper.multiply(pose.knee)
                let reached=pelvis.add(rotation.rotate(anchor)).add(upper.rotate(Math.Vec3(0.0,-0.42,0.0))).add(lower.rotate(Math.Vec3(0.0,-0.42,0.0)))
                let error=reached.subtract(ankle).length();maximum=Math.max(maximum,error)
                assert(error<0.00001)
                assert(Math.abs(lower.multiply(pose.ankle).dot(foot_rotation))>0.99999)
                count++
            }
        } } }
    }
    print("Leg inverse kinematics: $(count) rotated targets, maximum error $(maximum)")
}

test "unreachable and coincident leg targets stay on the reachable shell" {
    let targets:Math.Vec3[]=[Math.Vec3(),Math.Vec3(0.0,-0.1,0.0),Math.Vec3(0.0,-2.0,0.0),Math.Vec3(1.0,-1.0,0.5)]
    for target in targets {
        let foot=target.add(Math.Vec3(0.0,-0.04,0.09))
        let pose=solve(Math.Vec3(),Math.Quat.identity(),Math.Vec3(),foot,0.0)
        let lower=pose.hip.multiply(pose.knee)
        let reached=pose.hip.rotate(Math.Vec3(0.0,-0.42,0.0)).add(lower.rotate(Math.Vec3(0.0,-0.42,0.0)))
        var expected=Math.Vec3(0.0,-0.40,0.0)
        if target.length()>0.00001 { expected=target.normalized().multiply(Math.clamp(target.length(),0.40,0.83)) }
        assert(reached.subtract(expected).length()<0.00001)
        assert(Math.abs(lower.multiply(pose.ankle).w)>0.99999)
    }
}
