use GFX.Physics
use STD.Math

package enum Section {
    start
    bumps
    blocks
    jump
    steps
    rough
    landing
}

package func section(position:Math.Vec3) Section {
    if position.x< -6.0 { return Section.steps }
    if position.x>6.0 {
        if position.z>=29.0 { return Section.jump }
        return Section.rough
    }
    if position.z<4.0 { return Section.start }
    if position.z<17.0 { return Section.bumps }
    if position.z<29.0 { return Section.blocks }
    if position.z<43.0 { return Section.jump }
    return Section.landing
}

package func section_name(value:Section) str {
    match value {
        start=>{ return "Départ" }
        bumps=>{ return "Bosses" }
        blocks=>{ return "Blocs progressifs" }
        jump=>{ return "Tremplin" }
        steps=>{ return "Grandes marches" }
        rough=>{ return "Bosses alternées" }
        landing=>{ return "Réception" }
    }
}

package struct Piece {
    let kind:int
    let position:Math.Vec3
    let size:Math.Vec3
    let rotation:Math.Quat
    init(position:Math.Vec3,size:Math.Vec3,kind:int=0,rotation:Math.Quat=Math.Quat()) {
        self.kind=kind;self.position=position;self.size=size;self.rotation=rotation
    }
}

package func layout() Piece[] {
    var pieces:Piece[]=[]
    let across=Math.Quat.angle_axis(Math.half_pi(),Math.Vec3.back())
    pieces.append(Piece(Math.Vec3(0.0,-0.12,7.0),Math.Vec3(0.42,2.8,0.0),2,across))
    pieces.append(Piece(Math.Vec3(-1.65,-0.1,12.0),Math.Vec3(0.65),1))
    pieces.append(Piece(Math.Vec3(1.65,-0.1,14.0),Math.Vec3(0.65),1))
    pieces.append(Piece(Math.Vec3(0.0,0.15,19.0),Math.Vec3(5.4,0.3,1.0)))
    pieces.append(Piece(Math.Vec3(0.0,0.25,22.0),Math.Vec3(5.4,0.5,1.2)))
    pieces.append(Piece(Math.Vec3(0.0,0.35,25.0),Math.Vec3(5.4,0.7,1.4)))
    pieces.append(Piece(Math.Vec3(0.0,1.22,35.0),Math.Vec3(7.0,0.24,8.0),0,
        Math.Quat.angle_axis(-0.3,Math.Vec3.right())))
    pieces.append(Piece(Math.Vec3(-11.0,0.35,8.0),Math.Vec3(5.0,0.7,1.5)))
    pieces.append(Piece(Math.Vec3(-11.0,0.65,11.0),Math.Vec3(5.0,1.3,1.5)))
    pieces.append(Piece(Math.Vec3(-11.0,0.95,14.0),Math.Vec3(5.0,1.9,1.5)))
    for index in 0...6 {
        let z=8.0+(index as float)*4.5
        var x=10.0;if index%2==1 { x=13.0 }
        pieces.append(Piece(Math.Vec3(x,-0.35,z),Math.Vec3(1.2),1))
    }
    pieces.append(Piece(Math.Vec3(13.0,1.0,36.0),Math.Vec3(6.0,0.25,7.0),0,
        Math.Quat.angle_axis(-0.26,Math.Vec3.right())))
    return pieces
}

func shape(piece:Piece) Physics.Shape3D {
    if piece.kind==1 { return Physics.Shape3D.sphere(Physics.Sphere3D(piece.size.x)) }
    if piece.kind==2 { return Physics.Shape3D.cylinder(Physics.Cylinder3D(piece.size.x,piece.size.y)) }
    return Physics.Shape3D.box(Physics.Box3D(piece.size))
}

package func create(world:Physics.World3D) {
    for piece in layout() {
        world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
            ..shape=shape(piece) ..transform=Physics.Transform3D(piece.position,piece.rotation) ..friction=1.1
            ..collision_filter=Physics.CollisionFilter3D(category_bits:1,mask_bits:14))
    }
}

package func chassis_shape() Physics.Shape3D {
    var parts:Physics.CompoundChild3D[]=[
        Physics.CompoundChild3D(0,Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.25,0.35,4.2))),
            Physics.Transform3D(Math.Vec3(0.0,-0.15,0.0))),
        Physics.CompoundChild3D(1,Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.9,1.0,1.8))),
            Physics.Transform3D(Math.Vec3(0.0,1.0,0.1))),
        Physics.CompoundChild3D(2,Physics.Shape3D.box(Physics.Box3D(Math.Vec3(2.0,0.3,1.2))),
            Physics.Transform3D(Math.Vec3(0.0,0.65,1.55))),
        Physics.CompoundChild3D(3,Physics.Shape3D.box(Physics.Box3D(Math.Vec3(2.1,0.45,4.6))),
            Physics.Transform3D(Math.Vec3(0.0,0.35,0.0))),
        Physics.CompoundChild3D(4,Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.05,0.65,1.5))),
            Physics.Transform3D(Math.Vec3(0.0,-0.65,0.15)))]
    return Physics.Shape3D.compound(Physics.Compound3D(parts))
}
