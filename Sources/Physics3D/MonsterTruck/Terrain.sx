use GFX.Assets.Model
use GFX.Physics
use STD.Math
use Physics3D.MonsterTruck.Arena

package static struct Collision {
    let surface:uint32=1
    let vehicle:uint32=14
}

package func section(position:Math.Vec3,quarter:Physics.Transform3D?) str {
    if let pose=quarter {
        let relative=pose.inverse_point(position)
        if Math.abs(relative.x)<10.0 && relative.z>= -20.0 && relative.z<18.0 { return "Quarter-pipe" }
    }
    if position.y>15.0 { return "Sommet" }
    if position.y>3.5 { return "Escalade" }
    return "Dalle"
}

package func add_floor(world:Physics.World3D) {
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..friction=1.0
        ..collision_filter=Physics.CollisionFilter3D(category_bits:Collision.surface,mask_bits:Collision.vehicle))
}

package func create(world:Physics.World3D,arena:@Model) {
    add_floor(world)
    for block in Arena.blocks(arena) {
        add_block(world,block)
    }
}

package func add_block(world:Physics.World3D,block:@Arena.Block) {
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.box(Physics.Box3D(block.size))
        ..transform=block.pose ..friction=1.1
        ..collision_filter=Physics.CollisionFilter3D(category_bits:Collision.surface,mask_bits:Collision.vehicle))
}

package func slope_spawn() Physics.Transform3D {
    let arena=Arena.load()
    return Arena.vehicle_spawn(arena,"Essai_Pente",Physics.Transform3D(Math.Vec3(0.0,2.35,0.0)))
}

package func ledge_spawn() Physics.Transform3D {
    let arena=Arena.load()
    return Arena.vehicle_spawn(arena,"Essai_Arete",Physics.Transform3D(Math.Vec3(0.0,2.35,0.0)))
}

package func bumps_spawn() Physics.Transform3D {
    let arena=Arena.load()
    return Arena.vehicle_spawn(arena,"Essai_Blocs",Physics.Transform3D(Math.Vec3(0.0,2.35,0.0)))
}
