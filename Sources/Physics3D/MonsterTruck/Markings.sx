use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Resources
use GFX.Scene3D
use Physics3D.MonsterTruck.Arena
use Physics3D.MonsterTruck.Primitives
use Physics3D.MonsterTruck.QuarterPipe
use Physics3D.MonsterTruck.SlideRails
use STD.Math

func batch(world:&Resources.World,mesh:Scene3D.MeshHandle,color:Color,placements:Scene3D.Transform[]) {
    var instances=Scene3D.Instances(placements)
    world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D()) ..with(Components.Mesh3D(mesh,casts_shadows:false))
        ..with(Components.Material3D(albedo:color,roughness:1.0)) ..with(instances))
}

package func create(world:&Resources.World,meshes:&Resources.Meshes3D,cube:Scene3D.MeshHandle) {
    // Three immutable batches; no per-frame marker entities or mesh rebuilding.
    var white:Scene3D.Transform[]=[];var dark:Scene3D.Transform[]=[]
    var arrows:Scene3D.Transform[]=[]
    let left=Arena.Grid.left+1.0;let right=Arena.right_edge()-1.0
    let near=Arena.Grid.near+1.0;let far=Arena.far_edge()-1.0
    let sides:float[]=[left,right]
    let ends:float[]=[near,far]
    for x in sides {
        white.append(Scene3D.Transform(Math.Vec3(x,0.006,(near+far)*0.5),Math.Quat(),Math.Vec3(0.16,0.01,far-near)))
    }
    for z in ends {
        white.append(Scene3D.Transform(Math.Vec3(0.0,0.006,z),Math.Quat(),Math.Vec3(right-left,0.01,0.16)))
    }
    for row in 0...2 { for column in 0...8 {
        let x= -5.25+(column as float)*1.5
        let tile=Scene3D.Transform(Math.Vec3(x,0.007,3.0+(row as float)*0.4),Math.Quat(),Math.Vec3(1.5,0.012,0.4))
        if (column+row)%2==0 { white.append(tile) } else { dark.append(tile) }
    } }
    let main_arrows:float[]=[6.0,50.0,94.0,134.0]
    for z in main_arrows { arrows.append(Scene3D.Transform(Math.Vec3(0.0,0.015,z),Math.Quat(),Math.Vec3(2.2))) }
    let quarter=QuarterPipe.Dimensions.origin
    let side_arrows:Math.Vec3[]=[Math.Vec3(-29.0,0.015,38.5),Math.Vec3(29.0,0.015,40.0),
        quarter.add(Math.Vec3(0.0,0.015,-5.0))]
    for position in side_arrows { arrows.append(Scene3D.Transform(position,Math.Quat(),Math.Vec3(2.2))) }
    let banks:Math.Vec3[]=[Arena.DirtBanks.west,Arena.DirtBanks.east]
    for bank in banks {
        let position=bank.add(Math.Vec3(0.0,0.015,-4.0))
        arrows.append(Scene3D.Transform(position,Math.Quat(),Math.Vec3(2.2)))
    }
    for rail in SlideRails.layout() {
        let point=rail.start.add(Math.Vec3(0.0,0.015,-17.0))
        arrows.append(Scene3D.Transform(point,Math.Quat(),Math.Vec3(2.2)))
    }
    batch(world,cube,Color.bytes(239,238,221),white)
    batch(world,cube,Color.bytes(40,49,61),dark)
    batch(world,meshes.add(Primitives.arrow()),Color.bytes(255,188,61),arrows)
}
