use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Physics
use GFX.Resources
use GFX.Scene3D
use Physics3D.MonsterTruck.Primitives
use STD.Math

package static struct Dimensions {
    let origin:Math.Vec3=Math.Vec3(43.0,0.0,91.0)
    let width:float=16.0
    let radius:float=13.0
    let angle:float=1.615
    let facets:int=9
    let deck_thickness:float=0.42
}

func edge(index:int,x:float) Math.Vec3 {
    let angle=Dimensions.angle*(index as float)/(Dimensions.facets as float)
    return Math.Vec3(x,Dimensions.radius*(1.0-Math.cos(angle)),Dimensions.radius*Math.sin(angle))
}

func facet_rotation(index:int) Math.Quat {
    let angle=Dimensions.angle*((index as float)+0.5)/(Dimensions.facets as float)
    return Math.Quat.angle_axis(-angle,Math.Vec3.right())
}

struct Support {
    let center:Math.Vec3
    let size:Math.Vec3
}

func supports() Support[] {
    var supports:Support[]=[]
    let sides:float[]=[-1.0,1.0]
    // Keep the trestle behind the riding surface and the returning truck.
    let length=Dimensions.radius+0.35
    let top=11.0
    for side in sides {
        let center=Math.Vec3(side*(Dimensions.width*0.5-0.30),top*0.5,length)
        supports.append(Support(center:center,size:Math.Vec3(0.33,top,0.30)))
    }
    let elevations:float[]=[2.6,7.0,11.0]
    for height in elevations {
        supports.append(Support(center:Math.Vec3(0.0,height-0.68,length),
            size:Math.Vec3(Dimensions.width-0.25,0.22,0.30)))
    }
    for index in [5,7,8] {
        let point=edge(index,0.0)
        let span=length-point.z
        for side in sides {
            let center=Math.Vec3(side*(Dimensions.width*0.5-0.30),point.y-0.44,point.z+span*0.5)
            supports.append(Support(center:center,size:Math.Vec3(0.28,0.24,span)))
        }
    }
    return supports
}

package func mesh() Scene3D.Geometry.Mesh {
    var vertices:Scene3D.Geometry.Vertex[]=[]
    var indices:uint32[]=[]
    let half=Dimensions.width*0.5
    let riding_surface=Color.bytes(91,94,99)
    let casing=Color.bytes(53,59,65)
    let stripe=Color.bytes(198,191,170)

    // The painted deck and collision facets share the same curved profile.
    let lanes:float[]=[-half,-half+0.22,half-0.22,half]
    for i in 0...Dimensions.facets {
        for lane in 0...3 {
            let left=lanes[lane]
            let right=lanes[lane+1]
            var color=stripe
            if lane==1 { color=riding_surface }
            Primitives.face(vertices,indices,edge(i,left),edge(i+1,left),edge(i+1,right),edge(i,right),color)
        }
        let left=edge(i,-half);let right=edge(i,half)
        let next_left=edge(i+1,-half);let next_right=edge(i+1,half)
        let thickness=facet_rotation(i).rotate(Math.Vec3(0.0,Dimensions.deck_thickness,0.0))
        Primitives.face(vertices,indices,left.subtract(thickness),next_left.subtract(thickness),
            next_left,left,casing)
        Primitives.face(vertices,indices,next_right.subtract(thickness),right.subtract(thickness),
            right,next_right,casing)
        Primitives.face(vertices,indices,right.subtract(thickness),next_right.subtract(thickness),
            next_left.subtract(thickness),left.subtract(thickness),casing)
    }
    let left=edge(Dimensions.facets,-half)
    let right=edge(Dimensions.facets,half)
    let thickness=facet_rotation(Dimensions.facets-1).rotate(Math.Vec3(0.0,Dimensions.deck_thickness,0.0))
    Primitives.face(vertices,indices,left.subtract(thickness),right.subtract(thickness),right,left,casing)
    for support in supports() { Primitives.box(vertices,indices,support.center,support.size,casing) }
    return Scene3D.Geometry.Mesh(vertices,indices)
}

package func create_collider(world:Physics.World3D) {
    let origin=Dimensions.origin
    for i in 0...Dimensions.facets {
        let a=edge(i,0.0);let b=edge(i+1,0.0)
        let rotation=facet_rotation(i)
        let thickness=rotation.rotate(Math.Vec3(0.0,Dimensions.deck_thickness,0.0))
        let center=origin.add(a.add(b).subtract(thickness).multiply(0.5))
        let size=Math.Vec3(Dimensions.width,Dimensions.deck_thickness,b.subtract(a).length())
        collider_box(world,center,size,rotation)
    }
}

func collider_box(world:Physics.World3D,center:Math.Vec3,size:Math.Vec3,rotation:Math.Quat) {
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.box(Physics.Box3D(size))
        ..transform=Physics.Transform3D(center,rotation)
        ..friction=1.1
        // Tires touch the deck; the inner rim is protected by the loaded tire.
        ..collision_filter=Physics.CollisionFilter3D(category_bits:1,mask_bits:12))
}

package func create_view(world:&Resources.World,meshes:&Resources.Meshes3D) {
    let asset=meshes.add(mesh())
    world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(position:Dimensions.origin))
        ..with(Components.Mesh3D(asset))
        ..with(Components.Material3D(albedo:Color.white(),metallic:0.15,roughness:0.76)))
}
