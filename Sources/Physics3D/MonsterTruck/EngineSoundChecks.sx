use GFX.Audio.Engines
use STD.Math
use STD.Process
use STD.Time.Stopwatch
use Physics3D.MonsterTruck.Model
use Physics3D.MonsterTruck.EngineSound
use Physics3D.MonsterTruck.Transmission

func mapping() {
    var truck = Model.Truck()
    assert(EngineSound.operating(truck).rpm == 850.0)
    truck.chassis.set_linear_velocity(Math.Vec3(0.0, 0.0, 30.0))
    assert(EngineSound.operating(truck).rpm == 850.0, "chassis speed must not substitute for the physical engine state")
    truck.chassis.set_linear_velocity(Math.Vec3())
    for frame in 0...120 {
        truck.controls(0.75,0.0);truck.step()
        let state=truck.motor.state();let sound=EngineSound.operating(truck)
        assert(sound.rpm==state.engine_rpm)
        assert(Math.abs(sound.load-Math.clamp(state.engine_torque/Transmission.Settings.torque,0.0,1.0))<0.000001)
    }
    print("Acoustic mapping passed: physical RPM and torque drive sound without a second transmission")
}
package func verify(directory:str? = null) {
    mapping()
    var expected = Model.Truck(); var actual = Model.Truck()
    var sound = EngineSound(directory, offline:true)
    var energy:float64 = 0.0
    for step in 0...120 {
        var gas = 0.0; if step > 40 { gas = 0.75 }
        expected.controls(gas, 0.0); actual.controls(gas, 0.0)
        expected.step(); actual.step(); sound.update(actual, 1.0 / 120.0)
        let samples = sound.render_offline(368)
        for sample in samples { assert(Math.is_finite(sample)); energy += sample as float64 * sample as float64 }
        assert(expected.chassis.transform() == actual.chassis.transform(), "audio changed the physics trajectory")
        assert(expected.chassis.linear_velocity() == actual.chassis.linear_velocity())
    }
    var clock = Stopwatch(); clock.start()
    while energy == 0.0 && clock.get_elapsed_seconds() < 5.0 {
        sound.update(actual, 0.01)
        for sample in sound.render_offline(480) { energy += sample as float64 * sample as float64 }
    }
    assert(energy > 0.0 && sound.current_rpm() > 0.0, "vehicle must produce audible PCM")
    sound.reset(); assert(sound.current_rpm() == 0.0)
    sound.update(actual, 0.0)
    print("Physics/audio checks passed: identical trajectory, finite nonzero PCM, nonblocking feed and reset; energy=", energy)
}
func main() {
    let arguments = Process.arguments(); var directory:str? = null
    if arguments.count() > 1 { directory = arguments[1] }
    verify(directory)
}
