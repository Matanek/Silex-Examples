use GFX.Physics
use STD.Math

package static struct Dimensions {
    let rings:int=24
    let slices:int=8
    let radius:float=1.18
    let half_width:float=0.48
}

func vertex(ring:int,slice:int) int {
    return ((ring+24)%24)*8+(slice+8)%8
}

package func make() Physics.SoftBody3DDefinition {
    // Same 24x8 layout and particle masses as the qualified bead coupling.
    // The flat tread and upright sidewalls replace the round torus section.
    let section:Math.Vec2[]=[Math.Vec2(0.0,1.18),Math.Vec2(0.38,1.18),
        Math.Vec2(0.48,1.06),Math.Vec2(0.25,0.66),Math.Vec2(0.0,0.60),
        Math.Vec2(-0.25,0.66),Math.Vec2(-0.48,1.06),Math.Vec2(-0.38,1.18)]
    var positions:Math.Vec3[]=[];var faces:int[]=[];var masses:float[]=[]
    var edges:Physics.SoftEdge3D[]=[];var bends:Physics.SoftBend3D[]=[]
    for ring in 0...24 {
        let angle=Math.two_pi()*(ring as float)/24.0
        for slice in 0...8 {
            let cross=section[slice]
            positions.append(Math.Vec3(cross.x,cross.y*Math.cos(angle),cross.y*Math.sin(angle)))
            masses.append(20.0)
            let a=vertex(ring,slice);let b=vertex(ring+1,slice)
            let c=vertex(ring,slice+1);let d=vertex(ring+1,slice+1)
            faces.append(a);faces.append(b);faces.append(c)
            faces.append(b);faces.append(d);faces.append(c)
            edges.append(Physics.SoftEdge3D(a,b,0.00015));edges.append(Physics.SoftEdge3D(a,c,0.00015))
            edges.append(Physics.SoftEdge3D(a,d,0.0003));edges.append(Physics.SoftEdge3D(b,c,0.0003))
            bends.append(Physics.SoftBend3D(b,c,a,d,0.005))
        }
    }
    return Physics.SoftBody3DDefinition(positions,faces,masses,edges,bends)
}
