use STD.Math

package static struct Grid {
    let left:float= -72.0
    let near:float= -20.0
    let columns:int=145
    let rows:int=185
    let spacing:float=1.0
}

package func right_edge() float { return Grid.left+(Grid.columns-1) as float*Grid.spacing }
package func far_edge() float { return Grid.near+(Grid.rows-1) as float*Grid.spacing }

package func ease(value:float) float {
    let t=Math.clamp(value,0.0,1.0)
    return t*t*(3.0-2.0*t)
}

// Rounded cross-sections fade the shoulders into the surrounding dirt.
package func shoulder(distance:float,top:float,base:float) float {
    return 1.0-ease((Math.abs(distance)-top)/(base-top))
}

func mound(x:float,z:float,center_x:float,center_z:float,width:float,length:float,height:float) float {
    let dx=(x-center_x)/width
    let dz=(z-center_z)/length
    return height*(1.0-ease(Math.sqrt(dx*dx+dz*dz)))
}

func plateau(x:float,z:float,center_x:float,start:float,top_start:float,top_end:float,end:float,
    top_width:float,width:float,height:float) float {
    let rise=ease((z-start)/(top_start-start))
    let fall=ease((end-z)/(end-top_end))
    return height*rise*fall*shoulder(x-center_x,top_width,width)
}

// A continuous soil surface with open run-ups between the main features.
package func relief(x:float,z:float) float {
    let table=plateau(x,z,0.0,9.0,24.0,32.0,45.0,6.0,13.0,2.65)
    let central=plateau(x,z,0.0,54.0,65.0,74.0,92.0,9.0,23.0,3.9)
    let west_jump=plateau(x,z,-28.0,41.0,55.0,57.0,62.0,4.0,10.5,3.1)
    let west_landing=plateau(x,z,-30.0,65.0,70.0,73.0,90.0,5.0,11.0,2.4)
    let east_banks=plateau(x,z,27.0,43.0,48.0,50.0,62.0,4.0,10.5,3.1)+
        plateau(x,z,28.0,68.0,80.0,82.0,91.0,4.0,10.5,3.5)
    let side=mound(x,z,-28.0,22.0,13.0,14.0,2.6)+mound(x,z,23.0,24.0,12.0,16.0,2.9)
    let rolls=mound(x,z,-1.0,101.0,8.0,5.4,0.66)+mound(x,z,1.2,111.0,8.0,6.0,1.04)+
        mound(x,z,-1.8,123.0,10.0,7.0,0.76)
    let back=plateau(x,z,16.0,113.0,132.0,139.0,158.0,4.5,14.0,2.3)+
        mound(x,z,40.0,131.0,16.0,17.0,1.45)
    let outside=mound(x,z,-53.0,35.0,15.5,22.0,1.05)+mound(x,z,-53.0,78.0,14.0,22.0,1.4)
    return Math.max(Math.max(table,central),Math.max(Math.max(west_jump,west_landing),
        Math.max(east_banks,Math.max(side,Math.max(rolls,Math.max(back,outside))))))
}
