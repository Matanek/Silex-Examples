use GFX.Assets.GLTF
use GFX.Assets.Model
use GFX.Physics
use STD.Math
use STD.Text

package struct Block {
    let name:str
    let pose:Physics.Transform3D
    let size:Math.Vec3
}

package func load() Model {
    match try GLTF.decode(embed_bytes("Assets/Arena.glb")) {
        success(model)=>{ return model }
        failure(error)=>{ panic("MonsterTruck Assets/Arena.glb: "+error.detail) }
    }
}

// Use local mesh bounds, including the mesh origin, then apply the node's
// exported world transform. This also handles cubes whose scale was applied.
package func blocks(model:@Model) Block[] {
    var result:Block[]=[]
    for index in 0...model.node_count() {
        let node=model.node(index)
        if !Text.starts_with(node.name,"Bloc_") { continue }
        assert(node.mesh>=0,"A Bloc_ object must have a mesh")
        let transform=node.world_transform
        assert(transform.scale.x>0.0 && transform.scale.y>0.0 && transform.scale.z>0.0,
            "A Bloc_ object must have positive scale")
        let mesh=model.model_mesh(node.mesh)
        var minimum=Math.Vec3(3.4e38)
        var maximum=Math.Vec3(-3.4e38)
        for primitive in mesh.primitives {
            for vertex in model.mesh(primitive.mesh).vertices() {
                minimum=minimum.minimum(vertex.position)
                maximum=maximum.maximum(vertex.position)
            }
        }
        let size=maximum.subtract(minimum)
        assert(size.x>0.0 && size.y>0.0 && size.z>0.0,"A Bloc_ object must have volume")
        let local_center=minimum.add(maximum).multiply(0.5)
        let scale=transform.scale
        let offset=Math.Vec3(local_center.x*scale.x,local_center.y*scale.y,local_center.z*scale.z)
        let center=transform.position.add(transform.rotation.rotate(offset))
        result.append(Block(name:node.name,pose:Physics.Transform3D(center,transform.rotation),
            size:Math.Vec3(size.x*scale.x,size.y*scale.y,size.z*scale.z)))
    }
    return result
}

package func marker(model:@Model,name:str) Physics.Transform3D? {
    for index in 0...model.node_count() {
        let node=model.node(index)
        if node.name==name {
            let pose=node.world_transform
            return Physics.Transform3D(pose.position,pose.rotation)
        }
    }
    return null
}

package func vehicle_spawn(model:@Model,name:str,fallback:Physics.Transform3D) Physics.Transform3D {
    if let marker=marker(model,name) {
        return Physics.Transform3D(marker.position.add(Math.Vec3(0.0,2.35,0.0)),marker.rotation)
    }
    return fallback
}
