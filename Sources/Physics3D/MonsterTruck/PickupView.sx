use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Resources
use GFX.Scene3D
use Physics3D.MonsterTruck.TyreMesh
use Physics3D.MonsterTruck.Model
use Physics3D.MonsterTruck.PickupBody
use Physics3D.MonsterTruck.Primitives
use Physics3D.MonsterTruck.RimMesh
use Physics3D.MonsterTruck.WheelView
use STD.Math

package class PickupView {
    var truck:Model.Truck
    var wheels:WheelView[]=[]
    private var parts:ECS.Entity[]=[]
    private var tyre:TyreMesh=TyreMesh()
    var struts:ECS.Entity[]=[]
    var last_step:int= -1
    init(truck:Model.Truck,world:&Resources.World,meshes:&Resources.Meshes3D) {
        self.truck=truck
        let red=Color.bytes(220,39,38)
        let assets=WheelView.Assets(rim:meshes.add(RimMesh.rim(red)),
            hub:meshes.add(RimMesh.hub()),
            bolt:meshes.add(Scene3D.Geometry.Cylinder.make(0.021,0.025,6)))
        for wheel in truck.wheels { self.wheels.append(WheelView(wheel,assets,self.tyre,world,meshes)) }
        self.parts.append(WheelView.mesh_entity(world,meshes.add(PickupBody.shell(red)),
            Color.white(),metallic:0.35,roughness:0.32))
        self.parts.append(WheelView.mesh_entity(world,meshes.add(PickupBody.windows()),
            Color.white(),metallic:0.25,roughness:0.18))
        self.parts.append(WheelView.mesh_entity(world,meshes.add(PickupBody.frame_and_trim()),
            Color.white(),metallic:0.25,roughness:0.56))
        let strut=meshes.add(PickupBody.shock())
        for _ in 0...4 { self.struts.append(WheelView.mesh_entity(world,strut,Color.white(),0.55,0.38)) }
    }
    func rebind(truck:Model.Truck) {
        self.truck=truck;self.last_step= -1
        var index=0
        for view in self.wheels { view.wheel=truck.wheels[index];index++ }
    }
    func update(world:&Resources.World,meshes:&Resources.Meshes3D) {
        if self.last_step==self.truck.steps { return }
        self.last_step=self.truck.steps
        let pose=self.truck.chassis.transform()
        for part in self.parts {
            world.update<Components.Transform3D>(part,func(t:&Components.Transform3D) {
                t.position=pose.position
                t.rotation=pose.rotation
            })
        }
        var index=0
        for view in self.wheels {
            view.update(world,meshes,self.tyre)
            var wheel=self.truck.wheels[index]
            let top=pose.point(Math.Vec3(wheel.anchor.x*0.36,0.12,wheel.anchor.z))
            let bottom=wheel.rim.position();let offset=bottom.subtract(top)
            let position=top.add(bottom).multiply(0.5)
            let rotation=Primitives.align(Math.Vec3.up(),offset.normalized());let size=Math.Vec3(1.0,offset.length(),1.0)
            world.update<Components.Transform3D>(self.struts[index],func(t:&Components.Transform3D) {
                t.position=position;t.rotation=rotation;t.scale=size
            })
            index++
        }
    }
}
