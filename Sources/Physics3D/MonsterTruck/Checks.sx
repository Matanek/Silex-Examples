use Physics3D.SoftTire.BeadChecks
use Physics3D.MonsterTruck.HandlingChecks
use Physics3D.MonsterTruck.Model
use STD.Process
use STD.Time
use STD.Math

package struct Observation {
    var x:float=0.0
    var y:float=0.0
    var z:float=0.0
    var speed:float=0.0
    var highest:float=0.0
    var bead:float=0.0
    var floor:float=100.0
    init() {}
}

func inspect_joints(truck:Model.Truck) {
    for wheel in truck.wheels {
        let travel=wheel.suspension.translation()
        let lateral=Math.sqrt(travel.x*travel.x+travel.z*travel.z)
        let expected=truck.chassis.transform().vector(
            Math.Quat.angle_axis(wheel.current_steering,Math.Vec3.up()).rotate(Math.Vec3.right()))
        let axle=wheel.rim.transform().vector(Math.Vec3.up())
        let alignment=Math.abs(axle.dot(expected))
        if lateral>=0.025 || Math.abs(travel.y)>=0.51 || alignment<=0.995 {
            print("Truck joint error: lateral=",lateral," travel=",travel.y," alignment=",alignment)
        }
        assert(lateral<0.025 && Math.abs(travel.y)<0.51 && alignment>0.995)
    }
}

package func inspect(frames:int=480,workers:int=4,drive:bool=false,turn:float=0.0,
    course:bool=false,pressure:float=700.0) Observation {
    var truck=Model.Truck(workers,course);truck.set_pressure(pressure)
    var clock=Time.Clock();let start=clock.tick();var seconds=0.0
    var result=Observation()
    for frame in 0...frames {
        if drive && frame>=120 { truck.controls(1.0,turn) }
        let before=clock.tick();truck.step();seconds+=clock.tick()
        inspect_joints(truck)
        let p=truck.chassis.position()
        assert(Math.is_finite(p.x) && Math.is_finite(p.y) && Math.is_finite(p.z))
        result.highest=Math.max(result.highest,p.y)
        result.bead=Math.max(result.bead,truck.maximum_bead_error())
        result.floor=Math.min(result.floor,truck.minimum_y())
        if result.floor<=0.025 || result.bead>=0.08 {
            print("Truck limit frame=",frame+1," x=",p.x," y=",p.y," z=",p.z,
                " bead=",result.bead," floor=",result.floor)
            var index=0
            for wheel in truck.wheels {
                let hub=wheel.rim.position();var minimum=100.0
                for point in wheel.tyre.positions() { minimum=Math.min(minimum,point.y) }
                print("wheel=",index," hub y=",hub.y," z=",hub.z,
                    " bead=",wheel.seat.maximum_error()," floor=",minimum)
                index++
            }
        }
        assert(result.floor>0.025 && result.bead<0.08)
        if frame%120==119 || frame+1==frames {
            print("frame=",frame+1," x=",p.x," y=",p.y," z=",p.z,
                " speed=",truck.chassis.linear_velocity().length()," bead=",result.bead," floor=",result.floor)
        }
    }
    let p=truck.chassis.position();result.x=p.x;result.y=p.y;result.z=p.z
    result.speed=truck.chassis.linear_velocity().length()
    print("physics seconds=",seconds," simulated=",(frames as float)/120.0," workers=",workers)
    return result
}

func compare_workers() {
    var one=Model.Truck(1);var four=Model.Truck(4)
    for frame in 0...120 {
        if frame>=30 { one.controls(0.6,0.4);four.controls(0.6,0.4) }
        one.step();four.step();inspect_joints(one);inspect_joints(four)
        assert(one.chassis.position().nearly_equal(four.chassis.position(),0.0))
        assert(one.chassis.linear_velocity().nearly_equal(four.chassis.linear_velocity(),0.0))
        let a=one.chassis.transform().rotation;let b=four.chassis.transform().rotation
        assert(a.x==b.x && a.y==b.y && a.z==b.z && a.w==b.w)
        for index in 0...4 {
            assert(one.wheels[index].rim.position().nearly_equal(four.wheels[index].rim.position(),0.0))
            for vertex in 0...192 {
                assert(one.wheels[index].tyre.position(vertex).nearly_equal(four.wheels[index].tyre.position(vertex),0.0))
                assert(one.wheels[index].tyre.velocity(vertex).nearly_equal(four.wheels[index].tyre.velocity(vertex),0.0))
            }
        }
    }
    print("Truck workers: identical chassis, hubs and particles")
}

func braking() {
    var truck=Model.Truck(4)
    for frame in 0...480 { if frame>=120 { truck.controls(1.0,0.0) }
        truck.step();inspect_joints(truck) }
    let speed=truck.chassis.linear_velocity().length()
    assert(speed>3.0)
    truck.controls(0.0,0.0,brake:true)
    for _ in 0...180 { truck.step();inspect_joints(truck) }
    assert(truck.chassis.linear_velocity().length()<speed*0.4)
    // Space targets the rear wheel pair; the fronts remain freely rolling.
    truck.controls(0.0,0.0,handbrake:true)
    for _ in 0...60 { truck.step();inspect_joints(truck) }
    assert(truck.maximum_bead_error()<0.08)
    print("Truck braking: deceleration and retained rear braking")
}

package func verify() {
    compare_workers()
    let rest=inspect()
    assert(rest.y>1.7 && rest.y<2.8 && rest.speed<0.7)
    let low=inspect(pressure:250.0)
    assert(low.y>1.6 && low.y<2.8)
    let firm=inspect(pressure:1000.0)
    assert(firm.y>1.6 && firm.y<2.8 && firm.speed<0.7)
    let straight=inspect(frames:720,drive:true)
    assert(straight.z>12.0 && Math.abs(straight.x)<2.0)
    let left=inspect(frames:720,drive:true,turn:1.0)
    let right=inspect(frames:720,drive:true,turn:-1.0)
    assert(left.x>2.0 && right.x< -2.0)
    braking()
    let arena=inspect(frames:1440,drive:true,course:true)
    assert(arena.z>38.0 && arena.highest>3.5)
    BeadChecks.reciprocal()
    let original=BeadChecks.inspect("Default bead preset",frames:120)
    assert(original.error<0.08)
    HandlingChecks.verify()
    print("Monster truck physical checks passed")
}

func main() {
    var workers=1;var frames=60;var drive=false;var turn=0.0;var course=false
    for arg in Process.arguments() {
        if arg=="--verify" { verify();return }
        if arg=="--handling" { HandlingChecks.verify();return }
        if arg=="--compare" { compare_workers();return }
        if arg=="--firm" { let firm=inspect(pressure:1000.0);return }
        if arg=="--four" { workers=4 }
        if arg=="--long" { frames=480 }
        if arg=="--drive" { drive=true;frames=600 }
        if arg=="--short-drive" { drive=true;frames=240 }
        if arg=="--course" { drive=true;course=true;frames=1440 }
        if arg=="--turn" { turn=1.0 }
    }
    let result=inspect(frames,workers,drive,turn,course)
}
