use GFX.Application
use GFX.Components
use GFX.Input
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use GFX.Scene2D
use GFX.Scene3D
use GFX.Window
use Physics3D.MonsterTruck.Terrain
use Physics3D.MonsterTruck.Scene
use Physics3D.MonsterTruck.Controls
use Physics3D.MonsterTruck.Checks
use Physics3D.MonsterTruck.RampChecks
use Physics3D.MonsterTruck.SlopeChecks
use Physics3D.MonsterTruck.ArenaChecks
use Physics3D.MonsterTruck.SceneChecks
use Physics3D.MonsterTruck.EngineSound
use Physics3D.MonsterTruck.StutterTrace
use STD.Math
use STD.Process
use STD.Time

func update(world:&Resources.World,state:&Scene.TruckScene,input:@Resources.InputState,
    simulation:@Application.Simulation,controller:&Application.Controller,window:&Window) {
    if input.is_pressed(Input.Key.escape) { controller.stop();return }
    if var trace=state.stutter_trace { trace.begin(input.focused_window()!=null,simulation.delta()) }
    if !state.profile {
        for event in input.events() {
            Scene.handle(world,state,event)
            match event {
                key_pressed(_)=>{
                    if var trace=state.stutter_trace {
                        if trace.handle(event) {
                            if state.quit_after_mark { window.set_title("MonsterTruck — À-coup marqué · fermeture dans 2 s") }
                            else { window.set_title("MonsterTruck — À-coup marqué") }
                        }
                    }
                }
                mouse_wheel(wheel)=>{ state.chase.distance=Math.clamp(state.chase.distance-wheel.delta.y*0.75,7.0,18.0) }
                else=>{}
            }
        }
        Scene.perform(world,state)
    }
    if state.profile && state.metrics.elapsed>=state.profile_duration {
        state.metrics.report(state.truck.steps)
        print("truck x=",state.truck.chassis.position().x," y=",state.truck.chassis.position().y,
            " z=",state.truck.chassis.position().z," bead=",state.truck.maximum_bead_error())
        controller.stop();return
    }
    var clock=Time.Stopwatch();clock.start()
    let step_seconds=1.0/120.0
    // At 60 Hz two steps are due per image. Carry one more if an impact
    // overruns, so a delayed frame cannot starve the next render and audio feed.
    let catch_up_steps=2
    state.accumulator=Math.min(state.accumulator+simulation.delta(),(catch_up_steps as float+1.0)*step_seconds)
    var ticks=0
    while state.accumulator>=step_seconds && ticks<catch_up_steps {
        if state.profile {
            var gas=0.0;if state.truck.steps>=240 { gas=state.profile_throttle }
            if state.hold_profile { state.truck.controls(0.0,0.0,brake:true,handbrake:true) }
            else if state.ramp_profile {
                var throttle=0.0;if state.truck.steps>=120 && state.truck.steps<480 {throttle=0.25}
                state.truck.controls(throttle,0.0,brake:state.truck.steps>=480,handbrake:state.truck.steps>=480)
            }
            else {
                var turn=0.0;if state.profile_turn && state.truck.steps>=480 { turn=0.8 }
                state.truck.controls(gas,turn)
            }
        } else {
            state.panel.drive(state.truck)
        }
        state.truck.step();state.accumulator-=step_seconds;ticks++
    }
    let physics_seconds=clock.get_elapsed_seconds()
    if var trace=state.stutter_trace { trace.physics(physics_seconds,ticks,state.accumulator) }
    state.metrics.physics_seconds+=physics_seconds
    if state.profile || state.trace_performance {
        let focused=input.focused_window()!=null
        if focused!=state.trace_focused { state.trace_focus_changed=true }
        state.trace_focused=focused
        state.trace_physics_seconds+=physics_seconds;state.trace_physics_ticks+=ticks
        state.trace_maximum_update=Math.max(state.trace_maximum_update,physics_seconds)
    }
    if var sound=state.sound { sound.update(state.truck,simulation.delta()) }
    if state.profile || state.hud_visible {
        state.telemetry+=simulation.delta()
        if state.telemetry>=0.15 { Scene.labels(state);state.telemetry=0.0 }
        if state.ui.update(0.0) {
            world.update<Scene2D.Canvas>(state.hud,func(c:&Scene2D.Canvas) {
                c.replace(state.ui.drawing(Controls.Hud.width,Controls.Hud.height))
            })
        }
    }
}

func sync_view(world:&Resources.World,meshes:&Resources.Meshes3D,state:&Scene.TruckScene,
    simulation:@Application.Simulation) {
    // Scene3D gathers the camera, transforms and meshes during render.
    state.view!.update(world,meshes)
    Scene.follow(world,state,simulation.delta())
    if var dirt=state.dirt {
        let feedback=dirt.update(world,meshes,state.truck,state.chase.transform(),simulation.delta())
        if var sound=state.sound {
            sound.update_gravel(feedback.rumble,simulation.delta())
            sound.play_landing(feedback.impact)
        }
    }
    if var trace=state.stutter_trace {
        trace.prepared(state.truck.steps,state.view!.last_step,state.truck.chassis.transform(),
            state.truck.chassis.linear_velocity(),state.chase.yaw)
    }
}

// Exclusive World access orders this sample after the Scene3D gathering system.
func trace_render_ready(world:&Resources.World,state:&Scene.TruckScene) {
    if var trace=state.stutter_trace {
        trace.render_ready(world.get<Components.Transform3D>(state.camera).position)
    }
}

func finish_trace_frame(state:&Scene.TruckScene,renderer:@Resources.Renderer,controller:&Application.Controller) {
    if var trace=state.stutter_trace {
        let stats=renderer.stats()
        if trace.finish(stats.draw_calls(),stats.shadow_draw_calls()) && state.quit_after_mark { controller.stop() }
    }
}

func save_trace(state:&Scene.TruckScene) {
    if var trace=state.stutter_trace {
        match try trace.save() {
            success=>{ print("Trace MonsterTruck : ",trace.path) }
            failure(error)=>{ print("Échec de l’écriture de la trace MonsterTruck : ",trace.path," — ",error.detail) }
        }
    }
}

func render(state:&Scene.TruckScene) {
    state.metrics.frame()
    if (state.profile || state.trace_performance) && state.metrics.frames>0 && state.metrics.interval_frames==0 {
        var slopes=0
        for wheel in state.truck.wheels {
            let hit=state.truck.world.ray_cast(Physics.Ray3D(wheel.rim.position(),Math.Vec3(0.0,-3.0,0.0)),
                filter:Physics.QueryFilter3D(mask_bits:1))
            if let support=hit { if support.normal().y<0.995 { slopes++ } }
        }
        print("profile slope_contacts=",slopes," speed=",state.truck.chassis.linear_velocity().length()," elapsed=",state.metrics.elapsed," fps=",state.metrics.fps,
            " z=",state.truck.chassis.position().z," y=",state.truck.chassis.position().y,
            " simulated_seconds=",(state.truck.steps as float)/120.0," physics_seconds=",state.metrics.physics_seconds,
            " x=",state.truck.chassis.position().x," sector=",Terrain.section_name(Terrain.section(state.truck.chassis.position())),
            " physics_ms_per_tick=",state.trace_physics_seconds*1000.0/Math.max(1.0,state.trace_physics_ticks as float),
            " maximum_update_ms=",state.trace_maximum_update*1000.0," focused=",state.trace_focused,
            " focus_changed=",state.trace_focus_changed,
            " up=",state.truck.chassis.transform().vector(Math.Vec3.up()).y)
        state.trace_physics_seconds=0.0;state.trace_physics_ticks=0;state.trace_maximum_update=0.0
        state.trace_focus_changed=false
    }
}

func main() {
    var workers=4;var profile=false;var slope=false;var ramp=false;var audible=true;var bumps=false
    var profile_throttle:float=0.75;var profile_turn=false;var trace_performance=false;var profile_duration:float=12.0
    var spawn:Physics.Transform3D?=null
    var directory:str?=null
    var trace_path:str?=null
    var quit_after_mark=false
    let arguments=Process.arguments()
    for i,arg in arguments.indexed() {
        if arg=="--silent" { audible=false }
        if arg=="--engine-library" { if i+1>=arguments.count() { panic("--engine-library requires a bank directory") } directory=arguments[i+1] }
        if arg=="--ramp-check" {RampChecks.verify();return}
        if arg=="--slope-check" { SlopeChecks.verify();return }
        if arg=="--arena-check" { ArenaChecks.verify();return }
        if arg=="--check" { Checks.verify();return }
        if arg=="--scene-check" { SceneChecks.verify();return }
        if arg=="--single" { workers=1 }
        if arg=="--ledge" { spawn=Terrain.ledge_spawn() }
        if arg=="--bumps" || arg=="--profile-bumps" { spawn=Terrain.bumps_spawn() }
        if arg=="--profile-bumps" { profile=true;bumps=true }
        if arg=="--profile-ramp" {profile=true;ramp=true}
        if arg=="--profile-slope" { profile=true;slope=true }
        if arg=="--profile" { profile=true }
        if arg=="--profile-drive" { profile=true;profile_throttle=1.0 }
        if arg=="--profile-boost" { profile=true;profile_throttle=1.5 }
        if arg=="--profile-turn" { profile=true;profile_throttle=1.0;profile_turn=true }
        if arg=="--trace-performance" { trace_performance=true }
        if arg=="--quit-after-mark" { quit_after_mark=true }
        if arg=="--trace-stutter" {
            if i+1>=arguments.count() { panic("--trace-stutter requires an output CSV path") }
            trace_path=arguments[i+1]
        }
        if arg=="--profile-long" { profile=true;profile_duration=36.0 }
    }
    if slope { profile_duration=6.0 }
    var state=Scene.TruckScene(workers,profile,slope,ramp,profile_throttle,profile_turn,trace_performance,profile_duration,spawn:spawn,bumps:bumps)
    if audible { state.sound=EngineSound(directory) }
    var title="MonsterTruck"
    if profile { title="MESURE AUTOMATIQUE — Monster pickup — $(profile_duration as int) secondes" }
    if ramp {title="MESURE AUTOMATIQUE — Montée de rampe — $(profile_duration as int) secondes"}
    if slope { title="MESURE AUTOMATIQUE — Monster truck sur pente — 6 secondes" }
    if bumps { title="MESURE AUTOMATIQUE — Petites bosses — $(profile_duration as int) secondes" }
    if let path=trace_path {
        state.stutter_trace=StutterTrace(path)
        state.quit_after_mark=quit_after_mark
        if !profile { title="MonsterTruck — M : marquer l’à-coup" }
    }
    title=title+" — Cadence 120 Hz"
    var app=Application() ..add_resource(state)
        ..add_resource(Resources.Skybox3D.procedural(Scene3D.ProceduralSky.day()))
        ..add_plugin(Plugins.Window(Plugins.Window.Settings() ..title=title ..width=1280 ..height=800))
        ..add_plugin(Plugins.Input()) ..add_plugin(Plugins.Time())
        ..add_plugin(Plugins.Scene3D()) ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Application.FramePacing(120))
        ..add_system(Application.Schedule.startup,Scene.startup)
        ..add_system(Application.Schedule.update,update,process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.post_update,sync_view,process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.render,render,process_mode:Application.ProcessMode.always)
    if trace_path!=null {
        app.add_system(Application.Schedule.render,trace_render_ready,process_mode:Application.ProcessMode.always)
        app.add_after_system(Application.Schedule.render,finish_trace_frame,process_mode:Application.ProcessMode.always)
        app.add_system(Application.Schedule.shutdown,save_trace)
    }
    app.run()
}
