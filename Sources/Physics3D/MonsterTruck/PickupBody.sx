use GFX.Color
use GFX.Scene3D
use Physics3D.MonsterTruck.Primitives
use STD.Math

// Each station cuts through the side panel. The lower edge traces both wheel openings.
struct Station {
    let z:float
    let sill:float
    let belt:float
    let width:float
    let stripe:float

    init(z:float,sill:float,belt:float,width:float,stripe:float) {
        self.z=z
        self.sill=sill
        self.belt=belt
        self.width=width
        self.stripe=stripe
    }

    func side(side:float,fraction:float) Math.Vec3 {
        return Math.Vec3(side*(self.width-0.055*(1.0-fraction)),
            self.sill+(self.belt-self.sill)*fraction,self.z)
    }

    func deck(side:float) Math.Vec3 {
        return Math.Vec3(side*(self.width-0.13),self.belt+0.095,self.z)
    }
}

static struct Bed {
    let front:float= -1.19
}

func stations() Station[] {
    return [
        Station(-2.77,0.07,0.72,0.94,0.08),
        Station(-2.63,0.08,0.78,1.04,0.13),
        Station(-2.53,0.31,0.79,1.08,0.14),
        Station(-2.33,0.49,0.80,1.11,0.15),
        Station(-2.06,0.55,0.80,1.13,0.16),
        Station(-1.79,0.49,0.80,1.13,0.17),
        Station(-1.55,0.30,0.80,1.10,0.20),
        Station(-1.38,0.01,0.80,1.04,0.27),
        Station(Bed.front,-0.16,0.80,1.01,0.34),
        Station(-0.77,-0.21,0.80,1.01,0.43),
        Station(-0.10,-0.21,0.80,1.01,0.48),
        Station(0.62,-0.17,0.79,1.01,0.36),
        Station(0.72,-0.15,0.79,1.01,0.33),
        Station(0.88,-0.08,0.78,1.02,0.27),
        Station(1.12,0.10,0.78,1.04,0.21),
        Station(1.34,0.37,0.78,1.09,0.17),
        Station(1.61,0.52,0.77,1.13,0.15),
        Station(1.94,0.56,0.76,1.14,0.15),
        Station(2.23,0.49,0.74,1.12,0.14),
        Station(2.47,0.32,0.72,1.08,0.13),
        Station(2.63,0.09,0.68,1.02,0.10),
        Station(2.75,0.09,0.61,0.90,0.07)]
}

func side_face(vertices:&Scene3D.Geometry.Vertex[],indices:&uint32[],side:float,
    a:Math.Vec3,b:Math.Vec3,c:Math.Vec3,d:Math.Vec3,color:Color) {
    if side>0.0 { Primitives.face(vertices,indices,a,b,c,d,color) }
    else { Primitives.face(vertices,indices,d,c,b,a,color) }
}

package func shell(paint:Color) Scene3D.Geometry.Mesh {
    let panels=stations()
    let lower=paint.lerp(Color.black(),0.30)
    let accent=Color.bytes(248,111,21)
    let highlight=Color.bytes(255,174,40)
    let liner=Color.bytes(24,26,30)
    var vertices:Scene3D.Geometry.Vertex[]=[]
    var indices:uint32[]=[]
    let sides:float[]=[-1.0,1.0]
    for i in 0...(panels.count()-1) {
        let a=panels[i];let b=panels[i+1]
        for side in sides {
            let a_trim=a.side(side,0.12);let b_trim=b.side(side,0.12)
            let a_stripe=a.side(side,0.84-a.stripe);let b_stripe=b.side(side,0.84-b.stripe)
            let a_highlight=a.side(side,0.81);let b_highlight=b.side(side,0.81)
            let a_upper=a.side(side,0.84);let b_upper=b.side(side,0.84)
            let a_belt=a.side(side,1.0);let b_belt=b.side(side,1.0)
            let a_base=a.side(side,0.0);let b_base=b.side(side,0.0)
            side_face(vertices,indices,side,b_base,a_base,a_trim,b_trim,lower)
            side_face(vertices,indices,side,b_trim,a_trim,a_stripe,b_stripe,paint)
            side_face(vertices,indices,side,b_stripe,a_stripe,a_highlight,b_highlight,accent)
            side_face(vertices,indices,side,b_highlight,a_highlight,a_upper,b_upper,highlight)
            side_face(vertices,indices,side,b_upper,a_upper,a_belt,b_belt,paint)
            side_face(vertices,indices,side,b_belt,a_belt,a.deck(side),b.deck(side),paint)
            // The folded lip gives the wheel openings depth when viewed from below.
            let lip=Math.Vec3(side*0.11,-0.02,0.0)
            side_face(vertices,indices,side,b_base.subtract(lip),a_base.subtract(lip),a_base,b_base,lower)
            if b.z<=Bed.front {
                let inset=Math.Vec3(side*0.045,0.20,0.0)
                side_face(vertices,indices,side,b.deck(side),a.deck(side),
                    a.deck(side).subtract(inset),b.deck(side).subtract(inset),liner)
            }
        }
        if a.z>=Bed.front {
            Primitives.face(vertices,indices,a.deck(-1.0),b.deck(-1.0),b.deck(1.0),a.deck(1.0),paint)
        } else {
            let left=Math.Vec3(-0.045,0.20,0.0)
            let right=Math.Vec3(0.045,0.20,0.0)
            Primitives.face(vertices,indices,a.deck(-1.0).subtract(left),b.deck(-1.0).subtract(left),
                b.deck(1.0).subtract(right),a.deck(1.0).subtract(right),liner)
            if b.z==Bed.front {
                Primitives.face(vertices,indices,b.deck(1.0).subtract(right),b.deck(-1.0).subtract(left),
                    b.deck(-1.0),b.deck(1.0),liner)
            }
        }
    }
    let tail=panels[0];let nose=panels[panels.count()-1]
    Primitives.face(vertices,indices,tail.deck(-1.0).add(Math.Vec3(0.045,-0.20,0.0)),
        tail.deck(1.0).add(Math.Vec3(-0.045,-0.20,0.0)),tail.deck(1.0),tail.deck(-1.0),liner)
    Primitives.face(vertices,indices,tail.side(1.0,0.0),tail.side(-1.0,0.0),tail.side(-1.0,1.0),tail.side(1.0,1.0),paint)
    Primitives.face(vertices,indices,tail.side(1.0,1.0),tail.side(-1.0,1.0),tail.deck(-1.0),tail.deck(1.0),paint)
    Primitives.face(vertices,indices,nose.side(-1.0,0.0),nose.side(1.0,0.0),nose.side(1.0,1.0),nose.side(-1.0,1.0),paint)
    Primitives.face(vertices,indices,nose.side(-1.0,1.0),nose.side(1.0,1.0),nose.deck(1.0),nose.deck(-1.0),paint)

    let fl=Math.Vec3(-0.88,0.885,0.72);let fr=Math.Vec3(0.88,0.885,0.72)
    let rl=Math.Vec3(-0.88,0.895,-1.19);let rr=Math.Vec3(0.88,0.895,-1.19)
    let tl=Math.Vec3(-0.72,1.60,0.04);let tr=Math.Vec3(0.72,1.60,0.04)
    let bl=Math.Vec3(-0.72,1.60,-1.08);let br=Math.Vec3(0.72,1.60,-1.08)
    Primitives.face(vertices,indices,fl,fr,tr,tl,paint)
    Primitives.face(vertices,indices,rr,rl,bl,br,paint)
    Primitives.face(vertices,indices,rl,fl,tl,bl,paint)
    Primitives.face(vertices,indices,fr,rr,br,tr,paint)
    let cfl=Math.Vec3(-0.55,1.66,-0.01);let cfr=Math.Vec3(0.55,1.66,-0.01)
    let crl=Math.Vec3(-0.55,1.66,-1.03);let crr=Math.Vec3(0.55,1.66,-1.03)
    Primitives.face(vertices,indices,bl,tl,cfl,crl,paint)
    Primitives.face(vertices,indices,tr,br,crr,cfr,paint)
    Primitives.face(vertices,indices,tl,tr,cfr,cfl,paint)
    Primitives.face(vertices,indices,br,bl,crl,crr,paint)
    Primitives.face(vertices,indices,crl,cfl,cfr,crr,paint)
    return Scene3D.Geometry.Mesh(vertices,indices)
}

package func windows() Scene3D.Geometry.Mesh {
    var vertices:Scene3D.Geometry.Vertex[]=[]
    var indices:uint32[]=[]
    let tint=Color.bytes(20,37,49)
    Primitives.face(vertices,indices,Math.Vec3(-0.78,0.95,0.665),Math.Vec3(0.78,0.95,0.665),
        Math.Vec3(0.65,1.52,0.125),Math.Vec3(-0.65,1.52,0.125),tint)
    Primitives.face(vertices,indices,Math.Vec3(0.77,0.985,-1.181),Math.Vec3(-0.77,0.985,-1.181),
        Math.Vec3(-0.64,1.51,-1.101),Math.Vec3(0.64,1.51,-1.101),tint)
    let sides:float[]=[-1.0,1.0]
    for side in sides {
        let bottom=0.863*side;let top=0.743*side
        side_face(vertices,indices,side,Math.Vec3(bottom,0.98,0.51),Math.Vec3(bottom,0.98,-0.52),
            Math.Vec3(top,1.52,-0.52),Math.Vec3(top,1.52,0.018),tint)
        side_face(vertices,indices,side,Math.Vec3(bottom,0.98,-0.62),Math.Vec3(bottom,0.98,-1.08),
            Math.Vec3(top,1.52,-1.00),Math.Vec3(top,1.52,-0.62),tint)
    }
    return Scene3D.Geometry.Mesh(vertices,indices)
}

func beam(vertices:&Scene3D.Geometry.Vertex[],indices:&uint32[],a:Math.Vec3,b:Math.Vec3,
    width:float,color:Color) {
    let axis=b.subtract(a).normalized()
    let u=axis.cross(Math.Vec3.right()).normalized().multiply(width*0.5)
    let v=axis.cross(u)
    let corners:Math.Vec3[]=[u.add(v),v.subtract(u),u.add(v).negated(),u.subtract(v)]
    for index in 0...4 {
        let p=corners[index];let q=corners[(index+1)%4]
        Primitives.face(vertices,indices,a.add(p),a.add(q),b.add(q),b.add(p),color)
    }
}

func box(vertices:&Scene3D.Geometry.Vertex[],indices:&uint32[],center:Math.Vec3,size:Math.Vec3,color:Color) {
    let cube=Scene3D.Geometry.Cube.make()
    let offset=vertices.count() as uint32
    for vertex in cube.vertices() {
        let p=vertex.position
        let position=center.add(Math.Vec3(p.x*size.x,p.y*size.y,p.z*size.z))
        vertices.append(Scene3D.Geometry.Vertex(position,vertex.normal,vertex.uv,color))
    }
    for index in cube.indices() { indices.append(index+offset) }
}

package func frame_and_trim() Scene3D.Geometry.Mesh {
    var vertices:Scene3D.Geometry.Vertex[]=[]
    var indices:uint32[]=[]
    let graphite=Color.bytes(29,32,37)
    let sides:float[]=[-1.0,1.0]
    for side in sides {
        let x=side*0.64
        let rear=Math.Vec3(x,0.12,-2.36);let front=Math.Vec3(x,0.12,2.37)
        let skid_rear=Math.Vec3(x,-0.74,-0.70);let skid_front=Math.Vec3(x,-0.74,0.70)
        beam(vertices,indices,rear,front,0.13,graphite)
        beam(vertices,indices,rear,skid_rear,0.12,graphite)
        beam(vertices,indices,skid_front,front,0.12,graphite)
        beam(vertices,indices,skid_rear,skid_front,0.12,graphite)
        beam(vertices,indices,skid_rear,Math.Vec3(x,0.12,-0.12),0.084,graphite)
        beam(vertices,indices,skid_front,Math.Vec3(x,0.12,0.12),0.084,graphite)
        beam(vertices,indices,Math.Vec3(x,-0.41,-1.34),Math.Vec3(x,0.12,-1.59),0.085,graphite)
        beam(vertices,indices,Math.Vec3(x,-0.41,1.34),Math.Vec3(x,0.12,1.59),0.085,graphite)
    }
    let dark=Color.bytes(22,25,30)
    let metal=Color.bytes(84,91,98)
    box(vertices,indices,Math.Vec3(0.0,-0.48,0.15),Math.Vec3(0.88,0.50,1.24),dark)
    box(vertices,indices,Math.Vec3(0.0,0.12,2.69),Math.Vec3(1.88,0.14,0.26),metal)
    box(vertices,indices,Math.Vec3(0.0,0.10,-2.71),Math.Vec3(1.97,0.14,0.24),metal)
    box(vertices,indices,Math.Vec3(0.0,0.42,2.752),Math.Vec3(1.08,0.28,0.028),dark)
    for row in 0...3 {
        box(vertices,indices,Math.Vec3(0.0,0.34+0.08*(row as float),2.77),Math.Vec3(1.04,0.015,0.014),metal)
    }
    box(vertices,indices,Math.Vec3(0.0,0.59,-2.777),Math.Vec3(0.30,0.06,0.025),dark)
    for side in sides {
        box(vertices,indices,Math.Vec3(side*0.717,0.46,2.750),Math.Vec3(0.30,0.19,0.05),dark)
        box(vertices,indices,Math.Vec3(side*0.717,0.483,2.774),Math.Vec3(0.265,0.12,0.017),Color.bytes(247,240,215))
        box(vertices,indices,Math.Vec3(side*0.717,0.392,2.774),Math.Vec3(0.265,0.033,0.017),Color.bytes(237,137,42))
        box(vertices,indices,Math.Vec3(side*0.842,0.46,-2.756),Math.Vec3(0.12,0.37,0.059),Color.bytes(132,19,18))
        box(vertices,indices,Math.Vec3(side*0.842,0.40,-2.788),Math.Vec3(0.102,0.045,0.017),Color.bytes(221,144,107))
        box(vertices,indices,Math.Vec3(side*0.98,0.99,0.47),Math.Vec3(0.23,0.12,0.18),dark)
        box(vertices,indices,Math.Vec3(side*1.026,0.73,-0.41),Math.Vec3(0.042,0.043,0.16),dark)
    }
    return Scene3D.Geometry.Mesh(vertices,indices)
}

func coil_point(angle:float,height:float,radial:float,vertical:float) Math.Vec3 {
    return Math.Vec3(radial*Math.cos(angle),height+vertical,radial*Math.sin(angle))
}

package func shock() Scene3D.Geometry.Mesh {
    let shaft=Scene3D.Geometry.Cylinder.make(0.038,1.0,12)
    var vertices=shaft.vertices()
    var indices=shaft.indices()
    let boot=Color.bytes(47,50,54)
    let spring=Color.bytes(147,151,154)
    let sections=56
    for index in 0...sections {
        let progress=(index as float)/(sections as float)
        let next=((index+1) as float)/(sections as float)
        let a=Math.two_pi()*7.0*progress;let b=Math.two_pi()*7.0*next
        let y= -0.34+0.67*progress;let next_y= -0.34+0.67*next
        for edge in 0...6 {
            let theta=Math.two_pi()*(edge as float)/6.0
            let end=Math.two_pi()*((edge+1) as float)/6.0
            let radius=0.090+0.014*Math.cos(theta)
            let end_radius=0.090+0.014*Math.cos(end)
            let lip=0.014*Math.sin(theta);let end_lip=0.014*Math.sin(end)
            Primitives.face(vertices,indices,coil_point(a,y,radius,lip),coil_point(a,y,end_radius,end_lip),
                coil_point(b,next_y,end_radius,end_lip),coil_point(b,next_y,radius,lip),spring)
        }
    }
    let collars:float[]=[-0.35,0.34]
    for collar in collars {
        let sleeve=Scene3D.Geometry.Cylinder.make(0.108,0.036,12)
        let offset=vertices.count() as uint32
        for vertex in sleeve.vertices() {
            vertices.append(Scene3D.Geometry.Vertex(vertex.position.add(Math.Vec3(0.0,collar,0.0)),vertex.normal,vertex.uv,boot))
        }
        for index in sleeve.indices() { indices.append(index+offset) }
    }
    return Scene3D.Geometry.Mesh(vertices,indices)
}
