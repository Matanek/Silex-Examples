use GFX.Physics
use Physics3D.MonsterTruck.Model
use Physics3D.MonsterTruck.TyreProfile
use STD.Math

package struct Track {
    let point:Math.Vec3
    let spray:Math.Vec3
    let mist:float
    let clods:float
    let rumble:float
}

package func is_loose(hit:@Physics.WorldRayHit3D) bool {
    // Dirt belongs to the arena floor. Painted obstacles and steel have their
    // own surfaces, including the quarter-pipe entry.
    match hit.body().shape() {
        plane(_)=>{ return true }
        else=>{ return false }
    }
}

package func track(truck:@Model.Truck,index:int) Track? {
    let hit=truck.support(index)
    if hit==null { return null }
    let ground=hit!
    if !is_loose(ground) { return null }
    let wheel=truck.wheels[index]
    let center=wheel.rim.position()
    let point=ground.point()
    let normal=ground.normal()
    if center.subtract(point).dot(normal)>1.15 { return null }
    let pose=truck.chassis.transform()
    if pose.vector(Math.Vec3.up()).dot(normal)<0.15 { return null }

    let velocity=wheel.rim.linear_velocity()
    let tangent=velocity.subtract(normal.multiply(velocity.dot(normal)))
    let spin=wheel.rim.angular_velocity()
    let tread=tangent.add(spin.cross(normal.multiply(-TyreProfile.Dimensions.radius)))
    let slip=tread.subtract(normal.multiply(tread.dot(normal)))
    let slip_speed=slip.length()
    let speed=tangent.length()
    let throttle=Math.min(1.0,Math.abs(truck.drive))
    let rolling=Math.clamp((speed-1.2)/22.0,0.0,1.0)
    let scratching=Math.clamp((slip_speed-0.7)/10.0,0.0,1.0)
    let thrown=Math.max(scratching,throttle*rolling*0.55)
    let mist=Math.min(1.0,rolling*0.18+thrown*1.15)
    let rumble=Math.min(1.0,rolling*0.52+scratching*0.66)

    // The contact patch throws material in the direction its rubber scrubs.
    // At low slip the trail instead hangs behind the rolling wheel.
    var spray=tangent.multiply(-1.0).normalized()
    if slip_speed>1.3 { spray=slip.normalized() }
    return Track(point:point,spray:spray,mist:mist,clods:thrown,rumble:rumble)
}
