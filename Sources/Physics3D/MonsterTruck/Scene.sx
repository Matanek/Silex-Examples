use GFX.Components
use GFX.Physics
use GFX.ECS
use GFX.Input
use GFX.Input.Events
use GFX.Resources
use GFX.Scene2D
use GFX.UI
use Physics3D.MonsterTruck.Model
use Physics3D.MonsterTruck.Controls
use Physics3D.MonsterTruck.PickupView
use Physics3D.MonsterTruck.Environment
use Physics3D.MonsterTruck.Terrain
use Physics3D.MonsterTruck.ChaseCamera
use Physics3D.MonsterTruck.EngineSound
use Physics3D.SoftTire.Metrics
use STD.Math

package class TruckScene {
    var truck:Model.Truck
    var panel:Controls.Panel=Controls.Panel()
    var ui:UI.Session
    var view:PickupView?=null
    var camera:ECS.Entity=ECS.Entity()
    var hud:ECS.Entity=ECS.Entity()
    var shortcut_line:ECS.Entity=ECS.Entity()
    var shortcut_width:float=0.0
    var shortcut_center:float=0.0
    var shortcut_bottom:float=0.0
    var hud_visible:bool=false
    var accumulator:float=0.0
    var previous_chassis_position:Math.Vec3
    var previous_chassis_velocity:Math.Vec3
    var telemetry:float=0.0
    var chase:ChaseCamera
    var metrics:Metrics=Metrics()
    var profile:bool=false
    var hold_profile:bool=false
    var ramp_profile:bool=false
    let profile_duration:float
    let profile_throttle:float
    let profile_turn:bool
    var trace_focused:bool=false
    var trace_focus_changed:bool=false
    var trace_physics_seconds:float=0.0
    var trace_physics_ticks:int=0
    var trace_maximum_update:float=0.0
    let trace_performance:bool
    var sound:EngineSound?=null
    let workers:int
    init(workers:int=4,profile:bool=false,slope:bool=false,ramp:bool=false,throttle:float=0.75,turn:bool=false,trace:bool=false,duration:float=12.0,spawn:Physics.Transform3D?=null,bumps:bool=false) {
        self.profile_duration=duration;self.profile_throttle=throttle;self.profile_turn=turn;self.trace_performance=trace
        self.workers=workers;self.profile=profile;self.hold_profile=slope || bumps;self.ramp_profile=ramp
        if let pose=spawn { self.truck=Model.Truck(workers,obstacles:true,spawn:pose) }
        else if slope { self.truck=Model.Truck(workers,obstacles:true,spawn:Terrain.slope_spawn()) }
        else if ramp {self.truck=Model.Truck(workers,obstacles:true,
            spawn:Physics.Transform3D(Math.Vec3(-2.0,2.35,8.0),Math.Quat.angle_axis(0.3,Math.Vec3.up())))}
        else { self.truck=Model.Truck(workers,obstacles:true) }
        self.previous_chassis_position=self.truck.chassis.position()
        self.previous_chassis_velocity=self.truck.chassis.linear_velocity()
        self.chase=ChaseCamera(self.previous_chassis_position,self.truck.chassis.transform().vector(Math.Vec3.back()))
        if profile { self.ui=UI.Session(self.panel.measurement(slope,ramp,throttle,turn,duration,bumps:bumps)) }
        else { self.ui=UI.Session(self.panel.describe()) }
    }
    func create_view(world:&Resources.World,meshes:&Resources.Meshes3D) {
        self.view=PickupView(self.truck,world,meshes)
    }
    func step() {
        self.previous_chassis_position=self.truck.chassis.position()
        self.previous_chassis_velocity=self.truck.chassis.linear_velocity()
        self.truck.step()
    }
    func reset(world:&Resources.World,meshes:&Resources.Meshes3D) {
        var next=Model.Truck(self.workers,obstacles:true,final_drive:self.truck.final_drive)
        next.set_pressure(self.panel.pressure())
        self.view!.rebind(next,world,meshes);self.truck=next
        self.accumulator=0.0
        self.previous_chassis_position=self.truck.chassis.position()
        self.previous_chassis_velocity=self.truck.chassis.linear_velocity()
        self.chase.reset(self.previous_chassis_position)
        self.panel.reset=false
        if var sound=self.sound { sound.reset() }
    }
}

package func labels(state:&TruckScene) {
    let speed=Math.round(state.truck.chassis.linear_velocity().length()*3.6) as int
    let fps=Math.round(state.metrics.fps) as int
    let engine=state.truck.motor.state();var gear="N"
    if engine.gear>0 { gear="$(engine.gear)" }else if engine.gear<0 { gear="R" }
    state.panel.metrics.set("Vitesse : $(speed) km/h\nBoîte : $(gear) · $(Math.round(engine.engine_rpm) as int) tr/min\n$(fps) FPS")
    var name="monster"
    if state.panel.inflation==1 { name="bas" }
    if state.panel.inflation==2 { name="ferme" }
    let section=Terrain.section_name(Terrain.section(state.truck.chassis.position()))
    var mode="indépendante";if state.panel.coupled { mode="couplée" }
    var turbo="prêt";if state.truck.gas>1.0 { turbo="actif" }
    state.panel.settings.set("Gonflage : $(name)\nDirection : $(mode)\nSecteur : $(section)\nRapport de pont : $(state.truck.final_drive)\nTurbo : $(turbo)")
}

package func startup(world:&Resources.World,meshes:&Resources.Meshes3D,images:&Resources.Images,state:&TruckScene) {
    Environment.create(world,meshes,images);state.create_view(world,meshes)
    state.camera=world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D())
        ..with(Components.Camera3D(vertical_fov:Math.radians(62.0),far_plane:450.0)))
    labels(state)
    state.hud=world.spawn(ECS.EntityRecipe() ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(state.ui.drawing(Controls.Hud.width,Controls.Hud.height),Controls.Hud.width,Controls.Hud.height)
            ..anchor=Math.Vec2() ..pivot=Math.Vec2() ..space=Scene2D.CanvasSpace.viewport ..layer=100 ..visible=state.profile))
    if !state.profile {
        var drawing=Controls.shortcuts()
        let bounds=drawing.bounds()!
        state.shortcut_width=bounds.size.x
        state.shortcut_center=bounds.position.x+bounds.size.x*0.5
        state.shortcut_bottom=bounds.position.y+bounds.size.y
        state.shortcut_line=world.spawn(ECS.EntityRecipe()
            ..with(Scene2D.Transform(position:Math.Vec2(-state.shortcut_center,-state.shortcut_bottom-12.0)))
            ..with(Scene2D.Canvas(drawing) ..anchor=Math.Vec2(0.5,1.0) ..space=Scene2D.CanvasSpace.viewport ..layer=100))
    }
}

package func handle(world:&Resources.World,state:&TruckScene,event:@Events.Event) bool {
    match event {
        key_pressed(key)=>{
            if key.keycode==104 as uint32 || key.keycode==72 as uint32 || (key.keycode==0 as uint32 && key.key==Input.Key.h) {
                if !key.repeated {
                    state.hud_visible= !state.hud_visible
                    world.update<Scene2D.Canvas>(state.hud,func(canvas:&Scene2D.Canvas) { canvas.visible=state.hud_visible })
                }
                return true
            }
        }
        window_resized(size)=>{
            if size.size.x>0.0 {
                let scale=Math.min(1.0,Math.max(1.0,size.size.x-24.0)/state.shortcut_width)
                world.update<Scene2D.Transform>(state.shortcut_line,func(transform:&Scene2D.Transform) {
                    transform.scale=Math.Vec2(scale)
                    transform.position=Math.Vec2(-state.shortcut_center*scale,-state.shortcut_bottom*scale-12.0)
                })
            }
        }
        window_focus_lost(_)=>{
            state.panel.handle(event)
            return state.ui.handle(event)
        }
        else=>{}
    }
    if state.panel.handle(event) { return true }
    return state.hud_visible && state.ui.handle(event)
}

package func perform(world:&Resources.World,meshes:&Resources.Meshes3D,state:&TruckScene) {
    if state.panel.reset { state.reset(world,meshes) }
    if state.panel.changed { state.truck.set_pressure(state.panel.pressure());state.panel.changed=false }
    if state.panel.gearing_requested {
        state.panel.gearing_requested=false
        if !state.panel.forward && !state.panel.reverse && state.truck.configure_gearing(state.panel.final_drive) { state.panel.feedback.set("Démultiplication appliquée") }
        else { state.panel.final_drive=state.truck.final_drive;state.panel.feedback.set("Arrêtez-vous, gaz relâchés") }
        labels(state)
    }
}

package func follow(world:&Resources.World,state:&TruckScene,delta:float) {
    // Sample between the last two physics states, one tick behind real time.
    let alpha=Math.clamp(state.accumulator/Model.Truck.fixed_delta,0.0,1.0)
    let position=state.previous_chassis_position.lerp(state.truck.chassis.position(),alpha)
    let velocity=state.previous_chassis_velocity.lerp(state.truck.chassis.linear_velocity(),alpha)
    state.chase.update(position,velocity,delta)
    let pose=state.chase.transform()
    world.update<Components.Transform3D>(state.camera,func(t:&Components.Transform3D) { t.position=pose.position;t.rotation=pose.rotation })
}
