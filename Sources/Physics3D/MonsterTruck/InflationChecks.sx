use Physics3D.MonsterTruck.Model
use STD.Math

package func inspect(pressure:float,flex:float=4.0) float {
    var truck=Model.Truck(4,tyre_flex:flex);truck.set_pressure(pressure)
    truck.controls(0.0,0.0,brake:true,handbrake:true)
    var height=0.0;var footprint=0.0
    for frame in 0...480 {
        truck.step()
        if frame>=360 { for wheel in truck.wheels {
            height+=wheel.rim.position().y/480.0
            for ring in 0...24 { for slice in [0,1,7] {
                if wheel.tyre.position(ring*8+slice).y<0.06 { footprint+=1.0/480.0 }
            } }
        } }
    }
    print("inflation flex=",flex," pressure=",pressure," loaded_radius=",height," contact_vertices=",footprint,
        " bead=",truck.maximum_bead_error()," body_y=",truck.chassis.position().y)
    assert(truck.maximum_bead_error()<0.08 && truck.minimum_y()>0.025)
    return height
}

package func verify() {
    let low=inspect(60.0);let monster=inspect(1400.0);let firm=inspect(2600.0)
    assert(monster-low>0.06 && firm-monster>0.025)
    assert(low>0.85 && firm<1.3)
    print("Inflation profiles passed: distinct loaded deformation with retained beads")
}

func main() { verify() }
