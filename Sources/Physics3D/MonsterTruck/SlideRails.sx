use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Physics
use GFX.Resources
use GFX.Scene3D
use Physics3D.MonsterTruck.Arena
use STD.Math

package static struct Collision {
    let surface:uint64=16
}

package struct Rail {
    let start:Math.Vec3
    let end:Math.Vec3

    func approach_height() float { return self.start.y-0.80 }
}

package func layout() Rail[] {
    return [
        Rail(start:Math.Vec3(-27.0,2.04,116.0),end:Math.Vec3(-27.0,3.45,131.0)),
        Rail(start:Math.Vec3(-41.0,3.25,116.0),end:Math.Vec3(-41.0,1.65,131.0))]
}

// Raised wheel paths leave the rail's footings at the base elevation.
package func approach_ground(x:float,z:float) float {
    if z<101.0 || z>121.0 || x< -47.0 || x> -21.0 { return 0.0 }
    var height=0.0
    for rail in layout() {
        let lateral=Math.abs(Math.abs(x-rail.start.x)-2.0)
        let taper=1.0-Arena.ease((lateral-0.88)/1.00)
        let distance=z-rail.start.z
        let ramp=Arena.ease((distance+14.0)/12.0)*(1.0-Arena.ease((distance-1.0)/3.0))
        height=Math.max(height,taper*ramp*rail.approach_height())
    }
    return height
}

package func foundation_compaction(x:float,z:float) float {
    if x < -50.0 || x > -18.0 || z < 96.0 || z > 138.0 { return 0.0 }
    var value=0.0
    for rail in layout() {
        let width=Arena.shoulder(x-rail.start.x,3.6,8.0)
        let length=Arena.ease((z-rail.start.z+20.0)/6.0)*(1.0-Arena.ease((z-rail.end.z-2.0)/5.0))
        value=Math.max(value,width*length)
    }
    return value
}

enum Part {
    beam
    footing
}

struct Box {
    let center:Math.Vec3
    let size:Math.Vec3
    let rotation:Math.Quat
    let part:Part
}

func rail_beam(rail:Rail) Box {
    let axis=rail.end.subtract(rail.start)
    let rotation=Math.Quat.angle_axis(-Math.atan2(axis.y,axis.z),Math.Vec3.right())
    let size=Math.Vec3(0.70,0.22,axis.length())
    let center=rail.start.add(rail.end).multiply(0.5).subtract(rotation.rotate(Math.Vec3(0.0,size.y*0.5,0.0)))
    return Box(center:center,size:size,rotation:rotation,part:Part.beam)
}

func boxes(rail:Rail) Box[] {
    var pieces:Box[]=[rail_beam(rail)]
    let span=rail.end.subtract(rail.start)
    let stations:float[]=[0.08,0.50,0.92]
    for fraction in stations {
        let point=rail.start.add(span.multiply(fraction))
        let height=point.y-0.18
        pieces.append(Box(center:Math.Vec3(point.x,height*0.5,point.z),size:Math.Vec3(0.32,height,0.32),
            rotation:Math.Quat(),part:Part.footing))
        pieces.append(Box(center:Math.Vec3(point.x,0.09,point.z),size:Math.Vec3(1.34,0.18,0.62),
            rotation:Math.Quat(),part:Part.footing))
    }

    return pieces
}

package func create_colliders(world:Physics.World3D) {
    for rail in layout() {
        for piece in boxes(rail) {
            var friction=1.1
            var category:uint64=1
            if piece.part==Part.beam {
                category=Collision.surface
                friction=0.055
            }
            world.create_rigid_body(Physics.RigidBody3DSettings()
                ..body_type=Physics.BodyType3D.fixed
                ..shape=Physics.Shape3D.box(Physics.Box3D(piece.size))
                ..transform=Physics.Transform3D(piece.center,piece.rotation) ..friction=friction
                ..collision_filter=Physics.CollisionFilter3D(category_bits:category,mask_bits:14))
        }
    }
}

package func create_view(world:&Resources.World,meshes:&Resources.Meshes3D) {
    let cube=meshes.add(Scene3D.Geometry.Cube.make())
    var steel:Scene3D.Transform[]=[]
    var supports:Scene3D.Transform[]=[]
    for rail in layout() { for piece in boxes(rail) {
        let placement=Scene3D.Transform(piece.center,piece.rotation,piece.size)
        if piece.part==Part.beam { steel.append(placement) }
        else { supports.append(placement) }
    } }
    var metal_instances=Scene3D.Instances(steel)
    var support_instances=Scene3D.Instances(supports)
    world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D()) ..with(Components.Mesh3D(cube))
        ..with(Components.Material3D(albedo:Color.bytes(176,187,198),metallic:0.55,roughness:0.24))
        ..with(metal_instances))
    world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D()) ..with(Components.Mesh3D(cube))
        ..with(Components.Material3D(albedo:Color.bytes(67,75,83),metallic:0.3,roughness:0.60))
        ..with(support_instances))
}
