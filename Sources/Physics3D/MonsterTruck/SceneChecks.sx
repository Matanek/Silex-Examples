use GFX.Accessibility
use GFX.Color
use GFX.Components
use GFX.Input
use GFX.Input.Events
use GFX.Physics
use GFX.Resources
use GFX.Scene2D
use GFX.Scene3D
use GFX.Window
use GFX.UI
use Physics3D.MonsterTruck.Scene
use Physics3D.MonsterTruck.Controls
use Physics3D.MonsterTruck.HudChecks
use Physics3D.MonsterTruck.Model
use Physics3D.MonsterTruck.RimMesh
use Physics3D.MonsterTruck.TyreMesh
use Physics3D.MonsterTruck.TyreProfile
use STD.Math

func key_event(key:Input.Key,code:uint32) Events.Event {
    let modifiers=Input.Modifiers(shift:false,control:false,alt:false,system:false,
        left_shift:false,right_shift:false,level5:false,left_control:false,right_control:false,
        left_alt:false,right_alt:false,left_system:false,right_system:false,mode:false,
        caps_lock:false,num_lock:false,scroll_lock:false)
    return Events.Event.key_pressed(Events.KeyEvent(window:Window.Id(value:0 as uint32),
        keyboard:Input.KeyboardId(value:0 as uint32),key:key,keycode:code,raw:0 as uint16,
        repeated:false,modifiers:modifiers,timestamp:Input.Timestamp(nanoseconds:0 as uint)))
}

func named(source:Accessibility.Source,id:str,name:str) Accessibility.Element? {
    let element=source.read(id)!
    if element.role==Accessibility.Role.button && element.name==name { return element }
    for i in 0...element.child_count {
        if let child=source.child(id,i) { if let found=named(source,child,name) { return found } }
    }
    return null
}
func click(world:&Resources.World,state:&Scene.TruckScene,name:str) {
    var source=state.ui.accessibility();let button=named(source,source.root()!,name)!
    let point=Math.Vec2(button.bounds.x+button.bounds.width*0.5,button.bounds.y+button.bounds.height*0.5)
    let down=Events.MouseButtonEvent(window:Window.Id(value:0 as uint32),mouse:Input.MouseId(value:0 as uint32),
        button:Input.MouseButton.left,down:true,clicks:1 as uint8,position:point,timestamp:Input.Timestamp(nanoseconds:0 as uint))
    let up=Events.MouseButtonEvent(window:down.window,mouse:down.mouse,button:down.button,down:false,
        clicks:down.clicks,position:point,timestamp:down.timestamp)
    assert(Scene.handle(world,state,Events.Event.mouse_button_pressed(down)))
    assert(Scene.handle(world,state,Events.Event.mouse_button_released(up)))
}

func verify_normals(mesh:Scene3D.Geometry.Mesh) {
    let vertices=mesh.vertices();let indices=mesh.indices()
    for triangle in 0...mesh.triangle_count() {
        let a=vertices[indices[triangle*3] as int]
        let b=vertices[indices[triangle*3+1] as int]
        let c=vertices[indices[triangle*3+2] as int]
        let normal=b.position.subtract(a.position).cross(c.position.subtract(a.position))
        assert(normal.dot(a.normal)>0.0)
    }
}

func verify_wheel_rim() {
    let mesh=RimMesh.rim(Color.red_600())
    verify_normals(mesh)
    verify_normals(RimMesh.hub())
    let vertices=mesh.vertices();let indices=mesh.indices()
    var triangles:Physics.Triangle3D[]=[]
    for triangle in 0...mesh.triangle_count() {
        triangles.append(Physics.Triangle3D(vertices[indices[triangle*3] as int].position,
            vertices[indices[triangle*3+1] as int].position,vertices[indices[triangle*3+2] as int].position))
    }
    let rim=Physics.ShapePlacement3D(Physics.Shape3D.mesh(Physics.TriangleMesh3D(triangles)))
    let sides:float[]=[-1.0,1.0]
    for side in sides {
        let direction=Math.Vec3(0.0,-side*2.0,0.0)
        let lip=Physics.Geometry3D.ray_cast(Physics.Ray3D(Math.Vec3(0.623,side,0.014),direction),rim)
        let spoke=Physics.Geometry3D.ray_cast(Physics.Ray3D(Math.Vec3(0.386,side,0.077),direction),rim)
        let opening=Physics.Geometry3D.ray_cast(Physics.Ray3D(Math.Vec3(0.324,side,0.235),direction),rim)
        assert(lip.hit && spoke.hit && Math.abs(lip.point.y-spoke.point.y)>0.25)
        assert(!opening.hit)
    }
}

func verify_loaded_tread() {
    var truck=Model.Truck(4)
    for _ in 0...360 { truck.step() }
    var mesh=TyreMesh()
    let columns=2*TyreProfile.Dimensions.slices
    let tread_columns:int[]=[columns-2,columns-1,1,2]
    for wheel in truck.wheels {
        let points=mesh.deform(wheel.tyre.positions()).vertices()
        for ring in 0...TyreProfile.Dimensions.rings {
            let base=ring*columns
            let center=points[base].position
            let left=points[base+columns-2].position
            let right=points[base+2].position
            let axle=right.subtract(left).normalized()
            for column in tread_columns {
                let offset=points[base+column].position.subtract(center)
                assert(offset.subtract(axle.multiply(offset.dot(axle))).length()<0.001,
                    "the loaded tread must stay flat across the rim")
            }
        }
    }
}

package func verify() {
    verify_wheel_rim()
    var world=Resources.World();var meshes=Resources.Meshes3D();var images=Resources.Images()
    var state=Scene.TruckScene(1)
    Scene.startup(world,meshes,images,state);state.view!.update(world,meshes);Scene.follow(world,state,0.016)
    assert(!world.get<Scene2D.Canvas>(state.hud).visible)
    var shortcuts=copy world.get<Scene2D.Canvas>(state.shortcut_line)
    assert(shortcuts.visible && shortcuts.anchor==Math.Vec2(0.5,1.0))
    let resized=Events.WindowSizeEvent(window:Window.Id(value:0 as uint32),
        size:Math.Vec2(320.0,480.0),timestamp:Input.Timestamp(nanoseconds:0 as uint))
    Scene.handle(world,state,Events.Event.window_resized(resized))
    let placement=copy world.get<Scene2D.Transform>(state.shortcut_line)
    assert(placement.scale.x<1.0 && state.shortcut_width*placement.scale.x<=296.01)
    assert(Math.abs(placement.position.x+state.shortcut_center*placement.scale.x)<0.01)
    assert(Math.abs(placement.position.y+state.shortcut_bottom*placement.scale.y+12.0)<0.01)
    let restored=Events.WindowSizeEvent(window:resized.window,size:Math.Vec2(1280.0,800.0),timestamp:resized.timestamp)
    Scene.handle(world,state,Events.Event.window_resized(restored))
    assert(world.get<Scene2D.Transform>(state.shortcut_line).scale==Math.Vec2(1.0))
    let help=key_event(Input.Key.h,104 as uint32)
    assert(Scene.handle(world,state,help) && world.get<Scene2D.Canvas>(state.hud).visible)
    // Contact-sphere thickness belongs in the initial rim/tire clearance.
    for wheel in state.truck.wheels {
        let rim=Physics.ShapePlacement3D(wheel.rim.shape(),wheel.rim.transform())
        for point in wheel.tyre.positions() {
            let vertex=Physics.ShapePlacement3D(Physics.Shape3D.sphere(Physics.Sphere3D(0.035)),
                Physics.Transform3D(point))
            assert(Physics.Geometry3D.distance(vertex,rim).separation>0.005)
        }
    }
    click(world,state,"Plus court");Scene.perform(state)
    assert(state.truck.final_drive==9.0)
    assert(Scene.handle(world,state,key_event(Input.Key.space,32 as uint32)))
    assert(state.panel.brake && !state.panel.front_brake && !state.panel.handbrake && state.panel.final_drive==9.0 && !state.panel.gearing_requested,"Space must select four-wheel braking without activating the focused gearing button")
    match key_event(Input.Key.space,32 as uint32) {
        key_pressed(key)=>{ assert(Scene.handle(world,state,Events.Event.key_released(key))) }
        else=>{}
    }
    assert(!state.panel.brake)
    state.truck.gas=1.0;click(world,state,"Plus long");Scene.perform(state)
    assert(state.truck.final_drive==9.0 && state.panel.final_drive==9.0,"rejected gearing must restore displayed selection")
    state.truck.gas=0.0;state.panel.forward=true
    click(world,state,"Plus long");Scene.perform(state)
    assert(state.truck.final_drive==9.0,"held throttle must reject gearing before the next physics tick")
    state.panel.forward=false
    click(world,state,"Plus long");Scene.perform(state);assert(state.truck.final_drive==8.0)
    click(world,state,"Plus court");Scene.perform(state)
    assert(Scene.handle(world,state,help) && !world.get<Scene2D.Canvas>(state.hud).visible)
    let count=world.entities().count()
    var tyre=state.truck.wheels[0].tyre
    let rim=state.view!.wheels[0].rim;let rubber=state.view!.wheels[0].rubber
    let rubber_mesh=state.view!.wheels[0].tyre_mesh
    // Logical AZERTY letters may arrive with QWERTY physical scan codes.
    let forward=key_event(Input.Key.w,122 as uint32);let left=key_event(Input.Key.a,113 as uint32)
    state.panel.handle(forward)
    assert(Scene.handle(world,state,key_event(Input.Key.left_shift,0 as uint32)))
    assert(state.panel.boost)
    state.truck.held(state.panel.forward,false,false,false,false,state.panel.boost)
    assert(state.truck.gas==1.5,"Shift must reach the physical boost command")
    let release_shift=key_event(Input.Key.left_shift,0 as uint32)
    match release_shift {
        key_pressed(key)=>{ assert(Scene.handle(world,state,Events.Event.key_released(key))) }
        else=>{}
    }
    assert(!state.panel.boost)
    assert(Scene.handle(world,state,key_event(Input.Key.right_shift,0 as uint32)) && state.panel.boost)
    match key_event(Input.Key.right_shift,0 as uint32) {
        key_pressed(key)=>{ Scene.handle(world,state,Events.Event.key_released(key)) }
        else=>{}
    }
    assert(!state.panel.boost)
    state.truck.controls(0.0,0.0)
    state.panel.handle(left)
    state.panel.handle(key_event(Input.Key.space,32 as uint32))
    assert(state.panel.forward && state.panel.left && state.panel.brake && !state.panel.handbrake && !state.panel.reset)
    assert(Scene.handle(world,state,key_event(Input.Key.up,0 as uint32)))
    assert(Scene.handle(world,state,key_event(Input.Key.down,0 as uint32)))
    assert(state.panel.front_brake && state.panel.handbrake && state.panel.brake && !state.panel.gearing_requested)
    state.panel.handle(key_event(Input.Key.a,97 as uint32))
    state.panel.handle(key_event(Input.Key.left,0 as uint32))
    assert(state.panel.rear_left && state.panel.arrow_left)
    state.truck.held(false,false,false,false,false,false,
        state.panel.rear_left || state.panel.arrow_left,false)
    assert(state.truck.rear_steering<0.0 && !state.panel.reset)
    state.panel.handle(key_event(Input.Key.e,101 as uint32))
    state.panel.handle(key_event(Input.Key.right,0 as uint32))
    assert(state.panel.rear_right && state.panel.arrow_right)
    state.panel.handle(key_event(Input.Key.t,116 as uint32));assert(!state.panel.coupled)
    state.panel.handle(key_event(Input.Key.t,116 as uint32));assert(state.panel.coupled)
    state.panel.handle(key_event(Input.Key.p,112 as uint32));Scene.perform(state)
    assert(state.panel.inflation==1 && tyre==state.truck.wheels[0].tyre && !state.panel.reset)
    state.panel.handle(key_event(Input.Key.p,112 as uint32));Scene.perform(state)
    assert(state.panel.inflation==2 && tyre==state.truck.wheels[0].tyre)
    state.panel.handle(key_event(Input.Key.p,112 as uint32));Scene.perform(state)
    assert(state.panel.inflation==0 && tyre==state.truck.wheels[0].tyre)
    state.panel.handle(key_event(Input.Key.p,112 as uint32));Scene.perform(state)
    state.panel.handle(Events.Event.mouse_button_pressed(Events.MouseButtonEvent(
        window:Window.Id(value:0 as uint32),mouse:Input.MouseId(value:0 as uint32),button:Input.MouseButton.left,
        down:true,clicks:1 as uint8,position:Math.Vec2(640.0,400.0),timestamp:Input.Timestamp(nanoseconds:0 as uint))))
    assert(!state.panel.reset)
    Scene.handle(world,state,Events.Event.window_focus_lost(Events.WindowEvent(
        window:Window.Id(value:0 as uint32),timestamp:Input.Timestamp(nanoseconds:0 as uint))))
    assert(!state.panel.forward && !state.panel.left && !state.panel.brake && !state.panel.front_brake && !state.panel.handbrake && !state.panel.boost)
    assert(!state.panel.rear_left && !state.panel.rear_right && !state.panel.arrow_left && !state.panel.arrow_right)
    state.panel.handle(key_event(Input.Key.right,0 as uint32))
    for _ in 0...3 { state.truck.held(false,false,false,false,false,false,
        false,state.panel.rear_right || state.panel.arrow_right) }
    assert(state.truck.rear_steering>0.0 && !state.panel.reset)
    state.panel.handle(key_event(Input.Key.r,114 as uint32));Scene.perform(state)
    assert(tyre!=state.truck.wheels[0].tyre && !tyre.is_valid())
    assert(world.entities().count()==count && state.view!.wheels[0].rim==rim && state.view!.wheels[0].rubber==rubber)
    assert(state.panel.inflation==1 && state.truck.world.worker_count()==1 && state.truck.final_drive==9.0)
    state.view!.update(world,meshes)
    assert(world.get<Components.Mesh3D>(rubber).asset==rubber_mesh)
    let points=meshes.snapshot(rubber_mesh).vertices()
    let slices=TyreProfile.Dimensions.slices
    let rings=TyreProfile.Dimensions.rings
    let carcass_count=2*rings*slices
    assert(points.count()>carcass_count)
    // The undeformed contact face stays flat between the two tread edges.
    for slice in [1,2,2*slices-2,2*slices-1] {
        assert(Math.abs(points[slice].position.y-points[0].position.y)<0.00001)
    }
    let tread_edge=points[3].position
    let shoulder=points[4].position
    let sidewall=points[5].position
    assert(tread_edge.x>points[2].position.x+0.08)
    assert(Math.abs(tread_edge.y-points[0].position.y)<0.02)
    assert(shoulder.y<points[0].position.y-0.08)
    assert(Math.abs(shoulder.x-sidewall.x)<0.03 && shoulder.y-sidewall.y>0.10)
    assert(points[0].color.r<0.05 && points[carcass_count+1].color.r<0.07)
    let revision=meshes.revision(rubber_mesh)
    state.view!.update(world,meshes)
    assert(meshes.revision(rubber_mesh)==revision)
    state.truck.step()
    state.view!.update(world,meshes)
    let deformed=meshes.snapshot(rubber_mesh).vertices()
    assert(meshes.revision(rubber_mesh)>revision && deformed.count()==points.count())
    let particles=state.truck.wheels[0].tyre.positions()
    for ring in 0...rings {
        let base=ring*slices
        let visual=ring*2*slices
        assert(deformed[visual].position.nearly_equal(particles[base],0.000001))
        assert(deformed[visual+slices].position.nearly_equal(particles[base+4],0.000001))
        let width=deformed[visual+4].position.subtract(deformed[visual+12].position).length()
        let physical_width=particles[base+2].subtract(particles[base+6]).length()
        assert(Math.abs(width-physical_width-0.24)<0.00001)
    }
    assert(!deformed[carcass_count+1].position.nearly_equal(points[carcass_count+1].position,0.00001))
    Scene.labels(state);let updated=state.ui.update(0.0)
    HudChecks.verify(state.ui)
    var measurement=UI.Session(state.panel.measurement(false,true))
    let measured=measurement.update(0.0);HudChecks.verify(measurement)
    Scene.follow(world,state,0.016)
    let camera=copy world.get<Components.Camera3D>(state.camera)
    let transform=copy world.get<Components.Transform3D>(state.camera)
    let center=camera.project(state.truck.chassis.position(),transform,Math.Vec2(1280.0,800.0))!
    let left_point=camera.project(state.truck.chassis.position().add(Math.Vec3.right()),transform,Math.Vec2(1280.0,800.0))!
    assert(left_point.x<center.x)
    for wheel in state.truck.wheels { for point in wheel.tyre.positions() {
        let screen=camera.project(point,transform,Math.Vec2(1280.0,800.0))!
        assert(screen.x>310.0 && screen.x<1280.0 && screen.y>0.0 && screen.y<800.0)
    } }
    // The same travel direction must keep the same course even as the body
    // stands on its rear wheels, rolls onto its roof, or pitches beyond vertical.
    state.truck.chassis.set_linear_velocity(Math.Vec3(0.0,0.0,5.0))
    let heading=state.chase.yaw
    let tilts:float[]=[Math.half_pi(),Math.pi(),Math.pi()*1.5]
    let axes:Math.Vec3[]=[Math.Vec3.right(),Math.Vec3.back()]
    for axis in axes { for angle in tilts {
        state.truck.chassis.set_transform(Physics.Transform3D(state.truck.chassis.position(),
            Math.Quat.angle_axis(angle,axis)))
        Scene.follow(world,state,0.016)
        assert(Math.abs(state.chase.yaw-heading)<0.00001)
        let view=world.get<Components.Transform3D>(state.camera)
        assert(Math.abs(view.rotation.rotate(Math.Vec3.right()).y)<0.00001)
    } }
    verify_loaded_tread()
    print("Monster scene checks passed: input, reset, flat loaded treads, shortcuts and HUD, travel camera and rollover horizon")
}

func main() { verify() }
