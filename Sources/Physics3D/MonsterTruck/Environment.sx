use GFX.Assets.Model
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Resources
use GFX.Scene3D
use STD.Math

func sun_direction() Math.Vec3 {
    return Math.Vec3(-0.4,-1.0,-0.3).normalized()
}

package func skybox() Resources.Skybox3D {
    let sky=Scene3D.ProceduralSky.day()
        ..sun_direction=sun_direction().negated() ..sky_intensity=0.84 ..sun_intensity=2.85
    return Resources.Skybox3D.procedural(sky) ..diffuse_intensity=0.32 ..specular_intensity=0.84
}

package func create(world:&Resources.World,meshes:&Resources.Meshes3D,images:&Resources.Images,arena:Model) {
    let instance=Scene3D.instantiate(arena,world,meshes,images)
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.29)))
    // Shift the shadow lookup away from the adjoining faces of large tilted blocks.
    let shadow=Scene3D.Shadow.sun() ..normal_offset=0.18
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:sun_direction(),
        color:Color.bytes(255,248,235),intensity:3.15,shadow:shadow)
        ..shadow_distance=65.0))
}
