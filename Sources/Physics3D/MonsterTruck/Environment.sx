use GFX.Assets.PNG
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Resources
use GFX.Scene3D
use GFX.Scene3D.Skybox.ProceduralSky
use Physics3D.MonsterTruck.ArenaView
use Physics3D.MonsterTruck.Markings
use STD.Math

package func create(world:&Resources.World,meshes:&Resources.Meshes3D,images:&Resources.Images) {
    let dirt=images.add(PNG.decode(embed_bytes("Assets/PackedDirt.png")))
    let ground=meshes.add(Scene3D.Geometry.Plane.make(Math.Vec2(1024.0)))
    // Scene3D multiplies the sRGB texture in linear space. Cool the ochre without flattening the grit.
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform3D(rotation:Math.Quat.angle_axis(-Math.half_pi(),Math.Vec3.right())))
        ..with(Components.Mesh3D(ground,casts_shadows:false))
        ..with(Components.Material3D(albedo:Color.bytes(123,135,245),roughness:1.0))
        ..with(Components.MaterialSettings3D(textures:Components.MaterialTextures3D(
            albedo:Components.MaterialTexture3D(image:dirt,scale:Math.Vec2(256.0))))))
    ArenaView.create(world,meshes)
    let cube=meshes.add(Scene3D.Geometry.Cube.make())
    Markings.create(world,meshes,cube)
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.55)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4,-1.0,-0.3).normalized(),intensity:3.0)
        ..shadow_distance=65.0))
    world.spawn(ECS.EntityRecipe() ..with(Scene3D.Skybox.procedural(ProceduralSky.day())))
}
