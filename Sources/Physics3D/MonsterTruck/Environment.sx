use GFX.Assets.Model
use GFX.Components
use GFX.ECS
use GFX.Resources
use GFX.Scene3D
use STD.Math

package func create(world:&Resources.World,meshes:&Resources.Meshes3D,images:&Resources.Images,arena:Model) {
    let instance=Scene3D.instantiate(arena,world,meshes,images)
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.55)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4,-1.0,-0.3).normalized(),intensity:3.0)
        ..shadow_distance=65.0))
}
