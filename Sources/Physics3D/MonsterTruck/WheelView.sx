use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Resources
use GFX.Scene3D
use Physics3D.MonsterTruck.Wheel
use Physics3D.MonsterTruck.TyreMesh
use STD.Math

package struct Assets {
    let rim:Scene3D.MeshHandle
    let hub:Scene3D.MeshHandle
    let bolt:Scene3D.MeshHandle
}

package func mesh_entity(world:&Resources.World,asset:Scene3D.MeshHandle,color:Color,
    metallic:float=0.0,roughness:float=0.75) ECS.Entity {
    return world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D()) ..with(Components.Mesh3D(asset))
        ..with(Components.Material3D(albedo:color,metallic:metallic,roughness:roughness)))
}

func place(world:&Resources.World,entity:ECS.Entity,position:Math.Vec3,rotation:Math.Quat) {
    world.update<Components.Transform3D>(entity,func(t:&Components.Transform3D) { t.position=position;t.rotation=rotation })
}

package class WheelView {
    var wheel:Wheel
    let tyre_mesh:Scene3D.MeshHandle
    var rubber:ECS.Entity
    var rim:ECS.Entity
    var hub:ECS.Entity
    var bolts:ECS.Entity
    init(wheel:Wheel,assets:Assets,tyre:TyreMesh,paint:Color,world:&Resources.World,meshes:&Resources.Meshes3D) {
        self.wheel=wheel;var side=1.0
        if wheel.anchor.x<0.0 { side= -1.0 }
        self.tyre_mesh=meshes.add(tyre.deform(self.wheel.tyre.positions()))
        self.rubber=mesh_entity(world,self.tyre_mesh,Color.white(),roughness:0.98)
        self.rim=mesh_entity(world,assets.rim,paint,metallic:0.25,roughness:0.4)
        self.hub=mesh_entity(world,assets.hub,paint,metallic:0.25,roughness:0.4)
        var bolts:Scene3D.Transform[]=[]
        for index in 0...24 {
            let angle=Math.two_pi()*(index as float)/24.0
            let position=Math.Vec3(Math.cos(angle)*0.69,-side*0.476,Math.sin(angle)*0.69)
            bolts.append(Scene3D.Transform(position))
        }
        self.bolts=world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D()) ..with(Components.Mesh3D(assets.bolt))
            ..with(Components.Material3D(albedo:Color.bytes(27,27,29),metallic:0.65)) ..with(Scene3D.Instances(bolts)))
    }
    func update(world:&Resources.World,meshes:&Resources.Meshes3D,tyre:TyreMesh) {
        meshes.replace(self.tyre_mesh,tyre.deform(self.wheel.tyre.positions()))
        let pose=self.wheel.rim.transform()
        place(world,self.rim,pose.position,pose.rotation)
        place(world,self.hub,pose.position,pose.rotation)
        place(world,self.bolts,pose.position,pose.rotation)
    }
}
