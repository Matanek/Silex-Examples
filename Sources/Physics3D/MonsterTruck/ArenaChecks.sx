use GFX.Physics
use Physics3D.MonsterTruck.Arena
use Physics3D.MonsterTruck.Model
use Physics3D.MonsterTruck.QuarterPipe
use Physics3D.MonsterTruck.SlideRails
use Physics3D.MonsterTruck.Terrain
use STD.Math

func top_edge(piece:Arena.Piece,end:bool) Math.Vec3 {
    var z= -piece.size.z*0.5;if end { z= -z }
    return piece.position.add(piece.rotation.rotate(Math.Vec3(0.0,piece.size.y*0.5,z)))
}

func height(world:Physics.World3D,x:float,z:float,expected:float) {
    let hit=world.ray_cast(Physics.Ray3D(Math.Vec3(x,10.0,z),Math.Vec3(0.0,-20.0,0.0)))
    assert(hit!=null)
    if Math.abs(hit!.point().y-expected)>=0.0001 { print("arena height x=",x," z=",z," expected=",expected," actual=",hit!.point().y) }
    assert(Math.abs(hit!.point().y-expected)<0.0001 && hit!.normal().y>0.8)
}

func verify_quarter_geometry(world:Physics.World3D) {
    let origin=QuarterPipe.Dimensions.origin
    let r=QuarterPipe.Dimensions.radius
    let lip=QuarterPipe.Dimensions.angle
    let facets=QuarterPipe.Dimensions.facets
    var previous=0.0
    for i in 0...facets {
        let a=lip*(i as float)/(facets as float)
        let b=lip*((i+1) as float)/(facets as float)
        let y=r*(1.0-(Math.cos(a)+Math.cos(b))*0.5)
        let z=r*(Math.sin(a)+Math.sin(b))*0.5
        let normal=Math.Vec3(0.0,Math.cos((a+b)*0.5),-Math.sin((a+b)*0.5))
        let middle=origin.add(Math.Vec3(0.0,y,z))
        let ray=Physics.Ray3D(middle.add(normal.multiply(0.20)),normal.multiply(-0.4))
        let hit=world.ray_cast(ray)!
        assert(hit.point().nearly_equal(middle,0.0001) && hit.normal().nearly_equal(normal,0.0001))
        let angle=(a+b)*0.5
        assert(angle>previous)
        if i==0 { assert(angle<0.10) }
        previous=angle
    }
    assert(previous>1.50 && lip>Math.half_pi() && Terrain.section(origin)==Terrain.Section.quarter_pipe)
}

func verify_quarter_takeoff() {
    let origin=QuarterPipe.Dimensions.origin
    var truck=Model.Truck(4,obstacles:true,spawn:Physics.Transform3D(origin.add(Math.Vec3(0.0,2.35,-68.0))))
    truck.controls(0.67,0.0)
    let lip=QuarterPipe.Dimensions.radius*(1.0-Math.cos(QuarterPipe.Dimensions.angle))
    var highest=0.0
    var near_vertical=false
    var returned=false
    var approach_braked=false
    for _ in 0...1530 {
        truck.step()
        let position=truck.chassis.position()
        let motion=truck.chassis.linear_velocity()
        highest=Math.max(highest,position.y)
        if position.y>lip+1.0 && motion.y>9.0 && Math.abs(motion.z)<motion.y*0.15 {
            near_vertical=true
        }
        if !approach_braked && position.y>18.0 {
            truck.controls(0.0,0.0,brake:true,hard_brake:true)
            approach_braked=true
        }
        if !near_vertical || highest<lip+4.0 || motion.y>=0.0 || motion.z>= -1.0 || position.y>=lip { continue }
        let up=truck.chassis.transform().vector(Math.Vec3.up())
        if up.y<0.68 { continue }
        var wheels_on_deck=0
        for wheel in truck.wheels {
            for vertex in 0...wheel.tyre.vertex_count() {
                let point=wheel.tyre.position(vertex)
                if point.y<0.4 || point.z<=origin.z || point.z>=origin.z+QuarterPipe.Dimensions.radius { continue }
                let hit=truck.world.ray_cast(Physics.Ray3D(point.add(Math.Vec3(0.0,0.10,0.0)),Math.Vec3(0.0,-0.24,0.0)),
                    filter:Physics.QueryFilter3D(mask_bits:1))
                if hit!=null { wheels_on_deck++;break }
            }
        }
        if wheels_on_deck>=2 { returned=true;break }
    }
    print("Quarter-pipe test: chassis peak=",highest," lip=",lip," vertical=",near_vertical," returned=",returned)
    assert(near_vertical && returned,"the quarter-pipe must permit a near-vertical flight and a return to the deck")
}

func verify_slide_rails(world:Physics.World3D) {
    for rail in SlideRails.layout() {
        let middle=rail.start.add(rail.end).multiply(0.5)
        let hit=world.ray_cast(Physics.Ray3D(middle.add(Math.Vec3(0.0,0.7,0.0)),Math.Vec3(0.0,-1.4,0.0)),
            filter:Physics.QueryFilter3D(mask_bits:SlideRails.Collision.surface))!
        assert(hit.point().nearly_equal(middle,0.0001))
        assert(Terrain.section(middle)==Terrain.Section.slide_rails)
        let ledge=rail.start.add(Math.Vec3(2.06,0.0,-1.0))
        height(world,ledge.x,ledge.z,rail.approach_height())

        let spawn=rail.start.add(Math.Vec3(0.0,2.35-rail.start.y,-17.0))
        var truck=Model.Truck(4,obstacles:true,spawn:Physics.Transform3D(spawn))
        truck.held(true,false,false,false,false,false)
        var first=0.0
        var furthest=0.0
        var touches=0
        var contacts:Physics.Contact3D[]=[]
        for _ in 0...760 {
            truck.step()
            if truck.chassis.position().z<rail.start.z { continue }
            truck.world.write_contacts(contacts)
            for contact in contacts {
                let a=contact.first_body().collision_filter().category_bits
                let b=contact.second_body().collision_filter().category_bits
                if (a+b)!=SlideRails.Collision.surface+8 || contact.normal_impulse()<=0.0 { continue }
                let point=contact.point()
                if first==0.0 { first=point.z }
                furthest=Math.max(furthest,point.z)
                touches++
            }
            if truck.chassis.position().z>rail.end.z+1.0 { break }
        }
        print("Slide rail x=",rail.start.x," contact travel=",furthest-first," loaded contacts=",touches)
        assert(touches>12 && furthest-first>6.0 && furthest>rail.end.z-1.0,
            "the truck must reach and slide down the length of each rail on its chassis")
    }
}

package func verify() {
    let pieces=Arena.layout();assert(pieces.count()>=60 && pieces.count()<90)
    for index in 0...3 { assert(top_edge(pieces[index],true).nearly_equal(top_edge(pieces[index+1],false),0.00001)) }
    for index in 5...8 { assert(top_edge(pieces[index],true).nearly_equal(top_edge(pieces[index+1],false),0.00001)) }
    for piece in pieces { if piece.painted {
        assert(piece.size.x>=8.0 && piece.size.y>0.0 && piece.size.z>0.0)
        let up=piece.rotation.rotate(Math.Vec3.up());assert(up.y>0.8)
        let end=top_edge(piece,true);let start=top_edge(piece,false)
        assert(start.y>= -0.00001 && end.y>= -0.00001)
    } }
    var world=Physics.World3D();Terrain.create(world)
    height(world,0.0,11.5,0.075);height(world,0.0,14.5,0.375)
    height(world,0.0,17.5,0.975);height(world,0.0,20.5,1.875)
    height(world,0.0,25.0,2.4);height(world,0.0,29.5,1.875)
    height(world,0.0,35.5,0.375);height(world,0.0,38.5,0.075)
    height(world,0.0,50.25,0.546875);height(world,0.0,65.0,3.5)
    height(world,-14.75,65.0,0.546875);height(world,14.75,65.0,0.546875)
    height(world,-29.0,55.875,2.5);height(world,-29.0,74.75,2.96875)
    verify_quarter_geometry(world)
    verify_quarter_takeoff()
    verify_slide_rails(world)
    print("Arena geometry passed: continuous facets, solid matching surfaces and multiple approaches")
}

func main() { verify() }
