use GFX.Physics
use Physics3D.MonsterTruck.Arena
use Physics3D.MonsterTruck.Model
use Physics3D.MonsterTruck.QuarterPipe
use Physics3D.MonsterTruck.Terrain
use STD.Math

func top_edge(piece:Arena.Piece,end:bool) Math.Vec3 {
    var z= -piece.size.z*0.5;if end { z= -z }
    return piece.position.add(piece.rotation.rotate(Math.Vec3(0.0,piece.size.y*0.5,z)))
}

func height(world:Physics.World3D,x:float,z:float,expected:float) {
    let hit=world.ray_cast(Physics.Ray3D(Math.Vec3(x,10.0,z),Math.Vec3(0.0,-20.0,0.0)))
    assert(hit!=null)
    if Math.abs(hit!.point().y-expected)>=0.0001 { print("arena height x=",x," z=",z," expected=",expected," actual=",hit!.point().y) }
    assert(Math.abs(hit!.point().y-expected)<0.0001 && hit!.normal().y>0.8)
}

func verify_quarter_geometry(world:Physics.World3D) {
    let origin=QuarterPipe.Dimensions.origin
    let r=QuarterPipe.Dimensions.radius
    let lip=QuarterPipe.Dimensions.angle
    let facets=QuarterPipe.Dimensions.facets
    var previous=0.0
    for i in 0...facets {
        let a=lip*(i as float)/(facets as float)
        let b=lip*((i+1) as float)/(facets as float)
        let y=r*(1.0-(Math.cos(a)+Math.cos(b))*0.5)
        let z=r*(Math.sin(a)+Math.sin(b))*0.5
        let normal=Math.Vec3(0.0,Math.cos((a+b)*0.5),-Math.sin((a+b)*0.5))
        let ray=Physics.Ray3D(origin.add(Math.Vec3(0.0,y+0.5,z)),Math.Vec3(0.0,-1.0,0.0))
        let hit=world.ray_cast(ray)!
        assert(Math.abs(hit.point().y-y)<0.0001 && hit.normal().nearly_equal(normal,0.0001))
        let slope= -hit.normal().z/hit.normal().y
        assert(slope>previous)
        if i==0 { assert(slope<0.05) }
        previous=slope
    }
    assert(previous>3.0 && Terrain.section(origin)==Terrain.Section.quarter_pipe)
}

func verify_quarter_takeoff() {
    let origin=QuarterPipe.Dimensions.origin
    var truck=Model.Truck(4,obstacles:true,spawn:Physics.Transform3D(origin.add(Math.Vec3(0.0,2.35,-68.0))))
    truck.controls(1.0,0.0)
    let lip=QuarterPipe.Dimensions.radius*(1.0-Math.cos(QuarterPipe.Dimensions.angle))
    var highest=0.0
    var launched=false
    var entry_speed=0.0
    for _ in 0...1050 {
        truck.step()
        let position=truck.chassis.position()
        let motion=truck.chassis.linear_velocity()
        highest=Math.max(highest,position.y)
        if position.z<origin.z { entry_speed=motion.z }
        if position.y>lip+2.5 && motion.y>2.0 { launched=true }
        if launched && motion.y<=0.0 { break }
    }
    print("Quarter-pipe test: entry m/s=",entry_speed," chassis peak=",highest," lip=",lip)
    assert(launched,"the quarter-pipe must launch the truck above the lip")
}

package func verify() {
    let pieces=Arena.layout();assert(pieces.count()>=60 && pieces.count()<90)
    for index in 0...3 { assert(top_edge(pieces[index],true).nearly_equal(top_edge(pieces[index+1],false),0.00001)) }
    for index in 5...8 { assert(top_edge(pieces[index],true).nearly_equal(top_edge(pieces[index+1],false),0.00001)) }
    for piece in pieces { if piece.painted {
        assert(piece.size.x>=8.0 && piece.size.y>0.0 && piece.size.z>0.0)
        let up=piece.rotation.rotate(Math.Vec3.up());assert(up.y>0.8)
        let end=top_edge(piece,true);let start=top_edge(piece,false)
        assert(start.y>= -0.00001 && end.y>= -0.00001)
    } }
    var world=Physics.World3D();Terrain.create(world)
    height(world,0.0,11.5,0.075);height(world,0.0,14.5,0.375)
    height(world,0.0,17.5,0.975);height(world,0.0,20.5,1.875)
    height(world,0.0,25.0,2.4);height(world,0.0,29.5,1.875)
    height(world,0.0,35.5,0.375);height(world,0.0,38.5,0.075)
    height(world,0.0,50.25,0.546875);height(world,0.0,65.0,3.5)
    height(world,-14.75,65.0,0.546875);height(world,14.75,65.0,0.546875)
    height(world,-29.0,55.875,2.5);height(world,-29.0,74.75,2.96875)
    verify_quarter_geometry(world)
    verify_quarter_takeoff()
    print("Arena geometry passed: continuous facets, solid matching surfaces and multiple approaches")
}

func main() { verify() }
