use GFX.Physics
use Physics3D.MonsterTruck.Arena
use Physics3D.MonsterTruck.Model
use STD.Math

struct Waypoint {
    let x:float
    let z:float
    let height:float
    let speed:float
}

package func verify() {
    let arena=Arena.load()
    let start=Arena.vehicle_spawn(arena,"Depart",Physics.Transform3D(Math.Vec3(0.0,2.35,0.0)))
    var truck=Model.Truck(4,obstacles:true,spawn:start,arena:arena)
    let route:Waypoint[]=[
        Waypoint(x:0.0,z:25.0,height:5.4,speed:3.5),
        Waypoint(x:5.0,z:29.5,height:5.4,speed:2.4),
        Waypoint(x:24.0,z:29.5,height:10.4,speed:3.0),
        Waypoint(x:29.5,z:36.2,height:10.4,speed:2.3),
        Waypoint(x:29.0,z:42.0,height:10.4,speed:2.7),
        Waypoint(x:29.0,z:65.0,height:16.1,speed:3.6)]
    var next=0
    var peak_bead=0.0
    for frame in 0...7000 {
        let waypoint=route[next]
        let pose=truck.chassis.transform()
        let front=pose.vector(Math.Vec3.back())
        let dx=waypoint.x-pose.position.x
        let dz=waypoint.z-pose.position.z
        let distance=Math.sqrt(dx*dx+dz*dz)
        let side=dx*front.z-dz*front.x
        let forward=dx*front.x+dz*front.z
        let speed=truck.chassis.linear_velocity().length()
        if distance<2.8 && pose.position.y>waypoint.height+1.25 {
            next++
            if next==route.count() {
                print("Trial summit reached at height=",pose.position.y," maximum bead error=",peak_bead)
                return
            }
            continue
        }
        let turn=Math.clamp(Math.atan2(side,forward)*1.25,-1.0,1.0)
        let throttle=Math.clamp(0.34+(waypoint.speed-speed)*0.18,0.0,0.82)
        if frame>=90 { truck.controls(throttle,turn,brake:speed>waypoint.speed+1.1,hard_brake:true) }
        truck.step()
        let bead=truck.maximum_bead_error()
        peak_bead=Math.max(peak_bead,bead)
        if frame%300==299 || bead>=0.08 {
            print("Trial waypoint=",next," x=",pose.position.x," y=",pose.position.y," z=",pose.position.z,
                " heading=",Math.degrees(Math.atan2(front.x,front.z))," speed=",speed," bead=",bead)
        }
        assert(bead<0.08 && truck.minimum_y()>0.025,"tyres must stay seated and above the floor")
        assert(pose.vector(Math.Vec3.up()).y>0.60,"truck must stay upright")
    }
    panic("truck did not reach the summit")
}

func main() { verify() }
