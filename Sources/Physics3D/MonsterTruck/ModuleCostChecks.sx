use GFX.Physics
use Physics3D.MonsterTruck.Model
use Physics3D.MonsterTruck.Terrain
use Physics3D.MonsterTruck.Arena
use STD.Math
use STD.Time

func run(name:str,spawn:Physics.Transform3D) {
    var truck=Model.Truck(4,obstacles:true,spawn:spawn)
    var clock=Time.Clock();var seconds=0.0;var maximum=0.0
    for frame in 0...480 {
        truck.controls(0.0,0.0,brake:true,handbrake:true,hard_brake:true)
        clock.tick();truck.step();let elapsed=clock.tick()
        seconds+=elapsed;maximum=Math.max(maximum,elapsed)
        assert(truck.maximum_bead_error()<0.08 && truck.minimum_y()>0.025)
        if frame%120==119 {
            let p=truck.chassis.position()
            print(name," tick=",frame+1," seconds=",seconds," maximum=",maximum,
                " x=",p.x," y=",p.y," z=",p.z," speed=",truck.chassis.linear_velocity().length()," bead=",truck.maximum_bead_error())
            seconds=0.0;maximum=0.0
        }
    }
}

func main() {
    run("Slab",Physics.Transform3D(Math.Vec3(0.0,2.35,0.0)))
    run("Steps",Terrain.ledge_spawn())
    run("Ramp",Terrain.slope_spawn())
    run("Tilted blocks",Terrain.bumps_spawn())
    let arena=Arena.load()
    run("Summit",Arena.vehicle_spawn(arena,"Sommet",Physics.Transform3D()))
}
