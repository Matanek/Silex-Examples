use GFX.Color
use GFX.Scene3D
use STD.Math

package func face(vertices:&Scene3D.Geometry.Vertex[],indices:&uint32[],
    a:Math.Vec3,b:Math.Vec3,c:Math.Vec3,d:Math.Vec3,color:Color=Color.white()) {
    let offset=vertices.count() as uint32
    let normal=b.subtract(a).cross(c.subtract(a)).normalized()
    vertices.append(Scene3D.Geometry.Vertex(a,normal,Math.Vec2(),color))
    vertices.append(Scene3D.Geometry.Vertex(b,normal,Math.Vec2(1.0,0.0),color))
    vertices.append(Scene3D.Geometry.Vertex(c,normal,Math.Vec2(1.0),color))
    vertices.append(Scene3D.Geometry.Vertex(d,normal,Math.Vec2(0.0,1.0),color))
    indices.append(offset);indices.append(offset+1 as uint32);indices.append(offset+2 as uint32)
    indices.append(offset);indices.append(offset+2 as uint32);indices.append(offset+3 as uint32)
}

package func box(vertices:&Scene3D.Geometry.Vertex[],indices:&uint32[],center:Math.Vec3,size:Math.Vec3,color:Color) {
    let cube=Scene3D.Geometry.Cube.make()
    let offset=vertices.count() as uint32
    for vertex in cube.vertices() {
        let p=vertex.position
        let position=center.add(Math.Vec3(p.x*size.x,p.y*size.y,p.z*size.z))
        vertices.append(Scene3D.Geometry.Vertex(position,vertex.normal,vertex.uv,color))
    }
    for index in cube.indices() { indices.append(index+offset) }
}

package func align(first:Math.Vec3,second:Math.Vec3) Math.Quat {
    let dot=first.dot(second)
    if dot< -0.99999 {
        var axis=first.cross(Math.Vec3.right())
        if axis.length_squared()<0.00001 { axis=first.cross(Math.Vec3.up()) }
        return Math.Quat.angle_axis(Math.pi(),axis.normalized())
    }
    return Math.Quat(first.cross(second),1.0+dot).normalized()
}
