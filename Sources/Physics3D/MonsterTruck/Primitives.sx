use GFX.Scene3D
use STD.Math

func face(vertices:&Scene3D.Geometry.Vertex[],indices:&uint32[],
    a:Math.Vec3,b:Math.Vec3,c:Math.Vec3,d:Math.Vec3) {
    let offset=vertices.count() as uint32
    let normal=b.subtract(a).cross(c.subtract(a)).normalized()
    vertices.append(Scene3D.Geometry.Vertex(a,normal,Math.Vec2()))
    vertices.append(Scene3D.Geometry.Vertex(b,normal,Math.Vec2(1.0,0.0)))
    vertices.append(Scene3D.Geometry.Vertex(c,normal,Math.Vec2(1.0)))
    vertices.append(Scene3D.Geometry.Vertex(d,normal,Math.Vec2(0.0,1.0)))
    indices.append(offset);indices.append(offset+1 as uint32);indices.append(offset+2 as uint32)
    indices.append(offset);indices.append(offset+2 as uint32);indices.append(offset+3 as uint32)
}

// A lathed wheel with a beadlock lip and a recessed dish on both sides.
package func wheel_rim() Scene3D.Geometry.Mesh {
    let section:Math.Vec2[]=[
        Math.Vec2(-0.32,0.10),Math.Vec2(-0.32,0.54),Math.Vec2(-0.415,0.59),
        Math.Vec2(-0.47,0.635),Math.Vec2(-0.47,0.745),Math.Vec2(-0.435,0.78),
        Math.Vec2(0.435,0.78),Math.Vec2(0.47,0.745),Math.Vec2(0.47,0.635),
        Math.Vec2(0.415,0.59),Math.Vec2(0.32,0.54),Math.Vec2(0.32,0.10)]
    let segments=32
    var vertices:Scene3D.Geometry.Vertex[]=[];var indices:uint32[]=[]
    for band in 0...section.count()-1 {
        let first=section[band];let second=section[band+1]
        let tangent=second.subtract(first)
        let normal=Math.Vec2(-tangent.y,tangent.x).normalized()
        let start=vertices.count()
        for segment in 0...segments {
            let angle=(segment as float)*Math.two_pi()/(segments as float)
            let x=Math.cos(angle);let z=Math.sin(angle)
            let direction=Math.Vec3(x*normal.y,normal.x,z*normal.y)
            vertices.append(Scene3D.Geometry.Vertex(Math.Vec3(x*first.y,first.x,z*first.y),direction))
            vertices.append(Scene3D.Geometry.Vertex(Math.Vec3(x*second.y,second.x,z*second.y),direction))
            let a=(start+segment*2) as uint32
            let b=(start+((segment+1)%segments)*2) as uint32
            indices.append(a);indices.append(b+1 as uint32);indices.append(b)
            indices.append(a);indices.append(a+1 as uint32);indices.append(b+1 as uint32)
        }
    }
    return Scene3D.Geometry.Mesh(vertices,indices)
}

package func sphere() Scene3D.Geometry.Mesh {
    var vertices:Scene3D.Geometry.Vertex[]=[];var indices:uint32[]=[]
    for ring in 0...13 {
        let phi=Math.pi()*(ring as float)/12.0
        for column in 0...25 {
            let angle=Math.two_pi()*(column as float)/24.0
            let normal=Math.Vec3(Math.sin(phi)*Math.cos(angle),Math.cos(phi),Math.sin(phi)*Math.sin(angle))
            vertices.append(Scene3D.Geometry.Vertex(normal,normal,Math.Vec2((column as float)/24.0,(ring as float)/12.0)))
            if ring<12 && column<24 {
                let a=(ring*25+column) as uint32;let b=a+1 as uint32
                let c=a+25 as uint32;let d=c+1 as uint32
                indices.append(a);indices.append(b);indices.append(c)
                indices.append(b);indices.append(d);indices.append(c)
            }
        }
    }
    return Scene3D.Geometry.Mesh(vertices,indices)
}

// Paint geometry faces upward and points along the course's +Z direction.
package func arrow() Scene3D.Geometry.Mesh {
    var vertices:Scene3D.Geometry.Vertex[]=[];var indices:uint32[]=[]
    face(vertices,indices,Math.Vec3(-0.12,0.0,-0.7),Math.Vec3(-0.12,0.0,0.0),
        Math.Vec3(0.12,0.0,0.0),Math.Vec3(0.12,0.0,-0.7))
    let offset=vertices.count() as uint32
    vertices.append(Scene3D.Geometry.Vertex(Math.Vec3(-0.38,0.0,0.0),Math.Vec3.up(),Math.Vec2()))
    vertices.append(Scene3D.Geometry.Vertex(Math.Vec3(0.0,0.0,0.6),Math.Vec3.up(),Math.Vec2(0.5,1.0)))
    vertices.append(Scene3D.Geometry.Vertex(Math.Vec3(0.38,0.0,0.0),Math.Vec3.up(),Math.Vec2(1.0,0.0)))
    indices.append(offset);indices.append(offset+1 as uint32);indices.append(offset+2 as uint32)
    return Scene3D.Geometry.Mesh(vertices,indices)
}

package func cab() Scene3D.Geometry.Mesh {
    let w=0.975
    let a=Math.Vec3(-w,0.5,-0.8);let b=Math.Vec3(w,0.5,-0.8)
    let c=Math.Vec3(-w,0.5,1.0);let d=Math.Vec3(w,0.5,1.0)
    let e=Math.Vec3(-w,1.5,-0.65);let f=Math.Vec3(w,1.5,-0.65)
    let g=Math.Vec3(-w,1.5,0.7);let h=Math.Vec3(w,1.5,0.7)
    var vertices:Scene3D.Geometry.Vertex[]=[];var indices:uint32[]=[]
    face(vertices,indices,c,d,h,g);face(vertices,indices,b,a,e,f)
    face(vertices,indices,a,c,g,e);face(vertices,indices,d,b,f,h)
    face(vertices,indices,e,g,h,f);face(vertices,indices,c,a,b,d)
    return Scene3D.Geometry.Mesh(vertices,indices)
}

package func windows() Scene3D.Geometry.Mesh {
    var vertices:Scene3D.Geometry.Vertex[]=[];var indices:uint32[]=[]
    face(vertices,indices,Math.Vec3(-0.82,0.68,0.958),Math.Vec3(0.82,0.68,0.958),
        Math.Vec3(0.78,1.4,0.742),Math.Vec3(-0.78,1.4,0.742))
    let sides:float[]=[-1.0,1.0]
    for side in sides {
        let x=side*0.986
        face(vertices,indices,Math.Vec3(x,0.68,0.06),Math.Vec3(x,0.68,0.91),
            Math.Vec3(x,1.4,0.66),Math.Vec3(x,1.4,0.06))
        face(vertices,indices,Math.Vec3(x,0.68,-0.7),Math.Vec3(x,0.68,-0.04),
            Math.Vec3(x,1.4,-0.04),Math.Vec3(x,1.4,-0.57))
    }
    face(vertices,indices,Math.Vec3(0.8,0.73,-0.777),Math.Vec3(-0.8,0.73,-0.777),
        Math.Vec3(-0.78,1.38,-0.68),Math.Vec3(0.78,1.38,-0.68))
    return Scene3D.Geometry.Mesh(vertices,indices)
}

package func stripes() Scene3D.Geometry.Mesh {
    var vertices:Scene3D.Geometry.Vertex[]=[];var indices:uint32[]=[]
    let sides:float[]=[-1.0,1.0]
    for side in sides {
        let x=side*1.058
        face(vertices,indices,Math.Vec3(x,0.14,-2.1),Math.Vec3(x,0.32,-0.6),
            Math.Vec3(x,0.54,0.1),Math.Vec3(x,0.31,-0.25))
        face(vertices,indices,Math.Vec3(x,0.22,-0.2),Math.Vec3(x,0.39,0.5),
            Math.Vec3(x,0.54,1.8),Math.Vec3(x,0.29,0.8))
    }
    return Scene3D.Geometry.Mesh(vertices,indices)
}

package func align(first:Math.Vec3,second:Math.Vec3) Math.Quat {
    let dot=first.dot(second)
    if dot< -0.99999 {
        var axis=first.cross(Math.Vec3.right())
        if axis.length_squared()<0.00001 { axis=first.cross(Math.Vec3.up()) }
        return Math.Quat.angle_axis(Math.pi(),axis.normalized())
    }
    return Math.Quat(first.cross(second),1.0+dot).normalized()
}
