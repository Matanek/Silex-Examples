use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use GFX.Scene3D
use GFX.Stats
use STD.Math
use STD.Process
use STD.Time.Clock

class StressState {
    var mode:str = "bin"
    var count:int = 128
    var entities:ECS.Entity[] = []
    var bodies:Physics.RigidBody3D[] = []
    var dynamic_mesh:Scene3D.MeshHandle = Scene3D.MeshHandle()
    var colors:Color[] = []
    var emission:float = 0.0
    var clock:Clock = Clock()
    var step_clock:Clock = Clock()
    var frames:int = 0
    var seconds:float = 0.0
    var physics_steps:int = 0
    var physics_ms:float = 0.0
    var peak_step_ms:float = 0.0
    var collapsed:bool = false

    init(mode:str, count:int) {
        self.mode = mode
        self.count = count
    }
}

func begin_stress_step(application:Application, delta:float) {
    var resources = application.resources()
    var state = resources.get_mut<StressState>()
    state.step_clock.tick()
}

func end_stress_step(application:Application, delta:float) {
    var resources = application.resources()
    var state = resources.get_mut<StressState>()
    let elapsed = state.step_clock.tick() * 1000.0
    state.physics_ms += elapsed
    state.peak_step_ms = Math.max(state.peak_step_ms, elapsed)
    state.physics_steps++
}

struct StressStepMetrics:Application.Plugin {
    func id() str { return "Physics3DStressStepMetrics" }
    func build(host:&Application) {
        Physics.Physics3DStep.before_step(host, begin_stress_step)
        Physics.Physics3DStep.after_step(host, end_stress_step)
    }
}

func sphere_mesh(radius:float) Scene3D.Geometry.Mesh {
    let rings = 10
    let segments = 16
    var vertices:Scene3D.Geometry.Vertex[] = []
    var indices:uint32[] = []
    var ring = 0
    while ring <= rings {
        let latitude = Math.pi() * ring as float / rings as float
        let height = Math.cos(latitude)
        let spread = Math.sin(latitude)
        var segment = 0
        while segment <= segments {
            let longitude = 2.0 * Math.pi() * segment as float /
                segments as float
            let normal = Math.Vec3(
                spread * Math.cos(longitude),
                height,
                spread * Math.sin(longitude)
            )
            vertices.append(Scene3D.Geometry.Vertex(
                position:normal.multiply(radius),
                normal:normal,
                uv:Math.Vec2(segment as float / segments as float,
                    ring as float / rings as float)
            ))
            segment++
        }
        ring++
    }
    ring = 0
    while ring < rings {
        var segment = 0
        while segment < segments {
            let first = ring * (segments + 1) + segment
            let below = first + segments + 1
            indices.append(first as uint32)
            indices.append((first + 1) as uint32)
            indices.append(below as uint32)
            indices.append((first + 1) as uint32)
            indices.append((below + 1) as uint32)
            indices.append(below as uint32)
            segment++
        }
        ring++
    }
    return Scene3D.Geometry.Mesh(vertices, indices)
}

func visual_box(
    world:&Resources.World,
    meshes:&Resources.Meshes3D,
    size:Math.Vec3,
    position:Math.Vec3,
    color:Color,
    opacity:float = 1.0
) {
    let mesh = meshes.add(Scene3D.Geometry.Cube.make(size))
    var alpha = Scene3D.AlphaMode.opaque
    if opacity < 1.0 { alpha = Scene3D.AlphaMode.blend }
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform3D(position:position))
        ..with(Components.Mesh3D(mesh))
        ..with(Components.Material3D(
            albedo:color.with_alpha(opacity), roughness:0.85))
        ..with(Scene3D.MaterialSettings(alpha:alpha, unlit:opacity < 1.0)))
}

func fixed_box(
    world:&Resources.World,
    physics:&Physics.World3D,
    meshes:&Resources.Meshes3D,
    size:Math.Vec3,
    position:Math.Vec3,
    color:Color,
    opacity:float = 1.0
) {
    visual_box(world, meshes, size, position, color, opacity)
    physics.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(size))
        ..transform = Physics.Transform3D(position:position))
}

func spawn_dynamic_body(
    world:&Resources.World,
    physics:&Physics.World3D,
    state:&StressState,
    index:int
) {
    var position = Math.Vec3()
    var velocity = Math.Vec3()
    var shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.2))
    if state.mode == "bin" {
        let lane = (index * 37) % 25
        let column = lane % 5
        let row = lane / 5
        position = Math.Vec3(
            -4.3 + column as float * 0.43,
            5.2,
            (row as float - 2.0) * 0.43
        )
        velocity = Math.Vec3(2.0, -1.0, 0.0)
    } else {
        let column = index % 4
        let row = (index / 4) % 4
        let layer = index / 16
        position = Math.Vec3(
            (column as float - 1.5) * 0.31 + layer as float * 0.025,
            0.16 + layer as float * 0.31,
            (row as float - 1.5) * 0.31
        )
        shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.3)))
    }
    state.entities.append(world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform3D(position:position))
        ..with(Components.Mesh3D(state.dynamic_mesh))
        ..with(Components.Material3D(
            albedo:state.colors[index % state.colors.count()],
            roughness:0.55))))
    state.bodies.append(physics.create_rigid_body(
        Physics.RigidBody3DSettings()
            ..shape = shape
            ..transform = Physics.Transform3D(position:position)
            ..linear_velocity = velocity
            ..friction = 0.6))
}

func create_stress_scene(
    world:&Resources.World,
    physics:&Physics.World3D,
    meshes:&Resources.Meshes3D,
    state:&StressState
) {
    let floor_color = Color.bytes(105, 120, 133)
    if state.mode == "bin" {
        state.dynamic_mesh = meshes.add(sphere_mesh(0.2))
        // Interior: 10 m wide, 4 m high, 5 m deep; open at the top.
        // Glass and colliders share the same thin dimensions and inner faces.
        fixed_box(world, physics, meshes, Math.Vec3(10.08, 0.08, 5.08),
            Math.Vec3(0.0, -0.04, 0.0), Color.bytes(46, 54, 65))
        let glass_color = Color.bytes(132, 162, 187)
        fixed_box(world, physics, meshes, Math.Vec3(0.04, 4.0, 5.08),
            Math.Vec3(-5.02, 2.0, 0.0), glass_color, 0.065)
        fixed_box(world, physics, meshes, Math.Vec3(0.04, 4.0, 5.08),
            Math.Vec3(5.02, 2.0, 0.0), glass_color, 0.065)
        fixed_box(world, physics, meshes, Math.Vec3(10.0, 4.0, 0.04),
            Math.Vec3(0.0, 2.0, -2.52), glass_color, 0.065)
        fixed_box(world, physics, meshes, Math.Vec3(10.0, 4.0, 0.04),
            Math.Vec3(0.0, 2.0, 2.52), glass_color, 0.065)
        // Fine seams keep the silhouette readable without a bulky frame.
        let edge_color = Color.bytes(128, 154, 174)
        var side = -1
        while side <= 1 {
            visual_box(world, meshes, Math.Vec3(10.04, 0.018, 0.018),
                Math.Vec3(0.0, 4.0, side as float * 2.52), edge_color, 0.45)
            visual_box(world, meshes, Math.Vec3(0.018, 0.018, 5.04),
                Math.Vec3(side as float * 5.02, 4.0, 0.0), edge_color, 0.45)
            var end = -1
            while end <= 1 {
                visual_box(world, meshes, Math.Vec3(0.018, 4.0, 0.018),
                    Math.Vec3(side as float * 5.02, 2.0, end as float * 2.52),
                    edge_color, 0.45)
                end += 2
            }
            side += 2
        }
    } else {
        state.dynamic_mesh = meshes.add(Scene3D.Geometry.Cube.make(Math.Vec3(0.3)))
        fixed_box(world, physics, meshes, Math.Vec3(24.0, 0.5, 24.0),
            Math.Vec3(0.0, -0.25, 0.0), floor_color)
    }
    state.colors = [
        Color.bytes(86, 194, 234), Color.bytes(244, 177, 84),
        Color.bytes(179, 128, 227), Color.bytes(103, 204, 147),
        Color.bytes(242, 109, 125), Color.bytes(234, 220, 99)
    ]
    if state.mode == "bin" {
        state.colors = [
            Color.bytes(16, 139, 240), Color.bytes(245, 81, 24),
            Color.bytes(112, 31, 224), Color.bytes(34, 196, 49),
            Color.bytes(232, 27, 103), Color.bytes(240, 208, 22),
            Color.bytes(10, 195, 180), Color.bytes(204, 48, 217)
        ]
    }
    if state.mode == "column" {
        var index = 0
        while index < state.count {
            spawn_dynamic_body(world, physics, state, index)
            index++
        }
    }
    world.spawn(ECS.EntityRecipe()
        ..with(Components.AmbientLight3D(
            color:Color.white(), intensity:0.2)))
    world.spawn(ECS.EntityRecipe()
        ..with(Components.SunLight3D(
            direction:Math.Vec3(-0.4, -1.0, -0.3).normalized(),
            color:Color.white(), intensity:3.0)))
    state.clock.tick()
    print("Physics 3D stress: $(state.mode), $(state.count) dynamic bodies")
    print("Bin emits 80 spheres/s; Space topples the column; P pauses physics; Escape quits")
}

func emit_spheres(
    world:&Resources.World,
    physics:&Physics.World3D,
    state:&StressState,
    delta:float
) {
    state.emission = Math.min(8.0, state.emission + delta * 80.0)
    var emitted = 0
    while state.emission >= 1.0 && state.bodies.count() < state.count &&
        emitted < 8
    {
        spawn_dynamic_body(world, physics, state, state.bodies.count())
        state.emission -= 1.0
        emitted++
    }
}

func update_stress(
    input:@Resources.InputState,
    controller:&Application.Controller,
    time:@Resources.FrameTime,
    world:&Resources.World,
    physics:&Physics.World3D,
    window:&Resources.Window,
    simulation:&Application.Simulation,
    state:&StressState
) {
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if input.is_pressed(Input.Key.p) {
        if simulation.is_paused() { simulation.resume() }
        else { simulation.pause() }
    }
    if state.mode == "bin" && !simulation.is_paused() {
        emit_spheres(world, physics, state, time.delta)
    }
    if state.mode == "column" && !simulation.is_paused() && !state.collapsed &&
        input.is_pressed(Input.Key.space) {
        var first = state.count - 16
        if first < 0 { first = 0 }
        var index = first
        while index < state.count {
            state.bodies[index].apply_impulse(Math.Vec3(0.8, 0.0, 0.0))
            index++
        }
        state.collapsed = true
    }
    state.seconds += state.clock.tick()
    state.frames++
    if state.seconds >= 1.0 {
        var step_ms = 0.0
        if state.physics_steps > 0 {
            step_ms = state.physics_ms / state.physics_steps as float
        }
        let steps_per_second = state.physics_steps as float / state.seconds
        let steps_per_frame = state.physics_steps as float / state.frames as float
        let physics_frame_ms = state.physics_ms / state.frames as float
        let title = "Silex Physics 3D — $(state.mode) " +
            "$(state.bodies.count())/$(state.count) bodies — " +
            "$(steps_per_second) steps/s — $(step_ms) ms/step — " +
            "peak $(state.peak_step_ms) ms — $(steps_per_frame) steps/frame"
        if simulation.is_paused() { window.set_title(title + " — paused") }
        else { window.set_title(title) }
        print("$(title) — physics $(physics_frame_ms) ms/frame — " +
            "$(state.frames) frames/$(state.seconds) s")
        state.seconds = 0.0
        state.frames = 0
        state.physics_steps = 0
        state.physics_ms = 0.0
        state.peak_step_ms = 0.0
    }
}

func sync_stress(world:&Resources.World, state:@StressState) {
    var index = 0
    while index < state.bodies.count() {
        let position = state.bodies[index].position()
        let rotation = state.bodies[index].rotation()
        world.update<Components.Transform3D>(state.entities[index],
            func(transform:&Components.Transform3D) {
                transform.position = position
                transform.rotation = rotation
            })
        index++
    }
}

func body_count_argument(value:str) int {
    if value == "32" { return 32 }
    if value == "64" { return 64 }
    if value == "128" { return 128 }
    if value == "256" { return 256 }
    if value == "512" { return 512 }
    if value == "1024" { return 1024 }
    panic("expected 32, 64, 128, 256, 512 or 1024 bodies")
}

func run_scene(mode:str, count:int) {
    if mode != "bin" && mode != "column" {
        panic("expected bin or column")
    }
    var target_height = 2.5
    var camera_distance = 15.0
    var camera_yaw = 0.0
    var window_width = 1100
    if mode == "column" {
        let height = (count as float / 16.0) * 0.31
        target_height = Math.max(target_height, height * 0.5)
        camera_distance = Math.max(camera_distance, height * 1.8)
    } else {
        target_height = 3.2
        camera_distance = 21.0
        camera_yaw = Math.radians(25.0)
        window_width = 1280
    }
    Application()
        ..add_resource(StressState(mode, count))
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Silex Physics 3D Stress"
            ..width = window_width
            ..height = 800))
        ..add_plugin(Plugins.Scene3D())
        ..add_plugin(Stats.PerformancePanel())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings()
            ..target = Math.Vec3(0.0, target_height, 0.0)
            ..distance = camera_distance
            ..yaw = camera_yaw
            ..pitch = Math.radians(-22.0)))
        ..add_plugin(Plugins.Physics3D())
        ..add_plugin(StressStepMetrics())
        ..add_system(Application.Schedule.startup, create_stress_scene)
        ..add_system(Application.Schedule.update, update_stress,
            process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.post_update, sync_stress)
        ..run()
}

func main() {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            if arguments.count() == 1 {
                run_scene("bin", 128)
                return
            }
            if arguments.count() == 3 {
                run_scene(arguments[1], body_count_argument(arguments[2]))
                return
            }
        }
    }
    panic("usage: StressScene [bin|column 32|64|128|256|512|1024]")
}

test "sphere jet emits progressively and caps each slow frame" {
    var world = ECS.World()
    var physics = Physics.World3D()
    var state = StressState("bin", 128)
    state.colors = [Color.white()]
    var frame = 0
    while frame < 60 {
        emit_spheres(world, physics, state, 1.0 / 60.0)
        frame++
    }
    assert(state.bodies.count() == 80)
    assert(world.entities().count() == 80)
    assert(physics.body_count() == 80)
    emit_spheres(world, physics, state, 0.1)
    assert(state.bodies.count() == 88)
    emit_spheres(world, physics, state, 0.0)
    assert(state.bodies.count() == 88)
    var first = 0
    while first < 25 {
        var second = first + 1
        while second < 25 {
            assert(state.bodies[first].position().distance(
                state.bodies[second].position()) >= 0.4)
            second++
        }
        first++
    }
}
