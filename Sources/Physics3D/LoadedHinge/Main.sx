use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Plugins
use GFX.Resources
use GFX.Scene2D
use GFX.Scene3D
use GFX.UI
use GFX.Physics
use Physics3D.LoadedHinge.Model
use Physics3D.LoadedHinge.Controls
use STD.Math
use STD.Process

class LoadedHingeScene {
    var model:Model.LoadedHingeModel=Model.LoadedHingeModel()
    var controls:Controls.LoadedHingeControls=Controls.LoadedHingeControls()
    var ui:UI.Session
    var panel:ECS.Entity=ECS.Entity()
    var body:ECS.Entity=ECS.Entity()
    var payload:ECS.Entity=ECS.Entity()
    var arm:ECS.Entity=ECS.Entity()
    var attachment:ECS.Entity=ECS.Entity()
    var previous_body:Physics.Transform3D=Physics.Transform3D()
    var previous_payload:Physics.Transform3D=Physics.Transform3D()
    var accumulator:float=0.0
    var telemetry:float=0.0
    var smoke:bool=false
    var smoke_time:float=0.0
    var smoke_phase:int=0
    var smoke_pauses:int=0
    var smoke_pose:Physics.Transform3D=Physics.Transform3D()
    init() { self.ui=UI.Session(self.controls.describe()) }
}
func sphere_mesh() Scene3D.Geometry.Mesh {
    var vertices:Scene3D.Geometry.Vertex[]=[];var indices:uint32[]=[]
    var latitude=0
    while latitude<=12 {
        let angle=Math.pi()*latitude as float/12.0
        var longitude=0
        while longitude<=24 {
            let turn=2.0*Math.pi()*longitude as float/24.0
            let normal=Math.Vec3(Math.sin(angle)*Math.cos(turn),Math.cos(angle),Math.sin(angle)*Math.sin(turn))
            vertices.append(Scene3D.Geometry.Vertex(normal.multiply(0.5),normal,Math.Vec2(longitude as float/24.0,latitude as float/12.0)))
            if latitude<12 && longitude<24 {
                let i=(latitude*25+longitude) as uint32;let j=i+25 as uint32
                indices.append(i);indices.append(i+1 as uint32);indices.append(j)
                indices.append(i+1 as uint32);indices.append(j+1 as uint32);indices.append(j)
            }
            longitude++
        }
        latitude++
    }
    return Scene3D.Geometry.Mesh(vertices,indices)
}
func visual(world:&Resources.World,meshes:&Resources.Meshes3D,position:Math.Vec3,size:Math.Vec3,color:Color) ECS.Entity {
    let mesh=meshes.add(Scene3D.Geometry.Cube.make())
    return world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(position:position,scale:size))
        ..with(Components.Mesh3D(mesh)) ..with(Components.Material3D(albedo:color,roughness:0.45)))
}
func rebuild(state:&LoadedHingeScene,simulation:&Application.Simulation) {
    state.model.reset();state.previous_body=state.model.body!.transform();state.previous_payload=state.model.payload!.transform()
    state.accumulator=0.0;state.telemetry=0.0;simulation.pause()
    state.controls.feedback.set("Prêt — en pause ; choisissez gauche ou droite.")
    state.controls.pause_text.set("Reprendre (Espace)")
    var label="Charge derrière le bras";if state.model.offset<0.0 { label="Charge devant le bras" }
    state.controls.offset_text.set(label);state.controls.measure.set(state.model.measurement())
}
func perform(state:&LoadedHingeScene,simulation:&Application.Simulation) {
    while state.controls.resets>0 { state.controls.resets--;state.controls.command=0;rebuild(state,simulation) }
    while state.controls.flips>0 {
        state.controls.flips--;state.controls.command=0;state.model.offset=-state.model.offset;rebuild(state,simulation)
        var side="devant";if state.model.offset<0.0 { side="derrière" }
        state.controls.feedback.set("Charge $(side) le bras — en pause ; choisissez une direction.")
    }
    while state.controls.pauses>0 {
        state.controls.pauses--
        if simulation.is_paused() { simulation.resume();state.controls.feedback.set("Simulation reprise") }
        else { simulation.pause();state.controls.feedback.set("En pause — Espace ou le bouton pour reprendre") }
    }
    if state.controls.command!=0 {
        let command=copy state.controls.command;state.controls.command=0
        if command==2 { state.model.release();state.controls.feedback.set("Bras lâché — la gravité le ramène au repos") }
        else {
            state.model.aim(command as float)
            var side="gauche";if command>0 { side="droite" }
            state.controls.feedback.set("Commande n°$(state.model.commands) — cible à $(side) — en cours")
        }
        simulation.resume()
    }
    var label="Pause (Espace)";if simulation.is_paused() { label="Reprendre (Espace)" }
    state.controls.pause_text.set(label)
}
func startup(world:&Resources.World,meshes:&Resources.Meshes3D,state:&LoadedHingeScene,simulation:&Application.Simulation) {
    let sphere=meshes.add(sphere_mesh())
    state.body=world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D()) ..with(Components.Mesh3D(sphere))
        ..with(Components.Material3D(albedo:Color.bytes(75,163,245),roughness:0.45)))
    state.payload=visual(world,meshes,Math.Vec3(),Math.Vec3(0.55),Color.bytes(245,186,82))
    state.arm=visual(world,meshes,Math.Vec3(),Math.Vec3(0.1,1.0,0.1),Color.bytes(75,163,245))
    state.attachment=visual(world,meshes,Math.Vec3(),Math.Vec3(0.08,0.08,1.0),Color.bytes(100,235,160))
    visual(world,meshes,Math.Vec3(0.0,2.0,0.0),Math.Vec3(0.25),Color.bytes(225,225,225))
    visual(world,meshes,Math.Vec3(0.0,1.2,-0.45),Math.Vec3(0.12,1.4,0.12),Color.bytes(170,180,190))
    visual(world,meshes,Math.Vec3(0.0,2.0,-0.25),Math.Vec3(0.12,0.12,0.5),Color.bytes(170,180,190))
    visual(world,meshes,Math.Vec3(0.0,0.4,0.0),Math.Vec3(10.0,0.2,8.0),Color.bytes(52,70,87))
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.5)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4,-1.0,-0.3).normalized(),intensity:2.5) ..shadow_distance=40.0))
    rebuild(state,simulation)
    state.panel=world.spawn(ECS.EntityRecipe() ..with(Scene2D.Transform(position:Math.Vec2()))
        ..with(Scene2D.Canvas(state.ui.drawing(940,320),940,320) ..anchor=Math.Vec2() ..pivot=Math.Vec2()
            ..space=Scene2D.CanvasSpace.viewport ..layer=100))
}
func update(world:&Resources.World,input:@Resources.InputState,state:&LoadedHingeScene,simulation:&Application.Simulation,controller:&Application.Controller) {
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if !state.smoke {
        for event in input.events() { if !state.controls.handle(event) { let handled=state.ui.handle(event) } }
        perform(state,simulation)
    } else {
        if state.smoke_time==0.0 && simulation.is_paused() { state.controls.right();perform(state,simulation) }
        if state.smoke_time>=1.0 && state.smoke_pauses==0 {
            state.controls.pause();perform(state,simulation);state.smoke_pose=state.model.body!.transform();state.smoke_pauses=1
        } else if state.smoke_pauses>0 && state.smoke_pauses<8 {
            assert(simulation.is_paused() && simulation.delta()==0.0 && state.model.body!.transform()==state.smoke_pose)
            state.smoke_pauses++
        } else if state.smoke_pauses==8 { state.controls.pause();perform(state,simulation);state.smoke_pauses++ }
        if state.smoke_time>=3.0 && state.smoke_phase==0 {
            state.model.verify_settled();state.controls.left();perform(state,simulation);state.smoke_phase=1
        } else if state.smoke_time>=6.0 && state.smoke_phase==1 {
            state.model.verify_settled();state.controls.flip();perform(state,simulation)
            state.controls.right();perform(state,simulation);state.smoke_phase=2
        } else if state.smoke_time>=9.0 && state.smoke_phase==2 {
            state.model.verify_settled();state.controls.release();perform(state,simulation);state.smoke_phase=3
        }
    }
    state.accumulator+=simulation.delta()
    let delta=1.0/120.0
    while state.accumulator>=delta {
        state.previous_body=state.model.body!.transform();state.previous_payload=state.model.payload!.transform()
        state.model.world.step(delta);state.accumulator-=delta
        if state.smoke { state.model.verify();state.smoke_time+=delta }
    }
    state.telemetry+=simulation.delta()
    if state.telemetry>=0.1 { state.telemetry=0.0;state.controls.measure.set(state.model.measurement()) }
    if state.ui.update(0.0) { world.update<Scene2D.Canvas>(state.panel,func(p:&Scene2D.Canvas) { p.replace(state.ui.drawing(940,320)) }) }
    if state.smoke && state.smoke_time>=12.0 {
        state.model.verify_settled();print("Loaded hinge smoke: two targets, mirror load, release, pause/resume and rendered poses verified")
        controller.stop()
    }
}
func blended(first:Physics.Transform3D,second:Physics.Transform3D,alpha:float) Physics.Transform3D {
    var rotation=second.rotation;if first.rotation.dot(rotation)<0.0 { rotation=rotation.multiply(-1.0) }
    return Physics.Transform3D(first.position.lerp(second.position,alpha),
        first.rotation.multiply(1.0-alpha).add(rotation.multiply(alpha)).normalized())
}
func place(world:&Resources.World,entity:ECS.Entity,pose:Physics.Transform3D,size:Math.Vec3) {
    world.update<Components.Transform3D>(entity,func(t:&Components.Transform3D) { t.position=pose.position;t.rotation=pose.rotation;t.scale=size })
}
func render(world:&Resources.World,state:&LoadedHingeScene) {
    let alpha=Math.clamp(state.accumulator*120.0,0.0,1.0)
    let body=blended(state.previous_body,state.model.body!.transform(),alpha)
    let payload=blended(state.previous_payload,state.model.payload!.transform(),alpha)
    place(world,state.body,body,Math.Vec3(1.0));place(world,state.payload,payload,Math.Vec3(0.55))
    place(world,state.arm,Physics.Transform3D(body.point(Math.Vec3(0.0,0.5,0.0)),body.rotation),Math.Vec3(0.1,1.0,0.1))
    place(world,state.attachment,Physics.Transform3D(body.position.add(payload.position).multiply(0.5),body.rotation),Math.Vec3(0.08,0.08,1.0))
    if state.smoke {
        let displayed=world.get<Components.Transform3D>(state.body)
        assert(displayed.position.nearly_equal(body.position,0.00001) && displayed.scale==Math.Vec3(1.0))
        let weight=world.get<Components.Transform3D>(state.payload)
        assert(weight.position.nearly_equal(payload.position,0.00001))
    }
}
func main() {
    var state=LoadedHingeScene()
    match Process.arguments() {
        success(arguments)=> { for argument in arguments {
            if argument=="--controls-check" { verify_interactions();print("Loaded hinge: buttons, Space/R, movement, mirror, release and reset verified");return }
            if argument=="--smoke" { state.smoke=true;state.controls.automatic=true;state.ui=UI.Session(state.controls.describe()) }
        } }
        failure(error)=> { panic(error.detail) }
    }
    var title="Charnière chargée — commandes manuelles"
    if state.smoke { title="TEST AUTOMATIQUE — charnière chargée — fermeture à la fin" }
    Application() ..add_resource(state)
        ..add_plugin(Plugins.Window(Plugins.Window.Settings() ..title=title ..width=1280 ..height=800))
        ..add_plugin(Plugins.Time()) ..add_plugin(Plugins.Scene3D()) ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings() ..target=Math.Vec3(0.0,1.65,0.3)
            ..vertical_fov=0.9 ..distance=7.0 ..yaw=Math.radians(-32.0) ..pitch=Math.radians(-12.0)))
        ..add_system(Application.Schedule.startup,startup)
        ..add_system(Application.Schedule.update,update,process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.render,render,process_mode:Application.ProcessMode.always) ..run()
}
func step_for_check(state:&LoadedHingeScene,rate:int=120) {
    var i=0;while i<rate*3 { state.model.world.step(1.0/rate as float);state.model.verify();i++ }
    state.model.verify_settled();state.accumulator=0.0
    state.previous_body=state.model.body!.transform();state.previous_payload=state.model.payload!.transform()
}
func verify_interactions() {
    var world=Resources.World();var meshes=Resources.Meshes3D();var state=LoadedHingeScene();var simulation=Application.Simulation()
    startup(world,meshes,state,simulation);assert(simulation.is_paused())
    var drawing=state.ui.drawing(940,320);assert(drawing.command_count()>0)
    let initial=state.model.body!.position()
    Controls.click(state.ui,290.0,110.0);perform(state,simulation);assert(!simulation.is_paused() && state.model.commands==1)
    step_for_check(state,60);let right=state.model.body!.position();assert(right.x-initial.x>0.5)
    render(world,state);assert(world.get<Components.Transform3D>(state.body).position==right)
    assert(state.controls.handle(Controls.key_event(Input.Key.space,32 as uint32)));perform(state,simulation);assert(simulation.is_paused())
    assert(state.controls.handle(Controls.key_event(Input.Key.space,32 as uint32,true)));perform(state,simulation);assert(simulation.is_paused())
    let changed=state.ui.update(0.0);var refreshed=state.ui.drawing(940,320)
    Controls.click(state.ui,100.0,110.0);perform(state,simulation);assert(!simulation.is_paused())
    step_for_check(state);assert(right.x-state.model.body!.position().x>1.0)
    let moved=state.ui.update(0.0);var layout=state.ui.drawing(940,320)
    Controls.click(state.ui,300.0,160.0);perform(state,simulation);assert(simulation.is_paused())
    Controls.click(state.ui,510.0,160.0);perform(state,simulation);assert(state.model.offset==-1.0 && simulation.is_paused())
    assert(state.model.payload!.position().z==-1.0)
    Controls.click(state.ui,290.0,110.0);perform(state,simulation);step_for_check(state)
    let before_release=state.model.joint!.angle()
    let mirrored=state.ui.update(0.0);var mirror_layout=state.ui.drawing(940,320)
    Controls.click(state.ui,490.0,110.0);perform(state,simulation);assert(state.model.joint!.motor()==null && !simulation.is_paused())
    step_for_check(state);assert(Math.abs(state.model.joint!.angle()-before_release)>0.05)
    assert(state.controls.handle(Controls.key_event(Input.Key.p,114 as uint32)));perform(state,simulation)
    assert(simulation.is_paused() && state.model.body!.position()==initial)
    render(world,state);assert(world.get<Components.Transform3D>(state.body).position==initial)
    let reset=state.ui.update(0.0);var reset_layout=state.ui.drawing(940,320)
    Controls.click(state.ui,90.0,160.0);perform(state,simulation);assert(simulation.is_paused() && state.model.commands==0)
}
test "loaded hinge buttons and shortcuts mutate physics and rendered poses visibly" { verify_interactions() }
