use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Plugins
use GFX.Resources
use GFX.Scene2D
use GFX.Scene3D
use GFX.UI
use GFX.Physics
use Physics3D.HingeImpact.Model
use Physics3D.HingeImpact.Controls
use STD.Math
use STD.Process

class HingeImpactScene {
    var model:Model.HingeImpactModel=Model.HingeImpactModel()
    var controls:Controls.HingeImpactControls=Controls.HingeImpactControls()
    var ui:UI.Session
    var panel:ECS.Entity=ECS.Entity()
    var rotor:ECS.Entity=ECS.Entity()
    var tip:ECS.Entity=ECS.Entity()
    var accumulator:float=0.0
    var telemetry:float=0.0
    var smoke:bool=false
    var smoke_time:float=0.0
    var smoke_phase:int=0
    var smoke_pauses:int=0
    var smoke_pose:Physics.Transform3D=Physics.Transform3D()
    init() { self.ui=UI.Session(self.controls.describe()) }
}

func visual(world:&Resources.World,meshes:&Resources.Meshes3D,position:Math.Vec3,size:Math.Vec3,color:Color) ECS.Entity {
    let mesh=meshes.add(Scene3D.Geometry.Cube.make())
    return world.spawn(ECS.EntityRecipe() ..with(Components.Transform3D(position:position,scale:size))
        ..with(Components.Mesh3D(mesh)) ..with(Components.Material3D(albedo:color,roughness:0.45)))
}
func rebuild(state:&HingeImpactScene,simulation:&Application.Simulation) {
    state.model.reset();state.accumulator=0.0;state.telemetry=0.0
    state.controls.driven=false;state.controls.mode_changes=0;simulation.pause()
    state.controls.feedback.set("Prêt — rotation libre — choisissez un sens.")
    state.controls.pause_text.set("Reprendre (Espace)");state.controls.measure.set(state.model.measurement())
}
func perform(state:&HingeImpactScene,simulation:&Application.Simulation) {
    while state.controls.resets>0 { state.controls.resets--;state.controls.command=0;rebuild(state,simulation) }
    while state.controls.mode_changes>0 {
        state.controls.mode_changes--;state.model.driven=state.controls.driven
        state.model.hinge!.set_motor(null);simulation.pause()
        var mode="Rotation libre";if state.model.driven { mode="Avec moteur" }
        state.controls.feedback.set("$(mode) sélectionné — choisissez un sens.")
    }
    while state.controls.pauses>0 {
        state.controls.pauses--
        if simulation.is_paused() { simulation.resume();state.controls.feedback.set("Simulation reprise") }
        else { simulation.pause();state.controls.feedback.set("En pause — Espace ou le bouton pour reprendre") }
    }
    if state.controls.command!=0 {
        let direction=copy state.controls.command;state.controls.command=0
        state.model.aim(direction as float);simulation.resume()
        var side="bas";if direction>0 { side="haut" }
        state.controls.feedback.set("Commande n°$(state.model.commands) — vers le repère $(side).")
    }
    var label="Pause (Espace)";if simulation.is_paused() { label="Reprendre (Espace)" }
    state.controls.pause_text.set(label);state.controls.measure.set(state.model.measurement())
}
func startup(world:&Resources.World,meshes:&Resources.Meshes3D,state:&HingeImpactScene,simulation:&Application.Simulation) {
    state.rotor=visual(world,meshes,Math.Vec3(),Math.Vec3(5.0,0.16,0.25),Color.bytes(245,186,82))
    state.tip=visual(world,meshes,Math.Vec3(),Math.Vec3(0.24),Color.bytes(250,95,80))
    visual(world,meshes,Math.Vec3(0.0,2.4,0.3),Math.Vec3(0.26,0.26,0.7),Color.bytes(225,225,225))
    let signs:float[]=[-1.0,1.0]
    for sign in signs {
        visual(world,meshes,Math.Vec3(2.65*Math.cos(0.3),2.4+sign*2.65*Math.sin(0.3),0.0),
            Math.Vec3(0.14,0.4,0.5),Color.bytes(100,235,160))
    }
    visual(world,meshes,Math.Vec3(0.0,-0.15,0.0),Math.Vec3(10.0,0.2,8.0),Color.bytes(52,70,87))
    world.spawn(ECS.EntityRecipe() ..with(Components.AmbientLight3D(intensity:0.5)))
    world.spawn(ECS.EntityRecipe() ..with(Components.SunLight3D(direction:Math.Vec3(-0.4,-1.0,-0.3).normalized(),intensity:2.5)))
    rebuild(state,simulation)
    state.panel=world.spawn(ECS.EntityRecipe() ..with(Scene2D.Transform(position:Math.Vec2()))
        ..with(Scene2D.Canvas(state.ui.drawing(980,360),980,360) ..anchor=Math.Vec2() ..pivot=Math.Vec2()
            ..space=Scene2D.CanvasSpace.viewport ..layer=100))
}
func update(world:&Resources.World,input:@Resources.InputState,state:&HingeImpactScene,simulation:&Application.Simulation,controller:&Application.Controller) {
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if !state.smoke {
        for event in input.events() { if !state.controls.handle(event) { let handled=state.ui.handle(event) } }
        perform(state,simulation)
    } else {
        if state.smoke_time==0.0 && simulation.is_paused() { state.controls.right();perform(state,simulation) }
        if state.smoke_time>=0.25 && state.smoke_pauses==0 {
            state.controls.pause();perform(state,simulation);state.smoke_pose=state.model.body!.transform();state.smoke_pauses=1
        } else if state.smoke_pauses>0 && state.smoke_pauses<8 {
            assert(simulation.is_paused() && simulation.delta()==0.0 && state.model.body!.transform()==state.smoke_pose);state.smoke_pauses++
        } else if state.smoke_pauses==8 { state.controls.pause();perform(state,simulation);state.smoke_pauses++ }
        if state.smoke_time>=1.0 && state.smoke_phase==0 {
            state.model.at_stop(1.0);state.controls.left();perform(state,simulation);state.smoke_phase=1
        } else if state.smoke_time>=2.0 && state.smoke_phase==1 {
            state.model.at_stop(-1.0);state.controls.motor_mode();state.controls.right();perform(state,simulation);state.smoke_phase=2
        } else if state.smoke_time>=5.0 && state.smoke_phase==2 {
            state.model.at_stop(1.0);state.controls.left();perform(state,simulation);state.smoke_phase=3
        }
    }
    var scale=0.25;if state.smoke { scale=1.0 }
    state.accumulator+=simulation.delta()*scale
    let delta=1.0/120.0
    while state.accumulator>=delta {
        state.model.step(delta);state.accumulator-=delta
        if state.smoke { state.smoke_time+=delta }
    }
    state.telemetry+=simulation.delta()
    if state.telemetry>=0.1 { state.telemetry=0.0;state.controls.measure.set(state.model.measurement()) }
    if state.ui.update(0.0) { world.update<Scene2D.Canvas>(state.panel,func(p:&Scene2D.Canvas) { p.replace(state.ui.drawing(980,360)) }) }
    if state.smoke && state.smoke_time>=8.0 {
        state.model.at_stop(-1.0);assert(state.model.brakes>=4)
        print("Hinge impact smoke: free/motor stops, reversal, pause/resume, impulse balance and rendered poses verified");controller.stop()
    }
}
func place(world:&Resources.World,entity:ECS.Entity,pose:Physics.Transform3D) {
    world.update<Components.Transform3D>(entity,func(t:&Components.Transform3D) { t.position=pose.position;t.rotation=pose.rotation })
}
func render(world:&Resources.World,state:&HingeImpactScene) {
    let pose=state.model.body!.transform()
    place(world,state.rotor,pose)
    place(world,state.tip,Physics.Transform3D(pose.point(Math.Vec3(2.4,0.0,0.0)),pose.rotation))
    if state.smoke {
        let displayed=world.get<Components.Transform3D>(state.rotor)
        assert(displayed.position==pose.position && displayed.rotation==pose.rotation)
        assert(world.get<Components.Transform3D>(state.tip).position==pose.point(Math.Vec3(2.4,0.0,0.0)))
    }
}
func step_for_check(state:&HingeImpactScene,direction:float) {
    var i=0;while i<360 { state.model.step(1.0/120.0);i++ }
    state.model.at_stop(direction);state.accumulator=0.0
}
func verify_interactions() {
    var world=Resources.World();var meshes=Resources.Meshes3D();var state=HingeImpactScene();var simulation=Application.Simulation()
    startup(world,meshes,state,simulation);assert(simulation.is_paused())
    var drawing=state.ui.drawing(980,360);assert(drawing.command_count()>0)
    Controls.click(state.ui,290.0,110.0);perform(state,simulation);assert(!simulation.is_paused())
    step_for_check(state,1.0);render(world,state)
    let right=copy world.get<Components.Transform3D>(state.tip).position
    assert(state.controls.handle(Controls.key_event(Input.Key.space,32 as uint32)));perform(state,simulation);assert(simulation.is_paused())
    assert(state.controls.handle(Controls.key_event(Input.Key.space,32 as uint32,true)));perform(state,simulation);assert(simulation.is_paused())
    let refresh=state.ui.update(0.0);var next=state.ui.drawing(980,360)
    Controls.click(state.ui,100.0,110.0);perform(state,simulation);step_for_check(state,-1.0);render(world,state)
    assert(right.y-world.get<Components.Transform3D>(state.tip).position.y>1.4)
    let modes=state.ui.update(0.0);var mode_layout=state.ui.drawing(980,360)
    Controls.click(state.ui,680.0,110.0);perform(state,simulation);assert(simulation.is_paused() && state.model.driven)
    Controls.click(state.ui,290.0,110.0);perform(state,simulation);step_for_check(state,1.0)
    Controls.click(state.ui,100.0,110.0);perform(state,simulation);step_for_check(state,-1.0)
    Controls.click(state.ui,490.0,110.0);perform(state,simulation);assert(simulation.is_paused() && !state.model.driven && state.model.hinge!.motor()==null)
    assert(state.controls.handle(Controls.key_event(Input.Key.p,114 as uint32)));perform(state,simulation)
    assert(simulation.is_paused() && state.model.hinge!.angle()==0.0 && state.model.commands==0)
    let reset=state.ui.update(0.0);var reset_layout=state.ui.drawing(980,360)
    Controls.click(state.ui,90.0,160.0);perform(state,simulation);assert(simulation.is_paused())
}
func main() {
    var state=HingeImpactScene()
    match Process.arguments() {
        success(arguments)=> { for argument in arguments {
            if argument=="--controls-check" { verify_interactions();print("Hinge impact: four buttons, Space/R, free/motor stops, reversal and rendered motion verified");return }
            if argument=="--smoke" { state.smoke=true;state.controls.automatic=true;state.ui=UI.Session(state.controls.describe()) }
        } }
        failure(error)=> { panic(error.detail) }
    }
    var title="Charnière — impact libre et motorisé — ralenti ×0,25"
    if state.smoke { title="TEST AUTOMATIQUE — charnière — fermeture à la fin" }
    Application() ..add_resource(state)
        ..add_plugin(Plugins.Window(Plugins.Window.Settings() ..title=title ..width=1280 ..height=800))
        ..add_plugin(Plugins.Time()) ..add_plugin(Plugins.Scene3D()) ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings() ..target=Math.Vec3(0.0,4.0,0.0)
            ..vertical_fov=0.9 ..distance=8.0 ..yaw=Math.radians(-10.0) ..pitch=Math.radians(-8.0)))
        ..add_system(Application.Schedule.startup,startup)
        ..add_system(Application.Schedule.update,update,process_mode:Application.ProcessMode.always)
        ..add_system(Application.Schedule.render,render,process_mode:Application.ProcessMode.always) ..run()
}
test "hinge impact controls visibly move both stops in free and motor modes" { verify_interactions() }
