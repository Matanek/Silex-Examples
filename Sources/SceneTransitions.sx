use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.ECS
use GFX.Input
use GFX.Plugins
use GFX.Resources
use GFX.Scene2D
use STD.Math
use STD.Process

static struct Const {
    let width:int = 480
    let height:int = 270
    let verification_frames:int = 2
}

struct SceneIdentity { let value:int }
struct SceneMarker { let value:int }
struct LocalFrame { var value:int }

class DemoRun {
    let verification:bool
    var observed:int[]
    var finalizations:int

    init(verification:bool) {
        self.verification = verification
        self.observed = []
        self.finalizations = 0
    }
}

func verification_mode() bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--verify" { return true }
            }
        }
    }
    return false
}

func panel_drawing(identity:int) Canvas {
    var accent = Color.sky_400()
    if identity == 2 { accent = Color.amber_400() }
    var font = Canvas.Font.default()
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(240.0, 135.0), 92.0),
            Canvas.Fill.solid(accent)
        )
        painter.text(
            "Scene $(identity)",
            Math.Vec2(240.0, 112.0),
            Canvas.TextStyle(
                size:28.0,
                color:Color.slate_950(),
                alignment:Canvas.TextAlignment.center,
                font:font
            )
        )
        painter.text(
            "Press 1 or 2 to change scene",
            Math.Vec2(240.0, 235.0),
            Canvas.TextStyle(
                size:14.0,
                color:Color.slate_200(),
                alignment:Canvas.TextAlignment.center,
                font:font
            )
        )
    })
    return drawing
}

func spawn_panel(
    identity:@SceneIdentity,
    world:&ECS.World
) {
    world.spawn(ECS.EntityRecipe()
        ..with(SceneMarker(value:identity.value))
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(
            panel_drawing(identity.value),
            Const.width,
            Const.height
        )
            ..space = Scene2D.CanvasSpace.viewport
            ..anchor = Math.Vec2(0.5)
            ..pivot = Math.Vec2(0.5)
        )
    )
}

func configured_scene(scene:Application.Scene, identity:int) Application.Scene {
    return scene
        ..add_resource(SceneIdentity(value:identity))
        ..add_resource(LocalFrame(value:0))
        ..add_plugin(Scene2D.Content())
        ..add_system(Application.Schedule.startup, spawn_panel)
        ..add_after_system(Application.Schedule.render, advance_scene)
        ..add_system(Application.Schedule.finalize, finalize_scene)
}

func advance_scene(
    identity:@SceneIdentity,
    frame:&LocalFrame,
    panels:ECS.Query<(@SceneMarker, @Scene2D.Canvas)>,
    input:@Resources.InputState,
    run:&DemoRun,
    scenes:&Application.Scenes,
    controller:&Application.Controller
) {
    var count = 0
    for (marker, panel) in panels {
        assert(marker.value == identity.value)
        assert(panel.width() == Const.width)
        assert(panel.height() == Const.height)
        assert(panel.space == Scene2D.CanvasSpace.viewport)
        assert(panel.anchor.x == 0.5 && panel.anchor.y == 0.5)
        assert(panel.pivot.x == 0.5 && panel.pivot.y == 0.5)
        count++
    }
    assert(count == 1)

    frame.value++
    run.observed.append(identity.value)

    var requested = 0
    if run.verification {
        if identity.value == 1 && frame.value == Const.verification_frames {
            requested = 2
        } elif identity.value == 2 && frame.value == Const.verification_frames {
            controller.stop()
        }
    } else {
        if input.is_pressed(Input.Key.num1) { requested = 1 }
        if input.is_pressed(Input.Key.num2) { requested = 2 }
    }
    if requested != 0 && requested != identity.value {
        scenes.request(configured_scene(scenes.create(), requested))
    }
}

func finalize_scene(run:&DemoRun) {
    run.finalizations++
}

func main() {
    let verification = verification_mode()
    var run = DemoRun(verification)
    var application = Application()..add_resource(run)
    var initial = configured_scene(Application.Scene(application), 1)

    application
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Application scene transitions"
            ..width = Const.width
            ..height = Const.height
            ..hidden = verification
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Scene2D.Plugin())
        ..add_plugin(Application.Scenes(initial))

    assert(application.run() == 0)
    if verification {
        assert(run.observed.count() == 4)
        assert(run.observed[0] == 1)
        assert(run.observed[1] == 1)
        assert(run.observed[2] == 2)
        assert(run.observed[3] == 2)
        assert(run.finalizations == 2)
    }
}
