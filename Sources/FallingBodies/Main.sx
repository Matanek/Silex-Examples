use GFX.Application
use GFX.Color
use GFX.Plugins
use Model.Demo
use Model.Simulation
use Model.SpawnSlots
use Systems.create_scene
use Systems.synchronize_visuals
use Systems.update_simulation
use Visuals.Visuals

func main() {
    Application()
        ..add_resource(Simulation())
        ..add_resource(SpawnSlots())
        ..add_resource(Visuals())
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Falling bodies"
            ..width = Demo.window_width
            ..height = Demo.window_height
            ..resizable = false
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.FPSPanel())
        ..add_plugin(Plugins.Time())
        ..add_system(Application.Schedule.startup, create_scene)
        ..add_system(Application.Schedule.update, update_simulation)
        ..add_after_system(Application.Schedule.update, synchronize_visuals)
        ..run()
}
