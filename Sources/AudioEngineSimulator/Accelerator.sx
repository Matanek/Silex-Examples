public struct Pedal {
    var pressed:bool = false
    private let full_travel:int
    private var travel:int = 0

    init(sample_rate:int = 48_000) {
        self.full_travel = sample_rate * 3 / 10
    }

    func advance(frames:int) {
        // Full travel takes 0.30 s on release and twice that speed on press.
        var movement = -frames
        if self.pressed { movement = 2 * frames }
        self.travel += movement
        if self.travel > self.full_travel { self.travel = self.full_travel }
        if self.travel < 0 { self.travel = 0 }
    }

    func opening() float32 { return self.travel as float32 / self.full_travel as float32 }
    func throttle(idle_trim:float32 = 0.0) float32 {
        let opening = self.opening()
        return 0.028 + 0.592 * opening + idle_trim * (1.0 - opening)
    }
}
