use GFX.Audio.Engines
use GFX.Audio.Engines.Vehicles
use Module.PresetSession

public func run() {
    var a:float32[] = []
    var b:float32[] = []
    for _ in 0...960 { a.append(0.0); b.append(0.0) }
    for index, profile in PresetSession.catalogue().indexed() {
        let key = profile.key
        var demo = PresetSession(index)
        var reference = Vehicles.create(key)
        var input = reference.controls()
        demo.toggle_running()
        input.running = true
        for block in 0...200 {
            if block == 60 {
                demo.set_throttle(0.5)
                demo.set_load(0.4)
                input.throttle = 0.5
                input.load = 0.4
                let travel:float = 0.5 / 0.9
                if key == "sport-v8" { input.throttle = 0.3 * travel * travel }
                if key == "custom-1800" { input.throttle = 0.16 * travel * travel }
            }
            if block == 100 { demo.set_throttle(1.0); input.throttle = 1.0 }
            if block == 140 {
                demo.set_throttle(0.0)
                input.throttle = null
            }
            if block == 170 { demo.toggle_running(); input.running = false }
            demo.update(480.0 / 44_100.0)
            try reference.set_controls(input) else error { panic(error.detail) }
            try demo.source.render(&a[0:960]) else error { panic(key + " · simulation at block $(block): $(error.detail)") }
            try reference.render(&b[0:960]) else error { panic(key + " · reference at block $(block): $(error.detail)") }
            assert(demo.source.current_rpm() == reference.current_rpm(), key + " · RPM differs at block $(block): $(demo.source.current_rpm()) / $(reference.current_rpm())")
            assert(demo.source.is_starting() == reference.is_starting(), key + " · starter differs")
            for cylinder in 0...profile.cylinders {
                assert(demo.source.last_combustion_frame(cylinder) == reference.last_combustion_frame(cylinder))
            }
            for i in 0...960 {
                if a[i] != b[i] { panic(key + " · PCM differs at block $(block), sample $(i): $(a[i]) / $(b[i])") }
            }
        }
        for cylinder in 0...demo.selected().cylinders {
            if let frame = demo.source.last_combustion_frame(cylinder) { assert(frame <= demo.source.frame()) }
            else { panic(key + " · aucune combustion pour le cylindre $(cylinder)") }
        }
        assert(demo.source.drive_state()!.gear == 0)
        print(key, " · PCM, régime, démarreur et combustions identiques au point mort")
    }
}
