use GFX.Canvas
use GFX.Color
use STD.Math
use Module.PanelLayout

public func background() Color { return Color.bytes(11, 15, 21) }

public func panel(painter:&Canvas.Painter, frame:Canvas.Rect) {
    let shape = Canvas.Rect(frame.position, frame.size, radius:Math.min(12.0, Math.min(frame.size.x, frame.size.y) * 0.12))
    painter.fill(shape, Canvas.Fill.solid(Color.bytes(18, 24, 33)))
    painter.stroke(shape, Canvas.Stroke(Color.bytes(47, 59, 74), 1.0))
}

public func centered_label(painter:&Canvas.Painter, measuring:Canvas, frame:Canvas.Rect, text:str, style:Canvas.TextStyle) {
    var centered = style
    centered.alignment = Canvas.TextAlignment.center
    let metrics = measuring.measure_text(text, centered)
    let position = frame.position.add(Math.Vec2(frame.size.x * 0.5, (frame.size.y - metrics.height) * 0.5))
    painter.text(text, position, centered, clip:frame)
}

public func instruments(painter:&Canvas.Painter, measuring:Canvas, layout:PanelLayout.Layout, powered:bool, starting:bool,
    key_turn:float, opening:float, progressive:bool?, rpm:float, rev_limit:float) {
    let frame = layout.controls
    panel(painter, frame)
    let key = layout.key
    let key_radius = Math.min(key.size.y * 0.24, key.size.x * 0.23)
    let center = key.position.add(Math.Vec2(key.size.x * 0.5, key.size.y * 0.35))
    painter.fill(Canvas.Circle(center, key_radius), Canvas.Fill.solid(Color.bytes(31, 42, 54)))
    painter.stroke(Canvas.Circle(center, key_radius), Canvas.Stroke(Color.bytes(72, 87, 105), 1.25))
    let angle = (key_turn - 2.0) * Math.pi() / 3.0
    var color = Color.bytes(172, 190, 208)
    var state = "Arrêt"
    if powered {
        color = Color.bytes(255, 194, 99)
        state = "Contact"
        if starting { state = "Démarrage" }
    }
    let direction = Math.Vec2(Math.cos(angle), Math.sin(angle)).multiply(key_radius)
    let bow = center.subtract(direction.multiply(0.45))
    let tip = center.add(direction.multiply(0.62))
    painter.stroke(Canvas.Line(bow, tip), Canvas.Stroke(color, key_radius * 0.19))
    painter.stroke(Canvas.Circle(bow, key_radius * 0.25), Canvas.Stroke(color, key_radius * 0.17))
    let key_text = Math.min(15.0, Math.min(key.size.x * 0.12, key.size.y * 0.16))
    painter.text(state, Math.Vec2(center.x, key.position.y + key.size.y * 0.72),
        Canvas.TextStyle(size:key_text, color:color, alignment:Canvas.TextAlignment.center,
            weight:Canvas.TextWeight.bold), clip:key)
    painter.text("Clé · M", Math.Vec2(center.x, key.position.y + key.size.y * 0.88),
        Canvas.TextStyle(size:key_text * 0.70, color:Color.bytes(154, 171, 190),
            alignment:Canvas.TextAlignment.center), clip:key)

    tachometer(painter, layout.tachometer, rpm, rev_limit)
    pedal(painter, layout.pedal, opening)
    if let mode = progressive { pedal_mode(painter, measuring, layout.pedal_mode, mode) }
}

func pedal_mode(painter:&Canvas.Painter, measuring:Canvas, frame:Canvas.Rect, progressive:bool) {
    var mode = "Hard"
    var fill = Color.bytes(76, 57, 39)
    if progressive { mode = "Soft"; fill = Color.bytes(34, 69, 78) }
    painter.fill(Canvas.Rect(frame.position, frame.size, radius:frame.size.y * 0.32), Canvas.Fill.solid(fill))
    centered_label(painter, measuring, frame, mode,
        Canvas.TextStyle(size:frame.size.y * 0.58, color:Color.bytes(234, 240, 248)))
}

func pedal(painter:&Canvas.Painter, frame:Canvas.Rect, opening:float) {
    panel(painter, frame)
    let side = frame.size.x
    let origin = frame.position
    let pivot = origin.add(Math.Vec2(side * 0.23, side * 0.70))
    let angle = -0.96 + 0.56 * opening
    let axis = Math.Vec2(Math.cos(angle), Math.sin(angle))
    let tip = pivot.add(axis.multiply(side * 0.46))
    let steel = Color.bytes(176, 195, 213)
    let cyan = Color.bytes(119, 214, 225)
    painter.text("Espace", origin.add(Math.Vec2(side * 0.09, side * 0.155)),
        Canvas.TextStyle(size:side * 0.108, color:steel), clip:frame)
    let base = origin.add(Math.Vec2(side * 0.72, side * 0.72))
    let linkage = pivot.add(axis.multiply(side * 0.26))
    painter.stroke(Canvas.Line(base, linkage), Canvas.Stroke(Color.bytes(71, 89, 108), side * 0.05))
    painter.stroke(Canvas.Line(pivot, tip), Canvas.Stroke(steel.mix(cyan, opening), side * 0.084))
    painter.fill(Canvas.Circle(pivot, side * 0.048), Canvas.Fill.solid(Color.bytes(98, 121, 145)))
    painter.stroke(Canvas.Line(origin.add(Math.Vec2(side * 0.15, side * 0.75)),
        origin.add(Math.Vec2(side * 0.86, side * 0.75))), Canvas.Stroke(Color.bytes(57, 73, 91), side * 0.03))
    let track = PanelLayout.rect(origin.x + side * 0.14, origin.y + side * 0.86, side * 0.72, side * 0.074)
    painter.fill(track, Canvas.Fill.solid(Color.bytes(40, 52, 67)))
    if opening > 0.0 {
        painter.fill(PanelLayout.rect(track.position.x, track.position.y, track.size.x * opening, track.size.y),
            Canvas.Fill.solid(cyan))
    }
}

func tachometer(painter:&Canvas.Painter, frame:Canvas.Rect, rpm:float, rev_limit:float) {
    let radius = Math.min(frame.size.y * 0.34, frame.size.x * 0.41)
    let center = frame.position.add(Math.Vec2(frame.size.x * 0.5, frame.size.y * 0.40))
    let angle_start:float = 0.75 * Math.pi()
    let angle_range:float = 1.5 * Math.pi()
    let scale_rpm = Math.ceil((rev_limit + 500.0) / 1_000.0) * 1_000.0
    let cut_fraction = rev_limit / scale_rpm
    painter.stroke(Canvas.Arc(center, radius, angle_start, angle_range),
        Canvas.Stroke(Color.bytes(82, 99, 118), 1.5))
    painter.stroke(Canvas.Arc(center, radius, angle_start + cut_fraction * angle_range, (1.0 - cut_fraction) * angle_range),
        Canvas.Stroke(Color.bytes(240, 106, 117), 2.2))
    for i in 0...8 {
        let a = angle_start + i as float * angle_range / 7.0
        let axis = Math.Vec2(Math.cos(a), Math.sin(a))
        painter.stroke(Canvas.Line(center.add(axis.multiply(radius * 0.84)), center.add(axis.multiply(radius))),
            Canvas.Stroke(Color.bytes(160, 176, 195), 1.2))
    }
    let angle = angle_start + Math.clamp(rpm / scale_rpm, 0.0, 1.0) * angle_range
    let needle = center.add(Math.Vec2(Math.cos(angle), Math.sin(angle)).multiply(radius * 0.78))
    painter.stroke(Canvas.Line(center, needle), Canvas.Stroke(Color.bytes(255, 194, 99), 2.2))
    painter.fill(Canvas.Circle(center, radius * 0.095), Canvas.Fill.solid(Color.bytes(255, 194, 99)))
    let size = Math.min(29.0, Math.min(frame.size.x * 0.20, frame.size.y * 0.16))
    let text = Math.Vec2(center.x, frame.position.y + frame.size.y * 0.73)
    let rounded = (Math.round(rpm / 10.0) * 10.0) as int
    painter.text("$(rounded)", text, Canvas.TextStyle(size:size, color:Color.bytes(237, 242, 248),
        alignment:Canvas.TextAlignment.center, weight:Canvas.TextWeight.bold), clip:frame)
    painter.text("tr/min", Math.Vec2(center.x, frame.position.y + frame.size.y * 0.91),
        Canvas.TextStyle(size:size * 0.58, color:Color.bytes(154, 171, 190),
            alignment:Canvas.TextAlignment.center), clip:frame)
}
