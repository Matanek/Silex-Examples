use GFX.Audio
use GFX.Audio.EngineSimulation
use GFX.Audio.Engines
use GFX.Canvas
use GFX.Color
use GFX.Input.Events
use GFX.Input.Keyboard
use GFX.Input.Pointer
use GFX.Viewer
use GFX.Window
use STD.Math
use STD.Time.Stopwatch
use Package.EngineWorkshop.Workshop.Workshop
use Module.Dashboard
use Module.EngineConfig
use Module.EngineViews
use Module.PanelLayout
use Module.PresetPlayback.PresetPlayback
use Module.PresetPlayback.CombustionDisplay

func preset_labels() str[9] { return ["Chevrolet 454", "4 cylindres · GTI", "Flat-six · 911", "V8 américain", "V10 · LFA",
    "V12 · Ferrari 412 T2", "Motocross · 500 4T", "Hayabusa · 4 en ligne", "Chopper · V-twin 1800"] }

class PresetPanel:Canvas.Session {
    private let labels:str[9] = preset_labels()
    private var workshop:Workshop
    private var combustion:CombustionDisplay
    private var grouped_banks:bool = false
    private var first_bank_on_right:bool = false
    private var layout:PanelLayout.Layout = PanelLayout.Layout(1_120, 740, with_gearbox:true)
    private var measuring:Canvas = Canvas()
    private var picture:Canvas = Canvas()
    private var generation:int = -1
    private var setup:EngineConfig.Setup = EngineConfig.Setup()
    private var bank_angle:float = 90.0
    private var geometry:EngineSimulation.Cylinder[] = []
    private var cycle:float = 0.0
    private var rpm:float = 0.0
    private var key_turn:float = 0.0
    private var drag:int? = null

    init(workshop:Workshop, combustion:CombustionDisplay) {
        self.workshop = workshop
        self.combustion = combustion
    }

    private func refresh_geometry() {
        if self.generation == self.workshop.generation { return }
        self.generation = self.workshop.generation
        let profile = self.workshop.selected()
        let twin = profile.key == "custom-1800"
        self.setup = EngineConfig.Setup(vee:profile.cylinders >= 6 || twin,
            cylinders:profile.cylinders, displacement:Math.round(profile.displacement_cc) as int)
        // Most native V engines list all cylinders of one bank before the next.
        // The generated flat-six declares alternating individual banks.
        self.grouped_banks = self.setup.vee && profile.key != "sport-flat6"
        self.first_bank_on_right = profile.key == "454" || profile.key == "sport-v8" || twin
        self.bank_angle = self.setup.bank_angle()
        if profile.key == "sport-flat6" { self.bank_angle = 180.0 }
        if profile.key == "sport-v12" { self.bank_angle = 75.0 }
        if twin { self.bank_angle = 45.0 }
        self.geometry = self.setup.assembly().cylinders
        if twin { self.geometry[1].firing_degrees = 315.0 }
        self.cycle = 0.0
        self.rpm = 0.0
        self.key_turn = 0.0
    }

    func update(delta:float) bool {
        self.refresh_geometry()
        let rpm = self.workshop.source.current_rpm()
        // The reference exposes RPM. Both views share a reconstructed crank angle.
        let position = self.cycle + delta * (self.rpm + rpm) * 3.0
        self.cycle = position - Math.floor(position / 720.0) * 720.0
        let previous_rpm = self.rpm
        self.rpm = rpm
        let previous_turn = self.key_turn
        let powered = self.workshop.running.value()
        if powered { self.key_turn = Math.min(1.0, self.key_turn + delta / 0.16) }
        else { self.key_turn = Math.max(0.0, self.key_turn - delta / 0.16) }
        return powered || rpm > 0.0 || previous_rpm != rpm || previous_turn != self.key_turn
    }

    private func cylinder_states() EngineSimulation.CylinderState[] {
        var states:EngineSimulation.CylinderState[] = []
        for index, cylinder in self.geometry.indexed() {
            let offset = self.cycle + 720.0 - cylinder.firing_degrees as float
            let phase = offset - Math.floor(offset / 720.0) * 720.0
            let angle = phase * Math.pi() / 180.0
            let radius = cylinder.stroke_mm as float * 0.5
            let rod = cylinder.rod_mm as float
            let lateral = radius * Math.sin(angle)
            let travel = radius * (1.0 - Math.cos(angle)) + rod - Math.sqrt(rod * rod - lateral * lateral)
            var native_index = index
            if self.grouped_banks {
                var bank = index % 2
                if self.first_bank_on_right { bank = 1 - bank }
                native_index = bank * self.setup.rows() + index / 2
            }
            states.append(EngineSimulation.CylinderState(cycle_degrees:phase as float32, piston_mm:travel as float32,
                last_firing_frame:self.combustion.last_combustion_frame(native_index)))
        }
        return states
    }

    func drawing(width:int, height:int) Canvas {
        if width < 80 || height < 80 { return Canvas() }
        self.layout = PanelLayout.Layout(width, height, with_gearbox:true)
        self.refresh_geometry()
        let layout = self.layout
        let setup = self.setup
        let states = self.cylinder_states()
        let combustion_clock = self.combustion.frame()
        let bank_angle = self.bank_angle
        let powered = self.workshop.running.value()
        let starting = self.workshop.source.is_starting()
        let opening = self.workshop.source.controls().throttle ?? 0.0
        let throttle = self.workshop.throttle.value()
        let load = self.workshop.load.value()
        let volume = self.workshop.volume.value()
        let key_turn = self.key_turn
        let rpm = self.rpm
        let redline = self.workshop.selected().redline_rpm
        let transmission = self.workshop.source.drive_state()!
        let gears = self.workshop.source.gearing.ratios.count()
        let requested_gear = self.workshop.requested_gear
        var measuring = self.measuring
        self.picture.clear()
        self.picture.paint(func(painter:&Canvas.Painter) {
            self.draw_presets(painter, measuring)
            Dashboard.panel(painter, layout.profile)
            Dashboard.panel(painter, layout.overhead)
            EngineViews.profile(painter, layout.profile, setup, states, combustion_clock, bank_angle:bank_angle)
            EngineViews.overhead(painter, layout.overhead, setup, states, combustion_clock)
            Dashboard.instruments(painter, layout, powered, starting, key_turn, opening, rpm, redline)
            draw_gearbox(painter, measuring, layout.gearbox, transmission, gears, requested_gear)
            let frame = layout.equipment
            Dashboard.panel(painter, frame)
            let view = PanelLayout.Viewport(frame, 160.0, 129.0)
            draw_slider(painter, frame, view, 0, "Accélérateur", throttle)
            draw_slider(painter, frame, view, 1, "Charge du banc", load)
            draw_slider(painter, frame, view, 2, "Volume d’écoute", volume)
        })
        return self.picture
    }

    private func draw_presets(painter:&Canvas.Painter, measuring:Canvas) {
        let frame = self.layout.setup
        Dashboard.panel(painter, frame)
        let view = PanelLayout.Viewport(frame, 162.0, 345.0)
        let ink = Color.bytes(197, 212, 228)
        painter.text("Moteurs", view.point(0.0, 0.0), Canvas.TextStyle(size:17.0 * view.scale, color:ink), clip:frame)
        let selected = self.workshop.profile.value() ?? 0
        for i, caption in self.labels.indexed() {
            button(painter, measuring, preset_row(view, i), caption, i == selected, 12.5 * view.scale)
        }
        let audition = self.workshop.audition
        var caption = "Essai 8 secondes"
        if audition { caption = "Essai en cours" }
        button(painter, measuring, preset_row(view, self.labels.count()), caption, audition, 12.5 * view.scale)
    }

    private func change_control(index:int, x:float) {
        let view = PanelLayout.Viewport(self.layout.equipment, 160.0, 129.0)
        let level = Math.clamp((x - view.origin.x) / (160.0 * view.scale), 0.0, 1.0)
        match index {
            0 => { self.workshop.throttle.set(level); self.workshop.controls_changed(level) }
            1 => { self.workshop.load.set(level); self.workshop.controls_changed(level) }
            else => { self.workshop.volume.set(level); self.workshop.sync() }
        }
    }

    func handle(event:@Events.Event) bool {
        match event {
            mouse_button_pressed(value) => {
                if value.button != Pointer.MouseButton.left { return false }
                if contains(self.layout.key, value.position) { self.workshop.toggle_running(); return true }
                for gear in 0...self.workshop.source.gearing.ratios.count() + 1 {
                    if contains(gear_button(self.layout.gearbox, gear), value.position) {
                        self.workshop.select_gear(gear)
                        return true
                    }
                }
                let presets = PanelLayout.Viewport(self.layout.setup, 162.0, 345.0)
                for i in 0...self.labels.count() {
                    if contains(preset_row(presets, i), value.position) {
                        if i != (self.workshop.profile.value() ?? 0) {
                            self.drag = null
                            self.workshop.choose_profile_and_stop(i)
                        }
                        return true
                    }
                }
                if contains(preset_row(presets, self.labels.count()), value.position) {
                    self.workshop.audition_cycle()
                    return true
                }
                let controls = PanelLayout.Viewport(self.layout.equipment, 160.0, 129.0)
                for i in 0...3 {
                    let start = controls.point(0.0, slider_y(i) - 10.0)
                    if contains(PanelLayout.rect(start.x - 4.0 * controls.scale, start.y,
                        168.0 * controls.scale, 20.0 * controls.scale), value.position) {
                        self.drag = i; self.change_control(i, value.position.x); return true
                    }
                }
            }
            mouse_moved(value) => {
                if let index = self.drag { self.change_control(index, value.position.x); return true }
            }
            mouse_button_released(value) => {
                if value.button == Pointer.MouseButton.left {
                    if let index = self.drag {
                        self.drag = null; self.change_control(index, value.position.x); return true
                    }
                }
            }
            key_pressed(value) => {
                if value.modifiers.control || value.modifiers.alt || value.modifiers.system { return false }
                match value.key {
                    n => { if !value.repeated { self.workshop.select_gear(0) }
                        return true }
                    up => { if !value.repeated { self.workshop.select_gear(self.workshop.requested_gear + 1) }
                        return true }
                    down => { if !value.repeated { self.workshop.select_gear(self.workshop.requested_gear - 1) }
                        return true }
                    else => {}
                }
            }
            window_focus_lost(value) => { self.drag = null }
            else => {}
        }
        return false
    }

    func accepts_text_input() bool { return false }
    func text_input_target() Canvas.TextInputTarget? { return null }
    func pointer_cursor() Window.Cursor { return Window.Cursor.standard }

    func check_combustion(lit:bool) {
        var drawing = self.drawing(1_120, 740)
        var chamber = false
        var piston = false
        let profile_amber = Color.bytes(248, 174, 82)
        let overhead_amber = Color.bytes(255, 181, 84)
        for command in drawing.commands() {
            match command {
                stroke_line(value) => {
                    let start = value.shape.start
                    if contains(self.layout.profile, start) &&
                        value.style.brush().color_at(start) == profile_amber { chamber = true }
                }
                fill_circle(value) => {
                    let center = value.shape.center
                    if contains(self.layout.overhead, center) &&
                        value.style.brush().color_at(center) == overhead_amber { piston = true }
                }
                else => {}
            }
        }
        assert(chamber == lit && piston == lit)
        if lit {
            let states = self.cylinder_states()
            assert(states[0].last_firing_frame != null && states[1].last_firing_frame == null)
        }
    }

    func check_slider(index:int, level:float) {
        let view = PanelLayout.Viewport(self.layout.equipment, 160.0, 129.0)
        let y = slider_y(index)
        let label = view.point(160.0, y - 27.0)
        let thumb = view.point(160.0 * level, y)
        let expected = Math.round(level * 100.0) as int
        var has_label = false
        var has_thumb = false
        for command in self.picture.commands() {
            match command {
                text(value) => {
                    if value.position == label && value.value == "$(expected) %" { has_label = true }
                }
                fill_circle(value) => {
                    if Math.abs(value.shape.center.x - thumb.x) < 0.01 && Math.abs(value.shape.center.y - thumb.y) < 0.01 {
                        has_thumb = true
                    }
                }
                else => {}
            }
        }
        assert(has_label && has_thumb, "slider $(index) should display $(expected) %")
    }

    func check_views(width:int, height:int) {
        var drawing = self.drawing(width, height)
        var cutaway = false
        var overhead = false
        var pedal = false
        var liners = 0
        let middle = self.layout.profile.position.x + self.layout.profile.size.x * 0.5
        for command in drawing.commands() {
            match command {
                text(value) => { if value.value == "Espace" { pedal = contains(self.layout.pedal, value.position) } }
                fill_circle(value) => {
                    if contains(self.layout.profile, value.shape.center) { cutaway = true }
                    if contains(self.layout.overhead, value.shape.center) { overhead = true }
                }
                stroke_line(value) => {
                    let start = value.shape.start
                    let end = value.shape.end
                    let ink = value.style.brush().color_at(start)
                    if contains(self.layout.profile, start) && ink.r > ink.b && ink.b > ink.g {
                        let direction = end.subtract(start)
                        let edge = value.style.width * Math.abs(direction.y) / direction.length() * 0.5
                        assert(Math.max(start.x, end.x) + edge < middle ||
                            Math.min(start.x, end.x) - edge > middle, "cylinder banks overlap at the crank centerline")
                        liners++
                    }
                }
                else => {}
            }
        }
        assert(cutaway && overhead && pedal && liners == 6)
        assert(self.layout.profile.position.y + self.layout.profile.size.y < self.layout.overhead.position.y)
        let pedal_frame = self.layout.pedal
        let gearbox = self.layout.gearbox
        assert(gearbox.position.x > pedal_frame.position.x + pedal_frame.size.x && gearbox.position.y == pedal_frame.position.y)
        assert(contains(gearbox, gear_button(gearbox, 0).position))
        assert(contains(gearbox, gear_button(gearbox, self.workshop.source.gearing.ratios.count()).position))
    }
}

func gear_button(frame:Canvas.Rect, gear:int) Canvas.Rect {
    let view = PanelLayout.Viewport(frame, 92.0, 100.0)
    var position = view.point(32.0, 28.0)
    if gear > 0 {
        position = view.point(32.0 * ((gear - 1) / 2) as float, 56.0 * ((gear - 1) % 2) as float)
    }
    return PanelLayout.rect(position.x, position.y, 28.0 * view.scale, 24.0 * view.scale)
}

func draw_gearbox(painter:&Canvas.Painter, measuring:Canvas, frame:Canvas.Rect,
    state:Engines.DriveState, gears:int, requested:int) {
    Dashboard.panel(painter, frame)
    let view = PanelLayout.Viewport(frame, 92.0, 100.0)
    let gate = Canvas.Stroke(Color.bytes(64, 82, 102), 2.0 * view.scale)
    painter.stroke(Canvas.Line(view.point(14.0, 40.0), view.point(78.0, 40.0)), gate)
    for pair in 0...(gears + 1) / 2 {
        let x = 14.0 + pair as float * 32.0
        var end = 68.0
        if pair * 2 + 2 > gears { end = 40.0 }
        painter.stroke(Canvas.Line(view.point(x, 12.0), view.point(x, end)), gate)
    }
    for gear in 0...gears + 1 {
        let target = gear_button(frame, gear)
        var label = "N"
        if gear > 0 { label = "$(gear)" }
        button(painter, measuring, target, label, gear == state.gear, 14.0 * view.scale)
        if gear == requested && gear != state.gear {
            painter.stroke(Canvas.Rect(target.position, target.size, radius:target.size.y * 0.20),
                Canvas.Stroke(Color.bytes(255, 194, 99), view.scale))
        }
    }
    var status = "$(Math.round(state.speed_kmh) as int) km/h"
    if state.shift_refused { status = "Rapport refusé" }
    let position = view.point(0.0, 83.0)
    let label = PanelLayout.rect(position.x, position.y, 92.0 * view.scale, 17.0 * view.scale)
    Dashboard.centered_label(painter, measuring, label, status, Canvas.TextStyle(size:11.0 * view.scale,
        color:Color.bytes(176, 195, 213)))
}

func slider_y(index:int) float { return 29.0 + 43.0 * index as float }

func draw_slider(painter:&Canvas.Painter, frame:Canvas.Rect, view:PanelLayout.Viewport, index:int, caption:str, level:float) {
    let y = slider_y(index)
    let percent = Math.round(level * 100.0) as int
    let ink = Color.bytes(197, 212, 228)
    let accent = Color.bytes(119, 214, 225)
    painter.text(caption, view.point(0.0, y - 27.0), Canvas.TextStyle(size:12.0 * view.scale, color:ink), clip:frame)
    painter.text("$(percent) %", view.point(160.0, y - 27.0), Canvas.TextStyle(size:12.0 * view.scale,
        alignment:Canvas.TextAlignment.end, color:accent), clip:frame)
    let start = view.point(0.0, y)
    let end = view.point(160.0, y)
    let thumb = view.point(160.0 * level, y)
    painter.stroke(Canvas.Line(start, end), Canvas.Stroke(Color.bytes(64, 82, 102), 2.0 * view.scale))
    if level > 0.0 { painter.stroke(Canvas.Line(start, thumb), Canvas.Stroke(accent, 2.0 * view.scale)) }
    painter.fill(Canvas.Circle(thumb, 4.0 * view.scale), Canvas.Fill.solid(accent))
}

func preset_row(view:PanelLayout.Viewport, index:int) Canvas.Rect {
    let start = view.point(0.0, 33.0 + 31.0 * index as float)
    return PanelLayout.rect(start.x, start.y, 162.0 * view.scale, 27.0 * view.scale)
}

func button(painter:&Canvas.Painter, measuring:Canvas, frame:Canvas.Rect, caption:str, selected:bool, size:float) {
    var fill = Color.bytes(34, 44, 58)
    if selected { fill = Color.bytes(32, 72, 82) }
    painter.fill(Canvas.Rect(frame.position, frame.size, radius:frame.size.y * 0.20), Canvas.Fill.solid(fill))
    Dashboard.centered_label(painter, measuring, frame, caption, Canvas.TextStyle(size:size, color:Color.bytes(234, 240, 248)))
}

func contains(frame:Canvas.Rect, point:Math.Vec2) bool {
    return point.x >= frame.position.x && point.x < frame.position.x + frame.size.x &&
        point.y >= frame.position.y && point.y < frame.position.y + frame.size.y
}

public func show() {
    var workshop = Workshop(reference_only:true, transmission:Engines.Transmission.manual)
    var combustion = CombustionDisplay()
    var session = PresetPlayback(workshop, PresetPanel(workshop, combustion), Audio(), combustion)
    Viewer.show(session, Viewer.CanvasSettings(width:1_120, height:740, title:"AudioEngineSimulator",
        background:Dashboard.background()))
}

public func check() {
    var workshop = Workshop(reference_only:true, transmission:Engines.Transmission.manual)
    var combustion = CombustionDisplay()
    var panel = PresetPanel(workshop, combustion)
    var audio = Audio.offline(sample_rate:44_100, channels:2)
    var session = PresetPlayback(workshop, panel, audio, combustion)
    assert(workshop.catalogue.count() == preset_labels().count())
    session.drawing(1_120, 740)
    panel.check_slider(0, 0.0)
    panel.check_slider(1, 0.2)
    panel.check_slider(2, 0.7)
    let layout = PanelLayout.Layout(1_120, 740, with_gearbox:true)
    let presets = PanelLayout.Viewport(layout.setup, 162.0, 345.0)
    for i, profile in workshop.catalogue.indexed() {
        let row = preset_row(presets, i)
        assert(session.handle(Events.Event.mouse_button_pressed(click(row.position.add(row.size.multiply(0.5))))))
        assert(workshop.selected().key == profile.key)
    }
    combustion.append(1, 500)
    combustion.advance(499)
    panel.check_combustion(false)
    combustion.advance(500)
    panel.check_combustion(true)
    combustion.advance(2_150)
    panel.check_combustion(false)
    panel.check_views(1_120, 740)
    panel.check_views(420, 700)
    session.drawing(420, 700)
    let key = PanelLayout.Layout(420, 700, with_gearbox:true).key
    assert(session.handle(Events.Event.mouse_button_pressed(click(key.position.add(key.size.multiply(0.5))))))
    assert(workshop.running.value())
    let controls = PanelLayout.Viewport(PanelLayout.Layout(420, 700, with_gearbox:true).equipment, 160.0, 129.0)
    let throttle = controls.point(160.0 * 0.9, slider_y(0))
    let load = controls.point(160.0 * 0.4, slider_y(1))
    let volume = controls.point(160.0, slider_y(2))
    assert(session.handle(Events.Event.mouse_button_pressed(click(throttle))))
    session.drawing(420, 700)
    panel.check_slider(0, 0.9)
    assert(Math.abs((workshop.source.controls().throttle ?? 0.0) - 0.16) < 0.0001)
    assert(session.handle(Events.Event.mouse_button_pressed(click(load))))
    session.drawing(420, 700)
    panel.check_slider(1, 0.4)
    assert(Math.abs(workshop.source.controls().load - 0.4) < 0.0001)
    assert(session.handle(Events.Event.mouse_button_pressed(click(volume))))
    assert(session.handle(Events.Event.mouse_button_released(click(volume, down:false))))
    session.drawing(420, 700)
    panel.check_slider(2, 1.0)
    assert(workshop.source.controls().volume > 0.9999)
    let space = Events.KeyEvent(window:Window.Id(value:0 as uint32), keyboard:Keyboard.KeyboardId(value:0 as uint32),
        key:Keyboard.Key.space, keycode:0 as uint32, raw:0 as uint16, repeated:false,
        modifiers:Keyboard.Modifiers(), timestamp:Events.Timestamp(nanoseconds:0 as uint))
    assert(session.handle(Events.Event.key_pressed(space)))
    assert(Math.abs((workshop.source.controls().throttle ?? 0.0) - 0.16) < 0.0001)
    var pedal_timeout = Stopwatch()
    pedal_timeout.start()
    var intermediate = false
    while workshop.source.controls().throttle != 1.0 && pedal_timeout.get_elapsed_seconds() < 5.0 {
        session.update(480.0 / 44_100.0)
        audio.render(480)
        let opening = workshop.source.controls().throttle ?? 0.0
        if opening > 0.16 && opening < 1.0 { intermediate = true }
    }
    assert(intermediate && workshop.source.controls().throttle == 1.0)
    assert(!workshop.source.controls().accelerating)
    assert(session.handle(Events.Event.key_released(space)))
    pedal_timeout.restart()
    while (workshop.source.controls().throttle ?? 0.0) > 0.1601 && pedal_timeout.get_elapsed_seconds() < 5.0 {
        session.update(480.0 / 44_100.0)
        audio.render(480)
    }
    assert(Math.abs((workshop.source.controls().throttle ?? 0.0) - 0.16) < 0.0001)
    let narrow_presets = PanelLayout.Viewport(PanelLayout.Layout(420, 700, with_gearbox:true).setup, 162.0, 345.0)
    let audition = preset_row(narrow_presets, preset_labels().count())
    let chevrolet = preset_row(narrow_presets, 0)
    assert(session.handle(Events.Event.mouse_button_pressed(click(audition.position.add(audition.size.multiply(0.5))))))
    assert(workshop.audition && workshop.running.value())
    assert(session.handle(Events.Event.mouse_button_pressed(click(chevrolet.position.add(chevrolet.size.multiply(0.5))))))
    assert(workshop.selected().key == "454" && !workshop.audition && !workshop.running.value())
    assert(combustion.frame() == 0 && combustion.last_combustion_frame(1) == null)
    assert(!workshop.source.controls().running && !workshop.source.controls().accelerating)
    session.drawing(420, 700)
    panel.check_slider(0, 0.0)
    panel.check_slider(1, 0.2)
    panel.check_slider(2, 1.0)
    assert(session.handle(Events.Event.mouse_button_pressed(click(key.position.add(key.size.multiply(0.5))))))
    assert(workshop.running.value() && workshop.source.controls().running)
    var timeout = Stopwatch()
    timeout.start()
    while combustion.last_combustion_frame(0) == null && timeout.get_elapsed_seconds() < 5.0 {
        session.update(480.0 / 44_100.0)
        audio.render(480)
    }
    let ignition = combustion.last_combustion_frame(0)
    assert(ignition != null, "no native combustion reached the offline audio playhead")
    assert(ignition! <= combustion.frame())
    let gearbox = PanelLayout.Layout(420, 700, with_gearbox:true).gearbox
    let first = gear_button(gearbox, 1)
    let neutral = gear_button(gearbox, 0)
    assert(workshop.source.drive_state()!.gear == 0)
    assert(session.handle(Events.Event.mouse_button_pressed(click(first.position.add(first.size.multiply(0.5))))))
    assert(workshop.source.controls().gear == 1)
    timeout.restart()
    while workshop.source.drive_state()!.gear != 1 && timeout.get_elapsed_seconds() < 5.0 {
        session.update(480.0 / 44_100.0)
        audio.render(480)
    }
    assert(workshop.source.drive_state()!.gear == 1)
    assert(session.handle(Events.Event.mouse_button_pressed(click(neutral.position.add(neutral.size.multiply(0.5))))))
    assert(workshop.source.controls().gear == 0)
    timeout.restart()
    while workshop.source.drive_state()!.gear != 0 && timeout.get_elapsed_seconds() < 5.0 {
        session.update(480.0 / 44_100.0)
        audio.render(480)
    }
    assert(workshop.source.drive_state()!.gear == 0)
    print("Banc des presets · combustions, curseurs, boîte et redémarrage vérifiés")
}

func click(position:Math.Vec2, down:bool = true) Events.MouseButtonEvent {
    return Events.MouseButtonEvent(window:Window.Id(value:0 as uint32), mouse:Pointer.MouseId(value:0 as uint32),
        button:Pointer.MouseButton.left, down:down, clicks:1 as uint8, position:position,
        timestamp:Events.Timestamp(nanoseconds:0 as uint))
}
