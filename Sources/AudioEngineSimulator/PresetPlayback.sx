use GFX.Audio
use GFX.Canvas
use GFX.Input.Events
use GFX.Input.Keyboard
use GFX.Window
use STD.Error.Kind
use Package.EngineWorkshop.Workshop.Workshop
use Module.Accelerator

struct Combustion {
    let cylinder:int
    let frame:int
}

public class CombustionDisplay {
    private var waiting:Combustion[] = []
    private var visible:int[16]
    private var played_frame:int = 0

    init() {
        for cylinder in 0...16 { self.visible[cylinder] = 0 }
    }

    func frame() int { return self.played_frame }

    func last_combustion_frame(cylinder:int) int? {
        let frame = self.visible[cylinder]
        if frame == 0 { return null }
        return frame
    }

    func append(cylinder:int, frame:int) {
        self.waiting.append(Combustion(cylinder:cylinder, frame:frame))
    }

    func advance(frame:int) {
        self.played_frame = frame
        if self.waiting.count() == 0 { return }
        var future:Combustion[] = []
        for event in self.waiting {
            if event.frame <= frame { self.visible[event.cylinder] = event.frame }
            else { future.append(event) }
        }
        self.waiting = future
    }

    func reset() {
        self.played_frame = 0
        self.waiting = []
        for cylinder in 0...self.visible.count() { self.visible[cylinder] = 0 }
    }
}

// Match EngineWorkshop's stereo queue and controls while leaving its session independent.
// Read only ready native blocks; never wait for the simulator in a UI frame.
public class PresetPlayback:Canvas.Session {
    private var workshop:Workshop
    private var panel:Canvas.Session
    private var audio:Audio
    private var stream:Audio.Stream
    private var playing:Audio.PlayingSound = Audio.PlayingSound()
    private var samples:float32[] = []
    private var pending:bool = false
    private var offset:int = 0
    private var generation:int = 0
    private var combustion:CombustionDisplay
    private var pedal:Accelerator.Pedal = Accelerator.Pedal(sample_rate:44_100)
    init(workshop:Workshop, panel:Canvas.Session, audio:Audio, combustion:CombustionDisplay) {
        self.workshop = workshop
        self.panel = panel
        self.audio = audio
        self.combustion = combustion
        self.stream = self.audio.stream(sample_rate:44_100, channels:2, capacity_frames:2_400)
        for _ in 0...960 { self.samples.append(0.0) }
        self.workshop.source.enqueue()
    }
    private func feed() {
        if self.generation != self.workshop.generation {
            if self.playing.is_valid() { self.audio.stop(self.playing) }
            self.audio.release(self.stream)
            self.stream = self.audio.stream(sample_rate:44_100, channels:2, capacity_frames:2_400)
            self.playing = Audio.PlayingSound(); self.pending = false; self.offset = 0
            self.generation = self.workshop.generation
            self.combustion.reset()
            self.pedal = Accelerator.Pedal(sample_rate:44_100)
            self.workshop.source.enqueue()
        }
        var count = 0
        while count < 8 {
            if self.audio.stream_info(self.stream).queued_frames >= 2_400 { break }
            if !self.pending {
                let previous = self.workshop.source.frame()
                if !self.workshop.source.render_ready(&self.samples[0:960]) { break }
                for cylinder in 0...self.workshop.selected().cylinders {
                    if let frame = self.workshop.source.last_combustion_frame(cylinder) {
                        if frame > previous { self.combustion.append(cylinder, frame) }
                    }
                }
                self.pending = true; self.offset = 0
            }
            match try self.audio.write(self.stream, @self.samples[self.offset * 2:960]) {
                failure(error) => { if error.kind != Kind.would_block() { panic(error.detail) }
                    break }
                success(frames) => {
                    self.offset += frames
                    if self.offset == 480 {
                        self.pending = false
                        // Send the travel at the start of the next audio block.
                        self.workshop.set_keyboard_opening(self.pedal.opening() as float)
                        self.workshop.source.enqueue()
                        self.pedal.advance(480)
                    }
                    if frames == 0 { break }
                }
            }
            count++
        }
        if !self.playing.is_valid() && self.audio.stream_info(self.stream).queued_frames >= 1_920 {
            self.playing = self.audio.play(self.stream, Audio.Playback(fade_in_seconds:0.05))
        }
        self.combustion.advance(self.audio.stream_info(self.stream).consumed_frames)
    }
    func drawing(width:int, height:int) Canvas { self.feed(); return self.panel.drawing(width, height) }
    func update(delta:float) bool {
        self.workshop.update(delta); self.feed(); return self.panel.update(delta)
    }
    func handle(event:@Events.Event) bool {
        match event {
            window_focus_lost(value) => { self.pedal.pressed = false; self.workshop.set_braking(false) }
            key_pressed(value) => {
                if !self.panel.accepts_text_input() && !value.modifiers.control && !value.modifiers.alt && !value.modifiers.system {
                    let m = value.keycode == 109 as uint32 || value.keycode == 77 as uint32 || (value.keycode == 0 as uint32 && value.key == Keyboard.Key.m)
                    if m { if !value.repeated { self.workshop.toggle_running() }
                        return true }
                    if value.key == Keyboard.Key.s {
                        if !value.repeated { self.workshop.set_braking(true) }
                        return true
                    }
                    if value.key == Keyboard.Key.space {
                        if !value.repeated { self.pedal.pressed = true }
                        return true
                    }
                }
            }
            key_released(value) => {
                if value.key == Keyboard.Key.space { self.pedal.pressed = false; return true }
                if value.key == Keyboard.Key.s { self.workshop.set_braking(false); return true }
            }
            else => {}
        }
        let handled = self.panel.handle(event)
        if self.generation != self.workshop.generation { self.feed() }
        return handled
    }
    func accepts_text_input() bool { return self.panel.accepts_text_input() }
    func text_input_target() Canvas.TextInputTarget? { return self.panel.text_input_target() }
    func pointer_cursor() Window.Cursor { return self.panel.pointer_cursor() }
    drop {
        if self.playing.is_valid() { self.audio.stop(self.playing, fade_out_seconds:0.03) }
    }
}
