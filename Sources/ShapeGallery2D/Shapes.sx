use GFX.Canvas
use GFX.Color
use STD.Math
use Module.Drawing.arrow
use Module.Drawing.card
use Module.Drawing.label
use Module.Drawing.polygon
use Module.Drawing.star

public func paint_round_shapes(painter:&Canvas.Painter, font:Canvas.Font, origin:Math.Vec2) {
    card(painter, font, "Circles and ellipses", origin, Math.Vec2(275.0, 195.0))
    painter.stroke(Canvas.Circle(origin.add(Math.Vec2(55.0, 105.0)), 30.0), Canvas.Stroke(Color.sky_400(), 4.0))
    painter.fill(Canvas.Ellipse(origin.add(Math.Vec2(138.0, 105.0)), Math.Vec2(42.0, 27.0)), Canvas.Fill.solid(Color.emerald_400()))
    painter.stroke(Canvas.Circle(origin.add(Math.Vec2(225.0, 105.0)), 30.0), Canvas.Stroke(Color.violet_400(), 13.0))
    label(painter, font, "thin outline", origin.add(Math.Vec2(24.0, 150.0)), 11.0)
    label(painter, font, "filled", origin.add(Math.Vec2(124.0, 150.0)), 11.0)
    label(painter, font, "thick outline", origin.add(Math.Vec2(188.0, 150.0)), 11.0)
}

public func paint_arcs(painter:&Canvas.Painter, font:Canvas.Font, origin:Math.Vec2) {
    card(painter, font, "Arcs, sectors, and segments", origin, Math.Vec2(275.0, 195.0))
    painter.stroke(
        Canvas.Arc(origin.add(Math.Vec2(52.0, 113.0)), 35.0, Math.pi(), Math.pi()),
        Canvas.Stroke(Color.sky_400(), 5.0)..cap = Canvas.StrokeCap.round
    )
    painter.fill(
        Canvas.Sector(origin.add(Math.Vec2(137.0, 110.0)), 38.0, -Math.pi() * 0.5, Math.pi() * 1.55),
        Canvas.Fill.solid(Color.amber_400())
    )
    painter.stroke(
        Canvas.Arc(origin.add(Math.Vec2(224.0, 110.0)), 31.0, Math.pi() * 0.15, Math.pi() * 1.55),
        Canvas.Stroke(Color.purple_400(), 14.0)..cap = Canvas.StrokeCap.butt
    )
    label(painter, font, "arc", origin.add(Math.Vec2(42.0, 158.0)), 11.0)
    label(painter, font, "sector", origin.add(Math.Vec2(116.0, 158.0)), 11.0)
    label(painter, font, "ring sector", origin.add(Math.Vec2(184.0, 158.0)), 11.0)
}

public func paint_rectangles(painter:&Canvas.Painter, font:Canvas.Font, origin:Math.Vec2) {
    card(painter, font, "Rectangles, squares, rounding", origin, Math.Vec2(275.0, 195.0))
    painter.stroke(Canvas.Rect(origin.add(Math.Vec2(24.0, 72.0)), Math.Vec2(70.0, 55.0)), Canvas.Stroke(Color.blue_400(), 4.0))
    painter.fill(Canvas.Rect(origin.add(Math.Vec2(112.0, 68.0)), Math.Vec2(58.0)), Canvas.Fill.solid(Color.green_400()))
    painter.fill(
        Canvas.Rect(origin.add(Math.Vec2(188.0, 68.0)), Math.Vec2(64.0, 62.0), 18.0),
        Canvas.Fill.with_brush(Canvas.Brush.linear(
            start:origin.add(Math.Vec2(188.0, 68.0)),
            end:origin.add(Math.Vec2(252.0, 130.0)),
            start_color:Color.violet_400(),
            end_color:Color.pink_400()
        ))
    )
    label(painter, font, "outline", origin.add(Math.Vec2(35.0, 148.0)), 11.0)
    label(painter, font, "filled", origin.add(Math.Vec2(127.0, 148.0)), 11.0)
    label(painter, font, "gradient", origin.add(Math.Vec2(198.0, 148.0)), 11.0)
}

public func paint_polygons(painter:&Canvas.Painter, font:Canvas.Font, origin:Math.Vec2) {
    card(painter, font, "Regular polygons", origin, Math.Vec2(275.0, 195.0))
    painter.stroke(polygon(origin.add(Math.Vec2(54.0, 108.0)), 36.0, 3, -Math.pi() * 0.5), Canvas.Stroke(Color.amber_400(), 4.0))
    painter.stroke(polygon(origin.add(Math.Vec2(137.0, 108.0)), 36.0, 5, -Math.pi() * 0.5), Canvas.Stroke(Color.teal_400(), 4.0))
    painter.stroke(polygon(origin.add(Math.Vec2(222.0, 108.0)), 36.0, 8, Math.pi() * 0.125), Canvas.Stroke(Color.violet_400(), 4.0))
    label(painter, font, "triangle", origin.add(Math.Vec2(32.0, 158.0)), 11.0)
    label(painter, font, "pentagon", origin.add(Math.Vec2(108.0, 158.0)), 11.0)
    label(painter, font, "octagon", origin.add(Math.Vec2(198.0, 158.0)), 11.0)
}

public func paint_special_polygons(painter:&Canvas.Painter, font:Canvas.Font, origin:Math.Vec2) {
    card(painter, font, "Star, diamond, and concave shape", origin, Math.Vec2(275.0, 195.0))
    painter.stroke(
        star(origin.add(Math.Vec2(54.0, 108.0)), 39.0, 17.0, 5),
        Canvas.Stroke(Color.yellow_400(), 4.0)..join = Canvas.StrokeJoin.miter
    )
    painter.stroke(polygon(origin.add(Math.Vec2(137.0, 108.0)), 38.0, 4, 0.0), Canvas.Stroke(Color.cyan_400(), 4.0))
    var concave = Canvas.Path()
        ..move_to(origin.add(Math.Vec2(190.0, 72.0)))
        ..line_to(origin.add(Math.Vec2(248.0, 75.0)))
        ..line_to(origin.add(Math.Vec2(222.0, 104.0)))
        ..line_to(origin.add(Math.Vec2(251.0, 141.0)))
        ..line_to(origin.add(Math.Vec2(211.0, 128.0)))
        ..line_to(origin.add(Math.Vec2(185.0, 151.0)))
        ..line_to(origin.add(Math.Vec2(194.0, 113.0)))
        ..close()
    painter.fill(concave, Canvas.Fill.solid(Color.rose_400().with_alpha(0.8)))
}

public func paint_freeform(painter:&Canvas.Painter, font:Canvas.Font, origin:Math.Vec2) {
    card(painter, font, "Closed freeform shape", origin, Math.Vec2(275.0, 195.0))
    var blob = Canvas.Path()
        ..move_to(origin.add(Math.Vec2(36.0, 112.0)))
        ..cubic_to(origin.add(Math.Vec2(18.0, 57.0)), origin.add(Math.Vec2(80.0, 48.0)), origin.add(Math.Vec2(112.0, 72.0)))
        ..cubic_to(origin.add(Math.Vec2(145.0, 35.0)), origin.add(Math.Vec2(180.0, 61.0)), origin.add(Math.Vec2(188.0, 88.0)))
        ..cubic_to(origin.add(Math.Vec2(258.0, 82.0)), origin.add(Math.Vec2(260.0, 142.0)), origin.add(Math.Vec2(205.0, 145.0)))
        ..cubic_to(origin.add(Math.Vec2(165.0, 166.0)), origin.add(Math.Vec2(145.0, 119.0)), origin.add(Math.Vec2(108.0, 150.0)))
        ..cubic_to(origin.add(Math.Vec2(68.0, 170.0)), origin.add(Math.Vec2(28.0, 153.0)), origin.add(Math.Vec2(36.0, 112.0)))
        ..close()
    let brush = Canvas.Brush.linear(
        start:origin.add(Math.Vec2(30.0, 60.0)),
        end:origin.add(Math.Vec2(245.0, 155.0)),
        start_color:Color.pink_400().with_alpha(0.35),
        end_color:Color.violet_500().with_alpha(0.8)
    )
    painter.fill(blob, Canvas.Fill.with_brush(brush))
    painter.stroke(blob, Canvas.Stroke(Color.pink_300(), 3.0)..join = Canvas.StrokeJoin.round)
}

public func paint_arrows(painter:&Canvas.Painter, font:Canvas.Font, origin:Math.Vec2) {
    card(painter, font, "Composite arrows", origin, Math.Vec2(275.0, 195.0))
    arrow(painter, origin.add(Math.Vec2(24.0, 78.0)), origin.add(Math.Vec2(245.0, 78.0)), Color.sky_400(), 4.0)
    arrow(painter, origin.add(Math.Vec2(24.0, 128.0)), origin.add(Math.Vec2(245.0, 128.0)), Color.rose_500(), 12.0)
    label(painter, font, "same intent, two weights", origin.add(Math.Vec2(55.0, 155.0)), 11.0)
}

public func paint_layering(painter:&Canvas.Painter, font:Canvas.Font, origin:Math.Vec2) {
    card(painter, font, "Transparency and layering", origin, Math.Vec2(275.0, 195.0))
    painter.fill(Canvas.Circle(origin.add(Math.Vec2(102.0, 108.0)), 49.0), Canvas.Fill.solid(Color.green_400().with_alpha(0.48)))
    painter.fill(Canvas.Rect(origin.add(Math.Vec2(106.0, 72.0)), Math.Vec2(92.0, 72.0)), Canvas.Fill.solid(Color.rose_400().with_alpha(0.5)))
    painter.fill(polygon(origin.add(Math.Vec2(176.0, 119.0)), 53.0, 3, -Math.pi() * 0.5), Canvas.Fill.solid(Color.blue_400().with_alpha(0.5)))
    painter.stroke(Canvas.Circle(origin.add(Math.Vec2(102.0, 108.0)), 49.0), Canvas.Stroke(Color.green_300(), 2.0))
    painter.stroke(Canvas.Rect(origin.add(Math.Vec2(106.0, 72.0)), Math.Vec2(92.0, 72.0)), Canvas.Stroke(Color.rose_300(), 2.0))
}
