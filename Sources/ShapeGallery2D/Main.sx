use GFX.Canvas
use GFX.Color
use GFX.Viewer
use Drawing.Constants
use Gallery.paint_gallery

func main() {
    var font = Canvas.Font.default()
    var gallery = Canvas()
    gallery.paint(func(painter:&Canvas.Painter) { paint_gallery(painter, font) })
    assert(gallery.command_count() > 50)
    Viewer.show(gallery, Viewer.CanvasSettings(
        width:Constants.canvas_width + 40,
        height:Constants.canvas_height + 40,
        title:"GFX.Canvas — Shape gallery",
        background:Color.black()
    ))
}
