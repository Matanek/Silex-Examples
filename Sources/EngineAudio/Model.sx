use GFX.Audio.Synthesis
use GFX.Audio.Processing
use STD.Error
use STD.Error.Kind
use STD.Math
use Module.Reference.ReferenceClient
use Module.Profiles.Catalog
use Module.Profiles.Profile
use Module.Airflow.Airflow

// The bench owns its RPM response. A game can instead supply RPM to Engine.
public class Bench:Synthesis.Generator {
    let format:Processing.Format
    let reference_mode:bool
    private var reference:ReferenceClient? = null
    var source:Synthesis.Engine
    var accelerating:bool = false
    var focused:bool = true
    var exhaust:float = 0.65
    var roughness:float = 0.4
    var load:float = 0.3
    var volume:float = 0.7
    var ambience:float = 0.06
    var breath:float = 0.0
    private var airflow:Airflow
    private var intake:float32[] = []
    var base_rpm:float = 800.0
    private var target_rpm:float = 800.0
    private var throttle:float = 0.0
    private var remaining:int = 0
    private var gain:float32 = 0.7
    private var ambience_gain:float32 = 0.06
    private var room:Processing.Reverb
    private var room_buffer:float32[] = []
    private var idle_offset:float = 0.0
    private var idle_speed:float = 0.0
    private var random:int = 73
    private let initially_running:bool
    private var ignition:bool
    private var starting:bool = false
    private var fuel:float = 1.0
    var produced_frames:int = 0
    var catalog:Catalog
    private var profile_id:int = 0
    var profile_generation:int = 0
    private var driving:bool = false
    private var automatic:bool = true
    private var requested_gear:int = 0
    var braking:bool = false
    var reference_ready:bool = false
    var notice:str = ""

    init(running:bool = true, reference:bool = false) {
        self.catalog = Catalog()
        self.reference_mode = reference
        var sample_rate = 48_000; if reference { sample_rate = 44_100 }
        self.format = Processing.Format(sample_rate:sample_rate, channels:2)
        self.airflow = Airflow(self.format)
        for _ in 0...480 { self.intake.append(0.0) }
        self.initially_running = running; self.ignition = running
        // Match the preceding candidates' whole-scenario RMS for listening.
        self.source = Synthesis.Engine.create(self.format, amplitude:0.249)
        self.room = Processing.Reverb.create(self.format, room_size:0.18,
            decay_seconds:0.22, damping:0.65, wet:1.0)
        for _ in 0...960 { self.room_buffer.append(0.0) }
        if reference {
            self.reference = ReferenceClient()
            self.exhaust = 1.0; self.roughness = 1.0; self.load = 0.2; self.ambience = 0.0
            self.ambience_gain = 0.0
        }
        if !running {
            self.target_rpm = 0.0; self.fuel = 0.0
            self.source.set_state(0.0, ramp_frames:0, fuel:0.0)
        }
    }

    func rpm() float {
        if let reference = self.reference { return reference.current_rpm() }
        return self.source.current_rpm() as float
    }
    func is_running() bool { return self.ignition }
    func is_starting() bool {
        if let reference = self.reference { return reference.is_starting() }
        return self.starting
    }

    func set_running(value:bool) {
        if self.ignition == value { return }
        self.ignition = value
        self.starting = value && self.target_rpm < self.base_rpm - 30.0
        // Neither a held pedal nor a previous acceleration carries across ignition.
        self.accelerating = false
    }

    func toggle_running() { self.set_running(!self.ignition) }

    func reset_controls() {
        self.exhaust = 0.65; self.roughness = 0.4; self.load = 0.3; self.volume = 0.7
        self.ambience = 0.06; self.base_rpm = 800.0
        self.breath = self.profile().breath
        if self.reference_mode { self.exhaust = 1.0; self.roughness = 1.0; self.load = 0.2; self.ambience = 0.0 }
    }

    func profile_index() int { return self.profile_id }
    func profile() Profile { return self.catalog.get(self.profile_id) }
    func road_mode() bool { return self.driving }
    func auto_mode() bool { return self.automatic }
    func gear() int {
        if let reference = self.reference { return reference.current_gear() }
        return 0
    }
    func speed() float {
        if let reference = self.reference { return reference.speed_kmh() }
        return 0.0
    }
    func shift_flags() int {
        if let reference = self.reference { return reference.drive_flags() }
        return 0
    }
    func shift_count() int {
        if let reference = self.reference { return reference.shift_count() }
        return 0
    }
    func can_change_vehicle() bool { return !self.ignition && self.rpm() < 5.0 && self.speed() < 0.5 }

    private func replace_reference() {
        self.reference = ReferenceClient(self.profile_id, self.profile().key, self.driving)
        self.profile_generation++; self.reference_ready = false
        self.accelerating = false; self.braking = false; self.requested_gear = 0
        self.remaining = 0; self.produced_frames = 0; self.room.reset(); self.airflow.reset()
        self.notice = ""
    }
    func select_profile(index:int) bool {
        if index < 0 || index >= self.catalog.count() { return false }
        if index == self.profile_id { return true }
        if !self.can_change_vehicle() { self.notice = "Couper le moteur et immobiliser le véhicule."; return false }
        self.profile_id = index; self.base_rpm = 800.0; self.breath = self.profile().breath
        self.replace_reference(); return true
    }
    func toggle_road() {
        if !self.reference_mode { return }
        if !self.can_change_vehicle() { self.notice = "Couper le moteur et immobiliser le véhicule."; return }
        self.driving = !self.driving; self.replace_reference()
    }
    func toggle_auto() {
        if !self.driving { self.notice = "Choisir Route pour utiliser la boîte."; return }
        self.automatic = !self.automatic; self.requested_gear = self.gear(); self.notice = ""
    }
    func shift_up() {
        if !self.driving { self.notice = "Choisir Route pour utiliser la boîte."; return }
        if self.automatic { self.requested_gear = self.gear() }
        self.automatic = false
        if self.requested_gear < self.profile().gears { self.requested_gear++ }
        self.notice = ""
    }
    func shift_down() {
        if !self.driving { self.notice = "Choisir Route pour utiliser la boîte."; return }
        if self.automatic { self.requested_gear = self.gear() }
        self.automatic = false
        if self.requested_gear > 0 { self.requested_gear-- }
        self.notice = ""
    }
    func neutral() {
        if self.driving { self.automatic = false; self.requested_gear = 0; self.notice = "" }
    }
    private func drive_mode() int {
        if self.automatic { return 1 }
        return 2
    }
    private func accept_telemetry() {
        self.reference_ready = true
    }

    private func advance() {
        var pedal = 0.0
        if self.ignition && self.accelerating && self.focused && !self.is_starting() { pedal = 1.0 }
        self.throttle += (pedal - self.throttle) * 0.16
        // Fuel controls future pressure events; already injected events ring out.
        var fuel_target = 0.0; if self.ignition { fuel_target = 1.0 }
        self.fuel += Math.clamp(fuel_target - self.fuel, -0.01 / 0.35, 0.01 / 0.6)
        if !self.ignition {
            self.target_rpm = Math.max(0.0, self.target_rpm - (1_200.0 + 0.35 * self.target_rpm) * 0.01)
        } elif self.is_starting() {
            self.target_rpm = Math.min(self.base_rpm, self.target_rpm + 1_400.0 * 0.01)
            if self.target_rpm == self.base_rpm { self.starting = false }
        } elif pedal > 0.0 {
            self.target_rpm += (1_700.0 + 1_600.0 * (1.0 - self.load)) * 0.01
        } else {
            let difference = self.base_rpm - self.target_rpm
            self.target_rpm += Math.clamp(difference, -(1_000.0 + 600.0 * self.load) * 0.01, 28.0)
        }
        self.target_rpm = Math.clamp(self.target_rpm, 0.0, 6_600.0)
        // A damped idle governor responds to small torque disturbances at 100 Hz.
        // The game-facing generator continues to use the RPM supplied by its caller.
        self.random = (self.random * 48_271) % 2_147_483_647
        let disturbance = 2.0 * ((self.random % 16_777_216) as float / 16_777_216.0) - 1.0
        self.idle_speed += (-36.0 * self.idle_offset - 8.0 * self.idle_speed + 5_000.0 * disturbance) * 0.01
        self.idle_speed = Math.clamp(self.idle_speed, -120.0, 120.0)
        self.idle_offset = Math.clamp(self.idle_offset + self.idle_speed * 0.01, -35.0, 35.0)
        let idle_weight = Math.clamp((1_800.0 - self.target_rpm) / 1_000.0, 0.0, 1.0)
        var audible_rpm = self.target_rpm
        if self.ignition && self.target_rpm >= 700.0 {
            audible_rpm += idle_weight * self.roughness * self.idle_offset
        }
        var engine_brake = 0.0
        if pedal == 0.0 && self.target_rpm > self.base_rpm + 50.0 {
            engine_brake = Math.clamp((self.target_rpm - 1_000.0) / 3_000.0, 0.0, 1.0)
        }
        // A mild ignition cut gives the limiter a distinct texture at full throttle.
        var firing_throttle = self.throttle
        if self.target_rpm >= 6_590.0 && (self.produced_frames / 2_400) % 3 == 0 { firing_throttle *= 0.25 }
        self.source.set_state(audible_rpm as float32, throttle:firing_throttle as float32,
            load:self.load as float32, engine_brake:engine_brake as float32, ramp_frames:480, fuel:self.fuel as float32)
        self.source.set_character(self.exhaust as float32, self.roughness as float32, ramp_frames:480)
    }

    private func process_output(samples:&float32[..]) {
        if self.reference_mode {
            self.airflow.mix(&samples[0:samples.count()], @self.intake[0:samples.count() / 2], self.breath)
        }
        for i in 0...samples.count() { self.room_buffer[i] = samples[i] }
        self.room.process(&self.room_buffer[0:samples.count()])
        var frame = 0
        while frame < samples.count() {
            self.gain += 0.002 * (self.volume as float32 - self.gain)
            self.ambience_gain += 0.002 * (self.ambience as float32 - self.ambience_gain)
            for channel in 0...2 {
                let index = frame + channel
                samples[index] = self.gain * ((1.0 - self.ambience_gain) * samples[index] +
                    self.ambience_gain * self.room_buffer[index])
            }
            frame += 2
        }
    }

    func request_reference(depth:int = 1) Result<void, Error> {
        if depth < 1 || depth > 4 { panic("reference request depth must be 1 to 4") }
        if var reference = self.reference {
            while reference.in_flight() < depth {
                try reference.request(480, self.ignition, self.accelerating && self.focused,
                    self.roughness, self.exhaust, self.base_rpm, self.load,
                    self.drive_mode(), self.requested_gear, self.braking && self.focused) else error {
                    return Result<void, Error>.failure(error)
                }
            }
            return Result<void, Error>.success()
        }
        return Result<void, Error>.failure(Error(kind:Kind.invalid_input(), operation:"engine-bench.request-reference",
            subject:null, detail:"reference mode required"))
    }

    func render_reference_ready(samples:&float32[..]) Result<bool, Error> {
        if samples.count() != 960 { panic("reference live blocks require 480 stereo frames") }
        if var reference = self.reference {
            let ready = try reference.render_ready(&samples[0:samples.count()], &self.intake[0:480]) else error { return Result<bool, Error>.failure(error) }
            if !ready { return Result<bool, Error>.success(false) }
            self.accept_telemetry()
            self.process_output(&samples[0:samples.count()])
            self.produced_frames += 480
            return Result<bool, Error>.success(true)
        }
        return Result<bool, Error>.success(false)
    }

    func render(samples:&float32[..]) Result<void, Error> {
        if samples.count() % 2 != 0 {
            return Result<void, Error>.failure(Error(kind:Kind.invalid_input(), operation:"engine-bench.render", subject:null, detail:"stereo frames required"))
        }
        var offset = 0
        while offset < samples.count() {
            if self.remaining == 0 {
                if !self.reference_mode { self.advance() }
                self.remaining = 480
            }
            var frames = (samples.count() - offset) / 2
            if frames > self.remaining { frames = self.remaining }
            if var reference = self.reference {
                try reference.render(&samples[offset:offset + frames * 2], &self.intake[0:frames], self.ignition,
                    self.accelerating && self.focused, self.roughness, self.exhaust, self.base_rpm, self.load,
                    self.drive_mode(), self.requested_gear, self.braking && self.focused) else error {
                    return Result<void, Error>.failure(error)
                }
            } else {
                try self.source.render(&samples[offset:offset + frames * 2]) else error {
                    return Result<void, Error>.failure(error)
                }
            }
            if self.reference_mode { self.accept_telemetry() }
            self.process_output(&samples[offset:offset + frames * 2])
            self.remaining -= frames; self.produced_frames += frames; offset += frames * 2
        }
        return Result<void, Error>.success()
    }

    func reset() {
        if self.reference_mode { self.replace_reference() }
        self.source.reset(); self.target_rpm = 800.0; self.throttle = 0.0
        self.remaining = 0; self.produced_frames = 0; self.accelerating = false
        self.gain = self.volume as float32
        self.ambience_gain = self.ambience as float32; self.room.reset(); self.airflow.reset()
        self.idle_offset = 0.0; self.idle_speed = 0.0; self.random = 73
        self.ignition = self.initially_running; self.starting = false; self.fuel = 1.0
        if !self.initially_running {
            self.target_rpm = 0.0; self.fuel = 0.0
            self.source.set_state(0.0, ramp_frames:0, fuel:0.0)
        }
    }
}
