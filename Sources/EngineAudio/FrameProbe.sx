use STD.Math
use STD.Time.Stopwatch

// One measurement per update/drawing only when --frame-profile is enabled.
public class FrameProbe {
    let enabled:bool
    private var interval:Stopwatch
    private var intervals:float[] = []
    private var feeds:float[] = []
    private var drawings:float[] = []
    private var warmed:bool = false

    init(enabled:bool = false) { self.enabled = enabled }

    func begin(elapsed:float) {
        if !self.enabled { return }
        self.warmed = elapsed >= 0.5
        if self.interval.is_running() && self.warmed { self.intervals.append(self.interval.get_elapsed_milliseconds()) }
        self.interval.restart()
    }
    func feed(milliseconds:float) { if self.enabled && self.warmed { self.feeds.append(milliseconds) } }
    func drawing(milliseconds:float) { if self.enabled && self.warmed { self.drawings.append(milliseconds) } }

    private func report_series(name:str, values:float[]) {
        if values.count() == 0 { return }
        var sorted = values
        var sum = 0.0
        for value in values { sum += value }
        var index = 1
        while index < sorted.count() {
            let value = sorted[index]; var cursor = index
            while cursor > 0 && sorted[cursor - 1] > value {
                sorted[cursor] = sorted[cursor - 1]; cursor--
            }
            sorted[cursor] = value; index++
        }
        let last = sorted.count() - 1
        print("FRAME_PROFILE ", name, " count=", sorted.count(), " mean_ms=", sum / sorted.count() as float,
            " median_ms=", sorted[last / 2], " p95_ms=", sorted[Math.floor(last as float * 0.95) as int],
            " p99_ms=", sorted[Math.floor(last as float * 0.99) as int], " max_ms=", sorted[last])
    }

    func report() {
        if !self.enabled { return }
        self.report_series("interval", self.intervals)
        self.report_series("feed", self.feeds)
        self.report_series("drawing", self.drawings)
    }
}
