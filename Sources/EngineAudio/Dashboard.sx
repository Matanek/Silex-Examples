use GFX.Canvas
use GFX.Color
use GFX.Input.Keyboard
use GFX.UI
use STD.Math
use Module.Model.Bench
use Module.Tachometer.Tachometer
use Module.FleetDashboard
use Module.Widgets.label
use Module.Widgets.control

class Controls {
    private var bench:Bench
    private var exhaust:UI.State<float>
    private var roughness:UI.State<float>
    private var load:UI.State<float>
    private var volume:UI.State<float>
    private var ambience:UI.State<float>

    init(bench:Bench) {
        self.bench = bench
        self.exhaust = UI.State<float>(bench.exhaust); self.roughness = UI.State<float>(bench.roughness)
        self.load = UI.State<float>(bench.load); self.volume = UI.State<float>(bench.volume)
        self.ambience = UI.State<float>(bench.ambience)
    }

    func change_exhaust(value:float) { self.bench.exhaust = value }
    func change_roughness(value:float) { self.bench.roughness = value }
    func change_load(value:float) { self.bench.load = value }
    func change_volume(value:float) { self.bench.volume = value }
    func change_ambience(value:float) { self.bench.ambience = value }
    func idle() { self.bench.base_rpm = 800.0 }
    func low() { self.bench.base_rpm = 1_000.0 }
    func high() { self.bench.base_rpm = 1_500.0 }
    func toggle_engine() { self.bench.toggle_running() }
    func restore() {
        self.bench.reset_controls()
        self.exhaust.set(self.bench.exhaust); self.roughness.set(self.bench.roughness)
        self.load.set(self.bench.load); self.volume.set(self.bench.volume)
        self.ambience.set(self.bench.ambience)
    }

    func view(automated:bool) UI.View {
        var bench = self.bench
        var idle = UI.Button("800", self.idle)
        var low = UI.Button("1 000", self.low)
        var high = UI.Button("1 500", self.high)
        var buttons:UI.Button[] = [idle, low, high]
        for var button in buttons {
            button.style.height = 34.0; button.style.grow = 1.0
            button.style.background = Color.slate_700(); button.style.foreground = Color.slate_100()
        }
        let presets:UI.View[] = [buttons[0], buttons[1], buttons[2]]
        var speeds = UI.Row(presets); speeds.style.gap = 8.0
        var power = UI.Button("Démarrer / Arrêter · M", self.toggle_engine)
        power.style.height = 38.0; power.style.radius = 8.0
        power.style.background = Color.amber_700(); power.style.foreground = Color.slate_100()
        var reset = UI.Button("Réglages initiaux", self.restore)
        reset.style.height = 40.0; reset.style.radius = 8.0
        reset.style.background = Color.slate_700(); reset.style.foreground = Color.slate_100()
        var badge = label("BANC D'ÉCOUTE  /  PROTOTYPE", 11.0, Color.amber_300())
        var title_text = "Moteur V8"
        var subtitle = "Deux échappements. Aucune boucle audio."
        var exhaust_caption = "Échappement · feutré → ouvert"
        var texture_caption = "Texture · régulier → rugueux"
        if bench.reference_mode {
            title_text = "Chevrolet 454"
            subtitle = "Simulation originale engine-sim · V8 7,4 L"
            exhaust_caption = "Échappement · brut → filtré"
            texture_caption = "Texture · pression → écoulement"
            badge = label("RÉFÉRENCE  /  ENGINE-SIM", 11.0, Color.amber_300())
        }
        var title = label(title_text, 30.0, Color.slate_100())
        title.style.font_weight = UI.FontWeight.bold
        var rpm_caption = "Régime au relâchement · tr/min"
        if bench.reference_mode { rpm_caption = "Ralenti libre / banc à 1 000 ou 1 500" }
        let controls:UI.View[] = [badge, title,
            label(subtitle, 12.0, Color.slate_400()), power,
            control(exhaust_caption, self.exhaust, self.change_exhaust),
            control(texture_caption, self.roughness, self.change_roughness),
            control("Charge du moteur", self.load, self.change_load),
            control("Réverbe courte · sec → ambiance", self.ambience, self.change_ambience, maximum:0.2),
            control("Volume", self.volume, self.change_volume), reset,
            label(rpm_caption, 11.0, Color.slate_400()), speeds]
        var panel = UI.Column(controls); panel.style.width = 330.0; panel.style.gap = 10.0
        panel.style.padding = UI.Insets(22.0); panel.style.background = Color.bytes(20, 28, 38)
        panel.style.radius = 18.0
        var dial = UI.CustomView(Tachometer(bench)); dial.style.grow = 1.0
        let body:UI.View[] = [dial, panel]
        var row = UI.Row(body, alignment:UI.Alignment.center); row.style.gap = 24.0
        var instruction = "M : démarrer / arrêter · ESPACE : accélérer · Relâcher : décélérer"
        if automated { instruction = "SCÉNARIO AUTOMATIQUE — démarrage, accélération, arrêt" }
        var hint = label(instruction, 14.0, Color.amber_200())
        hint.style.padding = UI.Insets(vertical:12.0, horizontal:18.0)
        hint.style.background = Color.bytes(36, 33, 27); hint.style.radius = 10.0
        let children:UI.View[] = [row, hint]
        var root = UI.Column(children); root.style.gap = 14.0; root.style.padding = UI.Insets(24.0)
        root.style.background = Color.bytes(8, 13, 20)
        return root
    }
}

public func dashboard(bench:Bench, automated:bool = false) UI.View {
    if bench.reference_mode { return FleetDashboard.dashboard(bench, automated) }
    var controls = Controls(bench)
    return controls.view(automated)
}
