use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.Math

// A diffuse intake/exhaust bed. Pressure transients remain the native simulator's.
public class Airflow {
    private var noise:Synthesis.WhiteNoise
    private var color:Processing.Equalizer
    private var buffer:float32[] = []
    private var gain:float32 = 0.0
    private let smoothing:float32

    init(format:Processing.Format) {
        self.noise = Synthesis.WhiteNoise.create(format, seed:8401)
        self.color = Processing.Equalizer.create(format, low_hz:300.0, high_hz:3_000.0,
            low_gain:0.0, mid_gain:1.0, high_gain:0.15)
        self.smoothing = (1.0 - Math.exp(-1.0 / (0.09 * format.sample_rate as float))) as float32
        for _ in 0...960 { self.buffer.append(0.0) }
    }

    func mix(samples:&float32[..], amount:float, rpm:float, accelerating:bool, ignition:bool) {
        assert(samples.count() <= 960 && samples.count() % 2 == 0)
        var target = Math.clamp(amount, 0.0, 1.0) * Math.clamp(rpm / 1_500.0, 0.0, 1.0)
        if accelerating { target = Math.min(1.0, target * 1.6) }
        if !ignition { target *= 0.25 }
        if target == 0.0 && self.gain == 0.0 { return }
        self.noise.render(&self.buffer[0:samples.count()])
        self.color.process(&self.buffer[0:samples.count()])
        var frame = 0
        while frame < samples.count() {
            self.gain += self.smoothing * (target as float32 - self.gain)
            if target == 0.0 && self.gain < 0.000001 { self.gain = 0.0 }
            for channel in 0...2 {
                let i = frame + channel
                // This split-band noise is bounded by ±2. Scale before mixing into
                // available headroom; never attenuate or clip the pressure attack.
                let headroom = Math.max(0.0, 0.98 - Math.abs(samples[i] as float)) as float32
                samples[i] += self.buffer[i] * 0.5 * self.gain * headroom
            }
            frame += 2
        }
    }

    func reset() { self.noise.reset(); self.color.reset(); self.gain = 0.0 }
}
