use GFX.Color
use GFX.UI
use STD.Math

public func label(value:str, size:float, color:Color) UI.Text {
    var text = UI.Text(value)
    text.style.font_size = size; text.style.foreground = color
    return text
}

func percent(value:float) str { return "$(Math.round(value * 100.0) as int) %" }

public func control(caption:str, value:UI.State<float>, action:func(float), maximum:float = 1.0) UI.Column {
    var current = UI.Text(value, format:percent)
    current.style.foreground = Color.slate_400(); current.style.font_size = 12.0
    var name = label(caption, 13.0, Color.slate_200()); name.style.grow = 1.0
    let heading:UI.View[] = [name, current]
    var slider = UI.Slider(value, 0.0, maximum, action)
    slider.style.height = 26.0; slider.style.accent = Color.amber_400()
    slider.style.background = Color.slate_700()
    let children:UI.View[] = [UI.Row(heading), slider]
    var result = UI.Column(children); result.style.gap = 8.0
    return result
}
