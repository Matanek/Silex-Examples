use GFX.Audio.Synthesis
use GFX.Input.Events
use GFX.Input.Keyboard
use GFX.Window
use STD.Math
use STD.Time
use STD.Time.Stopwatch
use Module.Model.Bench
use Module.Session.BenchSession

func zeros(count:int) float32[] {
    var values:float32[] = []
    for _ in 0...count { values.append(0.0) }
    return values
}

func key(down:bool, repeated:bool = false) Events.Event {
    let value = Events.KeyEvent(window:Window.Id(value:1 as uint32), keyboard:Keyboard.KeyboardId(value:0 as uint32),
        key:Keyboard.Key.space, keycode:32 as uint32, raw:44 as uint16,
        repeated:repeated, modifiers:Keyboard.Modifiers(), timestamp:Events.Timestamp(nanoseconds:0 as uint))
    if down { return Events.Event.key_pressed(value) }
    return Events.Event.key_released(value)
}

func ignition_key(repeated:bool = false) Events.Event {
    let value = Events.KeyEvent(window:Window.Id(value:1 as uint32), keyboard:Keyboard.KeyboardId(value:0 as uint32),
        key:Keyboard.Key.m, keycode:109 as uint32, raw:16 as uint16,
        repeated:repeated, modifiers:Keyboard.Modifiers(), timestamp:Events.Timestamp(nanoseconds:0 as uint))
    return Events.Event.key_pressed(value)
}

func verify_ignition() {
    var bench = Bench(running:false); var session = BenchSession(bench)
    var samples = zeros(960)
    session.handle(key(true)); assert(!bench.accelerating && !bench.is_running())
    for _ in 0...20 {
        bench.render(&samples[0:samples.count()])
        for sample in samples { assert(sample == 0.0) }
    }
    assert(bench.rpm() == 0.0)
    session.handle(ignition_key(repeated:true)); assert(!bench.is_running())
    session.handle(ignition_key()); assert(bench.is_running() && bench.is_starting() && !bench.accelerating)
    session.handle(ignition_key(repeated:true)); assert(bench.is_running())
    var energy:float64 = 0.0
    for _ in 0...100 {
        bench.render(&samples[0:samples.count()])
        for sample in samples { energy += sample as float64 * sample as float64 }
    }
    assert(energy > 0.1 && !bench.is_starting() && Math.abs(bench.rpm() - 800.0) < 35.0)
    session.handle(key(true))
    var running_energy:float64 = 0.0
    for block in 0...100 {
        bench.render(&samples[0:samples.count()])
        if block >= 80 {
            for sample in samples { running_energy += sample as float64 * sample as float64 }
        }
    }
    assert(bench.rpm() > 3_000.0)
    session.handle(ignition_key()); assert(!bench.is_running() && !bench.accelerating)
    bench.render(&samples[0:samples.count()])
    var tail:float64 = 0.0
    for sample in samples { tail += Math.abs(sample as float64) }
    assert(tail > 0.01, "ignition cut discarded the acoustic tail")
    var residual_energy:float64 = 0.0
    for block in 1...15 {
        bench.render(&samples[0:samples.count()])
        if block >= 10 {
            for sample in samples { residual_energy += sample as float64 * sample as float64 }
        }
    }
    assert(residual_energy * 4.0 > running_energy * 0.05,
        "shutdown muted the remaining combustions too quickly")
    for _ in 0...300 { bench.render(&samples[0:samples.count()]) }
    assert(bench.rpm() == 0.0)
    for sample in samples { assert(Math.abs(sample) < 0.000001, "engine failed to become silent") }
    bench.reset_controls(); assert(!bench.is_running())
    session.handle(key(true, repeated:true)); assert(!bench.accelerating)
    session.handle(ignition_key()); assert(bench.is_running() && !bench.accelerating)
    session.handle(key(true, repeated:true)); assert(!bench.accelerating)
    for _ in 0...100 { bench.render(&samples[0:samples.count()]) }
    session.handle(key(true)); assert(bench.accelerating)

    // Ignition ramps and the room retain identical PCM across arbitrary splits.
    var whole = Bench(running:false); var split = Bench(running:false)
    whole.toggle_running(); split.toggle_running()
    var a = zeros(96_000); var b = zeros(96_000)
    whole.render(&a[0:a.count()])
    split.render(&b[0:514]); split.render(&b[514:4_018]); split.render(&b[4_018:b.count()])
    for i, sample in a.indexed() { assert(sample == b[i]) }
    whole.toggle_running(); split.toggle_running()
    whole.render(&a[0:a.count()])
    split.render(&b[0:1_002]); split.render(&b[1_002:b.count()])
    for i, sample in a.indexed() { assert(sample == b[i]) }
    bench.reset(); assert(!bench.is_running() && bench.rpm() == 0.0)
    print("Ignition checks passed: silence, M/repeat, startup, residual combustion, stop tail, restart and block continuity")
}

public func verify() {
    verify_ignition()
    var bench = Bench(); var session = BenchSession(bench)
    assert(session.handle(key(true, repeated:true)) && !bench.accelerating)
    assert(session.handle(key(true)) && bench.accelerating)
    var samples = zeros(960)
    for _ in 0...100 { bench.render(&samples[0:samples.count()]) }
    assert(bench.rpm() > 3_000.0 && bench.rpm() < 4_000.0)
    session.handle(key(false)); assert(!bench.accelerating)
    for _ in 0...300 { bench.render(&samples[0:samples.count()]) }
    assert(Math.abs(bench.rpm() - 800.0) < 35.0)
    session.handle(key(true))
    let window = Events.WindowEvent(window:Window.Id(value:1 as uint32), timestamp:Events.Timestamp(nanoseconds:0 as uint))
    session.handle(Events.Event.window_focus_lost(window))
    assert(!bench.accelerating && !bench.focused)
    session.handle(key(true)); assert(!bench.accelerating)
    session.handle(Events.Event.window_focus_gained(window))
    session.handle(key(true, repeated:true)); assert(!bench.accelerating)
    session.handle(key(true)); assert(bench.accelerating)
    session.handle(key(false))
    var drawing = session.drawing(1_080, 820)
    assert(drawing.command_count() > 10)
    bench.load = 1.0; bench.exhaust = 0.0; bench.roughness = 1.0; bench.ambience = 0.2
    bench.base_rpm = 1_500.0
    bench.reset_controls(); assert(bench.load == 0.3 && bench.exhaust == 0.65)
    assert(bench.ambience == 0.06 && bench.base_rpm == 800.0)

    // The bench's 10 ms control clock, too, is independent of render block size.
    bench.reset(); bench.accelerating = true
    var expected = zeros(192_000); bench.render(&expected[0:expected.count()])
    bench.reset(); bench.accelerating = true
    var actual = zeros(192_000)
    bench.render(&actual[0:514]); bench.render(&actual[514:4_018]); bench.render(&actual[4_018:actual.count()])
    var maximum:float32 = 0.0
    for i, sample in actual.indexed() {
        assert(sample == expected[i] && Math.is_finite(sample))
        maximum = Math.max(maximum, Math.abs(sample)) as float32
    }
    assert(maximum > 0.01 && maximum <= 0.4)
    var idle = Bench()
    var minimum = 800.0; var maximum_rpm = 800.0
    for _ in 0...1_200 {
        idle.render(&samples[0:samples.count()])
        minimum = Math.min(minimum, idle.rpm()); maximum_rpm = Math.max(maximum_rpm, idle.rpm())
    }
    assert(minimum > 765.0 && maximum_rpm < 835.0 && maximum_rpm - minimum > 10.0,
        "idle variation must be present and bounded")
    idle.roughness = 0.0
    for _ in 0...10 { idle.render(&samples[0:samples.count()]) }
    assert(idle.rpm() == 800.0)
    idle.base_rpm = 1_500.0
    for _ in 0...100 { idle.render(&samples[0:samples.count()]) }
    assert(idle.rpm() == 1_500.0)

    var dry = Bench(); dry.ambience = 0.0; dry.reset()
    var wet = Bench(); wet.ambience = 0.2; wet.reset()
    var a = zeros(48_000); var b = zeros(48_000)
    dry.render(&a[0:a.count()]); wet.render(&b[0:b.count()])
    var difference:float64 = 0.0
    for i, sample in a.indexed() {
        assert(Math.is_finite(b[i]) && Math.abs(b[i]) < 1.0)
        difference += Math.abs(sample as float64 - b[i] as float64)
    }
    assert(difference > 0.1, "room mix did not change the rendered signal")
    print("Engine bench checks passed: input, focus, held RPM, bounded idle variation, room mix, drawing and block continuity")
    print("Idle RPM range: ", minimum, " .. ", maximum_rpm)
}

public func measure() {
    var source = Synthesis.Engine.create()
    var samples = zeros(960)
    for _ in 0...100 { source.render(&samples[0:samples.count()]) }
    // Output raw observations; report percentiles outside the timed section.
    var elapsed:int[] = []
    var timer = Stopwatch()
    for block in 0...1_000 {
        source.set_state(800.0 + (block % 500) as float32 * 11.0, throttle:0.8, load:0.6)
        timer.restart()
        source.render(&samples[0:samples.count()])
        timer.stop()
        let duration = Math.round(timer.get_elapsed_seconds() * 1_000_000.0) as int
        elapsed.append(duration)
    }
    for duration in elapsed { print("render_us ", duration) }
    assert(Math.is_finite(samples[479]))
}
