use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.File
use STD.Math
use Module.Model.Bench

func word(bytes:&uint8[], value:int, count:int) {
    var remaining = value
    for _ in 0...count { bytes.append((remaining % 256) as uint8); remaining /= 256 }
}

public func render_wav(path:str, variant:str = "full") {
    var bench = Bench()
    if variant == "smooth" { bench.exhaust = 0.0; bench.roughness = 0.0 }
    if variant == "dry" || variant == "idle-dry" || variant == "regular" { bench.ambience = 0.0 }
    if variant == "regular" { bench.roughness = 0.0 }
    // Start comparisons at their requested mix, without an initial wet transition.
    bench.reset()
    var sine = Synthesis.Oscillator.create(Processing.Format(sample_rate:48_000, channels:2), frequency_hz:53.3333, amplitude:0.1)
    let frames = 48_000 * 12
    var bytes:uint8[] = [82 as uint8, 73 as uint8, 70 as uint8, 70 as uint8]
    word(bytes, 36 + frames * 4, 4)
    for byte in [87, 65, 86, 69, 102, 109, 116, 32] { bytes.append(byte as uint8) }
    word(bytes, 16, 4); word(bytes, 1, 2); word(bytes, 2, 2)
    word(bytes, 48_000, 4); word(bytes, 48_000 * 4, 4); word(bytes, 4, 2); word(bytes, 16, 2)
    for byte in [100, 97, 116, 97] { bytes.append(byte as uint8) }
    word(bytes, frames * 4, 4)
    var samples:float32[] = []; for _ in 0...960 { samples.append(0.0) }
    for block in 0...1_200 {
        bench.accelerating = block >= 100 && block < 500
        if variant == "idle" || variant == "idle-dry" || variant == "regular" {
            bench.accelerating = false
            bench.base_rpm = 800.0
            if block >= 400 { bench.base_rpm = 1_000.0 }
            if block >= 800 { bench.base_rpm = 1_500.0 }
        }
        bench.render(&samples[0:samples.count()])
        if variant == "sine" {
            sine.set_frequency((bench.rpm() * 8.0 / 120.0) as float32)
            sine.render(&samples[0:samples.count()])
        }
        for sample in samples {
            var integer = Math.round(Math.clamp(sample, -1.0, 1.0) * 32_767.0) as int
            if integer < 0 { integer += 65_536 }
            word(bytes, integer, 2)
        }
    }
    File.write_all(path, @bytes[0:bytes.count()])
    print("Engine audio WAV: ", path, " (12 s, stereo 48000 Hz, ", variant, ")")
}
