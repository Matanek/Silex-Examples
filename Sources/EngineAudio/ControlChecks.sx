use Module.Model.Bench

use STD.Time.Stopwatch

func request(bench:Bench,depth:int) {
    match (try bench.request_reference(depth)) {
        failure(error) => { panic(error.operation+": "+error.detail) }
        success => {}
    }
}
func consume(bench:Bench,samples:&float32[..],count:int) {
    for _ in 0...count {
        var watch = Stopwatch(); watch.start()
        var received = false
        while !received {
            assert(watch.get_elapsed_seconds() < 5.0,"asynchronous reply timeout")
            match (try bench.render_reference_ready(&samples[0:samples.count()])) {
                failure(error) => { panic(error.operation+": "+error.detail) }
                success(ready) => { received = ready }
            }
        }
    }
}
func advance(bench:Bench,samples:&float32[..],count:int,asynchronous:bool) {
    var remaining = count
    while remaining > 0 {
        if asynchronous {
            var depth = remaining; if depth > 4 { depth = 4 }
            request(bench,depth); consume(bench,&samples[0:samples.count()],depth)
            remaining -= depth
        } else {
            match (try bench.render(&samples[0:samples.count()])) {
                failure(error) => { panic(error.operation+": "+error.detail) }
                success => {}
            }
            remaining--
        }
    }
}
func verify_mode(asynchronous:bool) {
    var bench = Bench(running:false,reference:true); bench.toggle_road()
    var samples:float32[] = []; for _ in 0...960 { samples.append(0.0) }
    bench.set_running(true); advance(bench,&samples[0:960],250,asynchronous)
    bench.accelerating = true; advance(bench,&samples[0:960],2400,asynchronous)
    assert(bench.speed() > 100.0 && bench.gear() >= 3,"moving road setup")
    let moving = bench.speed(); bench.set_running(false)
    assert(!bench.is_running() && bench.speed() == moving,"ignition cuts before vehicle stops")
    advance(bench,&samples[0:960],10,asynchronous)
    assert(!bench.is_running() && bench.speed() > 60.0 && bench.rpm() > 0.0,"coast with ignition off")
    bench.set_running(true); advance(bench,&samples[0:960],40,asynchronous)
    bench.neutral(); advance(bench,&samples[0:960],50,asynchronous)
    assert(bench.gear() == 0 && bench.speed() > 60.0,"rolling neutral")
    bench.shift_up(); advance(bench,&samples[0:960],40,asynchronous)
    assert(bench.gear() == 0 && bench.shift_flags() >= 2,"unsafe first gear stays rejected")
    var attempts = 0
    while bench.gear() == 0 && attempts < bench.profile().gears {
        if asynchronous { request(bench,4) }
        bench.shift_up()
        if asynchronous { consume(bench,&samples[0:960],4) }
        advance(bench,&samples[0:960],40,asynchronous); attempts++
    }
    assert(bench.gear() > 1,"higher safe gear must remain reachable after neutral")
    assert(bench.speed() > 50.0 && !bench.auto_mode(),"reengagement preserves motion and manual mode")
    bench.neutral(); advance(bench,&samples[0:960],50,asynchronous)
    bench.shift_up(); advance(bench,&samples[0:960],40,asynchronous)
    assert(bench.gear() == 0 && bench.shift_flags() >= 2,"first remains unsafe at speed")
    bench.accelerating = false; bench.braking = true
    advance(bench,&samples[0:960],700,asynchronous)
    assert(bench.speed() < 0.5 && bench.gear() == 0,"rejected command must not engage later")
    bench.neutral(); advance(bench,&samples[0:960],2,asynchronous)
    bench.shift_up(); advance(bench,&samples[0:960],40,asynchronous)
    assert(bench.gear() == 1,"fresh first gear command works after stopping")
    print("Asynchronous: ", asynchronous)
    print("Control checks passed: ignition-off coast, neutral, protected first, safe reengagement, no deferred shift")
}

public func verify() { verify_mode(false); verify_mode(true) }
