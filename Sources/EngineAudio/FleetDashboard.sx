use GFX.Color
use GFX.UI
use Module.Model.Bench
use Module.Tachometer.Tachometer
use Module.Widgets.label
use Module.Widgets.control

class Controls {
    private var bench:Bench
    private var selection:UI.State<int?>
    private var exhaust:UI.State<float>
    private var roughness:UI.State<float>
    private var load:UI.State<float>
    private var volume:UI.State<float>
    private var ambience:UI.State<float>

    init(bench:Bench) {
        self.bench = bench; self.selection = UI.State<int?>(bench.profile_index())
        self.exhaust = UI.State<float>(bench.exhaust); self.roughness = UI.State<float>(bench.roughness)
        self.load = UI.State<float>(bench.load); self.volume = UI.State<float>(bench.volume)
        self.ambience = UI.State<float>(bench.ambience)
    }
    func select(value:int) { self.bench.select_profile(value); self.selection.set(self.bench.profile_index()) }
    func change_exhaust(value:float) { self.bench.exhaust = value }
    func change_roughness(value:float) { self.bench.roughness = value }
    func change_load(value:float) { self.bench.load = value }
    func change_volume(value:float) { self.bench.volume = value }
    func change_ambience(value:float) { self.bench.ambience = value }
    func restore() {
        self.bench.reset_controls()
        self.exhaust.set(self.bench.exhaust); self.roughness.set(self.bench.roughness)
        self.load.set(self.bench.load); self.volume.set(self.bench.volume); self.ambience.set(self.bench.ambience)
    }
    func idle() { self.bench.base_rpm = 800.0 }
    func low() { self.bench.base_rpm = 1_000.0 }
    func high() { self.bench.base_rpm = 1_500.0 }
    private func button(text:str, action:func()) UI.Button {
        var result = UI.Button(text, action)
        result.style.height = 36.0; result.style.radius = 7.0; result.style.grow = 1.0
        result.style.background = Color.slate_700(); result.style.foreground = Color.slate_100()
        return result
    }
    func view(automated:bool) UI.View {
        var bench = self.bench
        var options:UI.SelectOption<int>[] = []
        for i in 0...bench.catalog.count() { options.append(UI.SelectOption<int>(i, bench.catalog.get(i).label)) }
        var select = UI.Select<int>(options, self.selection, self.select, popup_height:250.0)
        select.style.height = 40.0; select.style.font_size = 13.0
        select.style.foreground = Color.slate_100(); select.style.background = Color.slate_700()
        select.style.accent = Color.amber_700()
        select.popup_style.foreground = Color.slate_100(); select.popup_style.background = Color.slate_800()
        select.popup_style.accent = Color.amber_700()
        select.style.width = 350.0; select.popup_style.width = 400.0
        var power = self.button("Démarrer / Arrêter · M", bench.toggle_running)
        power.style.background = Color.amber_700()
        let gear_buttons:UI.View[] = [self.button("− · ↓", bench.shift_down),
            self.button("N", bench.neutral), self.button("+ · ↑", bench.shift_up)]
        var gears = UI.Row(gear_buttons); gears.style.gap = 8.0
        let rpm_buttons:UI.View[] = [self.button("Libre", self.idle), self.button("1 000", self.low), self.button("1 500", self.high)]
        var speeds = UI.Row(rpm_buttons); speeds.style.gap = 8.0
        let controls:UI.View[] = [label("BANC VÉHICULES", 26.0, Color.slate_100()),
            label("Moteur arrêté + véhicule immobile pour changer", 10.0, Color.slate_400()), select,
            self.button("Banc libre ⇄ Route", bench.toggle_road),
            label("Banc : écoute libre · Route : boîte + véhicule", 11.0, Color.slate_400()),
            power, self.button("Boîte automatique ⇄ manuelle · A", bench.toggle_auto), gears,
            label("En route : S maintenu pour freiner", 12.0, Color.amber_200()),
            control("Échappement · brut → filtré", self.exhaust, self.change_exhaust),
            control("Texture · pression → écoulement", self.roughness, self.change_roughness),
            control("Charge supplémentaire · banc uniquement", self.load, self.change_load),
            control("Réverbe courte", self.ambience, self.change_ambience, maximum:0.2),
            control("Volume", self.volume, self.change_volume),
            label("Régime maintenu · banc uniquement", 11.0, Color.slate_400()), speeds,
            self.button("Réglages initiaux", self.restore)]
        var panel = UI.Column(controls); panel.style.gap = 10.0; panel.style.padding = UI.Insets(20.0)
        var scroll = UI.ScrollView(panel); scroll.style.width = 390.0; scroll.style.height = 740.0
        scroll.style.background = Color.bytes(20, 28, 38); scroll.style.radius = 18.0
        var dial = UI.CustomView(Tachometer(bench)); dial.style.grow = 1.0
        let body:UI.View[] = [dial, scroll]
        var row = UI.Row(body, alignment:UI.Alignment.center); row.style.gap = 20.0
        var instruction = "M : contact · ESPACE : gaz · S : frein · A : auto / manuel · ↑ / ↓ : rapports · N : point mort"
        if automated { instruction = "SCÉNARIO AUTOMATIQUE — démarrage, accélération, arrêt" }
        var hint = label(instruction, 12.0, Color.amber_200())
        hint.style.padding = UI.Insets(vertical:12.0, horizontal:12.0)
        hint.style.background = Color.bytes(36, 33, 27); hint.style.radius = 10.0
        let children:UI.View[] = [row, hint]
        var root = UI.Column(children); root.style.gap = 14.0; root.style.padding = UI.Insets(24.0)
        root.style.background = Color.bytes(8, 13, 20)
        return root
    }
}

public func dashboard(bench:Bench, automated:bool) UI.View {
    var controls = Controls(bench)
    return controls.view(automated)
}
