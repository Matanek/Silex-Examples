use GFX.Audio
use GFX.Audio.Synthesis
use GFX.Color
use GFX.Viewer
use STD.Process
use Module.Model.Bench
use Module.Session.BenchSession
use Module.Checks
use Module.Offline
use Module.ReferenceChecks
use Module.Live
use Module.FleetChecks
use Module.AirflowChecks
use Module.ControlChecks

func main() {
    let arguments = Process.arguments()
    var smoke = false
    var reference = false
    var profile = false
    var preset = "454"
    var road = false
    var manual = false
    var index = 1
    while index < arguments.count() {
        let argument = arguments[index]
        if argument == "--control-check" { ControlChecks.verify(); return }
        elif argument == "--airflow-check" { AirflowChecks.verify(); return }
        elif argument == "--airflow-render" {
            index++; if index >= arguments.count() { panic("--airflow-render requires a WAV path") }
            let path = arguments[index]; var dry = false
            if index + 1 < arguments.count() {
                if arguments[index + 1] != "dry" { panic("--airflow-render accepts optional dry") }
                dry = true
            }
            AirflowChecks.render(path, dry); return
        }
        elif argument == "--fleet-check" { FleetChecks.verify(); return }
        elif argument == "--check" { Checks.verify(); return }
        elif argument == "--measure" { Checks.measure(); return }
        elif argument == "--reference-async-check" { ReferenceChecks.verify_async(); return }
        elif argument == "--reference-check" { ReferenceChecks.verify(); return }
        elif argument == "--reference-render" {
            index++; if index >= arguments.count() { panic("--reference-render requires a WAV path") }
            ReferenceChecks.verify(arguments[index]); return
        }
        elif argument == "--render" {
            index++; if index >= arguments.count() { panic("--render requires a WAV path") }
            let path = arguments[index]; var variant = "full"
            if index + 1 < arguments.count() { variant = arguments[index + 1] }
            if variant != "full" && variant != "smooth" && variant != "sine" &&
                variant != "dry" && variant != "idle" && variant != "idle-dry" && variant != "regular" && variant != "ignition" {
                panic("Choose full, smooth, sine, dry, idle, idle-dry, regular or ignition")
            }
            Offline.render_wav(path, variant); return
        }
        elif argument == "--smoke" { smoke = true }
        elif argument == "--road" { road = true; reference = true }
        elif argument == "--manual" { manual = true; road = true; reference = true }
        elif argument == "--preset" {
            index++; if index >= arguments.count() { panic("--preset requires a profile key") }
            preset = arguments[index]; reference = true
        }
        elif argument == "--reference" { reference = true }
        elif argument == "--frame-profile" { profile = true }
        elif argument == "--help" {
            print("Engine audio bench: M toggles ignition; hold SPACE to accelerate; release to return to the selected RPM.")
            print("--preset 454|berline|sport|cruiser|moto|truck|cross4|cross2 | --road | --manual")
            print("--airflow-check | --airflow-render output.wav [dry]")
            print("--control-check | --fleet-check | --reference | --reference-check | --reference-render output.wav | --frame-profile")
            print("--check | --measure | --render output.wav [full|smooth|sine|dry|idle|idle-dry|regular|ignition] | --smoke")
            return
        } else { panic("Unknown option; use --help") }
        index++
    }

    if reference { Live.show_reference(smoke, profile, preset, road, manual); return }

    var bench = Bench(running:false)
    var audio = Audio()
    var producer = Synthesis.StreamProducer.create(audio, bench, 9_223_372_036_854_775_807,
        block_frames:480, capacity_frames:2_880)
    for _ in 0...6 { producer.pump() }
    var playing = Audio.PlayingSound()
    var empty_observations = 0
    var session = BenchSession(bench, func() {
        // Window setup may exceed the prefill; start only once the host is ready to update.
        if !playing.is_valid() { playing = audio.play(producer.stream(), Audio.Playback(fade_in_seconds:0.05)) }
        let initial = audio.stream_info(producer.stream())
        if initial.starved { empty_observations++ }
        var iteration = 0
        while iteration < 8 {
            let info = audio.stream_info(producer.stream())
            if info.queued_frames >= info.capacity_frames { break }
            producer.pump(); iteration++
        }
    }, automated:smoke, profile:profile)
    var title = "GFX.Audio — Banc moteur V8 · M : contact · Espace : gaz"
    if smoke { title = "GFX.Audio — Scénario automatique moteur V8" }
    let settings = Viewer.CanvasSettings(width:1_080, height:820, title:title,
        background:Color.bytes(8, 13, 20))
    if smoke {
        Viewer.show_until(session, func() bool { return session.elapsed >= 5.0 }, settings)
    } else { Viewer.show(session, settings) }
    session.report_frames()
    if playing.is_valid() { audio.stop(playing, fade_out_seconds:0.0) }
    audio.release(producer.stream())
    print("Engine bench closed; empty stream observations: ", empty_observations,
        "; generated frames: ", bench.produced_frames)
}
