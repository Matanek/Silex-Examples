use GFX.Audio.Engines
use STD.Process
use STD.Math
use Module.Model.Bench

// The original autonomous bench is the oracle, never an implementation dependency.
func main() {
    let arguments = Process.arguments()
    var directory = "Build/EngineLibrary"
    if arguments.count() > 1 { directory = arguments[1] }
    var library = Engines.Library.open(directory)
    var expected:float32[] = []; var actual:float32[] = []
    for _ in 0...960 { expected.append(0.0); actual.append(0.0) }
    for index, profile in library.profiles().indexed() {
        var bench = Bench(running:false, reference:true); assert(bench.select_profile(index))
        var engine = library.engine(profile.key)
        var controls = engine.controls()
        for block in 0...650 {
            if block == 20 { bench.set_running(true); controls.running = true }
            if block == 220 { bench.accelerating = true; controls.accelerating = true }
            if block == 350 { bench.accelerating = false; controls.accelerating = false }
            if block == 380 { bench.exhaust = 0.4; controls.exhaust = 0.4 }
            if block == 400 { bench.roughness = 0.3; controls.texture = 0.3 }
            if block == 420 { bench.load = 0.6; controls.load = 0.6 }
            if block == 440 { bench.volume = 0.4; controls.volume = 0.4; bench.ambience = 0.08; controls.ambience = 0.08 }
            if block == 480 { bench.set_running(false); controls.running = false }
            engine.set_controls(controls)
            bench.render(&expected[0:960]); engine.render(&actual[0:960])
            assert(engine.current_rpm() == bench.rpm(), "extraction changed the simulation RPM")
            for frame in 0...960 {
                assert(Math.is_finite(actual[frame]) && actual[frame] == expected[frame], "extraction changed the validated sound")
            }
        }
        print("Bit-exact package extraction: ", profile.key)
    }
}
