use GFX.Audio.Engines
use STD.Process
use STD.Math
use STD.Time.Stopwatch
use Module.Model.Bench

class Pair {
    var bench:Bench
    var engine:Engines.Engine
    private var control:Engines.Controls
    private var expected:float32[] = []
    private var actual:float32[] = []
    init(library:Engines.Library, index:int = 0) {
        self.bench = Bench(running:false, reference:true); assert(self.bench.select_profile(index)); self.bench.toggle_road()
        self.engine = library.engine(self.bench.profile().key, transmission:Engines.Transmission.automatic)
        self.control = self.engine.controls()
        for _ in 0...960 { self.expected.append(0.0); self.actual.append(0.0) }
    }
    func power(value:bool) { self.bench.set_running(value); self.control.running = value; self.control.accelerating = false }
    func accelerate(value:bool) { self.bench.accelerating = value; self.control.accelerating = value }
    func brake(value:bool) { self.bench.braking = value; self.control.braking = value }
    func neutral() { self.bench.neutral(); self.control.transmission = Engines.Transmission.manual; self.control.gear = 0 }
    func up() {
        self.bench.shift_up()
        if self.control.transmission == Engines.Transmission.automatic { self.control.gear = self.engine.drive_state()!.gear }
        self.control.transmission = Engines.Transmission.manual
        if self.control.gear < self.engine.profile.gears { self.control.gear++ }
    }
    func reset_check() {
        self.engine.enqueue(); self.engine.reset()
        assert(self.engine.pending_blocks() == 0 && self.engine.drive_state() != null)
        assert(self.engine.controls().transmission == Engines.Transmission.manual && self.engine.controls().gear == 1)
        for _ in 0...40 { self.engine.render(&self.actual[0:960]) }
        assert(self.engine.drive_state()!.gear == 1, "reset lost the road simulation context")
    }
    func advance(count:int, asynchronous:bool = false) {
        self.engine.set_controls(self.control)
        var remaining = count
        while remaining > 0 {
            var depth = 1
            if asynchronous { depth = remaining; if depth > 4 { depth = 4 }
                self.bench.request_reference(depth); self.engine.enqueue(depth) }
            for block in 0...depth {
                if asynchronous {
                    var a = false; var b = false; var watch = Stopwatch(); watch.start()
                    while !a || !b {
                        if !a { a = self.bench.render_reference_ready(&self.expected[0:960]) }
                        if !b { b = self.engine.render_ready(&self.actual[0:960]) }
                        assert(watch.get_elapsed_seconds() < 5.0, "road render timed out")
                    }
                } else { self.bench.render(&self.expected[0:960]); self.engine.render(&self.actual[0:960]) }
                let state = self.engine.drive_state()!
                assert(self.engine.current_rpm() == self.bench.rpm() && state.gear == self.bench.gear() && state.speed_kmh == self.bench.speed())
                assert(state.shifting == (self.bench.shift_flags() % 2 == 1) && state.shift_refused == (self.bench.shift_flags() >= 2))
                assert(state.shift_count == self.bench.shift_count())
                for i in 0...960 { assert(self.expected[i] == self.actual[i] && Math.is_finite(self.actual[i]), "road extraction changed PCM") }
            }
            remaining -= depth
        }
    }
}
func verify(library:Engines.Library, asynchronous:bool) {
    var pair = Pair(library)
    var invalid = pair.engine.controls(); invalid.transmission = null
    match try pair.engine.set_controls(invalid) { failure(error) => {}; success => { panic("road/bench mutation accepted") } }
    invalid = pair.engine.controls(); invalid.gear = pair.engine.profile.gears + 1
    match try pair.engine.set_controls(invalid) { failure(error) => {}; success => { panic("invalid gear accepted") } }
    pair.power(true); pair.advance(250, asynchronous)
    pair.accelerate(true); pair.advance(2_400, asynchronous)
    assert(pair.engine.drive_state()!.speed_kmh > 100.0 && pair.engine.drive_state()!.gear >= 3)
    pair.power(false); pair.advance(10, asynchronous)
    assert(pair.engine.drive_state()!.speed_kmh > 60.0, "ignition cut must work while moving")
    pair.power(true); pair.advance(40, asynchronous)
    pair.neutral(); pair.advance(50, asynchronous)
    pair.up(); pair.advance(40, asynchronous)
    assert(pair.engine.drive_state()!.gear == 0 && pair.engine.drive_state()!.shift_refused)
    var attempts = 0
    while pair.engine.drive_state()!.gear == 0 && attempts < pair.engine.profile.gears {
        pair.up(); pair.advance(40, asynchronous); attempts++
    }
    assert(pair.engine.drive_state()!.gear > 1, "safe gear must remain reachable after N")
    pair.neutral(); pair.advance(50, asynchronous); pair.up(); pair.advance(40, asynchronous)
    pair.accelerate(false); pair.brake(true); pair.advance(700, asynchronous)
    assert(pair.engine.drive_state()!.speed_kmh < 0.5 && pair.engine.drive_state()!.gear == 0)
    pair.neutral(); pair.advance(2, asynchronous); pair.up(); pair.advance(40, asynchronous)
    assert(pair.engine.drive_state()!.gear == 1, "fresh command must engage first after stopping")
    pair.reset_check()
    print("Road bit-exact PCM and telemetry passed; async=", asynchronous)
}
func main() {
    let arguments = Process.arguments(); var directory = "Build/EngineLibrary-Package"
    if arguments.count() > 1 { directory = arguments[1] }
    var library = Engines.Library.open(directory)
    verify(library, false); verify(library, true)
    for i, profile in library.profiles().indexed() {
        var pair = Pair(library, i); pair.power(true); pair.advance(100)
        print("Road profile packet/PCM passed: ", profile.key)
    }
}
