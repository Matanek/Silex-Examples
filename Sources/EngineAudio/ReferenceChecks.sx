use STD.File
use STD.Math
use Module.Model.Bench

func word(bytes:&uint8[], value:int, count:int) {
    var remaining = value
    for _ in 0...count { bytes.append((remaining % 256) as uint8); remaining /= 256 }
}

public func verify(output:str? = null) {
    var bench = Bench(running:false, reference:true)
    var samples:float32[] = []; for _ in 0...960 { samples.append(0.0) }
    var maximum = 0.0
    var maximum_rpm = 0.0
    var residual = 0.0
    var final_energy = 0.0
    var bytes:uint8[] = []
    if output != null {
        let frames = 1_200 * 480
        for value in [82, 73, 70, 70] { bytes.append(value as uint8) }
        word(bytes, 36 + frames * 4, 4)
        for value in [87, 65, 86, 69, 102, 109, 116, 32] { bytes.append(value as uint8) }
        word(bytes, 16, 4); word(bytes, 1, 2); word(bytes, 2, 2)
        word(bytes, 44_100, 4); word(bytes, 44_100 * 4, 4); word(bytes, 4, 2); word(bytes, 16, 2)
        for value in [100, 97, 116, 97] { bytes.append(value as uint8) }
        word(bytes, frames * 4, 4)
    }
    for block in 0...1_200 {
        if block == 30 { bench.set_running(true) }
        if block == 950 { bench.set_running(false) }
        bench.accelerating = block >= 460 && block < 650
        // The underlying physical combustion remains variable with air noise and jitter disabled.
        bench.roughness = 1.0
        if output == null && block >= 300 && block < 400 { bench.roughness = 0.0 }
        bench.render(&samples[0:samples.count()])
        var energy = 0.0
        for sample in samples {
            assert(sample == sample && Math.abs(sample as float) <= 1.0, "reference finite and bounded")
            energy += sample as float * sample as float
            maximum = Math.max(maximum, Math.abs(sample as float))
            if output != null {
                var value = Math.round(sample as float * 32_767.0) as int
                if value < 0 { value += 65_536 }
                word(bytes, value, 2)
            }
        }
        maximum_rpm = Math.max(maximum_rpm, bench.rpm())
        if block < 30 { assert(energy == 0.0, "reference starts switched off") }
        if block == 30 { assert(bench.rpm() < 100.0, "reference starter does not instantly reach idle") }
        if block == 420 { assert(bench.rpm() > 650.0 && bench.rpm() < 1_300.0, "reference natural idle") }
        if block == 950 { assert(bench.rpm() > 200.0, "reference rotation persists after contact off") }
        if block >= 950 && block < 970 { residual += energy }
        if block >= 1_180 { final_energy += energy }
    }
    assert(maximum_rpm > 4_000.0, "reference accelerates under throttle")
    assert(residual > 0.001, "reference combustion and acoustic tail after contact off")
    assert(bench.rpm() < 5.0 && final_energy < 0.00001, "reference settles to stopped silence")
    if path = output { File.write_all(path, @bytes[0:bytes.count()]) }
    bench.set_running(true)
    for _ in 0...200 { bench.render(&samples[0:samples.count()]) }
    assert(bench.rpm() > 350.0, "reference restarts after complete stop")
    print("Reference checks passed: native 454 start, idle, noise zero, throttle, coast, silence, restart; peak ", maximum,
        "; maximum RPM ", maximum_rpm)
}
