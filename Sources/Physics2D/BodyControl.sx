use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use STD.Math
use STD.Process

static struct Demo {
    let width:int = 900
    let height:int = 560
    let pixels_per_meter:float = 80.0
    let platform_left:float = -2.3
    let platform_right:float = 2.3
    let platform_y:float = -2.15
    let cargo_radius:float = 0.32
    let fixed_delta:float = 1.0 / 60.0
    let maximum_substeps:int = 8
    let target_duration:float = 3.0
    let target_frames:int = 180
    let verification_frames:int = 540
}

struct BodyVisual { let identity:int }

class Simulation {
    var world:Physics.World2D
    var compound:Physics.RigidBody2D?
    var platform:Physics.RigidBody2D?
    var cargo:Physics.RigidBody2D?
    var accumulator:float
    var frames:int
    let verification:bool
    var platform_target_right:bool
    var maximum_cargo_excursion:float
    var derived_mass:float
    var derived_center:Math.Vec2

    init(verification:bool) {
        self.world = Physics.World2D()
        self.compound = null
        self.platform = null
        self.cargo = null
        self.accumulator = 0.0
        self.frames = 0
        self.verification = verification
        self.platform_target_right = true
        self.maximum_cargo_excursion = 0.0
        self.derived_mass = 0.0
        self.derived_center = Math.Vec2()

        var compound = self.world.create_rigid_body(
            Physics.RigidBody2DSettings()
                ..position = Math.Vec2(-3.2, 0.65)
                ..gravity_scale = 0.0
                ..allow_sleep = false
                ..create_implicit_collider = false
                ..debug_label = "compound-body"
        )
        self.world.create_collider(compound, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                Math.Vec2(-1.0, -0.28),
                Math.Vec2(0.0, -0.28),
                Math.Vec2(0.0, 0.28),
                Math.Vec2(-1.0, 0.28)
            ]))
            ..density = 1.0
        )
        self.world.create_collider(compound, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                Math.Vec2(0.2, -0.48),
                Math.Vec2(1.15, -0.48),
                Math.Vec2(1.15, 0.48),
                Math.Vec2(0.2, 0.48)
            ]))
            ..density = 2.0
        )
        self.derived_mass = compound.mass()
        self.derived_center = compound.local_center_of_mass()
        compound.apply_linear_impulse(
            Math.Vec2(2.4, 0.15),
            compound.world_point(Math.Vec2(-0.8, -0.25))
        )
        self.compound = compound

        var platform = self.world.create_rigid_body(
            Physics.RigidBody2DSettings()
                ..body_type = Physics.BodyType2D.kinematic
                ..position = Math.Vec2(
                    Demo.platform_left,
                    Demo.platform_y
                )
                ..create_implicit_collider = false
                ..debug_label = "kinematic-target"
        )
        let container_material = Physics.PhysicsMaterial2D()
            ..friction = 1.0
            ..restitution = 0.05
        self.world.create_collider(platform, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                Math.Vec2(-1.5, -0.15),
                Math.Vec2(1.5, -0.15),
                Math.Vec2(1.5, 0.15),
                Math.Vec2(-1.5, 0.15)
            ]))
            ..material = container_material
        )
        self.world.create_collider(platform, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                Math.Vec2(-1.55, 0.85),
                Math.Vec2(1.55, 0.85),
                Math.Vec2(1.55, 1.05),
                Math.Vec2(-1.55, 1.05)
            ]))
            ..material = container_material
        )
        self.world.create_collider(platform, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                Math.Vec2(-1.55, -0.15),
                Math.Vec2(-1.35, -0.15),
                Math.Vec2(-1.35, 0.85),
                Math.Vec2(-1.55, 0.85)
            ]))
            ..material = container_material
        )
        self.world.create_collider(platform, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                Math.Vec2(1.35, -0.15),
                Math.Vec2(1.55, -0.15),
                Math.Vec2(1.55, 0.85),
                Math.Vec2(1.35, 0.85)
            ]))
            ..material = container_material
        )
        platform.set_target_transform(
            Physics.Transform2D(
                position:Math.Vec2(
                    Demo.platform_right,
                    Demo.platform_y
                ),
                rotation:Math.pi() * 0.06
            ),
            Demo.target_duration
        )
        self.platform = platform

        self.cargo = self.world.create_rigid_body(
            Physics.RigidBody2DSettings()
                ..shape = Physics.Shape2D.circle(
                    Physics.Circle2D(Demo.cargo_radius)
                )
                ..position = Math.Vec2(
                    Demo.platform_left,
                    Demo.platform_y + 0.5
                )
                ..friction = 1.0
                ..restitution = 0.12
                ..is_bullet = true
                ..debug_label = "dynamic-cargo"
        )
    }
}

func verification_mode() bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--verify" { return true }
            }
        }
    }
    return false
}

func compound_drawing(center:Math.Vec2) Canvas {
    let scale = Demo.pixels_per_meter
    let origin = Math.Vec2(90.0, 50.0)
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(
                origin.add(Math.Vec2(-scale, -0.28 * scale)),
                Math.Vec2(scale, 0.56 * scale),
                5.0
            ),
            Canvas.Fill.solid(Color.sky_400())
        )
        painter.fill(
            Canvas.Rect(
                origin.add(Math.Vec2(0.2 * scale, -0.48 * scale)),
                Math.Vec2(0.95 * scale, 0.96 * scale),
                7.0
            ),
            Canvas.Fill.solid(Color.violet_400())
        )
        painter.fill(
            Canvas.Circle(origin.add(center.multiply(scale)), 6.0),
            Canvas.Fill.solid(Color.amber_300())
        )
    })
    return drawing
}

func platform_drawing() Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(10.0, 88.0), Math.Vec2(240.0, 24.0), 5.0),
            Canvas.Fill.solid(Color.cyan_400())
        )
        painter.fill(
            Canvas.Rect(Math.Vec2(6.0, 16.0), Math.Vec2(16.0, 96.0), 5.0),
            Canvas.Fill.solid(Color.cyan_400())
        )
        painter.fill(
            Canvas.Rect(Math.Vec2(238.0, 16.0), Math.Vec2(16.0, 96.0), 5.0),
            Canvas.Fill.solid(Color.cyan_400())
        )
        painter.fill(
            Canvas.Rect(Math.Vec2(6.0, 16.0), Math.Vec2(248.0, 16.0), 5.0),
            Canvas.Fill.solid(Color.cyan_400())
        )
    })
    return drawing
}

func cargo_drawing() Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(30.0), Demo.cargo_radius * Demo.pixels_per_meter),
            Canvas.Fill.solid(Color.amber_300())
        )
        painter.stroke(
            Canvas.Path()
                ..move_to(Math.Vec2(30.0, 30.0))
                ..line_to(Math.Vec2(52.0, 30.0)),
            Canvas.Stroke(Color.slate_950(), 3.0)
        )
    })
    return drawing
}

func explanation_drawing(simulation:@Simulation) Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "BODY CONTROL",
            Math.Vec2(28.0, 28.0),
            Canvas.TextStyle(
                size:22.0,
                color:Color.cyan_300(),
                weight:Canvas.TextWeight.bold
            )
        )
        painter.text(
            "Two colliders derive mass $(simulation.derived_mass) and an offset center of mass.",
            Math.Vec2(28.0, 66.0),
            Canvas.TextStyle(size:16.0, color:Color.slate_200())
        )
        painter.text(
            "Off-center impulse above; the moving container carries dynamic cargo through contacts.",
            Math.Vec2(28.0, 92.0),
            Canvas.TextStyle(size:16.0, color:Color.slate_300())
        )
        painter.text(
            "Amber dot: derived local center of mass",
            Math.Vec2(28.0, 124.0),
            Canvas.TextStyle(size:14.0, color:Color.amber_300())
        )
    })
    return drawing
}

func create_scene(world:&Resources.World, simulation:@Simulation) {
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Camera2D())
    )
    world.spawn(ECS.EntityRecipe()
        ..with(BodyVisual(identity:1))
        ..with(Components.Transform2D())
        ..with(Components.Canvas(
            compound_drawing(simulation.derived_center),
            180,
            100
        ))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(BodyVisual(identity:2))
        ..with(Components.Transform2D())
        ..with(Components.Canvas(platform_drawing(), 260, 200))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(BodyVisual(identity:3))
        ..with(Components.Transform2D())
        ..with(Components.Canvas(cargo_drawing(), 60, 60))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Canvas(
            explanation_drawing(simulation),
            Demo.width,
            160
        )
            ..space = Components.CanvasSpace.viewport
            ..anchor = Math.Vec2()
            ..pivot = Math.Vec2()
            ..layer = 10
        )
    )
}

func advance_simulation(
    simulation:&Simulation,
    controller:&Application.Controller
) {
    simulation.world.step(Demo.fixed_delta)
    simulation.frames++
    if let cargo = simulation.cargo {
        simulation.maximum_cargo_excursion = Math.max(
            simulation.maximum_cargo_excursion,
            Math.abs(cargo.position().x - Demo.platform_left)
        )
    }
    if !simulation.verification {
        if let compound = simulation.compound {
            if compound.position().x > 4.0 {
                compound.set_position(Math.Vec2(-3.2, 0.65))
                compound.set_rotation(0.0)
                compound.set_velocity(Math.Vec2())
                compound.set_angular_velocity(0.0)
                compound.apply_linear_impulse(
                    Math.Vec2(2.4, 0.15),
                    compound.world_point(Math.Vec2(-0.8, -0.25))
                )
            }
        }
    }
    if let platform = simulation.platform {
        if simulation.verification {
            assert(Math.abs(platform.position().x) <= 2.30001)
        }
        if simulation.frames % Demo.target_frames == 0 {
            var target_x = Demo.platform_left
            var target_rotation = 0.0
            if !simulation.platform_target_right {
                target_x = Demo.platform_right
                target_rotation = Math.pi() * 0.06
            }
            platform.set_target_transform(
                Physics.Transform2D(
                    position:Math.Vec2(target_x, Demo.platform_y),
                    rotation:target_rotation
                ),
                Demo.target_duration
            )
            simulation.platform_target_right =
                !simulation.platform_target_right
        }
        if simulation.verification {
            if let cargo = simulation.cargo {
                let local_position = platform.local_point(cargo.position())
                assert(
                    Math.abs(local_position.x) < 1.1,
                    "cargo x=$(local_position.x) y=$(local_position.y) step=$(simulation.frames)"
                )
                assert(
                    local_position.y > 0.25 && local_position.y < 0.75,
                    "cargo x=$(local_position.x) y=$(local_position.y) step=$(simulation.frames)"
                )
            }
        }
    }
    if simulation.verification &&
        simulation.frames == Demo.verification_frames
    {
        assert(simulation.derived_mass > 2.0)
        assert(simulation.derived_center.x > 0.2)
        if let compound = simulation.compound {
            assert(compound.velocity().length_squared() > 0.1)
            assert(Math.abs(compound.angular_velocity()) > 0.1)
            assert(compound.debug_label() == "compound-body")
        }
        if let platform = simulation.platform {
            assert(platform.position().nearly_equal(
                Math.Vec2(Demo.platform_right, Demo.platform_y),
                0.001
            ), "platform x=$(platform.position().x) y=$(platform.position().y)")
            assert(Math.nearly_equal(
                platform.rotation(),
                Math.pi() * 0.06,
                0.001
            ))
        }
        if let cargo = simulation.cargo {
            assert(cargo.is_valid())
            assert(cargo.position().y > -3.5)
            assert(simulation.maximum_cargo_excursion > 1.0)
        }
        controller.stop()
    }
}

func simulate(
    time:@Resources.FrameTime,
    simulation:&Simulation,
    controller:&Application.Controller
) {
    var elapsed:float = Demo.fixed_delta
    if !simulation.verification { elapsed = time.delta }
    simulation.accumulator = Math.min(
        simulation.accumulator + elapsed,
        Demo.fixed_delta * Demo.maximum_substeps as float
    )
    while simulation.accumulator >= Demo.fixed_delta {
        advance_simulation(simulation, controller)
        simulation.accumulator -= Demo.fixed_delta
    }
}

func synchronize_visuals(
    simulation:@Simulation,
    visuals:ECS.Query<(@BodyVisual, &Components.Transform2D)>
) {
    for (visual, transform) in visuals {
        if visual.identity == 1 {
            if let value = simulation.compound {
                transform.position = value.position().multiply(
                    Demo.pixels_per_meter
                )
                transform.rotation = value.rotation()
            }
        } elif visual.identity == 2 {
            if let value = simulation.platform {
                transform.position = value.position().multiply(
                    Demo.pixels_per_meter
                )
                transform.rotation = value.rotation()
            }
        } else {
            if let value = simulation.cargo {
                transform.position = value.position().multiply(
                    Demo.pixels_per_meter
                )
                transform.rotation = value.rotation()
            }
        }
    }
}

func main() {
    let verification = verification_mode()
    Application()
        ..add_resource(Simulation(verification))
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "GFX.Physics — Body control"
            ..width = Demo.width
            ..height = Demo.height
            ..resizable = false
            ..hidden = verification
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.Time())
        ..add_system(Application.Schedule.startup, create_scene)
        ..add_system(Application.Schedule.update, simulate)
        ..add_after_system(Application.Schedule.update, synchronize_visuals)
        ..run()
}
