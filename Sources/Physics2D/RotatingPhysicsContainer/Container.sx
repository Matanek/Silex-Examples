use GFX.Animation
use GFX.Components
use GFX.ECS
use GFX.Physics
use GFX.Resources
use STD.Math
use Module.Model.Showcase
use Module.Model.ContainerWall

public func rotate_offset(offset:Math.Vec2, angle:float) Math.Vec2 {
    let cosine = Math.cos(angle)
    let sine = Math.sin(angle)
    return Math.Vec2(
        offset.x * cosine - offset.y * sine,
        offset.x * sine + offset.y * cosine
    )
}

func create_container_wall(
    scene:&Resources.World,
    offset:Math.Vec2,
    size:Math.Vec2
) {
    scene.spawn(ECS.EntityRecipe()
        ..with(ContainerWall(offset:offset))
        ..with(Components.Transform2D(
            position:offset.multiply(Showcase.pixels_per_meter)
        ))
        ..with(Components.PhysicsBody2D(Physics.RigidBody2DSettings()
            ..body_type = Physics.BodyType2D.kinematic
            ..shape = Physics.Shape2D.box(Physics.Box2D(size))
            ..friction = 0.85
            ..restitution = 0.1
        ))
    )
}

public func create_container_walls(scene:&Resources.World) {
    let half = Showcase.container_half_extent
    let thickness = Showcase.container_wall_thickness
    let offset = half + thickness * 0.5
    let span = half * 2.0 + thickness * 2.0
    create_container_wall(
        scene,
        Math.Vec2(-offset, 0.0),
        Math.Vec2(thickness, span)
    )
    create_container_wall(
        scene,
        Math.Vec2(offset, 0.0),
        Math.Vec2(thickness, span)
    )
    create_container_wall(
        scene,
        Math.Vec2(0.0, -offset),
        Math.Vec2(span, thickness)
    )
    create_container_wall(
        scene,
        Math.Vec2(0.0, offset),
        Math.Vec2(span, thickness)
    )
}

public func container_rotation() Animation.Timeline {
    let pause = Showcase.container_turn_interval -
        Showcase.container_turn_duration
    let easing = Animation.Easing.in_out
    return Animation.sequence([
        Animation.rotate_to(
            Math.pi() * 0.25,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 0.5,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 0.75,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi(),
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 1.25,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 1.5,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 1.75,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 2.0,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause)
    ])..loop()
}
