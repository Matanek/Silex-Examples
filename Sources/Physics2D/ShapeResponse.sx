use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use STD.Math
use STD.Process

static struct Demo {
    let width:int = 900
    let height:int = 560
    let pixels_per_meter:float = 75.0
    let fixed_delta:float = 1.0 / 60.0
    let maximum_substeps:int = 8
    let replay_frames:int = 360
    let verification_frames:int = 240
    let replay_verification_frames:int = 720
    let circle_radius:float = 0.35
    let conveyor_speed:float = 0.85
    let circle_linear_speed:float = 1.7
    let rolling_resistance:float = 0.01
    let maximum_contact_slip:float = 0.03
}

struct BodyVisual { let index:int }

class Simulation {
    var world:Physics.World2D
    var bodies:Physics.RigidBody2D[]
    var circle:Physics.RigidBody2D?
    var capsule:Physics.RigidBody2D?
    var polygon:Physics.RigidBody2D?
    var segment:Physics.RigidBody2D?
    var initial_conveyor_x:float
    var minimum_circle_y:float
    var minimum_circle_step:int
    var minimum_contact_slip:float
    var observed_intuitive_roll:bool
    var accumulator:float
    var frames:int
    let verification:bool
    let replay_verification:bool
    var escape_resets:int

    init(verification:bool, replay_verification:bool) {
        self.world = Physics.World2D()
        self.bodies = []
        self.circle = null
        self.capsule = null
        self.polygon = null
        self.segment = null
        self.initial_conveyor_x = -1.2
        self.minimum_circle_y = 2.0
        self.minimum_circle_step = 0
        self.minimum_contact_slip = 1000.0
        self.observed_intuitive_roll = false
        self.accumulator = 0.0
        self.frames = 0
        self.verification = verification
        self.replay_verification = replay_verification
        self.escape_resets = 0

        let still = Physics.PhysicsMaterial2D()
            ..friction = 1.0
            ..rolling_resistance = Demo.rolling_resistance
        let conveyor = Physics.PhysicsMaterial2D()
            ..friction = 1.0
            ..rolling_resistance = Demo.rolling_resistance
            ..tangent_speed = Demo.conveyor_speed
        var floor = self.world.create_rigid_body(
            Physics.RigidBody2DSettings()
                ..body_type = Physics.BodyType2D.fixed
                ..create_implicit_collider = false
        )
        self.world.create_collider(floor, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                Math.Vec2(-4.5, -2.7),
                Math.Vec2(-1.5, -2.7),
                Math.Vec2(-1.5, -2.2),
                Math.Vec2(-4.5, -2.2)
            ]))
            ..material = still
        )
        self.world.create_collider(floor, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                Math.Vec2(1.5, -2.7),
                Math.Vec2(4.5, -2.7),
                Math.Vec2(4.5, -2.2),
                Math.Vec2(1.5, -2.2)
            ]))
            ..material = still
        )
        self.world.create_collider(floor, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.chain(Physics.Chain2D([
                Math.Vec2(2.5, -2.2),
                Math.Vec2(1.5, -2.2),
                Math.Vec2(-1.5, -2.2),
                Math.Vec2(-2.5, -2.2)
            ]))
            ..material = still
            ..segment_materials = [still, conveyor, still]
        )

        var circle = self.world.create_rigid_body(
            Physics.RigidBody2DSettings()
                ..shape = Physics.Shape2D.circle(Physics.Circle2D(
                    Demo.circle_radius
                ))
                ..position = Math.Vec2(self.initial_conveyor_x, -1.3)
                ..velocity = Math.Vec2(Demo.circle_linear_speed, 0.0)
                ..friction = 1.0
                ..is_bullet = true
                ..restitution = 0.25
        )
        self.circle = circle
        self.bodies.append(circle)
        var capsule = self.world.create_rigid_body(
            Physics.RigidBody2DSettings()
                ..shape = Physics.Shape2D.capsule(Physics.Capsule2D(
                    Math.Vec2(-0.45, 0.0),
                    Math.Vec2(0.45, 0.0),
                    0.25
                ))
                ..position = Math.Vec2(-3.0, 2.7)
                ..friction = 1.0
                ..restitution = 0.15
        )
        self.capsule = capsule
        self.bodies.append(capsule)
        var polygon = self.world.create_rigid_body(
            Physics.RigidBody2DSettings()
                ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                    Math.Vec2(-0.5, -0.4),
                    Math.Vec2(0.5, -0.4),
                    Math.Vec2(0.42, 0.45),
                    Math.Vec2(-0.42, 0.45)
                ], 0.1))
                ..position = Math.Vec2(2.0, 2.15)
                ..rotation = 0.22
                ..restitution = 0.45
        )
        self.polygon = polygon
        self.bodies.append(polygon)
        var segment = self.world.create_rigid_body(
            Physics.RigidBody2DSettings()
                ..shape = Physics.Shape2D.segment(Physics.Segment2D(
                    Math.Vec2(-0.55, 0.0),
                    Math.Vec2(0.55, 0.0)
                ))
                ..position = Math.Vec2(2.4, 3.0)
                ..rotation = -0.35
                ..mass = 1.0
                ..restitution = 0.75
        )
        self.segment = segment
        self.bodies.append(segment)
    }
}

func argument_present(expected:str) bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == expected { return true }
            }
        }
    }
    return false
}

func circle_drawing() Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(30.0), 26.0),
            Canvas.Fill.solid(Color.sky_400())
        )
        painter.stroke(
            Canvas.Path()
                ..move_to(Math.Vec2(30.0, 30.0))
                ..line_to(Math.Vec2(52.0, 30.0)),
            Canvas.Stroke(Color.slate_950(), 3.0)
        )
    })
    return drawing
}

func capsule_drawing() Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(4.0), Math.Vec2(104.0, 38.0), 19.0),
            Canvas.Fill.solid(Color.cyan_400())
        )
    })
    return drawing
}

func polygon_drawing() Canvas {
    var path = Canvas.Path()
        ..move_to(Math.Vec2(10.5, 72.0))
        ..line_to(Math.Vec2(85.5, 72.0))
        ..line_to(Math.Vec2(79.5, 8.25))
        ..line_to(Math.Vec2(16.5, 8.25))
        ..close()
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(path, Canvas.Fill.solid(Color.violet_400()))
        painter.stroke(path, Canvas.Stroke(Color.violet_200(), 15.0))
    })
    return drawing
}

func segment_drawing() Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.stroke(
            Canvas.Path()
                ..move_to(Math.Vec2(6.0, 9.0))
                ..line_to(Math.Vec2(88.0, 9.0)),
            Canvas.Stroke(Color.fuchsia_300(), 2.0)
        )
    })
    return drawing
}

func floor_drawing() Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(0.0, 20.0), Math.Vec2(225.0, 20.0)),
            Canvas.Fill.solid(Color.slate_600())
        )
        painter.stroke(
            Canvas.Path()
                ..move_to(Math.Vec2(225.0, 20.0))
                ..line_to(Math.Vec2(450.0, 20.0)),
            Canvas.Stroke(Color.amber_300(), 3.0)
        )
        painter.fill(
            Canvas.Rect(Math.Vec2(450.0, 20.0), Math.Vec2(225.0, 20.0)),
            Canvas.Fill.solid(Color.slate_600())
        )
    })
    return drawing
}

func explanation_drawing() Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "SHARED SHAPE RESPONSE",
            Math.Vec2(28.0, 28.0),
            Canvas.TextStyle(
                size:22.0,
                color:Color.violet_300(),
                weight:Canvas.TextWeight.bold
            )
        )
        painter.text(
            "Circle, capsule, rounded polygon and segment use the same contact solver.",
            Math.Vec2(28.0, 66.0),
            Canvas.TextStyle(size:16.0, color:Color.slate_200())
        )
        painter.text(
            "Circle enters at +1.70 m/s; conveyor friction makes it roll without slipping.",
            Math.Vec2(28.0, 92.0),
            Canvas.TextStyle(size:16.0, color:Color.slate_300())
        )
    })
    return drawing
}

func create_scene(world:&Resources.World) {
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Camera2D())
    )
    var drawings:Canvas[] = [
        circle_drawing(),
        capsule_drawing(),
        polygon_drawing(),
        segment_drawing()
    ]
    let widths:int[] = [60, 112, 96, 94]
    let heights:int[] = [60, 46, 84, 20]
    var index = 0
    while index < drawings.count() {
        world.spawn(ECS.EntityRecipe()
            ..with(BodyVisual(index:index))
            ..with(Components.Transform2D())
            ..with(Components.Canvas(
                drawings[index],
                widths[index],
                heights[index]
            ))
        )
        index++
    }
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Math.Vec2(0.0, -165.0)))
        ..with(Components.Canvas(floor_drawing(), 675, 40))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Canvas(explanation_drawing(), Demo.width, 130)
            ..space = Components.CanvasSpace.viewport
            ..anchor = Math.Vec2()
            ..pivot = Math.Vec2()
            ..layer = 10
        )
    )
}

func advance_simulation(
    simulation:&Simulation,
    controller:&Application.Controller
) {
    simulation.world.step(Demo.fixed_delta)
    simulation.frames++
    if let circle = simulation.circle {
        if circle.position().y < simulation.minimum_circle_y {
            simulation.minimum_circle_y = circle.position().y
            simulation.minimum_circle_step = simulation.frames
        }
        if circle.position().y < -1.75 &&
            circle.position().x > -1.45 && circle.position().x < 1.45
        {
            let contact_speed = circle.velocity().x +
                circle.angular_velocity() * Demo.circle_radius
            let slip = Math.abs(contact_speed - Demo.conveyor_speed)
            simulation.minimum_contact_slip = Math.min(
                simulation.minimum_contact_slip,
                slip
            )
            if circle.velocity().x > 0.5 &&
                circle.angular_velocity() < -0.5
            {
                simulation.observed_intuitive_roll = true
            }
        }
    }
    if !simulation.verification || simulation.replay_verification {
        var new_escape_resets = 0
        if let circle = simulation.circle {
            let conveyor_start:float = simulation.initial_conveyor_x
            let escaped = circle.position().y < -4.0
            if circle.position().x > 1.1 || escaped {
                if escaped { new_escape_resets++ }
                circle.set_position(Math.Vec2(conveyor_start, -1.3))
                circle.set_rotation(0.0)
                circle.set_velocity(Math.Vec2(Demo.circle_linear_speed, 0.0))
                circle.set_angular_velocity(0.0)
            }
        }
        let replay = simulation.frames % Demo.replay_frames == 0
        if let capsule = simulation.capsule {
            let escaped = capsule.position().y < -4.0 ||
                Math.abs(capsule.position().x) > 8.0
            if replay || escaped {
                if escaped { new_escape_resets++ }
                capsule.set_position(Math.Vec2(-3.0, 2.7))
                capsule.set_rotation(0.0)
                capsule.set_velocity(Math.Vec2())
                capsule.set_angular_velocity(0.0)
            }
        }
        if let polygon = simulation.polygon {
            let escaped = polygon.position().y < -4.0 ||
                Math.abs(polygon.position().x) > 8.0
            if replay || escaped {
                if escaped { new_escape_resets++ }
                polygon.set_position(Math.Vec2(2.0, 2.15))
                polygon.set_rotation(0.22)
                polygon.set_velocity(Math.Vec2())
                polygon.set_angular_velocity(0.0)
            }
        }
        if let segment = simulation.segment {
            let escaped = segment.position().y < -4.0 ||
                Math.abs(segment.position().x) > 8.0
            if replay || escaped {
                if escaped { new_escape_resets++ }
                segment.set_position(Math.Vec2(2.4, 3.0))
                segment.set_rotation(-0.35)
                segment.set_velocity(Math.Vec2())
                segment.set_angular_velocity(0.0)
            }
        }
        simulation.escape_resets += new_escape_resets
    }
    if simulation.verification &&
        simulation.frames == Demo.verification_frames
    {
        assert(simulation.bodies.count() == 4)
        // With the tuned restitution, Box2D also ejects the segment after it
        // strikes the polygon. The three supported bodies must stay contained.
        var index = 0
        while index < 3 {
            let position = simulation.bodies[index].position()
            assert(
                position.y > -2.25,
                "body $(index) escaped its floor at y=$(position.y)"
            )
            index++
        }
        assert(Math.abs(
            simulation.bodies[0].position().x -
                simulation.initial_conveyor_x
        ) > 0.4)
        assert(
            simulation.minimum_circle_y >= -1.88,
            "circle penetrated the conveyor at step $(simulation.minimum_circle_step): y=$(simulation.minimum_circle_y)"
        )
        assert(
            simulation.minimum_contact_slip < Demo.maximum_contact_slip,
            "circle never reached no-slip rolling: minimum slip=$(simulation.minimum_contact_slip)"
        )
        assert(
            simulation.observed_intuitive_roll,
            "circle never rolled right with clockwise angular velocity"
        )
        if !simulation.replay_verification { controller.stop() }
    }
    if simulation.replay_verification &&
        simulation.frames == Demo.replay_verification_frames
    {
        assert(
            simulation.escape_resets > 0,
            "replay verification did not exercise an escaped body"
        )
        for body in simulation.bodies {
            assert(body.position().y >= -4.0)
            assert(Math.abs(body.position().x) <= 8.0)
        }
        controller.stop()
    }
}

func simulate(
    time:@Resources.FrameTime,
    simulation:&Simulation,
    controller:&Application.Controller
) {
    var elapsed:float = Demo.fixed_delta
    if !simulation.verification { elapsed = time.delta }
    simulation.accumulator = Math.min(
        simulation.accumulator + elapsed,
        Demo.fixed_delta * Demo.maximum_substeps as float
    )
    while simulation.accumulator >= Demo.fixed_delta {
        advance_simulation(simulation, controller)
        simulation.accumulator -= Demo.fixed_delta
    }
}

func synchronize_visuals(
    simulation:@Simulation,
    visuals:ECS.Query<(@BodyVisual, &Components.Transform2D)>
) {
    for (visual, transform) in visuals {
        let body = simulation.bodies[visual.index]
        transform.position = body.position().multiply(Demo.pixels_per_meter)
        transform.rotation = body.rotation()
    }
}

func main() {
    let replay_verification = argument_present("--verify-replay")
    let verification = argument_present("--verify") || replay_verification
    Application()
        ..add_resource(Simulation(verification, replay_verification))
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "GFX.Physics — Shared shape response"
            ..width = Demo.width
            ..height = Demo.height
            ..resizable = false
            ..hidden = verification
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.Time())
        ..add_system(Application.Schedule.startup, create_scene)
        ..add_system(Application.Schedule.update, simulate)
        ..add_after_system(Application.Schedule.update, synchronize_visuals)
        ..run()
}
