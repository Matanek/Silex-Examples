use GFX.Canvas
use GFX.Color
use GFX.Input
use GFX.Physics
use GFX.Viewer
use STD.Math
use STD.Process

static struct Demo {
    let fixed_delta:float = 1.0 / 60.0
    let maximum_frame_delta:float = 0.05
}

func verification_mode() bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--verify" { return true }
            }
        }
    }
    return false
}

struct Oscillator {
    var body:Physics.RigidBody2D
    let origin:Math.Vec2
    let phase:float
    let radius:Math.Vec2

    init(
        body:Physics.RigidBody2D,
        origin:Math.Vec2,
        phase:float,
        radius:Math.Vec2 = Math.Vec2(18.0, 12.0)
    ) {
        self.body = body
        self.origin = origin
        self.phase = phase
        self.radius = radius
    }

    func drive(elapsed:float) {
        let angle = elapsed * 1.4 + self.phase
        let target = self.origin.add(Math.Vec2(
            Math.cos(angle) * self.radius.x,
            Math.sin(angle) * self.radius.y
        ))
        let spring = target.subtract(self.body.position()).multiply(18.0)
        let damping = self.body.velocity().multiply(5.0)
        self.body.apply_force_to_center(
            spring.subtract(damping).multiply(self.body.mass())
        )
    }
}

struct JointAnimation {
    var distance:Physics.DistanceJoint2D
    var motor:Physics.MotorJoint2D
    var mouse:Physics.MouseJoint2D
    var prismatic:Physics.PrismaticJoint2D
    var revolute:Physics.RevoluteJoint2D
    var wheel:Physics.WheelJoint2D

    init(
        distance:Physics.DistanceJoint2D,
        motor:Physics.MotorJoint2D,
        mouse:Physics.MouseJoint2D,
        prismatic:Physics.PrismaticJoint2D,
        revolute:Physics.RevoluteJoint2D,
        wheel:Physics.WheelJoint2D
    ) {
        self.distance = distance
        self.motor = motor
        self.mouse = mouse
        self.prismatic = prismatic
        self.revolute = revolute
        self.wheel = wheel
    }

    func retarget(elapsed:float) {
        self.distance.set_length(58.0 + Math.sin(elapsed * 1.7) * 18.0)
        self.motor.set_offsets(
            Math.Vec2(
                60.0 + Math.cos(elapsed * 1.3) * 20.0,
                Math.sin(elapsed * 1.3) * 16.0
            ),
            Math.sin(elapsed) * 0.45
        )
        self.mouse.set_target(Math.Vec2(
            775.0 + Math.cos(elapsed * 1.2) * 42.0,
            285.0 + Math.sin(elapsed * 1.6) * 30.0
        ))
        self.prismatic.set_target_translation(Math.sin(elapsed * 1.8) * 28.0)
        self.revolute.set_target_angle(Math.sin(elapsed * 1.5) * 0.75)
        self.wheel.set_motor(Math.cos(elapsed * 1.4) * 4.0, 8_000.0)
    }
}

func make_fixed(
    world:Physics.World2D,
    position:Math.Vec2,
    label:str
) Physics.RigidBody2D {
    return world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(12.0))
        ..position = position
        ..debug_label = label
    )
}

func make_dynamic(
    world:Physics.World2D,
    position:Math.Vec2
) Physics.RigidBody2D {
    return world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(24.0)))
        ..position = position
        ..gravity_scale = 0.0
        ..mass = 1.0
        ..linear_damping = 0.25
        ..angular_damping = 0.2
        ..allow_sleep = false
    )
}

func add_shapes(world:Physics.World2D) Oscillator[] {
    var oscillators:Oscillator[] = []
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(
            Math.Vec2(130.0, 18.0),
            5.0
        ))
        ..position = Math.Vec2(90.0, 135.0)
        ..debug_label = "contact"
    )
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(27.0))
        ..position = Math.Vec2(90.0, 105.0)
        ..gravity_scale = 0.0
        ..mass = 1.0
        ..linear_damping = 0.25
        ..allow_sleep = false
    )
    oscillators.append(Oscillator(body, Math.Vec2(90.0, 105.0), 0.0))
    body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.capsule(Physics.Capsule2D(
            Math.Vec2(-32.0, 0.0),
            Math.Vec2(32.0, 0.0),
            14.0
        ))
        ..position = Math.Vec2(260.0, 112.0)
        ..gravity_scale = 0.0
        ..mass = 1.0
        ..linear_damping = 0.25
        ..angular_velocity = 0.55
        ..allow_sleep = false
    )
    oscillators.append(Oscillator(body, Math.Vec2(260.0, 112.0), 2.1))
    body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
            Math.Vec2(-36.0, 22.0), Math.Vec2(-25.0, -28.0),
            Math.Vec2(18.0, -34.0), Math.Vec2(42.0, 12.0)
        ], 4.0))
        ..position = Math.Vec2(430.0, 112.0)
        ..gravity_scale = 0.0
        ..mass = 1.0
        ..linear_damping = 0.25
        ..angular_velocity = -0.45
        ..allow_sleep = false
    )
    oscillators.append(Oscillator(body, Math.Vec2(430.0, 112.0), 4.2))
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.segment(Physics.Segment2D(
            Math.Vec2(-48.0, 20.0),
            Math.Vec2(48.0, -20.0)
        ))
        ..position = Math.Vec2(600.0, 112.0)
        ..debug_label = "segment"
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.chain(Physics.Chain2D([
            Math.Vec2(-56.0, 22.0), Math.Vec2(-22.0, -20.0),
            Math.Vec2(22.0, -20.0), Math.Vec2(56.0, 22.0)
        ]))
        ..position = Math.Vec2(780.0, 112.0)
        ..debug_label = "chain"
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(25.0))
        ..position = Math.Vec2(940.0, 112.0)
        ..is_sensor = true
        ..debug_label = "sensor"
    )
    return oscillators
}

func add_joints(
    world:Physics.World2D,
    oscillators:&Oscillator[]
) JointAnimation {
    var fixed_body = make_fixed(world, Math.Vec2(85.0, 300.0), "distance")
    var moving = make_dynamic(world, Math.Vec2(145.0, 300.0))
    var distance = world.create_distance_joint(fixed_body, moving,
        Physics.DistanceJoint2DSettings()
            ..first_anchor = Math.Vec2(85.0, 300.0)
            ..second_anchor = Math.Vec2(145.0, 300.0)
            ..length = 60.0
            ..spring_enabled = true
            ..spring_hertz = 2.0
            ..spring_damping_ratio = 0.45)

    fixed_body = make_fixed(world, Math.Vec2(285.0, 300.0), "filter")
    moving = make_dynamic(world, Math.Vec2(345.0, 300.0))
    world.create_filter_joint(fixed_body, moving)
    oscillators.append(Oscillator(
        moving,
        Math.Vec2(345.0, 300.0),
        1.4,
        Math.Vec2(28.0, 22.0)
    ))

    fixed_body = make_fixed(world, Math.Vec2(485.0, 300.0), "motor")
    moving = make_dynamic(world, Math.Vec2(545.0, 300.0))
    var motor = world.create_motor_joint(fixed_body, moving,
        Physics.MotorJoint2DSettings()
            ..linear_offset = Math.Vec2(60.0, 0.0)
            ..maximum_force = 8_000.0
            ..maximum_torque = 8_000.0)

    moving = make_dynamic(world, Math.Vec2(745.0, 300.0))
    var mouse = world.create_mouse_joint(moving, Physics.MouseJoint2DSettings()
        ..target = Math.Vec2(805.0, 285.0)
        ..maximum_force = 8_000.0)

    fixed_body = make_fixed(world, Math.Vec2(85.0, 500.0), "prismatic")
    moving = make_dynamic(world, Math.Vec2(145.0, 500.0))
    var prismatic = world.create_prismatic_joint(fixed_body, moving,
        Physics.PrismaticJoint2DSettings()
            ..anchor = Math.Vec2(115.0, 500.0)
            ..axis = Math.Vec2(1.0, 0.0)
            ..spring_enabled = true
            ..spring_hertz = 2.2
            ..spring_damping_ratio = 0.5
            ..lower_translation = -30.0
            ..upper_translation = 30.0
            ..limit_enabled = true)

    fixed_body = make_fixed(world, Math.Vec2(335.0, 500.0), "revolute")
    moving = make_dynamic(world, Math.Vec2(395.0, 500.0))
    var revolute = world.create_revolute_joint(fixed_body, moving,
        Physics.RevoluteJoint2DSettings()
            ..anchor = Math.Vec2(365.0, 500.0)
            ..spring_enabled = true
            ..spring_hertz = 2.0
            ..spring_damping_ratio = 0.45
            ..lower_angle = -0.8
            ..upper_angle = 0.8
            ..limit_enabled = true)

    fixed_body = make_fixed(world, Math.Vec2(585.0, 500.0), "weld")
    moving = make_dynamic(world, Math.Vec2(645.0, 500.0))
    world.create_weld_joint(fixed_body, moving,
        Physics.WeldJoint2DSettings() ..anchor = Math.Vec2(615.0, 500.0))

    fixed_body = make_fixed(world, Math.Vec2(835.0, 500.0), "wheel")
    moving = make_dynamic(world, Math.Vec2(895.0, 500.0))
    var wheel = world.create_wheel_joint(fixed_body, moving,
        Physics.WheelJoint2DSettings()
            ..anchor = Math.Vec2(865.0, 500.0)
            ..axis = Math.Vec2(0.0, 1.0)
            ..spring_enabled = true
            ..spring_hertz = 2.0
            ..spring_damping_ratio = 0.45
            ..motor_enabled = true
            ..maximum_motor_torque = 8_000.0)

    return JointAnimation(
        distance,
        motor,
        mouse,
        prismatic,
        revolute,
        wheel
    )
}

class Showcase:Canvas.Session {
    private var world:Physics.World2D
    private var settings:Physics.World2DDebugSettings
    private var snapshot:Physics.World2DDebugSnapshot
    private var oscillators:Oscillator[]
    private var joints:JointAnimation
    private var accumulator:float
    private var elapsed:float

    init() {
        self.world = Physics.World2D(gravity:Math.Vec2())
        self.oscillators = add_shapes(self.world)
        self.joints = add_joints(self.world, self.oscillators)
        self.settings = Physics.World2DDebugSettings()
            ..shapes = true
            ..joints = true
            ..bounds = true
            ..centers_of_mass = true
            ..labels = true
            ..contacts = true
            ..contact_normals = true
            ..contact_impulses = true
            ..islands = true
            ..constraint_graph = true
            ..line_width = 2.0
            ..contact_radius = 4.0
            ..normal_length = 18.0
            ..impulse_scale = 0.02
            ..label_size = 11.0
        self.snapshot = Physics.World2DDebugSnapshot()
        self.accumulator = 0.0
        self.elapsed = 0.0
        self.advance_fixed_step()
        self.world.write_debug_snapshot(self.settings, self.snapshot)
        assert(self.snapshot.line_count() > 80)
        assert(self.snapshot.circle_count() > 20)
        assert(self.snapshot.label_count() > 10)
    }

    private func advance_fixed_step() {
        self.elapsed += Demo.fixed_delta
        self.joints.retarget(self.elapsed)
        var index = 0
        while index < self.oscillators.count() {
            var oscillator = self.oscillators[index]
            oscillator.drive(self.elapsed)
            index++
        }
        self.world.step(Demo.fixed_delta)
    }

    func drawing(width:int, height:int) Canvas.Canvas {
        var drawing = Physics.World2DDebug.canvas(self.snapshot)
        drawing.paint(func(painter:&Canvas.Painter) {
            painter.text(
                "LIVE PHYSICS  |  shapes · contacts · joints · islands · graph",
                Math.Vec2(24.0, 28.0),
                Canvas.TextStyle(size:14.0, color:Color.gray_200())
            )
        })
        return drawing
    }

    func update(delta:float) bool {
        self.accumulator += Math.min(delta, Demo.maximum_frame_delta)
        while self.accumulator >= Demo.fixed_delta {
            self.advance_fixed_step()
            self.accumulator -= Demo.fixed_delta
        }
        self.world.write_debug_snapshot(self.settings, self.snapshot)
        return true
    }

    func handle(event:@Input.Event) bool { return false }
    func accepts_text_input() bool { return false }

    func verify_motion() {
        var probe = self.oscillators[1]
        let initial = probe.body.position()
        var frame = 0
        while frame < 120 {
            self.update(Demo.fixed_delta)
            frame++
        }
        let final_position = probe.body.position()
        assert(final_position.subtract(initial).length() > 1.0)
        assert(self.snapshot.line_count() > 80)
        assert(self.snapshot.circle_count() > 20)
    }
}

func main() {
    var showcase = Showcase()
    if verification_mode() {
        showcase.verify_motion()
        return
    }
    Viewer.show(showcase, Viewer.CanvasSettings(
        width:1080,
        height:650,
        title:"GFX.Physics — Live 2D debug draw",
        background:Color.slate_950()
    ))
}
