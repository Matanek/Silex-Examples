use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use STD.Math
use STD.Process

static struct Demo {
    let window_width:int = 1080
    let window_height:int = 650
    let pixels_per_meter:float = 56.0
    let fixed_delta:float = 1.0 / 60.0
    let maximum_frame_delta:float = 0.05
    let respawn_interval:float = 0.85
}

func verification_mode() bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--verify" { return true }
            }
        }
    }
    return false
}

struct FallingBody {
    var body:Physics.RigidBody2D
    let origin:Math.Vec2
    let velocity:Math.Vec2
    let rotation:float
    let angular_velocity:float

    init(
        body:Physics.RigidBody2D,
        origin:Math.Vec2,
        velocity:Math.Vec2,
        rotation:float,
        angular_velocity:float
    ) {
        self.body = body
        self.origin = origin
        self.velocity = velocity
        self.rotation = rotation
        self.angular_velocity = angular_velocity
    }

    func restart() {
        self.body.set_position(self.origin)
        self.body.set_velocity(self.velocity)
        self.body.set_rotation(self.rotation)
        self.body.set_angular_velocity(self.angular_velocity)
    }
}

struct JointAnimation {
    var distance:Physics.DistanceJoint2D
    var motor:Physics.MotorJoint2D
    var mouse:Physics.MouseJoint2D
    var prismatic:Physics.PrismaticJoint2D
    var revolute:Physics.RevoluteJoint2D
    var wheel:Physics.WheelJoint2D

    init(
        distance:Physics.DistanceJoint2D,
        motor:Physics.MotorJoint2D,
        mouse:Physics.MouseJoint2D,
        prismatic:Physics.PrismaticJoint2D,
        revolute:Physics.RevoluteJoint2D,
        wheel:Physics.WheelJoint2D
    ) {
        self.distance = distance
        self.motor = motor
        self.mouse = mouse
        self.prismatic = prismatic
        self.revolute = revolute
        self.wheel = wheel
    }

    func retarget(elapsed:float) {
        self.distance.set_length(1.0 + Math.sin(elapsed * 1.7) * 0.28)
        self.motor.set_offsets(
            Math.Vec2(
                1.0 + Math.cos(elapsed * 1.3) * 0.3,
                Math.sin(elapsed * 1.3) * 0.25
            ),
            Math.sin(elapsed) * 0.45
        )
        self.mouse.set_target(Math.Vec2(
            6.8 + Math.cos(elapsed * 1.2) * 0.65,
            5.1 + Math.sin(elapsed * 1.6) * 0.45
        ))
        self.prismatic.set_target_translation(Math.sin(elapsed * 1.8) * 0.45)
        self.revolute.set_target_angle(Math.sin(elapsed * 1.5) * 0.75)
        self.wheel.set_motor(Math.cos(elapsed * 1.4) * 4.0, 120.0)
    }
}

func make_fixed(
    world:Physics.World2D,
    position:Math.Vec2,
    label:str
) Physics.RigidBody2D {
    return world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.18))
        ..position = position
        ..debug_label = label
    )
}

func make_joint_body(
    world:Physics.World2D,
    position:Math.Vec2
) Physics.RigidBody2D {
    return world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.42)))
        ..position = position
        ..gravity_scale = 0.0
        ..mass = 1.0
        ..linear_damping = 0.25
        ..angular_damping = 0.2
        ..allow_sleep = false
    )
}

func add_gravity_scene(world:Physics.World2D) FallingBody[] {
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(9.4, 0.35), 0.08))
        ..position = Math.Vec2(-4.0, 0.0)
        ..friction = 0.9
        ..debug_label = "gravity floor"
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.25, 8.5)))
        ..position = Math.Vec2(-8.7, 4.1)
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.25, 8.5)))
        ..position = Math.Vec2(0.7, 4.1)
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.segment(Physics.Segment2D(
            Math.Vec2(-1.2, 0.45),
            Math.Vec2(1.2, -0.45)
        ))
        ..position = Math.Vec2(-6.2, 2.25)
        ..friction = 0.75
        ..debug_label = "ramp"
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.chain(Physics.Chain2D([
            Math.Vec2(1.8, 0.65), Math.Vec2(1.1, 0.1),
            Math.Vec2(0.2, -0.15), Math.Vec2(-0.7, 0.1),
            Math.Vec2(-1.4, 0.65)
        ]))
        ..position = Math.Vec2(-2.0, 1.35)
        ..friction = 0.65
        ..debug_label = "chain"
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.55))
        ..position = Math.Vec2(-1.25, 4.4)
        ..is_sensor = true
        ..debug_label = "sensor"
    )

    var falling:FallingBody[] = []
    let circle_origin = Math.Vec2(-7.4, 7.6)
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.45))
        ..position = circle_origin
        ..velocity = Math.Vec2(0.75, 0.0)
        ..mass = 1.0
        ..restitution = 0.72
        ..friction = 0.45
        ..allow_sleep = false
    )
    falling.append(FallingBody(
        body, circle_origin, Math.Vec2(0.75, 0.0), 0.0, 0.0
    ))

    let capsule_origin = Math.Vec2(-5.6, 6.5)
    body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.capsule(Physics.Capsule2D(
            Math.Vec2(-0.48, 0.0), Math.Vec2(0.48, 0.0), 0.25
        ))
        ..position = capsule_origin
        ..velocity = Math.Vec2(0.25, 0.0)
        ..rotation = 0.18
        ..angular_velocity = 0.55
        ..mass = 1.0
        ..restitution = 0.4
        ..friction = 0.8
        ..allow_sleep = false
    )
    falling.append(FallingBody(
        body, capsule_origin, Math.Vec2(0.25, 0.0), 0.18, 0.55
    ))

    let polygon_origin = Math.Vec2(-3.8, 8.1)
    body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
            Math.Vec2(-0.5, -0.38), Math.Vec2(0.5, -0.38),
            Math.Vec2(0.42, 0.45), Math.Vec2(-0.42, 0.45)
        ], 0.1))
        ..position = polygon_origin
        ..velocity = Math.Vec2(-0.2, 0.0)
        ..rotation = 0.22
        ..angular_velocity = -0.42
        ..mass = 1.0
        ..restitution = 0.45
        ..friction = 1.0
        ..allow_sleep = false
    )
    falling.append(FallingBody(
        body, polygon_origin, Math.Vec2(-0.2, 0.0), 0.22, -0.42
    ))

    let box_origin = Math.Vec2(-2.2, 6.9)
    body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.75), 0.1))
        ..position = box_origin
        ..velocity = Math.Vec2(-0.45, 0.0)
        ..rotation = -0.12
        ..angular_velocity = 0.35
        ..mass = 1.0
        ..restitution = 0.58
        ..friction = 0.7
        ..allow_sleep = false
    )
    falling.append(FallingBody(
        body, box_origin, Math.Vec2(-0.45, 0.0), -0.12, 0.35
    ))
    return falling
}

func add_joints(world:Physics.World2D) JointAnimation {
    var fixed_body = make_fixed(world, Math.Vec2(2.1, 7.1), "distance")
    var moving = make_joint_body(world, Math.Vec2(3.1, 7.1))
    var distance = world.create_distance_joint(fixed_body, moving,
        Physics.DistanceJoint2DSettings()
            ..first_anchor = Math.Vec2(2.1, 7.1)
            ..second_anchor = Math.Vec2(3.1, 7.1)
            ..length = 1.0
            ..spring_enabled = true
            ..spring_hertz = 2.0
            ..spring_damping_ratio = 0.45)

    fixed_body = make_fixed(world, Math.Vec2(5.8, 7.1), "filter")
    moving = make_joint_body(world, Math.Vec2(6.8, 7.1))
    world.create_filter_joint(fixed_body, moving)
    moving.set_velocity(Math.Vec2(0.0, 0.8))

    fixed_body = make_fixed(world, Math.Vec2(2.1, 5.1), "motor")
    moving = make_joint_body(world, Math.Vec2(3.1, 5.1))
    var motor = world.create_motor_joint(fixed_body, moving,
        Physics.MotorJoint2DSettings()
            ..linear_offset = Math.Vec2(1.0, 0.0)
            ..maximum_force = 120.0
            ..maximum_torque = 120.0)

    moving = make_joint_body(world, Math.Vec2(6.8, 5.1))
    var mouse = world.create_mouse_joint(moving, Physics.MouseJoint2DSettings()
        ..target = Math.Vec2(6.8, 5.1)
        ..maximum_force = 120.0)

    fixed_body = make_fixed(world, Math.Vec2(2.1, 3.0), "prismatic")
    moving = make_joint_body(world, Math.Vec2(3.1, 3.0))
    var prismatic = world.create_prismatic_joint(fixed_body, moving,
        Physics.PrismaticJoint2DSettings()
            ..anchor = Math.Vec2(2.6, 3.0)
            ..axis = Math.Vec2(1.0, 0.0)
            ..spring_enabled = true
            ..spring_hertz = 2.2
            ..spring_damping_ratio = 0.5
            ..lower_translation = -0.5
            ..upper_translation = 0.5
            ..limit_enabled = true)

    fixed_body = make_fixed(world, Math.Vec2(5.8, 3.0), "revolute")
    moving = make_joint_body(world, Math.Vec2(6.8, 3.0))
    var revolute = world.create_revolute_joint(fixed_body, moving,
        Physics.RevoluteJoint2DSettings()
            ..anchor = Math.Vec2(6.3, 3.0)
            ..spring_enabled = true
            ..spring_hertz = 2.0
            ..spring_damping_ratio = 0.45
            ..lower_angle = -0.8
            ..upper_angle = 0.8
            ..limit_enabled = true)

    fixed_body = make_fixed(world, Math.Vec2(2.1, 1.0), "weld")
    moving = make_joint_body(world, Math.Vec2(3.1, 1.0))
    world.create_weld_joint(fixed_body, moving,
        Physics.WeldJoint2DSettings() ..anchor = Math.Vec2(2.6, 1.0))

    fixed_body = make_fixed(world, Math.Vec2(5.8, 1.0), "wheel")
    moving = make_joint_body(world, Math.Vec2(6.8, 1.0))
    var wheel = world.create_wheel_joint(fixed_body, moving,
        Physics.WheelJoint2DSettings()
            ..anchor = Math.Vec2(6.3, 1.0)
            ..axis = Math.Vec2(0.0, 1.0)
            ..spring_enabled = true
            ..spring_hertz = 2.0
            ..spring_damping_ratio = 0.45
            ..motor_enabled = true
            ..maximum_motor_torque = 120.0)

    return JointAnimation(
        distance,
        motor,
        mouse,
        prismatic,
        revolute,
        wheel
    )
}

func header_drawing() Canvas.Canvas {
    return Canvas.Canvas()
        ..paint(func(painter:&Canvas.Painter) {
            painter.fill(
                Canvas.Rect(Math.Vec2(), Math.Vec2(700.0, 54.0), 8.0),
                Canvas.Fill.solid(Color.black().with_alpha(0.78))
            )
            painter.text(
                "PHYSICS DEBUG DRAW  |  GRAVITY (0, -9.81) m/s²",
                Math.Vec2(14.0, 9.0),
                Canvas.TextStyle(size:14.0, color:Color.cyan_300())
            )
            painter.text(
                "metres · fixed 60 Hz · falling bodies · contacts · joints",
                Math.Vec2(14.0, 31.0),
                Canvas.TextStyle(size:12.0, color:Color.slate_300())
            )
        })
}

class Showcase {
    private var world:Physics.World2D
    private var settings:Physics.World2DDebugSettings
    private var snapshot:Physics.World2DDebugSnapshot
    private var canvas:Canvas.Canvas
    private var falling:FallingBody[]
    private var joints:JointAnimation
    private var accumulator:float
    private var elapsed:float
    private var respawn_elapsed:float
    private var next_respawn:int

    init() {
        self.world = Physics.World2D(gravity:Math.Vec2(0.0, -9.81))
        self.falling = add_gravity_scene(self.world)
        self.joints = add_joints(self.world)
        self.settings = Physics.World2DDebugSettings()
            ..shapes = true
            ..joints = true
            ..bounds = true
            ..centers_of_mass = true
            ..labels = true
            ..contacts = true
            ..contact_normals = true
            ..contact_impulses = true
            ..islands = true
            ..constraint_graph = true
            ..line_width = 0.025
            ..contact_radius = 0.065
            ..normal_length = 0.3
            ..impulse_scale = 0.04
            ..label_size = 0.2
        self.snapshot = Physics.World2DDebugSnapshot()
        self.canvas = Canvas.Canvas()
        self.accumulator = 0.0
        self.elapsed = 0.0
        self.respawn_elapsed = 0.0
        self.next_respawn = 0
        self.advance_fixed_step()
        self.redraw()
        assert(self.world.gravity() == Math.Vec2(0.0, -9.81))
        assert(self.snapshot.line_count() > 80)
        assert(self.snapshot.circle_count() > 20)
        assert(self.snapshot.label_count() > 8)
    }

    private func advance_fixed_step() {
        self.elapsed += Demo.fixed_delta
        self.joints.retarget(self.elapsed)
        self.world.step(Demo.fixed_delta)
    }

    private func redraw() {
        self.world.write_debug_snapshot(self.settings, self.snapshot)
        Physics.World2DDebug.draw(self.snapshot, self.canvas)
    }

    private func restart_next_body() {
        var falling = self.falling[self.next_respawn]
        falling.restart()
        self.next_respawn = (self.next_respawn + 1) % self.falling.count()
    }

    func drawing() Canvas.Canvas { return self.canvas }

    func update(delta:float) {
        let frame_delta = Math.min(delta, Demo.maximum_frame_delta)
        self.accumulator += frame_delta
        self.respawn_elapsed += frame_delta
        while self.respawn_elapsed >= Demo.respawn_interval {
            self.restart_next_body()
            self.respawn_elapsed -= Demo.respawn_interval
        }
        while self.accumulator >= Demo.fixed_delta {
            self.advance_fixed_step()
            self.accumulator -= Demo.fixed_delta
        }
        self.redraw()
    }

    func verify_motion() {
        var probe = self.falling[0]
        let initial = probe.body.position()
        var frame = 0
        while frame < 30 {
            self.update(Demo.fixed_delta)
            frame++
        }
        let final_position = probe.body.position()
        assert(final_position.y < initial.y - 0.5)
        while frame < 120 {
            self.update(Demo.fixed_delta)
            frame++
        }
        assert(self.snapshot.line_count() > 80)
        assert(self.snapshot.circle_count() > 20)
    }
}

func create_scene(
    world:&Resources.World,
    showcase:&Showcase
) {
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Camera2D())
    )
    var debug_canvas = Components.Canvas(showcase.drawing())
    debug_canvas.layer = 1
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(
            position:Math.Vec2(0.0, -240.0),
            scale:Math.Vec2(Demo.pixels_per_meter, -Demo.pixels_per_meter)
        ))
        ..with(debug_canvas)
    )
    var header = header_drawing()
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Math.Vec2(16.0)))
        ..with(Components.Canvas(header, 700, 54)
            ..anchor = Math.Vec2()
            ..pivot = Math.Vec2()
            ..space = Components.CanvasSpace.viewport
            ..layer = 100
        )
    )
}

func update_scene(
    time:@Resources.FrameTime,
    showcase:&Showcase
) {
    showcase.update(time.delta)
}

func main() {
    var showcase = Showcase()
    if verification_mode() {
        showcase.verify_motion()
        return
    }
    Application()
        ..add_resource(showcase)
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "GFX.Physics — SI gravity debug draw"
            ..width = Demo.window_width
            ..height = Demo.window_height
            ..resizable = false
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.FPSPanel())
        ..add_plugin(Plugins.Time())
        ..add_system(Application.Schedule.startup, create_scene)
        ..add_system(Application.Schedule.update, update_scene)
        ..run()
}
