use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use GFX.Scene2D
use STD.Math
use STD.Process

static struct Demo {
    let window_width:int = 620
    let window_height:int = 650
    let pixels_per_meter:float = 62.0
    let fixed_delta:float = 1.0 / 60.0
    let maximum_frame_delta:float = 0.05
    let horizontal_offset:float = 4.45
    let physics_origin_y:float = -240.0
}

class VerificationRun {
    let enabled:bool
    var frames:int

    init(enabled:bool) {
        self.enabled = enabled
        self.frames = 0
    }
}

func verification_mode() bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--verify" { return true }
            }
        }
    }
    return false
}

func point(x:float, y:float) Math.Vec2 {
    return Math.Vec2(x - Demo.horizontal_offset, y)
}

struct JointAnimation {
    var distance:Physics.DistanceJoint2D
    var motor:Physics.MotorJoint2D
    var mouse:Physics.MouseJoint2D
    var prismatic:Physics.PrismaticJoint2D
    var revolute:Physics.RevoluteJoint2D
    var wheel:Physics.WheelJoint2D
    var probe:Physics.RigidBody2D

    init(
        distance:Physics.DistanceJoint2D,
        motor:Physics.MotorJoint2D,
        mouse:Physics.MouseJoint2D,
        prismatic:Physics.PrismaticJoint2D,
        revolute:Physics.RevoluteJoint2D,
        wheel:Physics.WheelJoint2D,
        probe:Physics.RigidBody2D
    ) {
        self.distance = distance
        self.motor = motor
        self.mouse = mouse
        self.prismatic = prismatic
        self.revolute = revolute
        self.wheel = wheel
        self.probe = probe
    }

    func retarget(elapsed:float) {
        self.distance.set_length(1.0 + Math.sin(elapsed * 1.7) * 0.28)
        self.motor.set_offsets(
            Math.Vec2(
                1.0 + Math.cos(elapsed * 1.3) * 0.3,
                Math.sin(elapsed * 1.3) * 0.25
            ),
            Math.sin(elapsed) * 0.45
        )
        self.mouse.set_target(point(
            6.8 + Math.cos(elapsed * 1.2) * 0.65,
            5.1 + Math.sin(elapsed * 1.6) * 0.45
        ))
        self.prismatic.set_target_translation(Math.sin(elapsed * 1.8) * 0.45)
        self.revolute.set_target_angle(Math.sin(elapsed * 1.5) * 0.75)
        self.wheel.set_motor(Math.cos(elapsed * 1.4) * 4.0, 120.0)
    }
}

func make_fixed(
    world:Physics.World2D,
    position:Math.Vec2,
    label:str
) Physics.RigidBody2D {
    return world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.18))
        ..position = position
        ..debug_label = label
    )
}

func make_joint_body(
    world:Physics.World2D,
    position:Math.Vec2
) Physics.RigidBody2D {
    return world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.42)))
        ..position = position
        ..gravity_scale = 0.0
        ..mass = 1.0
        ..linear_damping = 0.25
        ..angular_damping = 0.2
        ..allow_sleep = false
    )
}

func add_joints(world:Physics.World2D) JointAnimation {
    var fixed_body = make_fixed(world, point(2.1, 7.1), "distance")
    var moving = make_joint_body(world, point(3.1, 7.1))
    var distance = world.create_distance_joint(fixed_body, moving,
        Physics.DistanceJoint2DSettings()
            ..first_anchor = point(2.1, 7.1)
            ..second_anchor = point(3.1, 7.1)
            ..length = 1.0
            ..spring_enabled = true
            ..spring_hertz = 2.0
            ..spring_damping_ratio = 0.45)

    fixed_body = make_fixed(world, point(5.8, 7.1), "filter")
    moving = make_joint_body(world, point(6.8, 7.1))
    world.create_filter_joint(fixed_body, moving)
    moving.set_velocity(Math.Vec2(0.0, 0.8))

    fixed_body = make_fixed(world, point(2.1, 5.1), "motor")
    moving = make_joint_body(world, point(3.1, 5.1))
    var motor = world.create_motor_joint(fixed_body, moving,
        Physics.MotorJoint2DSettings()
            ..linear_offset = Math.Vec2(1.0, 0.0)
            ..maximum_force = 120.0
            ..maximum_torque = 120.0)

    moving = make_joint_body(world, point(6.8, 5.1))
    var mouse = world.create_mouse_joint(moving, Physics.MouseJoint2DSettings()
        ..target = point(6.8, 5.1)
        ..maximum_force = 120.0)

    fixed_body = make_fixed(world, point(2.1, 3.0), "prismatic")
    moving = make_joint_body(world, point(3.1, 3.0))
    var prismatic = world.create_prismatic_joint(fixed_body, moving,
        Physics.PrismaticJoint2DSettings()
            ..anchor = point(2.6, 3.0)
            ..axis = Math.Vec2(1.0, 0.0)
            ..spring_enabled = true
            ..spring_hertz = 2.2
            ..spring_damping_ratio = 0.5
            ..lower_translation = -0.5
            ..upper_translation = 0.5
            ..limit_enabled = true)

    fixed_body = make_fixed(world, point(5.8, 3.0), "revolute")
    moving = make_joint_body(world, point(6.8, 3.0))
    var revolute = world.create_revolute_joint(fixed_body, moving,
        Physics.RevoluteJoint2DSettings()
            ..anchor = point(6.3, 3.0)
            ..spring_enabled = true
            ..spring_hertz = 2.0
            ..spring_damping_ratio = 0.45
            ..lower_angle = -0.8
            ..upper_angle = 0.8
            ..limit_enabled = true)

    fixed_body = make_fixed(world, point(2.1, 1.0), "weld")
    moving = make_joint_body(world, point(3.1, 1.0))
    world.create_weld_joint(fixed_body, moving,
        Physics.WeldJoint2DSettings() ..anchor = point(2.6, 1.0))

    fixed_body = make_fixed(world, point(5.8, 1.0), "wheel")
    moving = make_joint_body(world, point(6.8, 1.0))
    var wheel = world.create_wheel_joint(fixed_body, moving,
        Physics.WheelJoint2DSettings()
            ..anchor = point(6.3, 1.0)
            ..axis = Math.Vec2(0.0, 1.0)
            ..spring_enabled = true
            ..spring_hertz = 2.0
            ..spring_damping_ratio = 0.45
            ..motor_enabled = true
            ..maximum_motor_torque = 120.0)

    return JointAnimation(
        distance,
        motor,
        mouse,
        prismatic,
        revolute,
        wheel,
        moving
    )
}

func live_debug_settings() Physics.World2DDebugSettings {
    return Physics.World2DDebugSettings()
        ..shapes = true
        ..joints = true
        ..bounds = true
        ..centers_of_mass = true
        ..labels = false
        ..contacts = false
        ..contact_normals = false
        ..contact_impulses = false
        ..islands = true
        ..constraint_graph = true
        ..line_width = 0.025
        ..contact_radius = 0.065
}

func static_label_settings() Physics.World2DDebugSettings {
    return Physics.World2DDebugSettings()
        ..shapes = false
        ..joints = false
        ..labels = true
        ..label_size = 0.2
}

func label_screen_position(position:Math.Vec2) Math.Vec2 {
    return Math.Vec2(
        Demo.window_width as float * 0.5 + position.x * Demo.pixels_per_meter,
        Demo.window_height as float * 0.5 - Demo.physics_origin_y -
            position.y * Demo.pixels_per_meter
    )
}

func label_drawing(snapshot:Physics.World2DDebugSnapshot) Canvas.Canvas {
    return Canvas.Canvas()
        ..paint(func(painter:&Canvas.Painter) {
            var index = 0
            while index < snapshot.label_count() {
                let label = snapshot.label(index)
                painter.text(
                    label.text,
                    label_screen_position(label.position),
                    Canvas.TextStyle(
                        size:label.size * Demo.pixels_per_meter,
                        color:label.color
                    )
                )
                index++
            }
        })
}

func header_drawing() Canvas.Canvas {
    return Canvas.Canvas()
        ..paint(func(painter:&Canvas.Painter) {
            painter.fill(
                Canvas.Rect(Math.Vec2(), Math.Vec2(588.0, 54.0), 8.0),
                Canvas.Fill.solid(Color.black().with_alpha(0.78))
            )
            painter.text(
                "PHYSICS JOINT DEBUG DRAW  |  8 JOINT FAMILIES",
                Math.Vec2(14.0, 9.0),
                Canvas.TextStyle(size:14.0, color:Color.amber_300())
            )
            painter.text(
                "fixed 60 Hz · animated targets · bounds · centers · graph colors",
                Math.Vec2(14.0, 31.0),
                Canvas.TextStyle(size:12.0, color:Color.slate_300())
            )
        })
}

class Showcase {
    private var world:Physics.World2D
    private var settings:Physics.World2DDebugSettings
    private var snapshot:Physics.World2DDebugSnapshot
    private var label_snapshot:Physics.World2DDebugSnapshot
    private var canvas:Canvas.Canvas
    private var label_canvas:Canvas.Canvas
    private var joints:JointAnimation
    private var accumulator:float
    private var elapsed:float

    init() {
        self.world = Physics.World2D(gravity:Math.Vec2())
        self.joints = add_joints(self.world)
        self.settings = live_debug_settings()
        self.snapshot = Physics.World2DDebugSnapshot()
        self.label_snapshot = Physics.World2DDebugSnapshot()
        self.canvas = Canvas.Canvas()
        self.label_canvas = Canvas.Canvas()
        self.accumulator = 0.0
        self.elapsed = 0.0
        self.advance_fixed_step()
        self.redraw()
        self.world.write_debug_snapshot(
            static_label_settings(),
            self.label_snapshot
        )
        self.label_canvas = label_drawing(self.label_snapshot)
        assert(self.world.gravity() == Math.Vec2())
        assert(self.snapshot.line_count() > 40)
        assert(self.snapshot.circle_count() > 12)
        assert(self.label_snapshot.label_count() == 7)
        assert(label_screen_position(Math.Vec2(0.0, 1.0)).y <
            label_screen_position(Math.Vec2()).y)
    }

    private func advance_fixed_step() {
        self.elapsed += Demo.fixed_delta
        self.joints.retarget(self.elapsed)
        self.world.step(Demo.fixed_delta)
    }

    private func redraw() {
        self.world.write_debug_snapshot(self.settings, self.snapshot)
        Physics.World2DDebug.draw(self.snapshot, self.canvas)
    }

    func drawing() Canvas.Canvas { return self.canvas }
    func labels() Canvas.Canvas { return self.label_canvas }

    func update(delta:float) {
        let frame_delta = Math.min(delta, Demo.maximum_frame_delta)
        self.accumulator += frame_delta
        var advanced = false
        while self.accumulator >= Demo.fixed_delta {
            self.advance_fixed_step()
            self.accumulator -= Demo.fixed_delta
            advanced = true
        }
        if advanced { self.redraw() }
    }

    func verify_motion() {
        let initial = self.joints.probe.position()
        var frame = 0
        while frame < 120 {
            self.update(Demo.fixed_delta)
            frame++
        }
        let final_position = self.joints.probe.position()
        assert(final_position != initial)
        assert(self.snapshot.line_count() > 40)
        assert(self.snapshot.circle_count() > 12)
        assert(self.label_snapshot.label_count() == 7)
    }
}

func create_scene(
    world:&Resources.World,
    showcase:&Showcase
) {
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Camera2D())
    )
    var debug_canvas = Components.Canvas(showcase.drawing())
    debug_canvas.layer = 1
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(
            position:Math.Vec2(0.0, Demo.physics_origin_y),
            scale:Math.Vec2(Demo.pixels_per_meter, -Demo.pixels_per_meter)
        ))
        ..with(debug_canvas)
    )
    var label_canvas = Components.Canvas(showcase.labels())
    label_canvas.layer = 2
    label_canvas.space = Components.CanvasSpace.viewport
    label_canvas.text_mode = Scene2D.CanvasTextMode.vector
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(label_canvas)
    )
    var header = header_drawing()
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Math.Vec2(16.0)))
        ..with(Components.Canvas(header, 588, 54)
            ..anchor = Math.Vec2()
            ..pivot = Math.Vec2()
            ..space = Components.CanvasSpace.viewport
            ..layer = 100
        )
    )
}

func update_scene(
    time:@Resources.FrameTime,
    showcase:&Showcase
) {
    showcase.update(time.delta)
}

func finish_verification(
    run:&VerificationRun,
    controller:&Application.Controller
) {
    if !run.enabled { return }
    run.frames++
    if run.frames == 3 { controller.stop() }
}

func main() {
    let verification = verification_mode()
    var showcase = Showcase()
    if verification { showcase.verify_motion() }
    var run = VerificationRun(verification)
    var application = Application()
        ..add_resource(showcase)
        ..add_resource(run)
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "GFX.Physics — animated joint debug draw"
            ..width = Demo.window_width
            ..height = Demo.window_height
            ..resizable = false
            ..hidden = verification
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
            ..antialiasing = Plugins.RenderingAntialiasing.none
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.FPSPanel())
        ..add_plugin(Plugins.Time())
        ..add_system(Application.Schedule.startup, create_scene)
        ..add_system(Application.Schedule.update, update_scene)
        ..add_after_system(Application.Schedule.render, finish_verification)
    assert(application.run() == 0)
    if verification { assert(run.frames == 3) }
}
