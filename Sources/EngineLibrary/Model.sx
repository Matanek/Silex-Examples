use GFX.Audio.Engines
use GFX.UI
use GFX.Color
use STD.Math
use Module.Widgets
use Module.Widgets.Knob
use Module.Tachometer.Tachometer

// Only input and presentation live here. GFX.Audio owns every sound-producing step.
public class Bench {
    var source:Engines.Engine
    let reference_mode:bool = true
    var reference_ready:bool = false
    var profile_generation:int = 0
    var accelerating:bool = false
    var braking:bool = false
    private var driving:bool = false
    private var automatic:bool = true
    private var requested_gear:int = 0
    private var road:UI.State<bool> = UI.State<bool>(false)
    var focused:bool = true
    var base_rpm:float = 800.0
    var notice:str = ""
    private var library:Engines.Library
    private var running:bool = false
    private var power_state:UI.State<bool> = UI.State<bool>(false)
    private var auto_state:UI.State<bool> = UI.State<bool>(true)
    private var gearing_open:UI.State<bool> = UI.State<bool>(false)
    private var configured_gearing:Engines.Gearing? = null
    private var final_drive:Knob = Knob("Rapport de pont", 3.73, 0.05, 20.0, precision:1_000.0)
    private var ratios:Knob[] = []
    private var selection:UI.State<int?> = UI.State<int?>(0)
    private var selected:int = 0
    private var idle:Knob = Knob("Régime de maintien", 800.0, 700.0, 4_000.0, "tr/min")
    private var exhaust:Knob = Knob("Échappement · brut → filtré", 1.0, 0.0, 1.0)
    private var texture:Knob = Knob("Texture", 1.0, 0.0, 1.0)
    private var load:Knob = Knob("Charge", 0.2, 0.0, 1.0)
    private var intake:Knob = Knob("Admission du 4T", 0.0, 0.0, 1.0)
    private var ambience:Knob = Knob("Ambiance", 0.0, 0.0, 1.0)
    private var volume:Knob = Knob("Volume", 0.7, 0.0, 1.0)
    init(directory:str) {
        self.library = Engines.Library.open(directory); self.source = self.library.engine(); self.prepare_gearing()
    }
    func profile() Engines.Profile { return self.source.profile }
    func rpm() float { return self.source.current_rpm() }
    func is_starting() bool { return self.source.is_starting() }
    func is_running() bool { return self.running }
    func road_mode() bool { return self.driving }
    func auto_mode() bool { return self.automatic }
    func gear() int { if let state = self.source.drive_state() { return state.gear } return 0 }
    func speed() float { if let state = self.source.drive_state() { return state.speed_kmh } return 0.0 }
    func shift_flags() int {
        if let state = self.source.drive_state() {
            var flags = 0; if state.shifting { flags += 1 } if state.shift_refused { flags += 2 } return flags
        }
        return 0
    }
    private func transmission() Engines.Transmission? {
        if !self.driving { return null }
        if self.automatic { return Engines.Transmission.automatic }
        return Engines.Transmission.manual
    }
    private func can_change() bool { return !self.running && self.rpm() < 5.0 && self.speed() < 0.5 }
    func road_changed(value:bool) {
        if self.running { self.road.set(self.driving); self.notice = "Coupez le contact pour changer de mode."; return }
        self.driving = value; self.road.set(value)
        self.replace(self.profile().key)
    }
    private func replace(key:str) {
        var gearing:Engines.Gearing? = null
        if self.driving { gearing = self.configured_gearing }
        self.install(self.library.engine(key, transmission:self.transmission(), gearing:gearing))
    }
    private func install(source:Engines.Engine) {
        self.source = source
        self.requested_gear = 0; self.accelerating = false; self.braking = false
        self.profile_generation++; self.reference_ready = false; self.notice = ""; self.sync()
    }
    func toggle_auto() {
        if !self.driving { return }
        self.automatic = !self.automatic; self.auto_state.set(self.automatic); self.requested_gear = self.gear(); self.notice = ""; self.sync()
    }
    func shift_up() {
        if !self.driving { return }
        if self.automatic { self.requested_gear = self.gear() }
        self.automatic = false; self.auto_state.set(false)
        if self.requested_gear < self.source.gearing.ratios.count() { self.requested_gear++ }
        self.notice = ""; self.sync()
    }
    func shift_down() {
        if !self.driving { return }
        if self.automatic { self.requested_gear = self.gear() }
        self.automatic = false; self.auto_state.set(false)
        if self.requested_gear > 0 { self.requested_gear-- }
        self.notice = ""; self.sync()
    }
    func neutral() { if self.driving { self.automatic = false; self.auto_state.set(false); self.requested_gear = 0; self.notice = ""; self.sync() } }
    func toggle_running() { self.running = !self.running; self.power_state.set(self.running); self.accelerating = false; self.sync() }
    func changed(value:float) { self.sync() }
    func sync() {
        self.base_rpm = self.idle.value()
        self.source.set_controls(Engines.Controls(running:self.running, accelerating:self.accelerating && self.focused,
            idle_rpm:self.base_rpm, exhaust:self.exhaust.value(), texture:self.texture.value(), load:self.load.value(),
            intake:self.intake.value(), ambience:self.ambience.value(), volume:self.volume.value(),
            transmission:self.transmission(), gear:self.requested_gear, braking:self.braking && self.focused))
    }
    func restore() {
        self.idle.set(800.0); self.exhaust.set(1.0); self.texture.set(1.0); self.load.set(0.2)
        self.intake.set(self.profile().intake); self.ambience.set(0.0); self.volume.set(0.7); self.sync()
    }
    func choose(index:int) {
        if !self.can_change() {
            self.selection.set(self.selected); self.notice = "Coupez le moteur et immobilisez le véhicule pour changer."; return
        }
        let profiles = self.library.profiles()
        if index < 0 || index >= profiles.count() { return }
        self.configured_gearing = null
        self.replace(profiles[index].key); self.prepare_gearing()
        self.selected = index; self.selection.set(index)
        self.reference_ready = false; self.notice = ""; self.restore()
    }
    private func prepare_gearing() {
        let stock = self.profile().gearing
        self.final_drive.set(round_float<float>(stock.final_drive)); self.ratios = []
        for i, ratio in stock.ratios.indexed() {
            self.ratios.append(Knob("Rapport $(i + 1)", round_float<float>(ratio), 0.05, 20.0, precision:1_000.0))
        }
    }
    func apply_gearing() {
        if !self.driving || !self.can_change() { self.notice = "Appliquez la démultiplication moteur et véhicule arrêtés."; return }
        var values:float64[] = []
        for var knob in self.ratios { values.append(Math.round(knob.value() as float64 * 1_000.0) / 1_000.0) }
        let gearing = Engines.Gearing(ratios:values, final_drive:Math.round(self.final_drive.value() as float64 * 1_000.0) / 1_000.0)
        match try gearing.validate() {
            failure(error) => { self.notice = "Les rapports doivent décroître de la première à la dernière." }
            success => {
                var engine = try self.library.engine(self.profile().key, transmission:self.transmission(), gearing:gearing) else error {
                    self.notice = error.detail; return
                }
                self.configured_gearing = gearing; self.install(engine)
                self.notice = "Démultiplication appliquée."
            }
        }
    }
    func restore_gearing() {
        if !self.driving || !self.can_change() { self.notice = "Restaurez les rapports moteur et véhicule arrêtés."; return }
        self.configured_gearing = null; self.replace(self.profile().key); self.prepare_gearing()
        self.notice = "Rapports d’origine rétablis."
    }
    func toggle_gearing() { self.gearing_open.set(!self.gearing_open.value()) }
    func power_view(reads:UI.Reads) UI.View {
        var label = "Démarrer · M"; if reads.read(self.power_state) { label = "Arrêter · M" }
        return Widgets.button(label, self.toggle_running)
    }
    func automatic_view(reads:UI.Reads) UI.View {
        var label = "Passer en automatique · A"; if reads.read(self.auto_state) { label = "Passer en manuel · A" }
        return Widgets.button(label, self.toggle_auto)
    }
    func gearing_view(reads:UI.Reads) UI.View {
        let opened = reads.read(self.gearing_open)
        var label = "Régler la démultiplication"; if opened { label = "Masquer la démultiplication" }
        var content:UI.View[] = [Widgets.button(label, self.toggle_gearing)]
        if opened {
            content.append(Widgets.text("Valeur plus élevée : rapport plus court.", 12.0))
            content.append(Widgets.text("Appliquer moteur et véhicule arrêtés.", 12.0))
            content.append(self.final_drive.view(self.gearing_changed))
            for var knob in self.ratios { content.append(knob.view(self.gearing_changed)) }
            content.append(Widgets.button("Appliquer la démultiplication", self.apply_gearing))
            content.append(Widgets.button("Rapports d’origine", self.restore_gearing))
        }
        var result = UI.Column(content); result.style.gap = 12.0; return result
    }
    func gearing_changed(value:float) {}
    func view() UI.View {
        var options:UI.SelectOption<int>[] = []
        for i, profile in self.library.profiles().indexed() { options.append(UI.SelectOption<int>(i, profile.label)) }
        var select_style = UI.Style(); select_style.height = 42.0; select_style.padding = UI.Insets(8.0)
        select_style.background = Color.slate_700(); select_style.foreground = Color.slate_100(); select_style.radius = 8.0
        var tools = UI.Row([UI.Select<int>(options, self.selection, on_change:self.choose, style:select_style),
            UI.Reactive(self.power_view), Widgets.button("Réglages initiaux", self.restore)], wrap:true)
        tools.style.gap = 12.0
        var dial = UI.CustomView(Tachometer(self)); dial.style.width = 520.0; dial.style.height = 500.0
        dial.style.minimum_width = 280.0; dial.style.grow = 1.0
        var route = UI.Checkbox("Mode Route · boîte de vitesses", self.road, on_change:self.road_changed)
        route.style.foreground = Color.slate_100()
        var controls:UI.View[] = [route]
        if self.driving {
            var gears = UI.Row([Widgets.button("− · ↓", self.shift_down), Widgets.button("N", self.neutral), Widgets.button("+ · ↑", self.shift_up)])
            gears.style.gap = 8.0
            controls.append(UI.Reactive(self.automatic_view)); controls.append(gears)
            controls.append(Widgets.text("S maintenu : freiner", 13.0, Color.amber_200()))
            controls.append(UI.Reactive(self.gearing_view))
        } else { controls.append(self.idle.view(self.changed)); controls.append(self.load.view(self.changed)) }
        controls.append(self.exhaust.view(self.changed)); controls.append(self.texture.view(self.changed))
        if self.profile().key == "cross4" { controls.append(self.intake.view(self.changed)) }
        controls.append(self.ambience.view(self.changed)); controls.append(self.volume.view(self.changed))
        var panel = Widgets.card("Réglages du banc validé", "Espace maintenu : accélérer · relâcher : décélérer", controls)
        var body = UI.Row([dial, panel], wrap:true); body.style.gap = 18.0
        var content = UI.Column([Widgets.text("Moteurs — GFX.Audio", 28.0),
            Widgets.text("Chaîne sonore de la première démo · bibliothèque réutilisable", 14.0, Color.slate_400()), tools, body])
        content.style.padding = UI.Insets(22.0); content.style.gap = 16.0
        content.style.background = Color.bytes(8, 13, 20)
        return UI.ScrollView(content, smooth_scroll:true)
    }
}
