use Package.World3D.FPSController
use GFX.Physics
use STD.Math

func floor(world:Physics.World3D) {
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(100.0, 1.0, 100.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, -0.5, 0.0)))
}
func jump_peak(release:bool) float {
    var world = Physics.World3D()
    floor(world)
    var controller = FPSController()
    controller.step(world, FPSController.Commands(), 1.0 / 120.0)
    assert(controller.grounded)
    var highest = controller.position.y
    var index = 0
    while index < 240 {
        var command = FPSController.Commands()
        command.jump_pressed = index == 0
        command.jump_released = release && index == 8
        controller.step(world, command, 1.0 / 120.0)
        highest = Math.max(highest, controller.position.y)
        index++
    }
    assert(controller.grounded)
    assert(Math.abs(controller.position.y - 0.852) < 0.005)
    return highest - 0.852
}
func jump_case() {
    let held = jump_peak(false)
    let cut = jump_peak(true)
    print("FPS jump height: held=$(held), released=$(cut)")
    assert(held > 1.8 && held < 1.95)
    assert(cut > 0.6 && cut < held - 0.3)
}
func movement_case() {
    var world = Physics.World3D()
    floor(world)
    var straight = FPSController()
    var diagonal = FPSController()
    var sprint = FPSController()
    straight.step(world, FPSController.Commands(), 1.0 / 120.0)
    diagonal.step(world, FPSController.Commands(), 1.0 / 120.0)
    sprint.step(world, FPSController.Commands(), 1.0 / 120.0)
    var i = 0
    while i < 120 {
        straight.step(world, FPSController.Commands() ..forward = 1.0, 1.0 / 120.0)
        diagonal.step(world, FPSController.Commands() ..forward = 1.0 ..right = 1.0, 1.0 / 120.0)
        sprint.step(world, FPSController.Commands() ..forward = 1.0 ..sprint = true, 1.0 / 120.0)
        i++
    }
    assert(Math.abs(straight.position.z - 2.0) < 0.01)
    assert(Math.abs(diagonal.position.subtract(Math.Vec3(0.0, 0.852, 8.0)).length() - 6.0) < 0.01)
    assert(Math.abs(sprint.position.z - 0.2) < 0.01)
    assert(sprint.field_of_view > straight.field_of_view + 10.0)
}
func crouch_slide_case() {
    var world = Physics.World3D()
    floor(world)
    var controller = FPSController()
    controller.step(world, FPSController.Commands(), 1.0 / 120.0)
    controller.step(world, FPSController.Commands() ..forward = 1.0 ..sprint = true, 1.0 / 120.0)
    controller.step(world, FPSController.Commands() ..forward = 1.0 ..sprint = true
        ..crouch_held = true ..crouch_pressed = true ..jump_pressed = true, 1.0 / 120.0)
    assert(controller.sliding && controller.grounded)
    assert(Math.abs(controller.velocity.z) > 7.5)
    var i = 0
    while i < 180 {
        controller.step(world, FPSController.Commands() ..forward = 1.0 ..crouch_held = true, 1.0 / 120.0)
        i++
    }
    assert(!controller.sliding && controller.grounded)
    assert(Math.abs(controller.velocity.z + 3.0) < 0.01)
    assert(Math.abs(controller.crouch_offset + 0.55) < 0.01)
    assert(Math.abs(controller.position.y - 0.852) < 0.005)
}
func coyote_case() {
    var world = Physics.World3D()
    floor(world)
    var controller = FPSController()
    controller.position = Math.Vec3(49.5, 0.852, 8.0)
    controller.step(world, FPSController.Commands(), 1.0 / 120.0)
    assert(controller.grounded)
    var i = 0
    while controller.grounded && i < 60 {
        controller.step(world, FPSController.Commands() ..right = 1.0, 1.0 / 120.0)
        i++
    }
    assert(!controller.grounded && i < 60)
    controller.step(world, FPSController.Commands() ..right = 1.0 ..jump_pressed = true, 1.0 / 120.0)
    assert(controller.velocity.y > 9.0)
    let first_velocity = controller.velocity.y
    controller.step(world, FPSController.Commands() ..right = 1.0 ..jump_pressed = true, 1.0 / 120.0)
    assert(controller.velocity.y < first_velocity)
}
func tilt_case() {
    var world = Physics.World3D()
    floor(world)
    let sides:float[] = [-1.0, 1.0]
    for side in sides {
        var controller = FPSController()
        controller.yaw = 0.7
        controller.step(world, FPSController.Commands(), 1.0 / 120.0)
        var i = 0
        while i < 60 {
            controller.step(world, FPSController.Commands() ..right = side, 1.0 / 120.0)
            i++
        }
        let right = Math.Quat.angle_axis(controller.yaw, Math.Vec3.up()).rotate(Math.Vec3.right())
        let camera_up = controller.rotation().rotate(Math.Vec3.up())
        assert(camera_up.dot(right) * side > 0.04)
    }
}
func support_eye(controller:FPSController, fraction:float) float {
    return controller.eye_position(fraction).y - 0.85 - controller.bob.y -
        controller.landing_dip - controller.crouch_offset
}
func stairs_case(height:float = 0.8) {
    var world = Physics.World3D()
    floor(world)
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(3.0, height, 2.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, height / 2.0, 5.0)))
    var controller = FPSController()
    controller.step(world, FPSController.Commands(), 1.0 / 120.0)
    var climbed = false
    var i = 0
    while i < 180 {
        let before = support_eye(controller, 1.0)
        let position_before = controller.position
        var command = FPSController.Commands()
        if i < 55 { command.forward = 1.0 }
        controller.step(world, command, 1.0 / 120.0)
        let moved = controller.position.subtract(position_before)
        assert(Math.Vec2(moved.x, moved.z).length() <= 6.0 / 120.0 + 0.0001)
        let start = support_eye(controller, 0.0)
        let end = support_eye(controller, 1.0)
        assert(Math.abs(start - before) < 0.0001)
        assert(Math.abs(end - start) <= 3.0 / 120.0 + 0.0001)
        assert(Math.abs(support_eye(controller, 0.5) - (start + end) * 0.5) < 0.0001)
        if controller.position.y > 0.84 + height { climbed = true }
        i++
    }
    assert(climbed && controller.grounded)
    assert(Math.abs(support_eye(controller, 1.0) - controller.position.y) < 0.001)
}
func footstep_case() {
    var world = Physics.World3D()
    floor(world)
    var controller = FPSController()
    controller.step(world, FPSController.Commands(), 1.0 / 120.0)
    assert(!controller.landed_event && !controller.step_event)
    var steps = 0
    var last_pan = 0.0
    var i = 0
    while i < 240 {
        controller.step(world, FPSController.Commands() ..forward = 1.0, 1.0 / 120.0)
        if controller.step_event {
            assert(controller.step_pan * last_pan <= 0.0)
            assert(Math.abs(controller.step_pan) == 0.1)
            last_pan = controller.step_pan
            steps++
        }
        i++
    }
    assert(steps >= 4 && steps <= 5)
    i = 0
    while i < 60 {
        controller.step(world, FPSController.Commands(), 1.0 / 120.0)
        assert(!controller.step_event && !controller.landed_event)
        i++
    }
    var landings = 0
    i = 0
    while i < 150 {
        controller.step(world, FPSController.Commands() ..jump_pressed = i == 0, 1.0 / 120.0)
        assert(!controller.step_event)
        if controller.landed_event { landings++ }
        i++
    }
    assert(landings == 1)
    controller.step(world, FPSController.Commands() ..forward = 1.0 ..sprint = true, 1.0 / 120.0)
    i = 0
    while i < 60 {
        controller.step(world, FPSController.Commands() ..forward = 1.0 ..sprint = true
            ..crouch_held = true ..crouch_pressed = i == 0, 1.0 / 120.0)
        assert(controller.sliding && !controller.step_event)
        i++
    }
}
func landing_height_case(height:float, expected:int, frequency:float = 120.0) {
    var world = Physics.World3D()
    floor(world)
    var controller = FPSController()
    controller.position.y += height
    var landings = 0
    var i = 0
    while i < frequency {
        controller.step(world, FPSController.Commands(), 1.0 / frequency)
        if controller.landed_event {
            assert(Math.abs(controller.landing_height - height) < 0.001)
            landings++
        } else {
            assert(controller.landing_height == 0.0)
        }
        i++
    }
    print("drop $(height) at $(frequency) Hz: $(landings) impacts")
    assert(controller.grounded && landings == expected)
}
func small_fall_cadence_case() {
    var world = Physics.World3D()
    floor(world)
    var controller = FPSController()
    var steps = 0
    var last_pan = 0.0
    var i = 0
    while i < 600 {
        // Reproduce brief unsupported transitions while preserving gait phase.
        if i == 110 || i == 210 || i == 310 || i == 410 {
            controller.position.y += 0.2
            controller.grounded = false
            controller.velocity.y = 0.0
        }
        controller.step(world, FPSController.Commands() ..forward = 1.0 ..sprint = true, 1.0 / 120.0)
        assert(!controller.landed_event)
        if controller.step_event {
            assert(controller.step_pan * last_pan < 0.0 || steps == 0)
            last_pan = controller.step_pan
            steps++
        }
        i++
    }
    assert(controller.grounded && steps >= 12)
}
func landing_heights() {
    landing_height_case(0.12, 0)
    landing_height_case(0.2, 0)
    landing_height_case(0.29, 0)
    landing_height_case(0.31, 1)
    landing_height_case(0.8, 1)
    landing_height_case(1.5, 1)
    landing_height_case(3.0, 1)
    landing_height_case(0.2, 0, 60.0)
    landing_height_case(0.8, 1, 60.0)
}
func wall_footstep_case() {
    var world = Physics.World3D()
    floor(world)
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(10.0, 5.0, 1.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 2.5, 6.0)))
    var controller = FPSController()
    var i = 0
    while i < 240 {
        controller.step(world, FPSController.Commands() ..forward = 1.0, 1.0 / 120.0)
        if i > 60 { assert(!controller.step_event) }
        i++
    }
}
func stair_jump_case() {
    var world = Physics.World3D()
    floor(world)
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(3.0, 0.8, 2.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 0.4, 5.0)))
    var controller = FPSController()
    var i = 0
    while controller.position.y < 1.6 && i < 120 {
        controller.step(world, FPSController.Commands() ..forward = 1.0, 1.0 / 120.0)
        i++
    }
    assert(i < 120 && controller.stair_offset < -0.5)
    let before = support_eye(controller, 1.0)
    let previous_y = controller.position.y
    controller.step(world, FPSController.Commands() ..jump_pressed = true, 1.0 / 120.0)
    assert(!controller.grounded)
    assert(Math.abs(support_eye(controller, 0.0) - before) < 0.0001)
    let ballistic = controller.position.y - previous_y
    assert(ballistic > 0.07)
    assert(support_eye(controller, 1.0) - before - ballistic <= 3.0 / 120.0 + 0.0001)
}
test "FPS footsteps alternate only while walking, with one landing event" { footstep_case() }
test "FPS landing impact requires a significant fall height" { landing_heights() }
test "FPS repeated micro falls preserve sprint footstep alternation" { small_fall_cadence_case() }
test "FPS pushing into a wall does not produce footsteps" { wall_footstep_case() }
test "FPS jumping during stair smoothing cannot snap the eye" { stair_jump_case() }
test "FPS strafe leans the camera toward the movement" { tilt_case() }
test "FPS stair camera stays continuous across fixed and render steps" { stairs_case() }
test "FPS small obstacle preserves walking speed and smooth camera" { stairs_case(0.12) }
test "WorldDemo jump height, variable jump and landing" { jump_case() }
test "WorldDemo speeds, normalized diagonals and sprint FOV" { movement_case() }
test "WorldDemo crouch and timed slide keep the full-height capsule" { crouch_slide_case() }
test "WorldDemo coyote time permits one jump after leaving a ledge" { coyote_case() }
func main() { landing_heights(); small_fall_cadence_case(); footstep_case(); wall_footstep_case(); stair_jump_case(); tilt_case(); stairs_case(); stairs_case(0.12); jump_case(); movement_case(); crouch_slide_case(); coyote_case(); print("FPS controller scenarios passed") }
