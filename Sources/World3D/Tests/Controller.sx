use Package.World3D.FPSController
use GFX.Physics
use STD.Math

func floor(world:Physics.World3D) {
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(100.0, 1.0, 100.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, -0.5, 0.0)))
}
func jump_peak(release:bool) float {
    var world = Physics.World3D()
    floor(world)
    var controller = FPSController()
    controller.step(world, FPSController.Commands(), 1.0 / 120.0)
    assert(controller.grounded)
    var highest = controller.position.y
    var index = 0
    while index < 240 {
        var command = FPSController.Commands()
        command.jump_pressed = index == 0
        command.jump_released = release && index == 8
        controller.step(world, command, 1.0 / 120.0)
        highest = Math.max(highest, controller.position.y)
        index++
    }
    assert(controller.grounded)
    assert(Math.abs(controller.position.y - 0.852) < 0.005)
    return highest - 0.852
}
func jump_case() {
    let held = jump_peak(false)
    let cut = jump_peak(true)
    print("FPS jump height: held=$(held), released=$(cut)")
    assert(held > 1.8 && held < 1.95)
    assert(cut > 0.6 && cut < held - 0.3)
}
func movement_case() {
    var world = Physics.World3D()
    floor(world)
    var straight = FPSController()
    var diagonal = FPSController()
    var sprint = FPSController()
    straight.step(world, FPSController.Commands(), 1.0 / 120.0)
    diagonal.step(world, FPSController.Commands(), 1.0 / 120.0)
    sprint.step(world, FPSController.Commands(), 1.0 / 120.0)
    var i = 0
    while i < 120 {
        straight.step(world, FPSController.Commands() ..forward = 1.0, 1.0 / 120.0)
        diagonal.step(world, FPSController.Commands() ..forward = 1.0 ..right = 1.0, 1.0 / 120.0)
        sprint.step(world, FPSController.Commands() ..forward = 1.0 ..sprint = true, 1.0 / 120.0)
        i++
    }
    assert(Math.abs(straight.position.z - 2.0) < 0.01)
    assert(Math.abs(diagonal.position.subtract(Math.Vec3(0.0, 0.852, 8.0)).length() - 6.0) < 0.01)
    assert(Math.abs(sprint.position.z - 0.2) < 0.01)
    assert(sprint.field_of_view > straight.field_of_view + 10.0)
}
func crouch_slide_case() {
    var world = Physics.World3D()
    floor(world)
    var controller = FPSController()
    controller.step(world, FPSController.Commands(), 1.0 / 120.0)
    controller.step(world, FPSController.Commands() ..forward = 1.0 ..sprint = true, 1.0 / 120.0)
    controller.step(world, FPSController.Commands() ..forward = 1.0 ..sprint = true
        ..crouch_held = true ..crouch_pressed = true ..jump_pressed = true, 1.0 / 120.0)
    assert(controller.sliding && controller.grounded)
    assert(Math.abs(controller.velocity.z) > 7.5)
    var i = 0
    while i < 180 {
        controller.step(world, FPSController.Commands() ..forward = 1.0 ..crouch_held = true, 1.0 / 120.0)
        i++
    }
    assert(!controller.sliding && controller.grounded)
    assert(Math.abs(controller.velocity.z + 3.0) < 0.01)
    assert(Math.abs(controller.crouch_offset + 0.55) < 0.01)
    assert(Math.abs(controller.position.y - 0.852) < 0.005)
}
func coyote_case() {
    var world = Physics.World3D()
    floor(world)
    var controller = FPSController()
    controller.position = Math.Vec3(49.5, 0.852, 8.0)
    controller.step(world, FPSController.Commands(), 1.0 / 120.0)
    assert(controller.grounded)
    var i = 0
    while controller.grounded && i < 60 {
        controller.step(world, FPSController.Commands() ..right = 1.0, 1.0 / 120.0)
        i++
    }
    assert(!controller.grounded && i < 60)
    controller.step(world, FPSController.Commands() ..right = 1.0 ..jump_pressed = true, 1.0 / 120.0)
    assert(controller.velocity.y > 9.0)
    let first_velocity = controller.velocity.y
    controller.step(world, FPSController.Commands() ..right = 1.0 ..jump_pressed = true, 1.0 / 120.0)
    assert(controller.velocity.y < first_velocity)
}
test "WorldDemo jump height, variable jump and landing" { jump_case() }
test "WorldDemo speeds, normalized diagonals and sprint FOV" { movement_case() }
test "WorldDemo crouch and timed slide keep the full-height capsule" { crouch_slide_case() }
test "WorldDemo coyote time permits one jump after leaving a ledge" { coyote_case() }
func main() { jump_case(); movement_case(); crouch_slide_case(); coyote_case(); print("FPS controller scenarios passed") }
