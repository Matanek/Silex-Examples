use GFX.Canvas
use GFX.Color
use GFX.UI
use GFX.Viewer
use STD.Math

func caption(value:str, size:float = 16.0) UI.Text {
    var text = UI.Text(value)
    text.style.font_size = size
    return text
}

class OverflowDemo {
    var hidden:UI.State<bool> = UI.State<bool>(true)
    var actions:UI.State<int> = UI.State<int>(0)

    func activate() { self.actions.set(self.actions.value() + 1) }

    func action(label:str) UI.Button {
        var button = UI.Button(label, self.activate)
        button.style.width = 140.0
        button.style.height = 42.0
        button.style.background = Color.cyan_700()
        button.style.radius = 6.0
        button.style.shadow = UI.BoxShadow(offset:Math.Vec2(3.0), radius:6.0, color:Color.black().with_alpha(0.7))
        return button
    }

    func panel(reads:UI.Reads) UI.View {
        var row = UI.Row([self.action("Premier"), self.action("Deuxième"), self.action("Troisième")])
        row.style.gap = 14.0
        var panel = UI.Column([
            caption("La rangée déborde de cette boîte"),
            row,
            UI.TextField("Éditez, sélectionnez, puis redimensionnez")
        ])
        panel.style.width = 300.0
        panel.style.height = 150.0
        panel.style.padding = UI.Insets(16.0)
        panel.style.gap = 10.0
        panel.style.background = Color.slate_800()
        panel.style.border = UI.Border(1.0, Color.cyan_400())
        if reads.read(self.hidden) { panel.style.overflow = UI.Overflow.hidden }
        return panel
    }

    func status(reads:UI.Reads) UI.View {
        return caption("Actions déclenchées : $(reads.read(self.actions))")
    }

    func describe() UI.View {
        var root = UI.Column([
            caption("Débordement des conteneurs — J2", 24.0),
            caption("Masqué : texte, formes, ombres et clics restent dans la boîte."),
            caption("Décochez : la rangée apparaît et ses boutons restent cliquables."),
            UI.Checkbox("Masquer le débordement", self.hidden),
            UI.Reactive(self.panel),
            UI.Reactive(self.status),
            caption("Réduisez puis agrandissez la fenêtre pendant la saisie.")
        ])
        root.style.padding = UI.Insets(24.0)
        root.style.gap = 18.0
        root.style.background = Color.slate_950()
        root.style.foreground = Color.slate_100()
        root.style.accent = Color.cyan_400()
        return root
    }
}

func main() {
    var model = OverflowDemo()
    var session = UI.Session(model.describe())
    let result = Viewer.show(session,
        Viewer.CanvasSettings(width:760, height:520, title:"Silex — Débordement J2"))
    if result != 0 { panic("overflow viewer failed") }
}
