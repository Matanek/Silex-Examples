use GFX.Audio
use GFX.Audio.Music
use GFX.Audio.MIDI
use GFX.Application
use GFX.Plugins
use GFX.Resources
use GFX.Input
use STD.Process
use STD.Error

struct Demo {
    var player:Music.Player
    var elapsed:float = 0.0
    var stage:int = 0
    init(player:Music.Player) { self.player = player }
}
func make(audio:Audio, score:MIDI.Score, sine:bool) Music.Player {
    if sine {
        var instrument = try Music.Instruments.sine(amplitude:0.16, release_seconds:0.15) else error { panic(error.detail) }
        return try Music.Player.create(audio, score, using:instrument) else error { panic(error.detail) }
    }
    var timbre = Music.Timbre.retro(); timbre.amplitude = 0.10
    return try Music.Player.create(audio, score, using:timbre) else error { panic(error.detail) }
}
func start(demo:&Demo) {
    let playing = try demo.player.play() else error { panic(error.detail) }
    print("Space: pause/resume; S: stop; R: replay; Escape: quit. The Audio plugin feeds the player.")
}
func interactive(input:@Resources.InputState, demo:&Demo, controller:&Application.Controller) {
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if input.is_pressed(Input.Key.s) { demo.player.stop(); print("Stopped") }
    if input.is_pressed(Input.Key.space) {
        let state = try demo.player.state() else error { panic(error.detail) }
        if state == Music.State.paused { try demo.player.resume() else error { panic(error.detail) }; print("Resumed") }
        if state == Music.State.playing { try demo.player.pause() else error { panic(error.detail) }; print("Paused") }
    }
    if input.is_pressed(Input.Key.r) { let playing = try demo.player.replay() else error { panic(error.detail) }; print("Replayed") }
    if let error = demo.player.error() { panic(error.detail) }
}
func check(time:@Resources.FrameTime, demo:&Demo, controller:&Application.Controller) {
    demo.elapsed += time.delta
    if demo.stage == 0 && demo.elapsed >= 0.05 { try demo.player.pause() else error { panic(error.detail) }; demo.stage = 1 }
    if demo.stage == 1 && demo.elapsed >= 0.15 { let state = try demo.player.state() else error { panic(error.detail) }; assert(state == Music.State.paused); try demo.player.resume() else error { panic(error.detail) }; demo.stage = 2 }
    if demo.stage == 2 && demo.elapsed >= 0.35 { demo.player.stop(); let state = try demo.player.state() else error { panic(error.detail) }; assert(state == Music.State.stopped); print("Application-owned MIDI controls passed"); controller.stop() }
    if let error = demo.player.error() { panic(error.detail) }
}
func main() {
    let arguments = try Process.arguments() else error { panic(error.detail) }
    var checking = false; var standalone = false; var sine = false
    for argument in arguments {
        if argument == "--check" { checking = true }
        if argument == "--standalone" { standalone = true }
        if argument == "--sine" { sine = true }
    }
    if standalone {
        var audio = Audio(); let bytes = embed_bytes("Score.mid")
        var score = try MIDI.Score.parse(@bytes[0:bytes.count()], 48_000) else error { panic(error.detail) }
        var player = make(audio, score, sine)
        let playing = try player.play() else error { panic(error.detail) }
        try player.wait() else error { panic(error.detail) }
        let state = try player.state() else error { panic(error.detail) }; assert(state == Music.State.finished)
        print("Finished; ignored messages: ", player.ignored_messages()); return
    }
    var audio = Audio(); let bytes = embed_bytes("Score.mid")
    var score = try MIDI.Score.parse(@bytes[0:bytes.count()], 48_000) else error { panic(error.detail) }
    var player = make(audio, score, sine)
    var application = Application()
    application.add_resource(audio)
    application.add_resource(Demo(player))
    application.add_plugin(Plugins.Audio()); application.add_plugin(Plugins.Time()); application.add_plugin(Plugins.FramePacing(60))
    application.add_system(Application.Schedule.startup, start)
    if checking { application.add_system(Application.Schedule.update, check) }
    else {
        application.add_plugin(Plugins.Window(Plugins.Window.Settings()..title = "MIDI - Space pause, S stop, R replay, Escape quit"..width = 640..height = 200))
        application.add_plugin(Plugins.Input())
        application.add_system(Application.Schedule.update, interactive)
    }
    application.run()
}
