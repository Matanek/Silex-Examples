use GFX.Canvas
use GFX.Color
use GFX.Input.Events
use GFX.Input.Pointer
use GFX.Window
use GFX.UI
use GFX.UI.Input as UIInput
use GFX.Viewer
use STD.Process
use STD.Time
use STD.Math

func caption(text:str, size:float = 15.0) UI.Text {
    var result = UI.Text(text)
    result.style.font_size = size
    return result
}
func action(text:str, callback:func()) UI.Button {
    var result = UI.Button(text, callback)
    result.style.padding = UI.Insets(8.0)
    result.style.background = Color.slate_700()
    result.style.radius = 6.0
    return result
}

class ScrollForm {
    var vertical:UI.ScrollState = UI.ScrollState(0.0)
    var horizontal:UI.ScrollState = UI.ScrollState(0.0)
    var inner:UI.ScrollState = UI.ScrollState(0.0)
    var target:UI.Focus = UI.Focus()
    var smoothing:UI.State<bool> = UI.State<bool>(true)
    var actions:UI.State<int> = UI.State<int>(0)
    var names:UI.State<str>[] = []

    init() {
        for index in 0...18 { self.names.append(UI.State<str>("Projet $(index + 1)")) }
    }
    func activate() { self.actions.set(self.actions.value() + 1) }
    func beginning() { self.vertical.set_offset(0.0) }
    func end() { self.vertical.set_offset(self.vertical.maximum_offset()) }
    func reveal() { self.target.reveal() }
    func edit() { self.target.request() }

    func horizontal_panel(smooth:bool) UI.View {
        var cards:UI.View[] = []
        for index in 0...10 {
            var card = UI.Column([caption("Carte $(index + 1)", 18.0),
                action("Activer", self.activate)])
            card.style.width = 180.0
            card.style.padding = UI.Insets(12.0)
            card.style.background = Color.slate_800()
            card.style.radius = 8.0
            cards.append(card)
        }
        var content = UI.Row(cards)
        content.style.gap = 12.0
        var scroll = UI.ScrollView(content, axis:UI.Flow.horizontal, state:self.horizontal, smooth_scroll:smooth)
        scroll.style.height = 110.0
        scroll.style.padding = UI.Insets(8.0)
        scroll.style.background = Color.slate_900()
        return scroll
    }

    func inner_panel(smooth:bool) UI.View {
        var buttons:UI.View[] = []
        for index in 0...8 {
            var button = action("Action interne $(index + 1)", self.activate)
            button.style.height = 38.0
            buttons.append(button)
        }
        var content = UI.Column(buttons)
        content.style.gap = 6.0
        var scroll = UI.ScrollView(content, state:self.inner, smooth_scroll:smooth)
        scroll.style.height = 140.0
        scroll.style.padding = UI.Insets(8.0)
        scroll.style.background = Color.slate_800()
        return scroll
    }

    func content(smooth:bool) UI.View {
        var rows:UI.View[] = [caption("Défilement horizontal imbriqué"), self.horizontal_panel(smooth),
            caption("Molette : le scroll interne arrive à sa limite puis le parent défile."), self.inner_panel(smooth)]
        for index, name in self.names.indexed() {
            var label = caption("Ligne $(index + 1)")
            label.style.width = 95.0
            var field = UI.TextField(name)
            field.style.flex = 1.0
            field.style.padding = UI.Insets(8.0)
            field.style.background = Color.slate_900()
            field.style.radius = 5.0
            var editor:UI.View = field
            if index == self.names.count() - 1 { editor = UI.FocusTarget(self.target, field) }
            var row = UI.Row([label, editor], alignment:UI.Alignment.center)
            row.style.height = 40.0
            row.style.gap = 8.0
            rows.append(row)
        }
        var result = UI.Column(rows)
        result.style.padding = UI.Insets(8.0)
        result.style.gap = 10.0
        return result
    }

    func status(reads:UI.Reads) UI.View {
        return caption("Actions : $(reads.read(self.actions))")
    }
    func describe(reads:UI.Reads) UI.View {
        let smooth = reads.read(self.smoothing)
        var commands = UI.Row([action("Début", self.beginning), action("Fin", self.end),
            action("Voir la dernière ligne", self.reveal), action("Éditer la dernière", self.edit)], wrap:true)
        commands.style.gap = 8.0
        var scroll = UI.ScrollView(self.content(smooth), state:self.vertical, smooth_scroll:smooth)
        scroll.style.flex = 1.0
        scroll.style.padding = UI.Insets(8.0)
        scroll.style.background = Color.slate_800()
        scroll.style.radius = 8.0
        var root = UI.Column([caption("Viewports défilables — J2", 24.0),
            caption("Molette, barres, Tab et saisie ; redimensionnez pendant l’édition."),
            UI.Checkbox("Défilement lissé", checked:self.smoothing),
            commands, scroll, UI.Reactive(self.status)])
        root.style.padding = UI.Insets(20.0)
        root.style.gap = 12.0
        root.style.foreground = Color.slate_100()
        root.style.background = Color.slate_950()
        return root
    }
}

// Optional cadence report: monotonic intervals between host updates, not GPU FPS.
class ScrollTrace {
    var enabled:bool = false
    var clock:Time.Stopwatch = Time.Stopwatch()
    var elapsed:float = 0.0
    var maximum:float = 0.0
    var frames:int = 0
    var packets:int = 0
    var drawings:int = 0
    var pointer:Math.Vec2 = Math.Vec2()
    var pointer_known:bool = false
    init(enabled:bool = false) { self.enabled = enabled }
    func update(model:ScrollForm) {
        let smooth = model.smoothing.value()
        if !self.enabled { return }
        if !self.clock.is_running() { self.clock.start(); return }
        let interval = self.clock.get_elapsed_milliseconds()
        self.clock.restart()
        self.elapsed += interval
        if interval > self.maximum { self.maximum = interval }
        self.frames++
        if self.elapsed < 1000.0 { return }
        if self.packets > 0 {
            print("SCROLL_CADENCE smooth=$(smooth) updates=$(self.frames) interval_ms_mean=$(self.elapsed / self.frames as float) interval_ms_max=$(self.maximum) packets=$(self.packets) drawings=$(self.drawings) inner=$(model.inner.offset())/$(model.inner.maximum_offset()) parent=$(model.vertical.offset())/$(model.vertical.maximum_offset()) horizontal=$(model.horizontal.offset())/$(model.horizontal.maximum_offset())")
        }
        self.elapsed = 0.0
        self.maximum = 0.0
        self.frames = 0
        self.packets = 0
        self.drawings = 0
    }
}

class ScrollSession:Canvas.Session {
    var model:ScrollForm = ScrollForm()
    var runtime:UI.Runtime
    var trace:ScrollTrace
    init(tracing:bool = false) {
        self.runtime = UI.Runtime(UI.Reactive(self.model.describe))
        self.trace = ScrollTrace(tracing)
    }
    func drawing(width:int, height:int) Canvas {
        if self.trace.enabled { self.trace.drawings++ }
        return self.runtime.drawing(width, height)
    }
    func update(delta:float) bool {
        self.trace.update(self.model)
        return self.runtime.update(delta)
    }
    func handle(event:@Events.Event) bool {
        var runtime = self.runtime
        let changed = UIInput.handle(runtime, event)
        if self.trace.enabled {
            match event {
                mouse_moved(value) => { self.trace.pointer = value.position; self.trace.pointer_known = true }
                mouse_button_pressed(value) => { self.trace.pointer = value.position; self.trace.pointer_known = true }
                mouse_button_released(value) => { self.trace.pointer = value.position; self.trace.pointer_known = true }
                mouse_wheel(value) => {
                    if self.trace.packets < 3 {
                        print("SCROLL_ROUTE pointer_known=$(self.trace.pointer_known) pointer=($(self.trace.pointer.x),$(self.trace.pointer.y)) event=($(value.position.x),$(value.position.y)) delta=($(value.delta.x),$(value.delta.y)) flipped=$(value.flipped) changed=$(changed) inner=$(self.model.inner.offset())/$(self.model.inner.maximum_offset()) parent=$(self.model.vertical.offset())/$(self.model.vertical.maximum_offset())")
                    }
                    self.trace.packets++
                }
                else => {}
            }
        }
        return changed
    }

    func accepts_text_input() bool { return self.runtime.accepts_text_input() }

    func check_horizontal_cpu(width:int, flipped:bool, smooth:bool) {
        self.model.smoothing.set(smooth)
        self.update(0.0)
        self.model.beginning()
        self.model.inner.set_offset(0.0)
        self.model.horizontal.set_offset(0.0)
        var drawing = self.drawing(width, 740)
        let point = button_label_position(drawing.commands(), "Carte 1") ?? Math.Vec2()
        assert(point.x > 0.0 && point.y > 0.0)
        let wheel = Events.Event.mouse_wheel(Events.MouseWheelEvent(
            window:Window.Id(value:1 as uint32), mouse:Pointer.MouseId(value:1 as uint32),
            delta:Math.Vec2(1.0, 0.0), integer_delta:Math.Vec2(1.0, 0.0),
            position:point, flipped:flipped, timestamp:Events.Timestamp(nanoseconds:3 as uint)))
        assert(self.handle(wheel))
        self.update(1.0 / 120.0)
        let offset = self.model.horizontal.offset()
        assert(offset > 0.0 && self.model.vertical.offset() == 0.0 && self.model.inner.offset() == 0.0)
        drawing = self.drawing(width, 740)
        let moved = button_label_position(drawing.commands(), "Carte 1") ?? Math.Vec2()
        assert(Math.abs(moved.x - point.x + offset) < 0.001)
        assert(moved.y == point.y)
        let reverse = Events.Event.mouse_wheel(Events.MouseWheelEvent(
            window:Window.Id(value:1 as uint32), mouse:Pointer.MouseId(value:1 as uint32),
            delta:Math.Vec2(-1.0, 0.0), integer_delta:Math.Vec2(-1.0, 0.0),
            position:point, flipped:flipped, timestamp:Events.Timestamp(nanoseconds:4 as uint)))
        assert(self.handle(reverse))
        self.update(1.0 / 120.0)
        assert(self.model.horizontal.offset() < offset)
        drawing = self.drawing(width, 740)
        let returned = button_label_position(drawing.commands(), "Carte 1") ?? Math.Vec2()
        assert(returned.x > moved.x && returned.y == point.y)
        assert(Math.abs(returned.x - point.x + self.model.horizontal.offset()) < 0.001)
        print("HORIZONTAL_HIT width=$(width) flipped=$(flipped) smooth=$(smooth) offset=$(offset) return=$(self.model.horizontal.offset())")
    }

    func check_cpu() {
        var drawing = self.drawing(960, 740)
        assert(drawing.command_count() > 0)
        assert(self.model.vertical.maximum_offset() > 0.0)
        self.model.end()
        assert(self.update(0.0))
        drawing = self.drawing(960, 740)
        assert(self.model.vertical.offset() == self.model.vertical.maximum_offset())
        self.model.beginning()
        self.model.edit()
        assert(self.update(0.0))
        drawing = self.drawing(420, 540)
        assert(self.accepts_text_input() && self.model.vertical.offset() > 0.0)
        assert(self.runtime.insert_text("!"))
        drawing = self.drawing(1, 1)
        drawing = self.drawing(960, 740)
        assert(drawing.command_count() > 0)
        self.runtime.focus_lost()
        for flipped in [false, true] {
            self.model.beginning()
            self.model.inner.set_offset(0.0)
            drawing = self.drawing(960, 740)
            let point = button_label_position(drawing.commands(), "Action interne 1") ?? Math.Vec2()
            assert(point.y > 0.0)
            let motion = Events.Event.mouse_moved(Events.MouseMotionEvent(
                window:Window.Id(value:1 as uint32), mouse:Pointer.MouseId(value:1 as uint32),
                buttons:0 as uint32, position:point, delta:Math.Vec2(), relative:false,
                timestamp:Events.Timestamp(nanoseconds:1 as uint)))
            self.handle(motion)
            let wheel = Events.Event.mouse_wheel(Events.MouseWheelEvent(
                window:Window.Id(value:1 as uint32), mouse:Pointer.MouseId(value:1 as uint32),
                delta:Math.Vec2(0.0, -1.0), integer_delta:Math.Vec2(0.0, -1.0),
                position:point, flipped:flipped, timestamp:Events.Timestamp(nanoseconds:2 as uint)))
            assert(self.handle(wheel))
            self.update(1.0 / 120.0)
            assert(self.model.inner.offset() > 0.0 && self.model.vertical.offset() == 0.0)
            drawing = self.drawing(960, 740)
            let moved = button_label_position(drawing.commands(), "Action interne 1") ?? Math.Vec2()
            assert(Math.abs(moved.y - point.y + self.model.inner.offset()) < 0.001)
            self.check_horizontal_cpu(960, flipped, true)
        }
    }
}

func main() {
    var cpu_check = false
    var tracing = false
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--cpu-check" { cpu_check = true }
                if argument == "--scroll-trace" { tracing = true }
            }
        }
    }
    var session = ScrollSession(tracing)
    if cpu_check { session.check_cpu(); print("UIScrollView CPU : OK"); return }
    let result = Viewer.show(session,
        Viewer.CanvasSettings(width:960, height:740, title:"Silex — Viewports défilables J2"))
    if result != 0 { panic("scroll viewer failed") }
}

test "scroll demo constructs resizes reveals and edits without a window" {
    var session = ScrollSession()
    session.check_cpu()
}


test "scroll demo switches smooth mode without rebuilding its position" {
    var session = ScrollSession()
    var drawing = session.drawing(420, 540)
    session.model.vertical.set_offset(60.0)
    session.update(0.0)
    drawing = session.drawing(420, 540)
    session.model.smoothing.set(false)
    session.update(0.0)
    drawing = session.drawing(420, 540)
    assert(session.model.vertical.offset() == 60.0)
    session.model.smoothing.set(true)
    session.update(0.0)
    drawing = session.drawing(420, 540)
    assert(session.model.vertical.offset() == 60.0)
}

func button_label_position(commands:@Canvas.Command[], label:str) Math.Vec2? {
    for command in commands {
        match command {
            text(value) => {
                if value.value == label { return Math.Vec2(value.position.x + 4.0, value.position.y + 4.0) }
            }
            layer(value) => {
                if let point = button_label_position(value.commands(), label) { return point }
            }
            else => {}
        }
    }
    return null
}

test "system wheel direction over the rendered button reaches its nested viewport" {
    for width in [960, 420] {
        for flipped in [false, true] {
            var session = ScrollSession()
            var drawing = session.drawing(width, 740)
            let point = button_label_position(drawing.commands(), "Action interne 1") ?? Math.Vec2()
            assert(point.y > 0.0)
            let motion = Events.Event.mouse_moved(Events.MouseMotionEvent(
                window:Window.Id(value:1 as uint32), mouse:Pointer.MouseId(value:1 as uint32),
                buttons:0 as uint32, position:point, delta:Math.Vec2(), relative:false,
                timestamp:Events.Timestamp(nanoseconds:1 as uint)))
            assert(session.handle(motion))
            let delta = -1.0
            let wheel = Events.Event.mouse_wheel(Events.MouseWheelEvent(
                window:Window.Id(value:1 as uint32), mouse:Pointer.MouseId(value:1 as uint32),
                delta:Math.Vec2(0.0, delta), integer_delta:Math.Vec2(0.0, delta),
                position:point, flipped:flipped, timestamp:Events.Timestamp(nanoseconds:2 as uint)))
            assert(session.handle(wheel))
            session.update(1.0 / 120.0)
            assert(session.model.inner.offset() > 0.0)
            assert(session.model.vertical.offset() == 0.0)
            drawing = session.drawing(width, 740)
            let moved = button_label_position(drawing.commands(), "Action interne 1") ?? Math.Vec2()
            assert(Math.abs(moved.y - point.y + session.model.inner.offset()) < 0.001)
            print("SCROLL_HIT width=$(width) flipped=$(flipped) x=$(point.x) y=$(point.y) inner=$(session.model.inner.offset()) max=$(session.model.inner.maximum_offset()) moved_y=$(moved.y)")
        }
    }
}

test "horizontal native deltas move cards in system direction in both modes" {
    for width in [960, 420] {
        for flipped in [false, true] {
            for smooth in [false, true] {
                var session = ScrollSession()
                session.check_horizontal_cpu(width, flipped, smooth)
            }
        }
    }
}
