use GFX.Color
use GFX.UI
use GFX.UI.Terminal
use GFX.Viewer

func interface() UI.Column {
    var heading = UI.Text("System terminal embedded in an application interface")
    heading.style.font_size = 22.0
    heading.style.font_weight = UI.FontWeight.bold

    var terminal = Terminal.Shell(size:Terminal.Size(columns:100, rows:30))
    terminal.style.grow = 1.0

    let children:UI.View[] = [heading, terminal]
    var root = UI.Column(children)
    root.style.padding = UI.Insets(18.0)
    root.style.gap = 12.0
    root.style.background = Color.slate_900()
    root.style.foreground = Color.slate_100()
    return root
}

func main() {
    var root = interface()
    Viewer.show(
        UI.Session(root, autofocus:true),
        Viewer.CanvasSettings(
            width:1060,
            height:680,
            title:"Composed system terminal",
            background:Color.slate_950()
        )
    )
}
