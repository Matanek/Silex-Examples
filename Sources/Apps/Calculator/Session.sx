use GFX.Window.Cursor
use GFX.Canvas
use GFX.Input.Events
use GFX.Input.Keyboard
use GFX.UI
use Module.Calculator.Calculator
use Module.Calculator.Operation

// Adds calculator-specific keyboard commands to the generic retained UI session.
public class CalculatorSession:Canvas.Session {
    var calculator:Calculator
    var ui:UI.Session

    init(calculator:Calculator, root:UI.View) {
        self.calculator = calculator
        self.ui = UI.Session(root)
    }

    func drawing(width:int, height:int) Canvas {
        return self.ui.drawing(width, height)
    }

    func update(delta:float) bool { return self.ui.update(delta) }

    func handle(event:@Events.Event) bool {
        match event {
            key_pressed(value) => {
                if !value.repeated && self.shortcut_key(value.key, value.keycode) {
                    return true
                }
            }
            else => {}
        }
        return self.ui.handle(event)
    }

    func pointer_cursor() Cursor { return self.ui.pointer_cursor() }

    func accepts_text_input() bool { return self.ui.accepts_text_input() }

    module func shortcut_key(key:Keyboard.Key, keycode:uint32) bool {
        if keycode >= 48 as uint32 && keycode <= 57 as uint32 {
            self.calculator.digit((keycode - 48 as uint32) as int)
        } elif keycode == 43 as uint32 {
            self.calculator.choose(Operation.add)
        } elif keycode == 45 as uint32 {
            self.calculator.choose(Operation.subtract)
        } elif keycode == 42 as uint32 || keycode == 120 as uint32 ||
            keycode == 88 as uint32
        {
            self.calculator.choose(Operation.multiply)
        } elif keycode == 47 as uint32 {
            self.calculator.choose(Operation.divide)
        } elif keycode == 46 as uint32 || keycode == 44 as uint32 {
            self.calculator.decimal()
        } elif keycode == 37 as uint32 {
            self.calculator.percent()
        } elif keycode == 61 as uint32 {
            self.calculator.equals()
        } elif keycode == 99 as uint32 || keycode == 67 as uint32 {
            self.calculator.clear()
        } elif key == Keyboard.Key.num0 || key == Keyboard.Key.keypad_0 {
            self.calculator.digit(0)
        } elif key == Keyboard.Key.num1 || key == Keyboard.Key.keypad_1 {
            self.calculator.digit(1)
        } elif key == Keyboard.Key.num2 || key == Keyboard.Key.keypad_2 {
            self.calculator.digit(2)
        } elif key == Keyboard.Key.num3 || key == Keyboard.Key.keypad_3 {
            self.calculator.digit(3)
        } elif key == Keyboard.Key.num4 || key == Keyboard.Key.keypad_4 {
            self.calculator.digit(4)
        } elif key == Keyboard.Key.num5 || key == Keyboard.Key.keypad_5 {
            self.calculator.digit(5)
        } elif key == Keyboard.Key.num6 || key == Keyboard.Key.keypad_6 {
            self.calculator.digit(6)
        } elif key == Keyboard.Key.num7 || key == Keyboard.Key.keypad_7 {
            self.calculator.digit(7)
        } elif key == Keyboard.Key.num8 || key == Keyboard.Key.keypad_8 {
            self.calculator.digit(8)
        } elif key == Keyboard.Key.num9 || key == Keyboard.Key.keypad_9 {
            self.calculator.digit(9)
        } elif key == Keyboard.Key.keypad_plus {
            self.calculator.choose(Operation.add)
        } elif key == Keyboard.Key.minus || key == Keyboard.Key.keypad_minus {
            self.calculator.choose(Operation.subtract)
        } elif key == Keyboard.Key.keypad_multiply {
            self.calculator.choose(Operation.multiply)
        } elif key == Keyboard.Key.slash || key == Keyboard.Key.keypad_divide {
            self.calculator.choose(Operation.divide)
        } elif key == Keyboard.Key.period || key == Keyboard.Key.keypad_period ||
            key == Keyboard.Key.keypad_comma || key == Keyboard.Key.decimal_separator
        {
            self.calculator.decimal()
        } elif key == Keyboard.Key.keypad_percent {
            self.calculator.percent()
        } elif key == Keyboard.Key.equals || key == Keyboard.Key.keypad_equals {
            self.calculator.equals()
        } elif key == Keyboard.Key.enter || key == Keyboard.Key.keypad_enter {
            self.calculator.equals()
        } elif key == Keyboard.Key.escape || key == Keyboard.Key.delete ||
            key == Keyboard.Key.clear || key == Keyboard.Key.clear_again ||
            key == Keyboard.Key.keypad_clear
        {
            self.calculator.clear()
        } elif key == Keyboard.Key.backspace || key == Keyboard.Key.keypad_backspace {
            self.calculator.backspace()
        } else {
            return false
        }
        return true
    }
}

public func verify_calculator_shortcuts() {
    var calculator = Calculator()
    var session = CalculatorSession(calculator, UI.Text(""))
    assert(session.shortcut_key(Keyboard.Key.num1, 49 as uint32))
    assert(session.shortcut_key(Keyboard.Key.num2, 50 as uint32))
    assert(session.shortcut_key(Keyboard.Key.unknown(0 as uint32), 43 as uint32))
    assert(session.shortcut_key(Keyboard.Key.num3, 51 as uint32))
    assert(session.shortcut_key(Keyboard.Key.enter, 0 as uint32))
    assert(calculator.value() == 15.0, "calculator keyboard expression")

    assert(session.shortcut_key(Keyboard.Key.unknown(0 as uint32), 67 as uint32))
    assert(session.shortcut_key(Keyboard.Key.num9, 0 as uint32))
    assert(session.shortcut_key(Keyboard.Key.num8, 0 as uint32))
    assert(session.shortcut_key(Keyboard.Key.backspace, 0 as uint32))
    assert(calculator.value() == 9.0, "calculator keyboard backspace")
}
