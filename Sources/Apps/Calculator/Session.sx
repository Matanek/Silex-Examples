use GFX.Canvas
use GFX.Input.Events
use GFX.Input.Keyboard
use GFX.UI
use Module.Calculator.Calculator
use Module.Calculator.Operation

// Adds calculator-specific keyboard commands to the generic retained UI session.
public class CalculatorSession:Canvas.Session {
    var calculator:Calculator
    var ui:UI.Session

    init(calculator:Calculator, root:UI.View) {
        self.calculator = calculator
        self.ui = UI.Session(root)
    }

    func drawing(width:int, height:int) Canvas {
        return self.ui.drawing(width, height)
    }

    func update(delta:float) bool { return self.ui.update(delta) }

    func handle(event:@Events.Event) bool {
        match event {
            text_input(value) => {
                if self.shortcut_text(value.text) { return true }
            }
            key_pressed(value) => {
                if !value.repeated && self.shortcut_key(value.key) { return true }
            }
            else => {}
        }
        return self.ui.handle(event)
    }

    // Viewer enables platform text events while this session is active.
    func accepts_text_input() bool { return true }

    module func shortcut_text(value:str) bool {
        if value == "0" { self.calculator.digit(0) }
        elif value == "1" { self.calculator.digit(1) }
        elif value == "2" { self.calculator.digit(2) }
        elif value == "3" { self.calculator.digit(3) }
        elif value == "4" { self.calculator.digit(4) }
        elif value == "5" { self.calculator.digit(5) }
        elif value == "6" { self.calculator.digit(6) }
        elif value == "7" { self.calculator.digit(7) }
        elif value == "8" { self.calculator.digit(8) }
        elif value == "9" { self.calculator.digit(9) }
        elif value == "." || value == "," { self.calculator.decimal() }
        elif value == "+" { self.calculator.choose(Operation.add) }
        elif value == "-" || value == "−" { self.calculator.choose(Operation.subtract) }
        elif value == "*" || value == "x" || value == "X" || value == "×" {
            self.calculator.choose(Operation.multiply)
        } elif value == "/" || value == "÷" {
            self.calculator.choose(Operation.divide)
        } elif value == "=" { self.calculator.equals() }
        elif value == "%" { self.calculator.percent() }
        elif value == "c" || value == "C" { self.calculator.clear() }
        else { return false }
        return true
    }

    module func shortcut_key(key:Keyboard.Key) bool {
        if key == Keyboard.Key.enter || key == Keyboard.Key.keypad_enter {
            self.calculator.equals()
        } elif key == Keyboard.Key.escape || key == Keyboard.Key.delete ||
            key == Keyboard.Key.clear || key == Keyboard.Key.clear_again ||
            key == Keyboard.Key.keypad_clear
        {
            self.calculator.clear()
        } elif key == Keyboard.Key.backspace || key == Keyboard.Key.keypad_backspace {
            self.calculator.backspace()
        } else {
            return false
        }
        return true
    }
}

public func verify_calculator_shortcuts() {
    var calculator = Calculator()
    var session = CalculatorSession(calculator, UI.Text(""))
    assert(session.shortcut_text("1"))
    assert(session.shortcut_text("2"))
    assert(session.shortcut_text("+"))
    assert(session.shortcut_text("3"))
    assert(session.shortcut_key(Keyboard.Key.enter))
    assert(calculator.value() == 15.0, "calculator keyboard expression")

    assert(session.shortcut_text("C"))
    assert(session.shortcut_text("9"))
    assert(session.shortcut_text("8"))
    assert(session.shortcut_key(Keyboard.Key.backspace))
    assert(calculator.value() == 9.0, "calculator keyboard backspace")
}
