use GFX.Application
use GFX.Color
use GFX.Canvas
use GFX.Components
use GFX.ECS
use GFX.Plugins
use GFX.Rendering
use STD.Math
use STD.Process
use STD.Time.LocalTime

static struct Const {
    let canvas_size:int = 640

    func background_color() Color {
        return Color.bytes(215, 210, 203)
    }
}

func clock_point(center:Math.Vec2, radius:float, angle:float) Math.Vec2 {
    return center.add(Math.Vec2(Math.cos(angle), Math.sin(angle)).multiply(radius))
}

func paint_ticks(painter:&Canvas.Painter, center:Math.Vec2) {
    var tick = 0
    while tick < 60 {
        let angle = -Math.pi() * 0.5 + Math.two_pi() * tick as float / 60.0
        var inner_radius = 246.0
        var width = 1.4
        if tick % 5 == 0 {
            inner_radius = 232.0
            width = 3.0
        }
        painter.stroke(
            Canvas.Line(
                clock_point(center, inner_radius, angle),
                clock_point(center, 258.0, angle)
            ),
            Canvas.Stroke(Color.bytes(91, 76, 76), width)
                ..cap = Canvas.StrokeCap.round
        )
        tick++
    }
}

func paint_numbers(painter:&Canvas.Painter, font:Canvas.Font, center:Math.Vec2) {
    var style = Canvas.TextStyle(
        size:38.0,
        color:Color.bytes(91, 70, 73),
        alignment:Canvas.TextAlignment.center,
        font:font
    )
    var hour = 1
    while hour <= 12 {
        let angle = -Math.pi() * 0.5 + Math.two_pi() * hour as float / 12.0
        let position = clock_point(center, 198.0, angle)
        painter.text("$(hour)", Math.Vec2(position.x, position.y - 22.0), style)
        hour++
    }
}

func paint_hand(
    painter:&Canvas.Painter,
    center:Math.Vec2,
    angle:float,
    length:float,
    tail:float,
    width:float,
    color:Color
) {
    let direction = Math.Vec2(Math.cos(angle), Math.sin(angle))
    painter.stroke(
        Canvas.Line(
            center.subtract(direction.multiply(tail)),
            center.add(direction.multiply(length))
        ),
        Canvas.Stroke(color, width)..cap = Canvas.StrokeCap.round
    )
}

func clock_face_drawing(font:Canvas.Font) Canvas {
    let center = Math.Vec2(320.0)
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(center.add(Math.Vec2(0.0, 7.0)), 294.0),
            Canvas.Fill.solid(Color.black().with_alpha(0.20))
        )
        painter.fill(
            Canvas.Circle(center, 292.0),
            Canvas.Fill.solid(Color.bytes(221, 191, 177))
        )
        painter.fill(
            Canvas.Circle(center, 285.0),
            Canvas.Fill.solid(Color.bytes(247, 246, 241))
        )
        painter.stroke(
            Canvas.Circle(center, 285.0),
            Canvas.Stroke(Color.bytes(180, 174, 166), 2.0)
        )
        painter.stroke(
            Canvas.Circle(center, 278.0),
            Canvas.Stroke(Color.bytes(225, 220, 212), 1.5)
        )
        paint_ticks(painter, center)
        paint_numbers(painter, font, center)
    })
    return drawing
}

func clock_hand_drawing(
    length:float,
    tail:float,
    width:float,
    color:Color
) Canvas {
    let center = Math.Vec2(320.0)
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        paint_hand(painter, center, 0.0, length, tail, width, color)
    })
    return drawing
}

func clock_center_drawing() Canvas {
    let center = Math.Vec2(320.0)
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(center, 12.0),
            Canvas.Fill.solid(Color.bytes(82, 67, 68))
        )
        painter.fill(
            Canvas.Circle(center, 5.0),
            Canvas.Fill.solid(Color.bytes(221, 191, 177))
        )
    })
    return drawing
}

func seconds_of_day(time:LocalTime) float {
    let milliseconds = time.nanosecond / 1_000_000
    return time.hour as float * 3_600.0 + time.minute as float * 60.0 +
        time.second as float + milliseconds as float / 1_000.0
}

struct ClockFace {
    var hour_hand:ECS.Entity? = null
    var minute_hand:ECS.Entity? = null
    var second_hand:ECS.Entity? = null
    var last_millisecond:int = -1
}

class DemoRun {
    let verification:bool
    var frames:int

    init(verification:bool) {
        self.verification = verification
        self.frames = 0
    }
}

func verification_mode() bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--verify" { return true }
            }
        }
    }
    return false
}

func spawn_clock_canvas(
    world:&ECS.World,
    drawing:Canvas,
    angle:float,
    layer:int
) ECS.Entity {
    return world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(rotation:angle))
        ..with(Components.Canvas(
            drawing,
            Const.canvas_size,
            Const.canvas_size
        )
            ..anchor = Math.Vec2(0.5)
            ..pivot = Math.Vec2(0.5)
            ..space = Components.CanvasSpace.viewport
            ..layer = layer
        )
    )
}

func hour_angle(seconds:float) float {
    return -Math.pi() * 0.5 + Math.two_pi() * seconds / 43_200.0
}

func minute_angle(seconds:float) float {
    return -Math.pi() * 0.5 + Math.two_pi() * seconds / 3_600.0
}

func second_angle(seconds:float) float {
    return -Math.pi() * 0.5 + Math.two_pi() * seconds / 60.0
}

func create_clock(world:&ECS.World, face:&ClockFace) {
    let seconds = seconds_of_day(LocalTime.now())
    let ink = Color.bytes(82, 67, 68)
    face.last_millisecond = -1
    var clock_face = clock_face_drawing(Canvas.Font.default())
    spawn_clock_canvas(world, clock_face, 0.0, 0)
    var hour = clock_hand_drawing(132.0, 18.0, 11.0, ink)
    face.hour_hand = spawn_clock_canvas(world, hour, hour_angle(seconds), 1)
    var minute = clock_hand_drawing(184.0, 22.0, 7.0, ink)
    face.minute_hand = spawn_clock_canvas(world, minute, minute_angle(seconds), 2)
    var second = clock_hand_drawing(
        210.0,
        31.0,
        2.2,
        Color.bytes(156, 79, 70)
    )
    face.second_hand = spawn_clock_canvas(world, second, second_angle(seconds), 3)
    var center = clock_center_drawing()
    spawn_clock_canvas(world, center, 0.0, 4)
}

func rotate_hand(world:&ECS.World, entity:ECS.Entity?, angle:float) {
    if let display = entity {
        world.update<Components.Transform2D>(
            display,
            func(transform:&Components.Transform2D) { transform.rotation = angle }
        )
    }
}

func update_clock(world:&ECS.World, face:&ClockFace) {
    let seconds = seconds_of_day(LocalTime.now())
    let millisecond = Math.floor(seconds * 1_000.0) as int
    if millisecond == face.last_millisecond { return }
    rotate_hand(world, face.hour_hand, hour_angle(seconds))
    rotate_hand(world, face.minute_hand, minute_angle(seconds))
    rotate_hand(world, face.second_hand, second_angle(seconds))
    face.last_millisecond = millisecond
}

func finish_verification(
    run:&DemoRun,
    controller:&Application.Controller
) {
    if !run.verification { return }
    run.frames++
    if run.frames == 3 { controller.stop() }
}

func main() {
    let verification = verification_mode()
    var run = DemoRun(verification)
    var application = Application()
    var scene = Application.Scene(application)
        ..add_resource(ClockFace())
        ..add_resource(run)
        ..add_plugin(Plugins.Scene2DContent())
        ..add_system(Application.Schedule.startup, create_clock)
        ..add_system(Application.Schedule.update, update_clock)
        ..add_after_system(Application.Schedule.render, finish_verification)

    application
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Clock — GFX.Canvas"
            ..width = Const.canvas_size
            ..height = Const.canvas_size
            ..hidden = verification
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Const.background_color()
            ..present_mode = Rendering.PresentMode.immediate
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.SceneManager(scene))

    assert(application.run() == 0)
    if verification { assert(run.frames == 3) }
}
