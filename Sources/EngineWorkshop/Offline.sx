use GFX.Audio.Synthesis
use GFX.Audio.Synthesis.EngineParts
use STD.File
use STD.Math
use GFX.UI
use Module.Workshop.Workshop

func word(bytes:&uint8[], value:int, count:int) {
    var current = value
    for _ in 0...count { bytes.append((current % 256) as uint8); current /= 256 }
}
public func render(path:str) {
    var parts = EngineParts.v8(); parts.turbo = EngineParts.Turbo()
    var source = Synthesis.Engine.assemble(parts)
    var bytes:uint8[] = [82 as uint8, 73 as uint8, 70 as uint8, 70 as uint8]
    let frames = 48_000 * 12
    word(bytes, 36 + frames * 4, 4)
    for byte in [87, 65, 86, 69, 102, 109, 116, 32] { bytes.append(byte as uint8) }
    word(bytes, 16, 4); word(bytes, 1, 2); word(bytes, 2, 2); word(bytes, 48_000, 4)
    word(bytes, 192_000, 4); word(bytes, 4, 2); word(bytes, 16, 2)
    for byte in [100, 97, 116, 97] { bytes.append(byte as uint8) }
    word(bytes, frames * 4, 4)
    var samples:float32[] = []; for _ in 0...960 { samples.append(0.0) }
    source.set_state(800.0, throttle:0.2, load:0.2, ramp_frames:0)
    for block in 0...1_200 {
        if block == 250 { source.set_state(4_500.0, throttle:0.9, load:0.7, boost:0.8, ramp_frames:96_000) }
        if block == 650 {
            for i in 0...parts.exhausts.count() { parts.exhausts[i].silencer.absorption = 0.05 }
            source.set_parts(parts)
        }
        if block == 850 { source.set_state(800.0, throttle:0.0, load:0.1, boost:0.0, ramp_frames:72_000) }
        if block == 900 { source.set_state(0.0, fuel:0.0, ramp_frames:24_000) }
        source.render(&samples[0:960])
        for sample in samples {
            var value = Math.round(sample * 32_767.0) as int
            if value < 0 { value += 65_536 }
            word(bytes, value, 2)
        }
    }
    File.write_all(path, @bytes[0:bytes.count()])
    print("Engine workshop WAV: ", path)
}
public func check() {
    var workshop = Workshop(); var samples:float32[] = []; for _ in 0...960 { samples.append(0.0) }
    workshop.toggle_running()
    for _ in 0...100 { workshop.update(0.01); workshop.source.render(&samples[0:960]) }
    assert(workshop.source.current_rpm() > 700.0)
    workshop.bore.set(100.0); workshop.change_part(100.0); workshop.update(0.15)
    assert(workshop.source.parts()!.block.bore_mm == 100.0 as float32)
    assert(workshop.source.parts()!.exhausts[1].outlet_level == 0.1 as float32)
    workshop.listening.set(2); workshop.choose_listening(2)
    workshop.pipe.set(1_700.0); workshop.change_part(1_700.0); workshop.update(0.15)
    let solo = workshop.source.parts()!.mix
    assert(solo.intake == 1.0 as float32 && solo.exhaust == 0.0 as float32 && solo.mechanics == 0.0 as float32 && solo.turbo == 0.0 as float32)
    workshop.listening.set(0); workshop.choose_listening(0)
    for profile in 0...3 {
        workshop.profile.set(profile); workshop.choose_profile(profile)
        for _ in 0...25 { workshop.update(0.01); workshop.source.render(&samples[0:960]) }
    }
    workshop.cylinder_count.set(4); workshop.change_cylinders(4); workshop.update(0.15)
    assert(workshop.source.parts()!.block.cylinders == 4)
    workshop.turbo.set(true); workshop.change_turbo(true); workshop.update(0.15)
    assert(workshop.source.parts()!.turbo != null)
    for _ in 0...25 { workshop.source.render(&samples[0:960]) }
    var ui = UI.Session(workshop.view())
    for size in [400, 760, 1_160] { ui.drawing(size, 700) }
    workshop.toggle_running()
    for _ in 0...300 { workshop.update(0.01); workshop.source.render(&samples[0:960]) }
    assert(workshop.source.current_rpm() < 1.0)
    for sample in samples { assert(Math.is_finite(sample) && Math.abs(sample) <= 0.4) }
    print("Workshop check passed: profiles, dimensions, topology, turbo, responsive drawing and stop")
}
