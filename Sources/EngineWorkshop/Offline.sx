use STD.File
use STD.Math
use GFX.UI
use GFX.Input.Keyboard
use GFX.Audio.Engines
use Module.Workshop.Workshop

func zeros(count:int) float32[] {
    var values:float32[] = []; for _ in 0...count { values.append(0.0) }
    return values
}
func word(bytes:&uint8[], value:int, count:int) {
    var current = value
    for _ in 0...count { bytes.append((current % 256) as uint8); current /= 256 }
}
func wave(path:str, samples:@float32[..]) {
    var bytes:uint8[] = [82 as uint8, 73 as uint8, 70 as uint8, 70 as uint8]
    word(bytes, 36 + samples.count() * 2, 4)
    for byte in [87, 65, 86, 69, 102, 109, 116, 32] { bytes.append(byte as uint8) }
    word(bytes, 16, 4); word(bytes, 1, 2); word(bytes, 2, 2); word(bytes, 44_100, 4)
    word(bytes, 176_400, 4); word(bytes, 4, 2); word(bytes, 16, 2)
    for byte in [100, 97, 116, 97] { bytes.append(byte as uint8) }
    word(bytes, samples.count() * 2, 4)
    for sample in samples {
        assert(Math.is_finite(sample) && Math.abs(sample) <= 1.0)
        var value = Math.round(sample * 32_767.0) as int
        if value < 0 { value += 65_536 }
        word(bytes, value, 2)
    }
    File.write_all(path, @bytes[0:bytes.count()])
}
public func render(path:str, profile:str = "454", catalogue:bool = false) {
    var listing = Workshop(); var output:float32[] = []
    var samples = zeros(960); var found = false
    for i in 0...listing.catalogue.count() {
        if !catalogue && listing.catalogue[i].key != profile { continue }
        found = true
        var vehicle = Workshop(); vehicle.choose_profile(i); vehicle.audition_cycle()
        print(output.count() / 88_200, " s: ", listing.catalogue[i].key, " / ", listing.name(i))
        var frame = 0
        while frame < 441_000 {
            var frames = 480; if frame + frames > 441_000 { frames = 441_000 - frame }
            if frame >= 352_800 { vehicle.running.set(false); vehicle.audition = false; vehicle.accelerating = false }
            vehicle.update(frames as float / 44_100.0)
            vehicle.source.render(&samples[0:frames * 2])
            for j in 0...frames * 2 {
                var fade:float = 1.0
                if frame + j / 2 >= 432_180 { fade = (440_999 - frame - j / 2) as float / 8_820.0 }
                output.append(samples[j] * fade)
            }
            frame += frames
        }
    }
    if !found { panic("Unknown profile: $(profile). Use --list.") }
    wave(path, @output[0:output.count()]); print("Thermal vehicle workshop WAV: ", path)
}
public func list() {
    var workshop = Workshop()
    for i in 0...workshop.catalogue.count() { print(workshop.catalogue[i].key, " : ", workshop.name(i)) }
}
public func check() {
    var workshop = Workshop()
    var library = Engines.Library.open(); var reference = library.engine("454")
    var a = zeros(960); var b = zeros(960)
    var controls = Engines.Controls(running:true)
    for phase in 0...4 {
        workshop.running.set(phase != 3); workshop.accelerating = phase == 1 || phase == 2
        controls.running = phase != 3; controls.accelerating = phase == 1 || phase == 2
        if phase == 2 { workshop.load.set(0.8); controls.load = 0.8 }
        reference.set_controls(controls)
        for _ in 0...120 {
            workshop.update(480.0 / 44_100.0)
            workshop.source.render(&a[0:960]); reference.render(&b[0:960])
            assert(workshop.source.current_rpm() == reference.current_rpm())
            for i in 0...960 { assert(a[i] == b[i], "workshop changed Chevrolet reference PCM") }
        }
    }
    workshop.exhaust.set(0.4); workshop.sound_changed(0.4); workshop.remember()
    workshop.exhaust.set(0.9); workshop.sound_changed(0.9); workshop.compare()
    assert(workshop.source.controls().exhaust == 0.4 as float)
    workshop.compare(); assert(workshop.source.controls().exhaust == 0.9 as float)
    let generation = workshop.generation
    workshop.running.set(true); workshop.choose_profile(1)
    assert(workshop.generation == generation && workshop.profile.value() == 0)
    workshop.capacity.set(6_000.0); workshop.apply_capacity()
    assert(workshop.generation == generation, "geometry changed on a running engine")
    workshop.running.set(false)
    // A fresh stopped bench exercises actual selection and start events.
    var keyboard = Workshop(); var runtime = UI.Runtime(keyboard.view()); runtime.drawing(1_160, 900)
    assert(runtime.key_pressed(Keyboard.Key.tab)); assert(runtime.key_pressed(Keyboard.Key.down))
    assert(runtime.key_pressed(Keyboard.Key.end)); assert(runtime.key_pressed(Keyboard.Key.enter))
    assert(keyboard.profile.value() == 17)
    assert(keyboard.source.controls().idle_rpm == 800.0 as float, "nominal idle metadata must not engage the dyno")
    assert(runtime.key_pressed(Keyboard.Key.tab)); assert(runtime.key_pressed(Keyboard.Key.enter))
    assert(keyboard.running.value())
    var ui = UI.Session(keyboard.view())
    for width in [400, 760, 1_160] { ui.drawing(width, 900) }
    var slider = UI.Runtime(keyboard.capacity.view(keyboard.capacity_changed)); slider.drawing(320, 120)
    assert(slider.key_pressed(Keyboard.Key.tab)); assert(slider.key_pressed(Keyboard.Key.end))
    assert(Math.abs(keyboard.capacity.value() - 12_000.0) < 0.01)
    print("Workshop check passed: exact Chevrolet PCM, A/B, safe profile/geometry changes, keyboard and three layouts")
}
