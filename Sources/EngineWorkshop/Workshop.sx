use GFX.UI
use GFX.Color
use GFX.Audio.Engines
use GFX.Audio.Engines.Vehicles
use STD.Math
use Module.Widgets
use Module.Widgets.Knob

// The native simulator owns crank motion, combustion, gas flow and sound.
public class Workshop {
    var source:Engines.Engine
    let catalogue:Vehicles.Profile[] = Vehicles.catalogue()
    var generation:int = 0
    var running:UI.State<bool> = UI.State<bool>(false)
    var profile:UI.State<int?> = UI.State<int?>(0)
    var status:UI.State<str> = UI.State<str>("")
    var readout:UI.State<str> = UI.State<str>("Contact coupé")
    var notice:UI.State<str> = UI.State<str>("Citadines : extérieur feutré · diesel : voix hybride issue de la référence TDI.")
    var comparison:UI.State<str> = UI.State<str>("Écoute B · réglages courants")
    var capacity:Knob = Knob("Cylindrée totale à préparer", 7_438.0, 50.0, 12_000.0, "cm³", logarithmic:true)
    var throttle:Knob = Knob("Accélérateur", 0.0, 0.0, 1.0, "%")
    var idle:Knob = Knob("Maintien · 800 = ralenti libre", 800.0, 800.0, 4_000.0, "tr/min")
    var load:Knob = Knob("Charge du banc", 0.2, 0.0, 1.0, "%")
    var texture:Knob = Knob("Texture · souffle et variations", 1.0, 0.0, 1.0, "%")
    var exhaust:Knob = Knob("Échappement · brut ↔ réponse filtrée", 1.0, 0.0, 1.0, "%")
    var intake:Knob = Knob("Admission du mono 4T", 0.6, 0.0, 1.0, "%")
    var ambience:Knob = Knob("Ambiance", 0.0, 0.0, 1.0, "%")
    var volume:Knob = Knob("Volume d’écoute", 0.7, 0.0, 1.0, "%")
    var accelerating:bool = false
    var audition:bool = false
    var reference_active:bool = false
    private var selected_index:int = 0
    private var active_capacity:float
    private var reference:Engines.Controls = Engines.Controls()
    private var audition_time:float = 0.0
    private var display_time:float = 0.0

    init() {
        self.source = Vehicles.create("454")
        self.active_capacity = self.catalogue[0].displacement_cc
        self.capacity.set(self.active_capacity)
        self.intake.set(self.source.profile.intake)
        self.update_status(); self.remember(); self.sync()
    }
    func selected() Vehicles.Profile { return self.catalogue[self.selected_index] }
    func name(index:int) str { return self.catalogue[index].name }
    func toggle_running() {
        self.running.set(!self.running.value()); self.accelerating = false; self.audition = false; self.sync()
    }
    func controls_changed(value:float) { self.audition = false; self.sync() }
    func sound_changed(value:float) {
        self.reference_active = false; self.comparison.set("Écoute B · réglages courants"); self.sync()
    }
    func capacity_changed(value:float) { self.notice.set("Cylindrée préparée · appliquez moteur arrêté") }
    private func can_replace() bool { return !self.running.value() && self.source.current_rpm() < 5.0 }
    func choose_profile(index:int) {
        if !self.can_replace() {
            self.profile.set(self.selected_index); self.notice.set("Coupez le contact et attendez l’arrêt pour changer de moteur."); return
        }
        self.selected_index = index; self.profile.set(index)
        self.capacity.set(self.selected().displacement_cc)
        self.install()
    }
    func apply_capacity() {
        if !self.can_replace() { self.notice.set("Appliquez la cylindrée après avoir coupé le contact et attendu l’arrêt."); return }
        self.install()
    }
    private func install() {
        match try Vehicles.create(self.selected().key, displacement_cc:self.capacity.value()) {
            failure(error) => { self.notice.set("Cylindrée refusée : $(error.detail)") }
            success(var source) => {
                self.source = source; self.active_capacity = self.capacity.value(); self.generation++
                self.accelerating = false; self.audition = false; self.reference_active = false
                // Profile idle is metadata; this command engages the dyno.
                // Keep the reference bench's free-idle default for every model.
                self.throttle.set(0.0); self.idle.set(800.0)
                self.texture.set(1.0); self.exhaust.set(1.0); self.intake.set(self.source.profile.intake)
                self.ambience.set(0.0); self.load.set(0.2)
                self.update_status(); self.remember(); self.sync()
                self.notice.set("Moteur prêt · $(self.selected().note)")
            }
        }
    }
    private func update_status() {
        let selected = self.selected()
        self.status.set("$(selected.cylinders) cyl. · $(Math.round(self.active_capacity) as int) cm³ · $(selected.strokes)T · simulation thermique et réponse d’échappement")
    }
    func restore() { self.choose_profile(self.selected_index) }
    func remember() {
        self.reference = self.source.controls()
        self.reference.texture = self.texture.value(); self.reference.exhaust = self.exhaust.value()
        self.reference.intake = self.intake.value(); self.reference.ambience = self.ambience.value()
        self.reference_active = false; self.comparison.set("Écoute B · réglages courants"); self.sync()
    }
    func compare() {
        self.reference_active = !self.reference_active
        var label = "Écoute B · réglages courants"; if self.reference_active { label = "Écoute A · réglages mémorisés" }
        self.comparison.set(label); self.sync()
    }
    func audition_cycle() {
        self.running.set(true); self.audition = true; self.audition_time = 0.0
        self.notice.set("Essai 8 s · démarrage, gaz progressifs, charge, relâchement")
        self.sync()
    }
    // A free-revving engine needs very little opening. Spread the measured
    // useful range over 90% of the slider, retaining wide-open throttle at 100%.
    // This changes the bench input, never the simulated RPM or engine limits.
    private func pedal(value:float) float {
        if value >= 1.0 { return 1.0 }
        var useful:float = 1.0
        let key = self.selected().key
        if key == "custom-1200" || key == "custom-1800" { useful = 0.16 }
        if key == "sport-v8" { useful = 0.3 }
        if key == "city-i4" { useful = 0.05 }
        if useful == 1.0 { return value }
        if value <= 0.9 { let position = value / 0.9; return useful * position * position }
        return useful + (1.0 - useful) * ((value - 0.9) / 0.1)
    }
    func sync() {
        var controls = self.source.controls()
        controls.running = self.running.value(); controls.accelerating = self.accelerating
        controls.throttle = null
        if !self.accelerating && self.throttle.value() > 0.0 { controls.throttle = self.pedal(self.throttle.value()) }
        controls.idle_rpm = self.idle.value(); controls.load = self.load.value()
        controls.texture = self.texture.value(); controls.exhaust = self.exhaust.value()
        controls.intake = self.intake.value(); controls.ambience = self.ambience.value(); controls.volume = self.volume.value()
        if self.reference_active {
            controls.texture = self.reference.texture; controls.exhaust = self.reference.exhaust
            controls.intake = self.reference.intake; controls.ambience = self.reference.ambience
        }
        if self.audition {
            let time = self.audition_time
            controls.accelerating = false; controls.throttle = 0.0; controls.load = 0.1
            if time >= 2.0 && time < 4.0 { controls.throttle = self.pedal((time - 2.0) / 2.0) }
            if time >= 4.0 && time < 6.0 { controls.throttle = 1.0; controls.load = 0.7 }
        }
        self.source.set_controls(controls)
    }
    func update(delta:float) {
        if self.audition {
            self.audition_time += delta
            if self.audition_time >= 8.0 { self.audition = false; self.notice.set("Essai terminé · commandes du banc rétablies") }
        }
        self.sync(); self.display_time += delta
        if self.display_time >= 0.1 {
            self.display_time = 0.0
            var state = "contact coupé"
            if self.running.value() { state = "moteur en marche" }
            if self.source.is_starting() { state = "démarrage" }
            self.readout.set("$(Math.round(self.source.current_rpm()) as int) tr/min · $(state)")
        }
    }
    func readout_view(reads:UI.Reads) UI.View { return Widgets.text(reads.read(self.readout), 24.0, Color.cyan_300()) }
    func status_view(reads:UI.Reads) UI.View { return Widgets.text(reads.read(self.status), 14.0, Color.slate_300()) }
    func notice_view(reads:UI.Reads) UI.View { return Widgets.text(reads.read(self.notice), 12.0, Color.amber_200()) }
    func comparison_view(reads:UI.Reads) UI.View { return Widgets.text(reads.read(self.comparison), 15.0, Color.cyan_300()) }
    func power_view(reads:UI.Reads) UI.View {
        var label = "Démarrer · M"; if reads.read(self.running) { label = "Arrêter · M" }
        return Widgets.button(label, self.toggle_running)
    }
    func view() UI.View {
        var options:UI.SelectOption<int>[] = []
        for i in 0...self.catalogue.count() { options.append(UI.SelectOption<int>(i, self.name(i))) }
        var style = UI.Style(); style.height = 40.0; style.padding = UI.Insets(8.0)
        style.background = Color.slate_700(); style.foreground = Color.slate_100(); style.radius = 8.0
        var profile = UI.Select<int>(options, self.profile, on_change:self.choose_profile, style:style)
        profile.style.width = 320.0; profile.style.grow = 1.0
        var tools = UI.Row([profile, UI.Reactive(self.power_view), Widgets.button("Essai 8 secondes", self.audition_cycle)], wrap:true)
        tools.style.gap = 10.0
        var settings:UI.View[] = [Widgets.text("Référence 454 : géométrie d’origine conservée. Le V8 américain permet de modifier la cylindrée.", 12.0, Color.slate_300())]
        if self.selected().key != "454" {
            settings = [self.capacity.view(self.capacity_changed), Widgets.button("Appliquer la cylindrée", self.apply_capacity)]
        }
        settings.append(Widgets.button("Rétablir le profil", self.restore)); settings.append(Widgets.text(self.selected().note, 12.0, Color.amber_200()))
        var setup = Widgets.card("Moteur", "Le changement de géométrie demande un moteur arrêté", settings)
        var bench = Widgets.card("Banc d’écoute", "Pédale progressive à vide · Espace : plein gaz", [self.throttle.view(self.controls_changed),
            self.load.view(self.controls_changed), self.idle.view(self.controls_changed), self.volume.view(self.controls_changed)])
        var sound:UI.View[] = [self.texture.view(self.sound_changed), self.exhaust.view(self.sound_changed), self.ambience.view(self.sound_changed)]
        if self.source.profile.intake > 0.0 { sound.append(self.intake.view(self.sound_changed)) }
        sound.append(UI.Reactive(self.comparison_view)); sound.append(Widgets.button("Mémoriser B dans A", self.remember))
        sound.append(Widgets.button("Basculer A / B", self.compare))
        var character = Widgets.card("Écoute A / B", "Comparaison des traitements · volume et conduite communs", sound)
        var row = UI.Row([setup, bench, character], wrap:true); row.style.gap = 14.0
        var content = UI.Column([Widgets.text("Atelier des véhicules", 30.0, Color.slate_100()),
            Widgets.text("Citadines feutrées · diesel TDI hybride · Chevrolet 454 conservé"), tools,
            UI.Reactive(self.readout_view), UI.Reactive(self.status_view), UI.Reactive(self.notice_view), row,
            Widgets.text("Le régime et l’effort viennent de la simulation. Les variantes restent à qualifier par l’écoute.", 12.0, Color.slate_400())])
        content.style.gap = 14.0; content.style.padding = UI.Insets(22.0); content.style.background = Color.bytes(8, 13, 20)
        content.style.foreground = Color.slate_100()
        return UI.ScrollView(content, smooth_scroll:true)
    }
}
