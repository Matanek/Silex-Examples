use GFX.UI
use GFX.Color
use GFX.Audio.Synthesis
use GFX.Audio.Synthesis.EngineParts
use GFX.Audio.Synthesis.EngineVehicles
use STD.Math
use Module.Widgets
use Module.Widgets.Knob

// The workshop owns its listening bench; profiles and DSP belong to Audio.
public class Workshop {
    var source:Synthesis.Engine
    let catalogue:EngineVehicles.Profile[] = EngineVehicles.catalogue()
    var running:UI.State<bool> = UI.State<bool>(false)
    var profile:UI.State<int?> = UI.State<int?>(0)
    var listening:UI.State<int?> = UI.State<int?>(0)
    var advanced:UI.State<bool> = UI.State<bool>(false)
    var fixed_rpm:UI.State<bool> = UI.State<bool>(false)
    var status:UI.State<str> = UI.State<str>("")
    var readout:UI.State<str> = UI.State<str>("Contact coupé")
    var notice:UI.State<str> = UI.State<str>("Choisissez un véhicule, démarrez, puis donnez des gaz.")
    var comparison:UI.State<str> = UI.State<str>("Écoute B · vos réglages")
    var capacity:Knob = Knob("Cylindrée totale", 1_000.0, 50.0, 12_000.0, "cm³", logarithmic:true)
    var exhaust:Knob = Knob("Échappement · feutré ↔ ouvert", 0.0, -1.0, 1.0, "%")
    var attack:Knob = Knob("Combustion · ronde ↔ claquante", 0.4, 0.0, 1.0, "%")
    var intake:Knob = Knob("Admission · discrète ↔ grondante", 0.12, 0.0, 1.0, "%")
    var mechanics:Knob = Knob("Mécanique · discrète ↔ présente", 0.24, 0.0, 1.0, "%")
    var roughness:Knob = Knob("Fonctionnement · régulier ↔ irrégulier", 0.2, 0.0, 1.0, "%")
    var response:Knob = Knob("Temps de réponse aux gaz", 0.4, 0.08, 1.5, "s")
    var rpm:Knob = Knob("Régime du banc · ralenti ↔ limite", 0.0, 0.0, 1.0, "%")
    var throttle:Knob = Knob("Accélérateur", 0.15, 0.0, 1.0, "%")
    var load:Knob = Knob("Effort demandé", 0.2, 0.0, 1.0, "%")
    var volume:Knob = Knob("Volume d’écoute", 0.65, 0.0, 1.0, "%")
    var header:Knob = Knob("Longueur des collecteurs", 400.0, 100.0, 1_500.0, "mm")
    var pipe:Knob = Knob("Longueur des lignes", 2_100.0, 200.0, 3_000.0, "mm")
    var silencer:Knob = Knob("Volume des silencieux", 10.0, 0.1, 30.0, "L", logarithmic:true)
    var compression:Knob = Knob("Rapport de compression géométrique", 11.0, 2.0, 25.0, ":1")
    var accelerating:bool = false
    var audition:bool = false
    var reference_active:bool = false
    private var parts:EngineParts.Assembly
    private var reference:EngineParts.Assembly
    private var reference_roughness:float32 = 0.2
    private var current_rpm:float = 0.0
    private var dirty:bool = false
    private var quiet:float = 0.0
    private var display_elapsed:float = 0.0
    private var audition_time:float = 0.0
    private var idle_rpm:float = 850.0
    private var limit_rpm:float = 6_500.0

    init() {
        self.parts = self.catalogue[0].parts; self.reference = self.parts
        self.source = Synthesis.Engine.assemble(self.parts)
        self.choose_profile(0); self.source.set_state(0.0, fuel:0.0, ramp_frames:0)
    }
    func selected() EngineVehicles.Profile { return self.catalogue[self.profile.value() ?? 0] }
    func name(index:int) str {
        let names = ["Citadine · essence 1,0 L / 3 cylindres", "Citadine · essence 1,4 L / 4 cylindres",
            "Citadine · turbodiesel 1,6 L", "Sportive · 2,0 L turbo / esprit GTI",
            "Sportive · flat-six 3,2 L / esprit 911", "Sportive · V8 5,0 L / esprit Mustang",
            "Sportive · V10 5,2 L / esprit R8", "Sportive · V12 6,0 L / esprit Ferrari",
            "Motocross · 125 cm³ deux temps", "Motocross · 250 cm³ deux temps", "Motocross · 500 cm³ deux temps",
            "Motocross · 250 cm³ quatre temps", "Motocross · 500 cm³ quatre temps",
            "Moto de course · 1 000 cm³ / 4 en ligne", "Moto de course · 1 000 cm³ / V4 groupé",
            "Custom · V-twin 1 200 / esprit Harley", "Chopper · V-twin 1 800 / esprit Harley"]
        return names[index]
    }
    func toggle_running() { self.running.set(!self.running.value()); self.accelerating = false; self.audition = false }
    func audition_cycle() {
        self.running.set(true); self.audition = true; self.audition_time = 0.0
        self.notice.set("Essai 8 s · ralenti, montée, effort, relâchement")
    }
    func change_part(value:float) { self.dirty = true; self.quiet = 0.0; self.notice.set("Réglage B en préparation…") }
    func controls_changed(value:float) { self.audition = false }
    func choose_listening(value:int) { self.source.set_mix(self.listening_mix()) }
    private func listening_mix() EngineParts.Mix {
        var mix = self.parts.mix
        if self.reference_active { mix = self.reference.mix }
        let solo = self.listening.value() ?? 0
        if solo == 1 { return EngineParts.Mix(exhaust:1.0, intake:0.0, mechanics:0.0, turbo:0.0) }
        if solo == 2 { return EngineParts.Mix(exhaust:0.0, intake:1.0, mechanics:0.0, turbo:0.0) }
        if solo == 3 { return EngineParts.Mix(exhaust:0.0, intake:0.0, mechanics:1.0, turbo:0.0) }
        if solo == 4 { return EngineParts.Mix(exhaust:0.0, intake:0.0, mechanics:0.0, turbo:1.0) }
        return mix
    }
    func choose_profile(index:int) {
        self.profile.set(index)
        let selected = self.selected()
        self.idle_rpm = selected.idle_rpm; self.limit_rpm = selected.redline_rpm
        self.capacity.set(selected.parts.block.displacement_litres() * 1_000.0)
        self.exhaust.set(0.0); self.attack.set(selected.parts.head.sharpness)
        self.intake.set(selected.parts.mix.intake); self.mechanics.set(selected.parts.mix.mechanics)
        self.roughness.set(selected.roughness); self.response.set(selected.response_seconds)
        self.header.set(selected.parts.exhausts[0].header.length_mm); self.pipe.set(selected.parts.exhausts[0].pipe.length_mm)
        self.silencer.set(selected.parts.exhausts[0].silencer.volume_litres); self.compression.set(selected.parts.compression_ratio())
        self.rpm.set(0.0); self.throttle.set(0.0); self.load.set(0.2)
        self.accelerating = false; self.audition = false; self.reference_active = false
        self.apply(); self.remember()
    }
    func restore() { self.choose_profile(self.profile.value() ?? 0) }
    func remember() {
        if self.dirty { self.apply() }
        self.reference = self.parts; self.reference_roughness = self.roughness.value()
        self.reference_active = false; self.activate()
        self.notice.set("A mémorisé · modifiez B, puis comparez à régime et effort identiques")
    }
    func compare() {
        if self.dirty { self.apply() }
        self.reference_active = !self.reference_active; self.activate()
    }
    private func activate() {
        var parts = self.parts; var roughness = self.roughness.value()
        if self.reference_active { parts = self.reference; roughness = self.reference_roughness }
        parts.mix = self.listening_mix()
        self.source.set_parts(parts); self.source.set_mix(self.listening_mix()); self.source.set_character(1.0, roughness)
        var label = "Écoute B · vos réglages"; if self.reference_active { label = "Écoute A · référence mémorisée" }
        self.comparison.set(label)
    }
    func apply() {
        let base = self.selected().parts
        var parts = base
        let scale = Math.pow((self.capacity.value() / 1_000.0) / base.block.displacement_litres(), 1.0 / 3.0)
        parts.block.bore_mm *= scale; parts.block.stroke_mm *= scale
        parts.head.chamber_cc = self.capacity.value() / (parts.block.cylinders as float * (self.compression.value() - 1.0))
        parts.head.sharpness = self.attack.value()
        parts.mix.intake = self.intake.value(); parts.mix.mechanics = self.mechanics.value()
        parts.intake.filter_absorption = Math.clamp(base.intake.filter_absorption + (base.mix.intake - self.intake.value()) * 0.8, 0.0, 1.0)
        for i in 0...parts.exhausts.count() {
            parts.exhausts[i].header.length_mm += self.header.value() - base.exhausts[0].header.length_mm
            parts.exhausts[i].pipe.length_mm += self.pipe.value() - base.exhausts[0].pipe.length_mm
            parts.exhausts[i].silencer.volume_litres = self.silencer.value()
            parts.exhausts[i].silencer.absorption = Math.clamp(base.exhausts[i].silencer.absorption - self.exhaust.value() * 0.8, 0.0, 1.0)
            var baffles = base.exhausts[i].silencer.baffles - Math.round(self.exhaust.value() * 5.0) as int
            if baffles < 0 { baffles = 0 }
            if baffles > 8 { baffles = 8 }
            parts.exhausts[i].silencer.baffles = baffles
        }
        match try parts.validate() {
            failure(error) => { self.notice.set("Dimensions incompatibles. Ajustez la cylindrée ou la compression ; le son précédent est conservé.") }
            success => {
                self.parts = parts; self.reference_active = false; self.activate()
                let cc = Math.round(parts.block.displacement_litres() * 1_000.0) as int
                var cycle = "4T"; if parts.block.cycle == EngineParts.Cycle.two_stroke { cycle = "2T" }
                self.status.set("$(parts.block.cylinders) cyl. · $(cc) cm³ · $(cycle) · $(self.selected().idle_rpm as int)–$(self.selected().redline_rpm as int) tr/min")
                self.notice.set("B prêt · comparez l’attaque, le rythme et la résonance")
            }
        }
        self.dirty = false
    }
    func update(delta:float) {
        if self.dirty { self.quiet += delta; if self.quiet >= 0.12 { self.apply() } }
        var throttle = self.throttle.value(); var load = self.load.value()
        var fraction = throttle * (1.0 - 0.35 * load)
        if self.fixed_rpm.value() { fraction = self.rpm.value() }
        if self.accelerating { fraction = 0.85; throttle = 1.0 }
        if self.audition {
            self.audition_time += delta
            let time = self.audition_time
            fraction = 0.0; throttle = 0.12; load = 0.1
            if time >= 1.5 && time < 4.0 { fraction = (time - 1.5) / 2.5 * 0.85; throttle = 0.9; load = 0.35 }
            if time >= 4.0 && time < 6.0 { fraction = 0.7; throttle = 0.85; load = 0.9 }
            if time >= 6.0 { throttle = 0.0; load = 0.0 }
            if time >= 8.0 { self.audition = false; self.notice.set("Essai terminé · régime du banc rétabli") }
        }
        var target = self.idle_rpm + fraction * (self.limit_rpm - self.idle_rpm)
        var fuel:float = 1.0
        if !self.running.value() { target = 0.0; fuel = 0.0; throttle = 0.0; load = 0.0 }
        let previous = self.current_rpm
        self.current_rpm += (target - self.current_rpm) * (1.0 - Math.exp(-delta / self.response.value()))
        if self.current_rpm < 0.1 { self.current_rpm = 0.0 }
        var brake:float = 0.0
        if self.current_rpm < previous && throttle < 0.2 { brake = Math.clamp((previous - self.current_rpm) / Math.max(1.0, delta * 6_000.0), 0.0, 1.0) }
        self.source.set_state(self.current_rpm, throttle:throttle, load:load, fuel:fuel, engine_brake:brake, boost:throttle * load * fraction)
        self.display_elapsed += delta
        if self.display_elapsed >= 0.1 {
            self.display_elapsed = 0.0
            var state = "contact coupé"; if self.running.value() { state = "banc en marche" }
            if self.audition { state = "essai automatique" }
            self.readout.set("$(Math.round(self.current_rpm) as int) tr/min · effort $(Math.round(load * 100.0) as int) % · $(state)")
        }
    }
    func readout_view(reads:UI.Reads) UI.View { return Widgets.text(reads.read(self.readout), 23.0, Color.cyan_300()) }
    func status_view(reads:UI.Reads) UI.View { return Widgets.text(reads.read(self.status), 14.0, Color.slate_300()) }
    func notice_view(reads:UI.Reads) UI.View { return Widgets.text(reads.read(self.notice), 12.0, Color.amber_200()) }
    func comparison_view(reads:UI.Reads) UI.View { return Widgets.text(reads.read(self.comparison), 15.0, Color.cyan_300()) }
    func view() UI.View {
        var options:UI.SelectOption<int>[] = []
        for i in 0...self.catalogue.count() { options.append(UI.SelectOption<int>(i, self.name(i))) }
        var style = UI.Style(); style.height = 40.0; style.padding = UI.Insets(8.0)
        style.background = Color.slate_700(); style.foreground = Color.slate_100(); style.radius = 8.0
        var profile = UI.Select<int>(options, self.profile, on_change:self.choose_profile, style:style)
        profile.style.width = 320.0; profile.style.grow = 1.0
        var tools = UI.Row([profile, Widgets.button("Démarrer / arrêter · M", self.toggle_running),
            Widgets.button("Essai 8 secondes", self.audition_cycle), Widgets.button("Rétablir le profil", self.restore)], wrap:true)
        tools.style.gap = 10.0
        var character = Widgets.card("Signature sonore", "Réglages relatifs au véhicule choisi", [self.capacity.view(self.change_part),
            self.exhaust.view(self.change_part), self.attack.view(self.change_part), self.intake.view(self.change_part),
            self.mechanics.view(self.change_part), self.roughness.view(self.change_part)])
        var bench = Widgets.card("Banc d’écoute", "Espace maintenu : accélérer · relâcher : revenir aux gaz choisis", [
            self.throttle.view(self.controls_changed), self.load.view(self.controls_changed),
            self.response.view(self.controls_changed), self.volume.view(self.controls_changed),
            UI.CollapsiblePanel("Imposer le régime du banc", self.rpm.view(self.controls_changed), self.fixed_rpm),
            Widgets.text("À régime constant, augmentez l’effort pour entendre le moteur travailler.", 12.0, Color.slate_400())])
        let solos:UI.SelectOption<int>[] = [UI.SelectOption<int>(0, "Mélange complet"), UI.SelectOption<int>(1, "Échappement seul"),
            UI.SelectOption<int>(2, "Admission seule"), UI.SelectOption<int>(3, "Mécanique seule"), UI.SelectOption<int>(4, "Turbo seul (si présent)")]
        var comparison = Widgets.card("Comparer A / B", "Même régime et même effort · le niveau sonore peut changer", [
            UI.Reactive(self.comparison_view), Widgets.button("Mémoriser les réglages dans A", self.remember),
            Widgets.button("Basculer A / B", self.compare), UI.Select<int>(solos, self.listening, on_change:self.choose_listening, style:style),
            Widgets.text("A conserve le timbre. L’essai et le banc sont communs aux deux écoutes.", 12.0, Color.slate_400())])
        var row = UI.Row([character, bench, comparison], wrap:true); row.style.gap = 14.0
        var dimensions = UI.Row([Widgets.card("Géométrie", "La cylindrée conserve les proportions du cylindre", [
            self.compression.view(self.change_part), self.header.view(self.change_part)]),
            Widgets.card("Ligne et silencieux", "Les écarts entre sorties sont conservés", [self.pipe.view(self.change_part), self.silencer.view(self.change_part)])], wrap:true)
        dimensions.style.gap = 14.0
        var content = UI.Column([Widgets.text("Atelier des véhicules", 30.0, Color.slate_100()),
            Widgets.text("Choisissez une signature, façonnez son caractère, comparez en fonctionnement."), tools,
            UI.Reactive(self.readout_view), UI.Reactive(self.status_view), UI.Reactive(self.notice_view), row,
            UI.CollapsiblePanel("Réglages avancés", dimensions, self.advanced),
            Widgets.text("Profils sonores stylisés · inspirations, sans reproduction certifiée d’un modèle commercial.", 12.0, Color.slate_400())])
        content.style.gap = 14.0; content.style.padding = UI.Insets(22.0); content.style.background = Color.bytes(8, 13, 20)
        content.style.foreground = Color.slate_100()
        return UI.ScrollView(content, smooth_scroll:true)
    }
}
