use GFX.GPU
use GFX.Scene2D

test "keep the Canvas effects gallery shader compatible with CanvasFilter.v1" {
    let program = GPU.ShaderProgram.hlsl(
        file:"../Sources/CanvasEffectsGallery/Shaders/Tint.hlsl"
    )
    let compatibility = Scene2D.CanvasFilter.compatibility(program)
    assert(compatibility.accepted, compatibility.detail)
}
